# --- Astro DB (remote) ---
ASTRO_DB_REMOTE_URL=
ASTRO_DB_APP_TOKEN=

# --- Upstash Redis (sesiones persistentes en producción) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SMTP (newsletter manual) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# --- Blob de Vercel (subida de imágenes / media) ---
BLOB_READ_WRITE_TOKEN=

# --- reCAPTCHA v2 (opcional) ---
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Google Places (reseñas home) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Google OAuth / Sign in with Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/google/callback

# --- Contact form (optional, falls back to SMTP_FROM) ---
CONTACT_TO=

# --- Print bridge (impresoras ESC/POS del local) ---
# Secreto compartido entre la app y tools/print-bridge. Sin este valor,
# /api/print/poll responde 401 a todo: esa ruta queda fuera del middleware de
# admin y el token es lo unico que la protege.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRINT_BRIDGE_TOKEN=