---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db, Allergen, ProductAllergen, inArray } from "astro:db";

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") === "1";
const error = url.searchParams.get("error") ?? "";

const allergens = await db
  .select({
    id: Allergen.id,
    name: Allergen.name,
    slug: Allergen.slug,
    iconUrl: Allergen.iconUrl,
    sortOrder: Allergen.sortOrder,
    active: Allergen.active,
    createdAt: Allergen.createdAt,
    updatedAt: Allergen.updatedAt,
  })
  .from(Allergen)
  .orderBy(Allergen.sortOrder, Allergen.name);

const allergenIds = allergens.map((row) => row.id);

const productLinks = allergenIds.length
  ? await db
      .select({
        allergenId: ProductAllergen.allergenId,
        id: ProductAllergen.id,
      })
      .from(ProductAllergen)
      .where(inArray(ProductAllergen.allergenId, allergenIds))
  : [];

const productCountByAllergen = new Map<number, number>();
for (const row of productLinks) {
  productCountByAllergen.set(
    row.allergenId,
    (productCountByAllergen.get(row.allergenId) ?? 0) + 1,
  );
}

const totalAllergens = allergens.length;
const activeAllergens = allergens.filter((row) => row.active).length;
const withIcons = allergens.filter((row) => Boolean(row.iconUrl)).length;
const linkedAllergens = allergens.filter(
  (row) => (productCountByAllergen.get(row.id) ?? 0) > 0,
).length;

const errorMessage =
  error === "missing-name"
    ? "El nombre es obligatorio."
    : error === "invalid-slug"
      ? "El slug no es válido."
      : error === "duplicate-slug"
        ? "Ya existe otro alérgeno con ese slug."
        : error === "invalid-allergen"
          ? "El alérgeno indicado no es válido."
          : error === "not-found"
            ? "El alérgeno ya no existe."
            : error === "in-use-products"
              ? "No se puede borrar porque sigue enlazado a productos."
              : error === "invalid-intent"
                ? "Acción no válida."
                : "";

const stats = [
  {
    label: "Total",
    value: totalAllergens,
    note: "Catálogo global disponible",
    tone: "border-white/10 bg-white/[0.03] text-slate-300",
  },
  {
    label: "Activos",
    value: activeAllergens,
    note: "Disponibles para asociar",
    tone: "border-emerald-400/15 bg-emerald-400/8 text-emerald-200",
  },
  {
    label: "Con icono",
    value: withIcons,
    note: "Preview visual listo",
    tone: "border-sky-400/15 bg-sky-400/8 text-sky-200",
  },
  {
    label: "En uso",
    value: linkedAllergens,
    note: "Actualmente enlazados",
    tone: "border-amber-400/15 bg-amber-400/8 text-amber-200",
  },
];
---

<AdminLayout
  title="Alérgenos · Admin · Arcadia"
  heading="Alérgenos globales"
  description="Catálogo visual global para pública y admin. He reordenado esta pantalla para que respire más: menos ruido, más separación y edición más clara por bloque."
  actions={true}
>
  <Fragment slot="actions">
    <div class="flex flex-wrap gap-3">
      <a
        href="/admin/catalogo/productos"
        class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-sky-400/15 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/25 hover:bg-sky-400/15"
      >
        Ver productos
      </a>

      <a
        href="/admin/catalogo/ingredientes"
        class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06] hover:text-white"
      >
        Ver ingredientes
      </a>

      <a
        href="/admin/catalogo/modificadores"
        class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06] hover:text-white"
      >
        Ver modificadores
      </a>
    </div>
  </Fragment>

  {
    saved ? (
      <section class="mb-6 rounded-[26px] border border-emerald-400/15 bg-emerald-400/10 px-5 py-4 text-sm text-emerald-100">
        Alérgenos actualizados correctamente.
      </section>
    ) : null
  }

  {
    errorMessage ? (
      <section class="mb-6 rounded-[26px] border border-rose-400/15 bg-rose-400/10 px-5 py-4 text-sm text-rose-100">
        {errorMessage}
      </section>
    ) : null
  }

  <section class="grid gap-4 md:grid-cols-2 2xl:grid-cols-4">
    {
      stats.map((stat) => (
        <article
          class:list={[
            "rounded-[28px] border p-6 shadow-[0_18px_60px_rgba(2,6,23,0.28)]",
            stat.tone,
          ]}
        >
          <div class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500">
            {stat.label}
          </div>
          <div class="mt-4 text-4xl font-semibold tracking-[-0.05em] text-white">
            {stat.value}
          </div>
          <p class="mt-3 text-sm leading-6 text-slate-400">{stat.note}</p>
        </article>
      ))
    }
  </section>

  <section
    class="mt-6 grid gap-6 2xl:grid-cols-[380px_minmax(0,1fr)] 2xl:items-start"
  >
    <aside class="space-y-6 2xl:sticky 2xl:top-6">
      <section
        class="rounded-[30px] border border-white/10 bg-[#0f172a]/82 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.34)] lg:p-7"
      >
        <div
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
        >
          Alta
        </div>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white">
          Nuevo alérgeno
        </h2>
        <p class="mt-3 text-sm leading-7 text-slate-400">
          Da de alta un nuevo alérgeno con nombre, slug, icono y orden global.
        </p>

        <form
          method="post"
          action="/api/admin/allergens"
          class="mt-7 grid gap-5"
        >
          <input type="hidden" name="intent" value="create" />

          <label class="block">
            <span
              class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
              >Nombre</span
            >
            <input
              class="w-full rounded-2xl border border-white/10 bg-[#091121] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/30 focus:outline-none"
              type="text"
              name="name"
              placeholder="Gluten"
              required
            />
          </label>

          <label class="block">
            <span
              class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
              >Slug</span
            >
            <input
              class="w-full rounded-2xl border border-white/10 bg-[#091121] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/30 focus:outline-none"
              type="text"
              name="slug"
              placeholder="Se genera automáticamente si lo dejas vacío"
            />
          </label>

          <label class="block">
            <span
              class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
              >Icon URL</span
            >
            <input
              class="w-full rounded-2xl border border-white/10 bg-[#091121] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/30 focus:outline-none"
              type="text"
              name="iconUrl"
              placeholder="/images/allergens/gluten.webp"
            />
          </label>

          <label class="block">
            <span
              class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
              >Orden</span
            >
            <input
              class="w-full rounded-2xl border border-white/10 bg-[#091121] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/30 focus:outline-none"
              type="number"
              name="sortOrder"
              min="0"
              step="1"
              value={allergens.length}
              required
            />
          </label>

          <label
            class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4"
          >
            <div class="flex items-start gap-3">
              <input
                class="mt-1 h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400"
                type="checkbox"
                name="active"
                checked
              />
              <div>
                <div class="text-sm font-semibold text-white">Activo</div>
                <p class="mt-1 text-sm leading-6 text-slate-400">
                  Disponible para asociar a productos desde catálogo y
                  formularios del admin.
                </p>
              </div>
            </div>
          </label>

          <button
            type="submit"
            class="inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/15 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/25 hover:bg-sky-400/15"
          >
            Crear alérgeno
          </button>
        </form>
      </section>

      <section
        class="rounded-[30px] border border-white/10 bg-[#0f172a]/82 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.34)] lg:p-7"
      >
        <div
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
        >
          Criterio
        </div>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white">
          Representación visual
        </h2>

        <div class="mt-6 space-y-4">
          <article
            class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4"
          >
            <div class="text-sm font-semibold text-white">
              Iconos compartidos
            </div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              El icono se reutiliza donde exista visualización del alérgeno en
              admin y en pública.
            </p>
          </article>

          <article
            class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4"
          >
            <div class="text-sm font-semibold text-white">Orden global</div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              El orden define cómo se presentan los alérgenos cuando la app
              necesita una lista estable.
            </p>
          </article>

          <article
            class="rounded-[24px] border border-amber-400/15 bg-amber-400/8 p-4"
          >
            <div class="text-sm font-semibold text-amber-100">
              Borrado protegido
            </div>
            <p class="mt-2 text-sm leading-6 text-amber-100/80">
              Si un alérgeno sigue enlazado a productos, el borrado se bloquea
              para evitar incoherencias.
            </p>
          </article>
        </div>
      </section>
    </aside>

    <section
      class="overflow-hidden rounded-[32px] border border-white/10 bg-[#0f172a]/82 shadow-[0_24px_80px_rgba(2,6,23,0.34)]"
    >
      <div class="border-b border-white/[0.08] px-6 py-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <div
              class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
            >
              Gestión
            </div>
            <h2
              class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white lg:text-[2rem]"
            >
              Catálogo global de alérgenos
            </h2>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-400">
              Edición más espaciosa y ordenada. Cada alérgeno tiene su propio
              bloque visual con preview, datos y acciones sin comprimir el
              contenido.
            </p>
          </div>

          <div
            class="inline-flex items-center rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-slate-300"
          >
            {totalAllergens} elemento{totalAllergens === 1 ? "" : "s"}
          </div>
        </div>
      </div>

      {
        allergens.length === 0 ? (
          <div class="px-6 py-16 text-center lg:px-8">
            <div class="mx-auto max-w-md rounded-[28px] border border-white/10 bg-[#091121] p-8">
              <div class="text-lg font-semibold text-white">
                No hay alérgenos
              </div>
              <p class="mt-2 text-sm leading-6 text-slate-400">
                Crea el primero desde el bloque lateral para empezar a construir
                el catálogo global.
              </p>
            </div>
          </div>
        ) : (
          <div class="space-y-5 px-6 py-6 lg:px-8 lg:py-8">
            {allergens.map((allergen) => {
              const linkedProducts =
                productCountByAllergen.get(allergen.id) ?? 0;
              const canDelete = linkedProducts === 0;

              return (
                <section class="rounded-[28px] border border-white/10 bg-[#091121]/80 p-5 shadow-[0_18px_60px_rgba(2,6,23,0.22)] lg:p-6">
                  <div class="flex flex-col gap-5 border-b border-white/[0.08] pb-5 lg:flex-row lg:items-start lg:justify-between">
                    <div class="flex min-w-0 items-center gap-4">
                      {allergen.iconUrl ? (
                        <img
                          src={allergen.iconUrl}
                          alt={allergen.name}
                          class="h-16 w-16 rounded-[22px] object-cover ring-1 ring-white/10"
                        />
                      ) : (
                        <div class="flex h-16 w-16 items-center justify-center rounded-[22px] border border-white/10 bg-white/[0.03] text-sm font-semibold uppercase tracking-[0.16em] text-slate-400">
                          {allergen.name.slice(0, 1)}
                        </div>
                      )}

                      <div class="min-w-0">
                        <div class="text-xl font-semibold tracking-[-0.03em] text-white">
                          {allergen.name}
                        </div>
                        <div class="mt-2 flex flex-wrap items-center gap-2.5">
                          <code class="rounded-xl border border-white/10 bg-white/[0.04] px-3 py-1.5 text-xs text-slate-300">
                            {allergen.slug}
                          </code>

                          <span
                            class:list={[
                              "inline-flex items-center rounded-full border px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.16em]",
                              allergen.active
                                ? "border-emerald-400/15 bg-emerald-400/10 text-emerald-200"
                                : "border-rose-400/15 bg-rose-400/10 text-rose-200",
                            ]}
                          >
                            {allergen.active ? "Activo" : "Inactivo"}
                          </span>

                          <span class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-300">
                            {linkedProducts} producto
                            {linkedProducts === 1 ? "" : "s"}
                          </span>
                        </div>
                      </div>
                    </div>

                    <div class="grid gap-3 sm:grid-cols-2 lg:w-[340px]">
                      <div class="rounded-[22px] border border-white/10 bg-white/[0.03] px-4 py-3">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                          Orden
                        </div>
                        <div class="mt-2 text-lg font-semibold text-white">
                          {allergen.sortOrder}
                        </div>
                      </div>

                      <div class="rounded-[22px] border border-white/10 bg-white/[0.03] px-4 py-3">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                          Icono
                        </div>
                        <div class="mt-2 text-sm font-medium text-slate-300">
                          {allergen.iconUrl ? "Configurado" : "Sin icono"}
                        </div>
                      </div>
                    </div>
                  </div>

                  <form
                    method="post"
                    action="/api/admin/allergens"
                    class="mt-6 grid gap-5"
                  >
                    <input type="hidden" name="intent" value="update" />
                    <input
                      type="hidden"
                      name="allergenId"
                      value={allergen.id}
                    />

                    <div class="grid gap-5 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_140px]">
                      <label class="block xl:col-span-1">
                        <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                          Nombre
                        </span>
                        <input
                          class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/30 focus:outline-none"
                          type="text"
                          name="name"
                          value={allergen.name}
                          required
                        />
                      </label>

                      <label class="block xl:col-span-1">
                        <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                          Icon URL
                        </span>
                        <input
                          class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/30 focus:outline-none"
                          type="text"
                          name="iconUrl"
                          value={allergen.iconUrl ?? ""}
                          placeholder="/images/allergens/gluten.webp"
                        />
                      </label>

                      <label class="block">
                        <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                          Orden
                        </span>
                        <input
                          class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/30 focus:outline-none"
                          type="number"
                          name="sortOrder"
                          min="0"
                          step="1"
                          value={allergen.sortOrder}
                          required
                        />
                      </label>
                    </div>

                    <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_220px]">
                      <label class="block">
                        <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                          Slug
                        </span>
                        <input
                          class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/30 focus:outline-none"
                          type="text"
                          name="slug"
                          value={allergen.slug}
                          required
                        />
                      </label>

                      <label class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4">
                        <div class="flex items-start gap-3">
                          <input
                            class="mt-1 h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400"
                            type="checkbox"
                            name="active"
                            checked={allergen.active}
                          />
                          <div>
                            <div class="text-sm font-semibold text-white">
                              Activo
                            </div>
                            <p class="mt-1 text-sm leading-6 text-slate-400">
                              Visible para asociación y uso operativo.
                            </p>
                          </div>
                        </div>
                      </label>
                    </div>

                    <div class="flex flex-col gap-4 border-t border-white/[0.08] pt-5 lg:flex-row lg:items-center lg:justify-between">
                      <div class="text-sm leading-6 text-slate-400">
                        {canDelete
                          ? "Se puede borrar porque no está enlazado a productos."
                          : "No se puede borrar porque sigue asociado a productos."}
                      </div>

                      <div class="flex flex-wrap gap-3">
                        <button
                          type="submit"
                          class="inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/15 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/25 hover:bg-sky-400/15"
                        >
                          Guardar alérgeno
                        </button>
                      </div>
                    </div>
                  </form>

                  <div class="mt-5 border-t border-white/[0.08] pt-5">
                    <form method="post" action="/api/admin/allergens">
                      <input type="hidden" name="intent" value="delete" />
                      <input
                        type="hidden"
                        name="allergenId"
                        value={allergen.id}
                      />
                      <button
                        type="submit"
                        disabled={!canDelete}
                        class:list={[
                          "inline-flex min-h-10 items-center justify-center rounded-2xl px-4 py-2.5 text-sm font-semibold transition",
                          canDelete
                            ? "border border-rose-400/15 bg-rose-400/10 text-rose-200 hover:border-rose-400/25 hover:bg-rose-400/15"
                            : "cursor-not-allowed border border-white/10 bg-white/[0.03] text-slate-500",
                        ]}
                      >
                        Borrar alérgeno
                      </button>
                    </form>
                  </div>
                </section>
              );
            })}
          </div>
        )
      }
    </section>
  </section>
</AdminLayout>
