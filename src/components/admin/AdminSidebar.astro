---
import AdminIcon from "@/components/admin/AdminIcon.astro";
import {
  ADMIN_NAV,
  isItemActive,
  isSectionActive,
  type AdminNavAccent,
} from "@/lib/admin/nav";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props as Props;

/**
 * Clases por acento de sección. Se escriben completas a propósito: Tailwind
 * only genera las clases que encuentra literalmente en el código, así que no
 * se pueden componer con plantillas del tipo `text-${accent}-300`.
 */
const ACCENT_CLASSES: Record<
  AdminNavAccent,
  { icon: string; itemBg: string; dot: string; rail: string }
> = {
  sky: {
    icon: "text-sky-300",
    itemBg: "bg-sky-400/10",
    dot: "bg-sky-300",
    rail: "bg-sky-400/10 text-sky-300",
  },
  emerald: {
    icon: "text-emerald-300",
    itemBg: "bg-emerald-400/10",
    dot: "bg-emerald-300",
    rail: "bg-emerald-400/10 text-emerald-300",
  },
  amber: {
    icon: "text-amber-300",
    itemBg: "bg-amber-400/10",
    dot: "bg-amber-300",
    rail: "bg-amber-400/10 text-amber-300",
  },
  fuchsia: {
    icon: "text-fuchsia-300",
    itemBg: "bg-fuchsia-400/10",
    dot: "bg-fuchsia-300",
    rail: "bg-fuchsia-400/10 text-fuchsia-300",
  },
  rose: {
    icon: "text-rose-300",
    itemBg: "bg-rose-400/10",
    dot: "bg-rose-300",
    rail: "bg-rose-400/10 text-rose-300",
  },
  teal: {
    icon: "text-teal-300",
    itemBg: "bg-teal-400/10",
    dot: "bg-teal-300",
    rail: "bg-teal-400/10 text-teal-300",
  },
  violet: {
    icon: "text-violet-300",
    itemBg: "bg-violet-400/10",
    dot: "bg-violet-300",
    rail: "bg-violet-400/10 text-violet-300",
  },
};
---

<aside
  data-admin-sidebar
  style="width: var(--admin-sidebar-width)"
  class="hidden h-dvh min-w-0 shrink-0 overflow-hidden bg-admin-surface-2 text-slate-100 xl:flex xl:flex-col xl:transition-[width] xl:duration-200 xl:ease-out"
>
  <div class="flex h-dvh flex-col overflow-hidden">
    <!-- Marca. El botón de contraer vive en el header de página (AdminLayout). -->
    <div
      data-admin-sidebar-top
      class="flex h-[var(--admin-header-h)] shrink-0 items-center px-4 transition-all duration-200"
    >
      <div
        data-admin-sidebar-brand-row
        class="flex w-full items-center gap-3 transition-all duration-200"
      >
        <a href="/admin" data-admin-sidebar-brand-link class="min-w-0 flex-1">
          <div data-admin-sidebar-brand-inner class="flex items-center gap-3">
            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-admin border border-admin-border bg-white/[0.04]"
            >
              <img
                src="/ARCADIA_LOGO_WHITE.svg"
                alt="Arcadia"
                class="h-6 w-6 object-contain"
              />
            </div>

            <div data-admin-sidebar-brand-text class="min-w-0">
              <div class="admin-eyebrow">Arcadia</div>
              <div class="mt-1 truncate text-base font-semibold text-white">
                Admin Panel
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>

    <!-- FULL NAV (sidebar expandido) -->
    <nav
      data-admin-sidebar-nav
      data-admin-nav-full
      data-admin-scrollable
      class="min-h-0 flex-1 overflow-y-auto px-3 py-4 transition-all duration-200"
    >
      <div class="space-y-1.5">
        {
          ADMIN_NAV.map((section) => {
            const sectionActive = isSectionActive(section, currentPath);
            const accent = ACCENT_CLASSES[section.accent];

            return (
              <details
                class="admin-nav-group"
                data-nav-group={section.id}
                open={sectionActive}
              >
                <summary
                  class="admin-focus flex cursor-pointer select-none items-center gap-3 rounded-admin border border-transparent px-3 py-3 transition hover:border-admin-border hover:bg-white/[0.03]"
                >
                  <span
                    class:list={[
                      "flex shrink-0 items-center justify-center transition",
                      sectionActive ? accent.icon : "text-slate-400",
                    ]}
                  >
                    <AdminIcon name={section.icon} class="h-[22px] w-[22px]" />
                  </span>

                  <span
                    data-admin-sidebar-group-title
                    class:list={[
                      "flex-1 text-sm font-semibold transition",
                      sectionActive ? "text-white" : "text-slate-200",
                    ]}
                  >
                    {section.title}
                  </span>

                  <AdminIcon
                    name="chevron"
                    class="nav-chevron h-4 w-4 text-slate-500 transition-transform"
                  />
                </summary>

                <div class="nav-group-panel">
                  <div class="nav-group-panel-inner">
                    <div class="mt-1 mb-2 space-y-0.5 pl-3">
                  {section.items.map((item) => {
                    const active = isItemActive(item.href, currentPath);

                    return (
                      <a
                        href={item.href}
                        class:list={[
                          "group flex items-center gap-3 rounded-admin px-3 py-2 text-sm transition",
                          active
                            ? `${accent.itemBg} font-semibold text-white`
                            : "text-slate-400 hover:bg-white/[0.03] hover:text-slate-200",
                        ]}
                      >
                        <span
                          class:list={[
                            "h-1.5 w-1.5 shrink-0 rounded-full transition",
                            active
                              ? accent.dot
                              : "bg-slate-600 group-hover:bg-slate-400",
                          ]}
                        />
                        <span class="flex-1 truncate">{item.label}</span>
                        {item.soon ? (
                          <span class="rounded-full border border-admin-border bg-white/[0.03] px-2 py-0.5 text-[9px] font-semibold uppercase tracking-[0.14em] text-slate-500">
                            Pronto
                          </span>
                        ) : null}
                      </a>
                    );
                  })}
                    </div>
                  </div>
                </div>
              </details>
            );
          })
        }
      </div>
    </nav>

    <!-- RAIL (sidebar colapsado) -->
    <div
      data-admin-nav-rail
      class="min-h-0 flex-1 flex-col items-center gap-2 overflow-y-auto px-2 py-4"
    >
      {
        ADMIN_NAV.map((section) => {
          const sectionActive = isSectionActive(section, currentPath);

          return (
            <a
              href={section.landing}
              title={section.title}
              aria-label={section.title}
              class:list={[
                "admin-focus flex h-11 w-11 items-center justify-center rounded-admin transition",
                sectionActive
                  ? ACCENT_CLASSES[section.accent].rail
                  : "text-slate-400 hover:bg-white/[0.04] hover:text-white",
              ]}
            >
              <AdminIcon name={section.icon} class="h-[22px] w-[22px]" />
            </a>
          );
        })
      }
    </div>

  </div>

  <style is:global>
    [data-admin-sidebar] details.admin-nav-group > summary {
      list-style: none;
    }
    [data-admin-sidebar] details.admin-nav-group > summary::-webkit-details-marker {
      display: none;
    }
    [data-admin-sidebar] details.admin-nav-group[open] > summary .nav-chevron {
      transform: rotate(180deg);
    }

    /**
     * Despliegue animado.
     *
     * `<details>` no anima su apertura porque el contenido pasa de
     * `display:none` a visible de golpe. El truco es una rejilla que va de
     * `0fr` a `1fr`: anima sin necesidad de medir alturas en JS y funciona
     * aunque el contenido cambie de tamaño.
     */
    [data-admin-sidebar] .nav-group-panel {
      display: grid;
      grid-template-rows: 1fr;
      transition: grid-template-rows 220ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-admin-sidebar] .nav-group-panel-inner {
      min-height: 0;
      overflow: hidden;
    }

    /* Estado intermedio que fija el script mientras anima. */
    [data-admin-sidebar] .nav-group-panel[data-collapsed="true"] {
      grid-template-rows: 0fr;
    }

    @media (prefers-reduced-motion: reduce) {
      [data-admin-sidebar] .nav-group-panel {
        transition: none;
      }
      [data-admin-sidebar] .nav-chevron {
        transition: none;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const STORAGE_KEY = "arcadia-admin-nav-open";
      const sidebar = document.querySelector("[data-admin-sidebar]");
      if (!sidebar) return;

      const groups = Array.from(sidebar.querySelectorAll("[data-nav-group]"));
      if (!groups.length) return;

      function readOpen() {
        try {
          const raw = window.localStorage.getItem(STORAGE_KEY);
          return raw ? new Set(JSON.parse(raw)) : null;
        } catch {
          return null;
        }
      }

      function writeOpen() {
        try {
          const ids = groups
            .filter((group) => group.open)
            .map((group) => group.getAttribute("data-nav-group"));
          window.localStorage.setItem(STORAGE_KEY, JSON.stringify(ids));
        } catch {
          // almacenamiento no disponible
        }
      }

      // Restaurar sin animación: se aplica antes del primer pintado para que
      // no se vea saltar el sidebar al cambiar de página.
      const stored = readOpen();
      if (stored) {
        for (const group of groups) {
          const id = group.getAttribute("data-nav-group");
          // La sección activa se abre siempre: es donde está el usuario.
          if (group.open) continue;
          if (stored.has(id)) group.open = true;
        }
      }
      writeOpen();

      for (const group of groups) {
        const summary = group.querySelector("summary");
        const panel = group.querySelector(".nav-group-panel");
        if (!summary || !panel) continue;

        summary.addEventListener("click", (event) => {
          // El toggle se gestiona a mano para poder animar también el cierre;
          // sin JS, <details> sigue funcionando de forma nativa.
          event.preventDefault();

          if (group.dataset.animating === "1") return;
          group.dataset.animating = "1";

          const finish = () => {
            group.dataset.animating = "";
            panel.removeAttribute("data-collapsed");
            writeOpen();
          };

          if (group.open) {
            panel.setAttribute("data-collapsed", "true");
            const done = () => {
              panel.removeEventListener("transitionend", done);
              group.open = false;
              finish();
            };
            panel.addEventListener("transitionend", done);
            // Salvaguarda por si el navegador no dispara transitionend.
            window.setTimeout(() => {
              if (group.dataset.animating === "1") done();
            }, 320);
          } else {
            panel.setAttribute("data-collapsed", "true");
            group.open = true;
            requestAnimationFrame(() => {
              requestAnimationFrame(() => panel.removeAttribute("data-collapsed"));
            });
            window.setTimeout(finish, 240);
          }
        });
      }
    })();
  </script>
</aside>
