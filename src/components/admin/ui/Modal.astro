---
/**
 * Modal encima de la página (elemento <dialog> nativo, sin JS de framework).
 * El botón disparador y el <dialog> se emparejan por `id`; el open/close lo
 * gestiona un único listener delegado en AdminLayout.astro
 * ([data-modal-open] / [data-modal-close] / click en el backdrop).
 *
 * El <form> que va dentro sigue siendo un POST clásico: al enviarse, la
 * página navega/recarga igual que antes, así que no hace falta gestionar
 * el cierre del modal tras guardar.
 */
import AdminIcon from "@/components/admin/AdminIcon.astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  triggerLabel: string;
  triggerClass?: string;
  size?: "md" | "lg" | "xl";
}

const {
  id,
  title,
  description,
  triggerLabel,
  triggerClass = "inline-flex min-h-10 items-center justify-center gap-2 rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15",
  size = "md",
} = Astro.props as Props;

const width = size === "xl" ? "48rem" : size === "lg" ? "40rem" : "32rem";
---

<button type="button" data-modal-open={id} class={triggerClass}>
  {triggerLabel}
</button>

<dialog id={id} class="admin-modal" style={`--admin-modal-width:${width}`}>
  <div class="admin-modal-panel">
    <div class="admin-modal-header">
      <div class="min-w-0">
        <h3 class="text-lg font-semibold tracking-[-0.02em] text-white">{title}</h3>
        {description ? <p class="mt-1 text-sm leading-6 text-admin-muted">{description}</p> : null}
      </div>
      <button type="button" data-modal-close class="admin-modal-close" aria-label="Cerrar">
        <AdminIcon name="plus" class="h-[22px] w-[22px] rotate-45" />
      </button>
    </div>
    <div class="admin-modal-body">
      <slot />
    </div>
  </div>
</dialog>
