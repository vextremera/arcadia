---
/**
 * Gauge radial (arco ~250°) para progreso / comparativas, estilo "Monthly Target".
 * SVG puro calculado en servidor, sin JS en cliente.
 */
interface Props {
  percent: number;
  width?: number;
  strokeWidth?: number;
  color?: string;
  class?: string;
}

const {
  percent,
  width = 240,
  strokeWidth = 18,
  color = "#38bdf8",
  class: className = "",
} = Astro.props as Props;

const startAngle = -125;
const endAngle = 125;
const clamped = Math.max(0, Math.min(100, percent));
const valueAngle = startAngle + ((endAngle - startAngle) * clamped) / 100;

const r = (width - strokeWidth) / 2;
const cx = width / 2;
const cy = r + strokeWidth / 2;

function polar(angleDeg: number) {
  const rad = ((angleDeg - 90) * Math.PI) / 180;
  return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
}

function arc(a0: number, a1: number) {
  const p0 = polar(a0);
  const p1 = polar(a1);
  const largeArc = a1 - a0 <= 180 ? 0 : 1;
  return `M ${p0.x} ${p0.y} A ${r} ${r} 0 ${largeArc} 1 ${p1.x} ${p1.y}`;
}

const height = polar(endAngle).y + strokeWidth / 2;
const trackPath = arc(startAngle, endAngle);
const valuePath = clamped > 0 ? arc(startAngle, valueAngle) : "";
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  width="100%"
  class:list={["block overflow-visible", className]}
  role="img"
  aria-label={`Progreso ${Math.round(percent)}%`}
>
  <path d={trackPath} fill="none" stroke="rgba(255,255,255,0.08)" stroke-width={strokeWidth} stroke-linecap="round" />
  {
    valuePath ? (
      <path d={valuePath} fill="none" stroke={color} stroke-width={strokeWidth} stroke-linecap="round" />
    ) : null
  }
</svg>
