---
/**
 * KPI card estilo TailAdmin: icono en caja arriba, etiqueta, valor grande y
 * delta (▲/▼ vs periodo anterior) alineado a la derecha del valor.
 */
import AdminIcon from "@/components/admin/AdminIcon.astro";
import type { AdminIconName } from "@/lib/admin/icons";

interface Props {
  icon?: AdminIconName;
  label: string;
  value: string;
  /** Texto del delta, p. ej. "+12.4%". */
  delta?: string;
  trend?: "up" | "down" | "flat";
  helper?: string;
  class?: string;
}

const {
  icon,
  label,
  value,
  delta,
  trend = "flat",
  helper,
  class: className = "",
} = Astro.props as Props;

const trendClasses =
  trend === "up"
    ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
    : trend === "down"
      ? "border-rose-400/20 bg-rose-400/10 text-rose-300"
      : "border-white/10 bg-white/[0.03] text-slate-300";

const trendGlyph = trend === "up" ? "▲" : trend === "down" ? "▼" : "•";
---

<article class:list={["admin-card p-7 lg:p-8", className]}>
  {
    icon ? (
      <div class="flex items-center text-admin-muted">
        <AdminIcon name={icon} class="h-7 w-7" />
      </div>
    ) : null
  }

  <div class:list={["flex items-end justify-between gap-4", icon ? "mt-7" : ""]}>
    <div class="min-w-0">
      <div class="text-sm font-medium text-admin-muted">{label}</div>
      <div class="mt-2 text-[2rem] font-semibold leading-none tracking-[-0.02em] text-white lg:text-[2.25rem]">
        {value}
      </div>
    </div>

    {
      delta ? (
        <span
          class:list={[
            "inline-flex shrink-0 items-center gap-1 rounded-full border px-2.5 py-1 text-[11px] font-semibold",
            trendClasses,
          ]}
        >
          <span aria-hidden="true">{trendGlyph}</span>
          {delta}
        </span>
      ) : null
    }
  </div>

  {helper ? <p class="mt-3 text-sm leading-6 text-admin-muted">{helper}</p> : null}

  <div class="mt-4 empty:hidden">
    <slot name="spark" />
  </div>
</article>
