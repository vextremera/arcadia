---
import OpenProductButton from "@/islands/product/OpenProductButton";
import FavoriteButton from "@/islands/favorites/FavoriteButton";

type ProductCardModel = {
  id: number;
  name: string;
  description?: string | null;
  imageUrl?: string | null;
  priceCents: number;
  deliveryEnabled: boolean;
  pickupEnabled: boolean;
};

const { product } = Astro.props as { product: ProductCardModel };

const price = (product.priceCents / 100).toFixed(2);
---

<article class="rounded-2xl border border-zinc-200 p-5">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="truncate text-base font-semibold">{product.name}</h3>

          {product.description && (
            <p class="mt-1 line-clamp-2 text-sm text-zinc-600">{product.description}</p>
          )}

          <p class="mt-2 text-sm font-semibold">{price} €</p>

          <p class="mt-1 text-xs text-zinc-500">
            {product.deliveryEnabled ? "Delivery" : "Sin delivery"} ·{" "}
            {product.pickupEnabled ? "Recogida" : "Sin recogida"}
          </p>
        </div>

        {/* Favoritos */}
        <FavoriteButton client:load productId={product.id} />
      </div>
    </div>

    {product.imageUrl && (
      <img
        src={product.imageUrl}
        alt={product.name}
        loading="lazy"
        class="h-20 w-20 shrink-0 rounded-xl object-cover"
      />
    )}
  </div>

  <div class="mt-4">
    <OpenProductButton client:visible productId={product.id} label="Personalizar" />
  </div>
</article>
