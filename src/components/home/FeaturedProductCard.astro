---
import FavoriteButton from "@/islands/favorites/FavoriteButton";

type FeaturedProduct = {
  id: number;
  name: string;
  categoryName?: string | null;
  imageUrl?: string | null;
  priceCents: number;
};

const { product } = Astro.props as { product: FeaturedProduct };
const price = `${(product.priceCents / 100).toFixed(2)} €`;

const openProductJs = `window.dispatchEvent(new CustomEvent('arcadia:product:open',{detail:{productId:${product.id}}}))`;
---

<article class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/5">
  <div class="relative aspect-[16/10] bg-zinc-100">
    {product.imageUrl ? (
      <img
        src={product.imageUrl}
        alt={product.name}
        loading="lazy"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="h-full w-full bg-[radial-gradient(circle_at_30%_30%,rgba(0,0,0,.08),transparent_55%)]" />
    )}

    <div class="absolute right-3 top-3">
      <FavoriteButton client:visible productId={product.id} />
    </div>
  </div>

  <div class="p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h3 class="truncate text-base font-semibold">{product.name}</h3>
        {product.categoryName ? (
          <p class="mt-1 text-xs text-zinc-500">{product.categoryName}</p>
        ) : null}
      </div>

      <div class="shrink-0 rounded-full bg-zinc-900 px-3 py-1 text-sm font-bold text-white">
        {price}
      </div>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-2">
      <button
        type="button"
        class="rounded-xl bg-[#7b1e1e] px-4 py-2 text-sm font-semibold text-white hover:opacity-95"
        onclick={openProductJs}
      >
        Añadir
      </button>

      <button
        type="button"
        class="rounded-xl border border-zinc-300 bg-white px-4 py-2 text-sm font-semibold text-zinc-900 hover:bg-zinc-50"
        onclick={openProductJs}
      >
        Ver
      </button>
    </div>
  </div>
</article>
