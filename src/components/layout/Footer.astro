---
import { DEFAULT_LANG, getSiteCopy, SUPPORTED_LANGS } from "@/lib/i18n";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = getSiteCopy(lang).footer;
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;

type LangOption = {
  code: (typeof SUPPORTED_LANGS)[number];
  short: string;
  label: string;
  flagClass: string;
};

const langOptions: LangOption[] = [
  { code: "es", short: "ES", label: "Español", flagClass: "fi fi-es" },
  { code: "ca", short: "CA", label: "Català", flagClass: "fi fi-es-ct" },
  { code: "en", short: "EN", label: "English", flagClass: "fi fi-gb" },
  { code: "fr", short: "FR", label: "Français", flagClass: "fi fi-fr" },
];

const activeLang =
  langOptions.find((option) => option.code === lang) ?? langOptions[0];

const otherLangOptions = langOptions.filter(
  (option) => option.code !== activeLang.code,
);

const socialLinks = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/victor_arcadia/",
    label: "Instagram",
  },
  {
    name: "Facebook",
    href: "https://www.facebook.com/victorbararcadia/?locale=es_LA",
    label: "Facebook",
  },
  {
    name: "WhatsApp",
    href: "https://wa.me/34606077800?text=Hola%21%20Estoy%20interesado%20en%20hacer%20una%20reserva.",
    label: "WhatsApp",
  },
];
---

<footer class="mt-16 border-t border-zinc-200">
  <div class="mx-auto w-full max-w-340 px-4 py-10 sm:px-6 sm:py-12">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_1fr_1fr_1fr_1.05fr]">
      <div class="min-w-0">
        <div class="text-lg font-black tracking-[0.28em]">ARCADIA</div>

        <div class="mt-3 text-sm leading-8 text-zinc-700">
          {
            t.brandBlurb.map((line) => (
              <>
                {line}
                <br />
              </>
            ))
          }
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          {
            socialLinks.map((item) => (
              <a
                href={item.href}
                aria-label={item.label}
                title={item.label}
                class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-zinc-300 bg-white text-zinc-700 transition hover:-translate-y-0.5 hover:border-zinc-900 hover:text-zinc-900"
              >
                {item.name === "Instagram" ? (
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    class="h-5 w-5 fill-current"
                  >
                    <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.75a4 4 0 0 0-4 4v8.5a4 4 0 0 0 4 4h8.5a4 4 0 0 0 4-4v-8.5a4 4 0 0 0-4-4h-8.5Zm8.88 1.5a1.12 1.12 0 1 1 0 2.25 1.12 1.12 0 0 1 0-2.25ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.75A3.25 3.25 0 1 0 12 15.25 3.25 3.25 0 0 0 12 8.75Z" />
                  </svg>
                ) : item.name === "Facebook" ? (
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    class="h-5 w-5 fill-current"
                  >
                    <path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.92c0-.9.25-1.51 1.54-1.51H16.6V4.63c-.28-.04-1.23-.13-2.35-.13-2.33 0-3.92 1.42-3.92 4.04v2.36H7.7V14h2.63v8h3.17Z" />
                  </svg>
                ) : (
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    class="h-5 w-5 fill-current"
                  >
                    <path d="M19.05 4.94A9.93 9.93 0 0 0 12.02 2C6.5 2 2.03 6.47 2.03 11.99c0 1.76.46 3.48 1.33 4.99L2 22l5.18-1.35a9.96 9.96 0 0 0 4.84 1.23h.01c5.52 0 9.99-4.47 9.99-9.99 0-2.67-1.04-5.18-2.97-6.95ZM12.03 20.2h-.01a8.26 8.26 0 0 1-4.2-1.15l-.3-.18-3.07.8.82-2.99-.2-.31a8.23 8.23 0 0 1-1.27-4.38c0-4.56 3.7-8.26 8.25-8.26 2.2 0 4.28.86 5.84 2.42a8.2 8.2 0 0 1 2.42 5.84c0 4.55-3.7 8.25-8.25 8.25Zm4.53-6.17c-.25-.12-1.49-.73-1.72-.81-.23-.09-.4-.12-.57.12-.16.24-.65.8-.8.97-.15.17-.29.18-.54.06-.25-.13-1.04-.38-1.97-1.21-.73-.65-1.22-1.45-1.36-1.69-.14-.24-.01-.37.11-.49.1-.1.24-.28.36-.42.12-.14.16-.24.24-.41.08-.17.04-.32-.02-.45-.06-.12-.57-1.36-.78-1.87-.21-.5-.42-.43-.57-.43h-.49c-.17 0-.45.06-.68.31-.23.25-.88.86-.88 2.09 0 1.23.9 2.43 1.03 2.59.12.17 1.76 2.68 4.27 3.76.6.26 1.07.41 1.44.52.61.19 1.17.16 1.61.1.49-.07 1.49-.61 1.7-1.2.21-.58.21-1.08.15-1.2-.06-.11-.23-.17-.48-.29Z" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div class="min-w-0 text-sm text-zinc-700">
        <div class="font-semibold text-zinc-900">{t.contactTitle}</div>
        <div class="mt-3 space-y-2 leading-8">
          <div>C/ Maria Aurèlia Campmany i Farnés, nº 2</div>
          <div>17310 Lloret de Mar (Girona)</div>
          <div class="pt-2">+34 606 07 78 00</div>
          <div>victorarcadiaminube@gmail.com</div>
        </div>
      </div>

      <div class="min-w-0 text-sm text-zinc-700">
        <div class="font-semibold text-zinc-900">{t.linksTitle}</div>
        <div class="mt-3 flex flex-col gap-2 leading-8">
          <a class="hover:text-zinc-900" href="/#sobre">{t.links.about}</a>
          <a class="hover:text-zinc-900" href="/pedir">{t.links.order}</a>
          <a class="hover:text-zinc-900" href="/#horarios">{t.links.hours}</a>
          <a class="hover:text-zinc-900" href="/#ubicacion"
            >{t.links.location}</a
          >
        </div>
      </div>

      <div class="min-w-0 text-sm text-zinc-700">
        <div class="font-semibold text-zinc-900">{t.supportTitle}</div>
        <div class="mt-3 flex flex-col gap-2 leading-8">
          <a class="hover:text-zinc-900" href="/faq">{t.links.faq}</a>
          <a class="hover:text-zinc-900" href="/contacto">{t.links.contact}</a>
          <a class="hover:text-zinc-900" href="/legal">{t.links.legal}</a>
          <a class="hover:text-zinc-900" href="/privacidad">{t.links.privacy}</a
          >
        </div>
      </div>

      <div class="min-w-0 text-sm text-zinc-700">
        <div class="font-semibold text-zinc-900">{t.languageTitle}</div>

        <details class="group relative mt-3 w-full max-w-[250px]">
          <summary
            class="flex min-h-[52px] cursor-pointer list-none items-center justify-between rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-sm font-semibold text-zinc-900 transition hover:border-zinc-900 [&::-webkit-details-marker]:hidden"
          >
            <span class="flex items-center gap-3">
              <span
                class:list={["lang-flag", activeLang.flagClass]}
                aria-hidden="true"></span>
              <span>{activeLang.short}</span>
              <span class="text-zinc-500">{activeLang.label}</span>
            </span>

            <svg
              class="h-4 w-4 text-zinc-500 transition group-open:rotate-180"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
                clip-rule="evenodd"></path>
            </svg>
          </summary>

          <div
            class="absolute left-0 right-0 top-[calc(100%+0.5rem)] z-20 overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-[0_18px_40px_rgba(0,0,0,0.12)]"
          >
            <div class="p-2">
              {
                otherLangOptions.map((option) => (
                  <a
                    href={`/api/preferences/language?lang=${option.code}&redirectTo=${encodeURIComponent(currentPath)}`}
                    class="flex items-center justify-between gap-3 rounded-xl px-3 py-3 text-sm text-zinc-800 transition hover:bg-zinc-50"
                  >
                    <span class="flex items-center gap-3">
                      <span
                        class:list={["lang-flag", option.flagClass]}
                        aria-hidden="true"
                      />
                      <span class="font-semibold">{option.short}</span>
                      <span>{option.label}</span>
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </details>
      </div>
    </div>

    <div class="mt-10 border-t border-zinc-200 pt-6">
      <div
        class="flex flex-col gap-3 text-xs text-zinc-600 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>© {new Date().getFullYear()} Arcadia</div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a class="hover:text-zinc-900" href="/faq">{t.links.faq}</a>
          <a class="hover:text-zinc-900" href="/contacto">{t.links.contact}</a>
          <a class="hover:text-zinc-900" href="/legal">{t.links.legal}</a>
          <a class="hover:text-zinc-900" href="/privacidad">{t.links.privacy}</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const dropdowns = document.querySelectorAll("footer details");

    document.addEventListener("click", (event) => {
      dropdowns.forEach((details) => {
        if (!(details instanceof HTMLDetailsElement)) return;
        if (details.contains(event.target)) return;
        details.open = false;
      });
    });

    window.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      dropdowns.forEach((details) => {
        if (details instanceof HTMLDetailsElement) details.open = false;
      });
    });
  })();
</script>
