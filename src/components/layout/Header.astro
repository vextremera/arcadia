---
import CartBadge from "@/islands/cart/CartBadge";
import NegativeLogo from "public/ARCADIA_LOGO.svg";
import { DEFAULT_LANG, getSiteCopy } from "@/lib/i18n";

const user = Astro.locals.user;
const pathname = Astro.url.pathname;
const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = getSiteCopy(lang).header;

const next = encodeURIComponent(pathname === "/" ? "/cuenta" : pathname);

const navLinks = [
  { href: "/#sobre", label: t.nav.about },
  { href: "/#horarios", label: t.nav.hours },
  { href: "/#ubicacion", label: t.nav.location },
  { href: "/carta", label: t.nav.menuLetter },
  { href: "/menu", label: t.nav.menuDay },
  { href: "/pedir", label: t.nav.delivery },
];
---

<header
  id="site-header"
  class="sticky top-0 z-40 bg-bg/95 backdrop-blur supports-backdrop-filter:bg-bg/95"
>
  <div
    class="mx-auto flex w-full max-w-340 items-center justify-between gap-3 px-2 py-3 sm:py-4 2xl:max-w-448"
  >
    <a href="/" class="text-xl font-black tracking-[0.28em]">
      <img src={NegativeLogo.src} alt="Arcadia Logo" class="h-7 sm:h-8" />
    </a>

    <nav
      class="hidden items-center gap-8 text-sm font-semibold text-stone-700 xl:flex 2xl:gap-10"
      aria-label={t.aria.mainNav}
    >
      {
        navLinks.map((link) => (
          <a class="hover:text-stone-900" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <details class="xl:hidden" data-mobile-nav>
        <summary
          class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full transition-transform hover:-translate-y-0.5 active:translate-y-0 [&::-webkit-details-marker]:hidden"
          aria-label={t.aria.openMenu}
          title={t.aria.openMenu}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            height="24px"
            viewBox="0 -960 960 960"
            width="24px"
            fill="#1f1f1f"
            aria-hidden="true"
          >
            <path
              d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z"
            ></path>
          </svg>
        </summary>

        <div class="fixed inset-x-0 bottom-0 top-19 z-50 sm:top-21">
          <button
            type="button"
            class="absolute inset-0 h-full w-full bg-black/35"
            aria-label="Cerrar menú"></button>

          <div
            class="fixed left-3 right-3 top-19 max-h-[calc(100dvh-5.5rem)] overflow-auto rounded-4xl border border-zinc-200 bg-white p-2 shadow-[0_18px_40px_rgba(0,0,0,0.14)] sm:left-5 sm:right-5 sm:top-21"
          >
            <nav class="grid gap-1" aria-label={t.aria.mobileNav}>
              {
                navLinks.map((link) => (
                  <a
                    class="rounded-2xl px-4 py-3 text-sm font-semibold text-zinc-800 hover:bg-zinc-50"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                ))
              }
            </nav>
          </div>
        </div>
      </details>

      <CartBadge client:load />

      {
        user ? (
          <a
            class="grid h-10 w-10 place-items-center rounded-full cursor-pointer transition-transform hover:-translate-y-0.5 active:translate-y-0"
            href="/cuenta"
            aria-label={t.aria.account}
            title={t.aria.account}
          >
            <span class="text-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="24px"
                viewBox="0 -960 960 960"
                width="24px"
                fill="#1f1f1f"
              >
                <path d="M367-527q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm296.5-343.5Q560-607 560-640t-23.5-56.5Q513-720 480-720t-56.5 23.5Q400-673 400-640t23.5 56.5Q447-560 480-560t56.5-23.5ZM480-640Zm0 400Z" />
              </svg>
            </span>
          </a>
        ) : (
          <a
            class="grid h-10 w-10 place-items-center rounded-full cursor-pointer transition-transform hover:-translate-y-0.5 active:translate-y-0"
            href={`/login?next=${next}`}
            aria-label="Entrar"
            title="Entrar"
          >
            <span class="text-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="24px"
                viewBox="0 -960 960 960"
                width="24px"
                fill="#1f1f1f"
              >
                <path d="M367-527q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm296.5-343.5Q560-607 560-640t-23.5-56.5Q513-720 480-720t-56.5 23.5Q400-673 400-640t23.5 56.5Q447-560 480-560t56.5-23.5ZM480-640Zm0 400Z" />
              </svg>
            </span>
          </a>
        )
      }
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById("site-header");
    if (!header) return;

    const details = header.querySelector("details[data-mobile-nav]");
    if (!(details instanceof HTMLDetailsElement)) return;

    const closeMenu = () => {
      details.open = false;
    };

    header.querySelectorAll("details[data-mobile-nav] a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1280) closeMenu();
    });

    const overlayButton = header.querySelector(
      "details[data-mobile-nav] > div > button",
    );
    if (overlayButton instanceof HTMLButtonElement) {
      overlayButton.addEventListener("click", closeMenu);
    }
  })();
</script>
