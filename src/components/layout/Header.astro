---
import CartBadge from "@/islands/cart/CartBadge";
const user = Astro.locals.user;
const pathname = Astro.url.pathname;
const next = encodeURIComponent(pathname);

const CART_SVG = `<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#1f1f1f"><path d="M223.5-103.5Q200-127 200-160t23.5-56.5Q247-240 280-240t56.5 23.5Q360-193 360-160t-23.5 56.5Q313-80 280-80t-56.5-23.5Zm400 0Q600-127 600-160t23.5-56.5Q647-240 680-240t56.5 23.5Q760-193 760-160t-23.5 56.5Q713-80 680-80t-56.5-23.5ZM246-720l96 200h280l110-200H246Zm-38-80h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Zm134 280h280-280Z"/></svg>`;

const USER_SVG = `<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#1f1f1f"><path d="M234-276q51-39 114-61.5T480-360q69 0 132 22.5T726-276q35-41 54.5-93T800-480q0-133-93.5-226.5T480-800q-133 0-226.5 93.5T160-480q0 59 19.5 111t54.5 93Zm146.5-204.5Q340-521 340-580t40.5-99.5Q421-720 480-720t99.5 40.5Q620-639 620-580t-40.5 99.5Q539-440 480-440t-99.5-40.5ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm100-95.5q47-15.5 86-44.5-39-29-86-44.5T480-280q-53 0-100 15.5T294-220q39 29 86 44.5T480-160q53 0 100-15.5ZM523-537q17-17 17-43t-17-43q-17-17-43-17t-43 17q-17 17-17 43t17 43q17 17 43 17t43-17Zm-43-43Zm0 360Z"/></svg>`;
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200 bg-[#fbfaf7]/90 backdrop-blur"
>
  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4"
  >
    <a href="/" class="text-xl font-black tracking-[0.28em]">ARCADIA</a>

    <nav
      class="hidden items-center gap-10 text-sm font-semibold text-zinc-700 lg:flex"
    >
      <a class="hover:text-zinc-900" href="/#sobre">Sobre Nosotros</a>
      <a class="hover:text-zinc-900" href="/pedir">Carta</a>
      <a class="hover:text-zinc-900" href="/#reservas">Reservas</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/pedir"
        class="rounded-full bg-[#7b1f1f] px-5 py-2 text-sm font-semibold text-white hover:bg-[#6a1919]"
      >
        A Domicilio
      </a>

      <CartBadge client:load iconSvg={CART_SVG} />

      <a
        class="grid h-10 w-10 place-items-center rounded-full border border-zinc-300 bg-white hover:bg-zinc-50"
        href={user ? "/cuenta" : `/login?next=${next}`}
        aria-label={user ? "Cuenta" : "Entrar"}
        title={user ? "Cuenta" : "Entrar"}
        set:html={USER_SVG}
      />
    </div>
  </div>
</header>
