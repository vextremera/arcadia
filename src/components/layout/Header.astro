---
import CartBadge from "@/islands/cart/CartBadge";
import LanguageSwitcher from "@/components/layout/LanguageSwitcher.astro";
import NegativeLogo from "public/ARCADIA_LOGO.svg";
import { DEFAULT_LANG, getSiteCopy } from "@/lib/i18n";

const user = Astro.locals.user;
const pathname = Astro.url.pathname;
const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = getSiteCopy(lang).header;

// El rótulo de idioma vive en la copia del pie; se reutiliza para no añadir
// una clave nueva a los cuatro idiomas por una sola palabra.
const languageTitle = getSiteCopy(lang).footer.languageTitle;

const next = encodeURIComponent(pathname === "/" ? "/cuenta" : pathname);

const navLinks = [
  { href: "/#sobre", label: t.nav.about },
  { href: "/#horarios", label: t.nav.hours },
  { href: "/#ubicacion", label: t.nav.location },
  { href: "/carta", label: t.nav.menuLetter },
  { href: "/menu", label: t.nav.menuDay },
  { href: "/pedir", label: t.nav.delivery },
];
---

<header
  id="site-header"
  class="sticky top-0 z-40 bg-bg/95 backdrop-blur supports-backdrop-filter:bg-bg/95"
>
  <div
    class="mx-auto flex w-full max-w-340 items-center justify-between gap-3 px-2 py-3 sm:py-4 2xl:max-w-448"
  >
    <a
      href="/"
      class="inline-flex min-h-11 items-center text-xl font-black tracking-[0.28em]"
      aria-label="Arcadia · Inicio"
    >
      <img src={NegativeLogo.src} alt="Arcadia Logo" class="h-7 sm:h-8" />
    </a>

    <nav
      class="hidden items-center gap-8 text-sm font-semibold text-stone-700 xl:flex 2xl:gap-10"
      aria-label={t.aria.mainNav}
    >
      {
        navLinks.map((link) => (
          <a class="hover:text-stone-900" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        class="grid h-10 w-10 cursor-pointer place-items-center rounded-full transition-transform hover:-translate-y-0.5 active:translate-y-0 xl:hidden"
        aria-label={t.aria.openMenu}
        title={t.aria.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-open-menu
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          height="24px"
          viewBox="0 -960 960 960"
          width="24px"
          fill="#1f1f1f"
          aria-hidden="true"
        >
          <path
            d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z"
          ></path>
        </svg>
      </button>

      {/* En móvil el idioma vive dentro del menú a pantalla completa: aquí
          arriba competiría por sitio con el carrito y la cuenta. */}
      <LanguageSwitcher variant="compact" class="hidden xl:block" />

      <CartBadge client:load />

      {
        user ? (
          <a
            class="grid h-10 w-10 place-items-center rounded-full cursor-pointer transition-transform hover:-translate-y-0.5 active:translate-y-0"
            href="/cuenta"
            aria-label={t.aria.account}
            title={t.aria.account}
          >
            <span class="text-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="24px"
                viewBox="0 -960 960 960"
                width="24px"
                fill="#1f1f1f"
              >
                <path d="M367-527q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm296.5-343.5Q560-607 560-640t-23.5-56.5Q513-720 480-720t-56.5 23.5Q400-673 400-640t23.5 56.5Q447-560 480-560t56.5-23.5ZM480-640Zm0 400Z" />
              </svg>
            </span>
          </a>
        ) : (
          <a
            class="grid h-10 w-10 place-items-center rounded-full cursor-pointer transition-transform hover:-translate-y-0.5 active:translate-y-0"
            href={`/login?next=${next}`}
            aria-label="Entrar"
            title="Entrar"
          >
            <span class="text-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="24px"
                viewBox="0 -960 960 960"
                width="24px"
                fill="#1f1f1f"
              >
                <path d="M367-527q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm296.5-343.5Q560-607 560-640t-23.5-56.5Q513-720 480-720t-56.5 23.5Q400-673 400-640t23.5 56.5Q447-560 480-560t56.5-23.5ZM480-640Zm0 400Z" />
              </svg>
            </span>
          </a>
        )
      }
    </div>
  </div>
</header>

{/* Fuera del <header> a propósito: el header lleva backdrop-blur, y un
    backdrop-filter convierte al elemento en bloque contenedor de sus
    descendientes position:fixed. Dentro, el panel se recortaba al tamaño
    de la barra en vez de ocupar la pantalla. */}
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden flex-col overflow-y-auto bg-bg xl:hidden"
  data-mobile-menu
>
      <div class="flex items-center justify-between px-4 py-3 sm:py-4">
        <img src={NegativeLogo.src} alt="" class="h-7 sm:h-8" aria-hidden="true" />
        <button
          type="button"
          class="grid h-10 w-10 place-items-center rounded-full transition hover:bg-zinc-100"
          aria-label="Cerrar menú"
          data-close-menu
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            height="26px"
            viewBox="0 -960 960 960"
            width="26px"
            fill="#1f1f1f"
            aria-hidden="true"
          >
            <path
              d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"
            ></path>
          </svg>
        </button>
      </div>

      <nav class="flex flex-1 flex-col gap-1 px-4 pt-4" aria-label={t.aria.mobileNav}>
        {
          navLinks.map((link) => (
            <a
              class="border-b border-zinc-200/70 py-4 text-2xl font-semibold text-zinc-900"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="px-4 pb-8 pt-8">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">
          {languageTitle}
        </p>
        <LanguageSwitcher variant="inline" />
      </div>
</div>

<script is:inline>
  (() => {
    const menu = document.querySelector("[data-mobile-menu]");
    const openButton = document.querySelector("[data-open-menu]");
    if (!menu || !openButton) return;

    const setOpen = (open) => {
      // `hidden` y `flex` chocan en Tailwind, así que se alternan a mano.
      menu.classList.toggle("hidden", !open);
      menu.classList.toggle("flex", open);
      openButton.setAttribute("aria-expanded", open ? "true" : "false");
      // El menú cubre la pantalla: sin bloquear el documento, la página de
      // detrás se desplaza al arrastrar sobre él.
      document.body.style.overflow = open ? "hidden" : "";
    };

    const closeMenu = () => setOpen(false);

    openButton.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));

    menu.querySelectorAll("a, [data-close-menu]").forEach((element) => {
      element.addEventListener("click", closeMenu);
    });

    const languageSwitchers = Array.from(
      document.querySelectorAll("details[data-language-switcher]"),
    );

    const closeLanguage = () => {
      for (const item of languageSwitchers) item.open = false;
    };

    // Un desplegable abierto que no se cierra al pulsar fuera se queda colgando
    // sobre la página mientras navegas.
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (languageSwitchers.some((item) => item.contains(target))) return;
      closeLanguage();
    });

    window.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      closeMenu();
      closeLanguage();
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1280) closeMenu();
    });

    // Al volver por el historial la página se restaura tal cual: sin esto, el
    // bloqueo de scroll podría quedarse puesto sin menú abierto.
    window.addEventListener("pageshow", closeMenu);
  })();
</script>
