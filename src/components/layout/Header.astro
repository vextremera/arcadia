---
import CartBadge from "@/islands/cart/CartBadge";
import NegativeLogo from "public/ARCADIA_LOGO.svg";
const user = Astro.locals.user;
const pathname = Astro.url.pathname;
const next = encodeURIComponent(pathname);
---

<header class="sticky top-0 z-40 bg-bg">
  <div
    class="mx-auto flex w-full max-w-340 items-center justify-between px-1 py-3 sm:px-2 sm:py-4"
  >
    <a href="/" class="text-xl font-black tracking-[0.28em]">
      <img src={NegativeLogo.src} alt="Arcadia Logo" class="h-7 sm:h-8" />
    </a>

    <nav
      class="hidden items-center gap-10 text-sm font-semibold text-stone-700 lg:flex"
    >
      <a class="hover:text-stone-900" href="/#sobre">Sobre Nosotros</a>
      <a class="hover:text-stone-900" href="/#horarios">Horario</a>
      <a class="hover:text-stone-900" href="/#ubicacion">Ubicación</a>
      <a class="hover:text-stone-900" href="/carta">Carta</a>
      <a class="hover:text-stone-900" href="/menu">Menú</a>
      <a class="hover:text-stone-900" href="/pedir">Domicilio</a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">

      <CartBadge client:load />

      {
        user ? (
          <a
            class="grid h-9 w-9 place-items-center rounded-full cursor-pointer transition-transform hover:-translate-y-0.5 active:translate-y-0 sm:h-10 sm:w-10"
            href="/cuenta"
            aria-label="Cuenta"
            title="Cuenta"
          >
            <span class="text-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="24px"
                viewBox="0 -960 960 960"
                width="24px"
                fill="#1f1f1f"
              >
                <path d="M367-527q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm296.5-343.5Q560-607 560-640t-23.5-56.5Q513-720 480-720t-56.5 23.5Q400-673 400-640t23.5 56.5Q447-560 480-560t56.5-23.5ZM480-640Zm0 400Z" />
              </svg>
            </span>
          </a>
        ) : (
          <a
            class="grid h-9 w-9 place-items-center rounded-full cursor-pointer transition-transform hover:-translate-y-0.5 active:translate-y-0 sm:h-10 sm:w-10"
            href={`/login?next=${next}`}
            aria-label="Entrar"
            title="Entrar"
          >
            <span class="text-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="24px"
                viewBox="0 -960 960 960"
                width="24px"
                fill="#1f1f1f"
              >
                <path d="M367-527q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm296.5-343.5Q560-607 560-640t-23.5-56.5Q513-720 480-720t-56.5 23.5Q400-673 400-640t23.5 56.5Q447-560 480-560t56.5-23.5ZM480-640Zm0 400Z" />
              </svg>
            </span>
          </a>
        )
      }
    </div>
  </div>
</header>