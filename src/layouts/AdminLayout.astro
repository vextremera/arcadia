---
import "@/styles/global.css";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminIcon from "@/components/admin/AdminIcon.astro";
import { ADMIN_NAV, isSectionActive } from "@/lib/admin/nav";
import { ADMIN_ROLE_LABEL } from "@/lib/admin/roles";
import { adminDisplayName } from "@/server/auth/adminUsers";

type Props = {
  title?: string;
  heading?: string;
  description?: string;
};

const {
  title = "Admin · Arcadia",
  heading,
  description,
} = Astro.props as Props;

/**
 * El middleware ya garantiza que aquí hay sesión de panel; si no la hubiera no
 * se habría llegado a renderizar. El valor por defecto es sólo para que el
 * tipo cierre.
 */
const admin = Astro.locals.admin ?? { id: 0, username: "", displayName: null, role: "WORKER" as const };
const adminName = adminDisplayName(admin);

const pathname = Astro.url.pathname;
const pageHeading = heading ?? "Admin";
const pageDescription = description ?? "";
const pageTitle = title;

/**
 * Acento de la sección en la que está la página. Se publica como atributo en
 * el shell y global.css reasigna con él la escala `sky` (el color de acción
 * del admin), de modo que botones, pills y focus de toda la página adoptan el
 * color de su categoría sin tocar las clases de cada vista.
 */
const activeSection = ADMIN_NAV.find((section) =>
  isSectionActive(section, pathname),
);
const accent = activeSection?.accent ?? "sky";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/ARCADIA_LOGO.svg" />
    <title>{pageTitle}</title>
  </head>

  <body
    data-admin-ui="true"
    class="h-dvh overflow-hidden bg-admin-bg text-admin-text antialiased"
  >
    <div
      id="admin-shell"
      data-admin-accent={accent}
      data-sidebar-collapsed="false"
      class="h-dvh bg-[radial-gradient(circle_at_top,rgba(56,189,248,0.05),transparent_28%),linear-gradient(180deg,#0a0a0b_0%,#141416_100%)]"
    >
      <div class="flex h-dvh w-full gap-0 overflow-hidden">
        <AdminSidebar currentPath={pathname} role={admin.role} />

        <div class="min-w-0 flex-1 xl:border-l xl:border-white/5">
          <div class="flex h-dvh min-w-0 flex-col overflow-hidden">
            <!-- La altura se fija solo desde xl, que es donde aparece el
                 sidebar y sus bordes deben coincidir. Por debajo el contenido
                 se apila y necesita crecer. -->
            <header
              class="shrink-0 border-b border-admin-border bg-admin-surface-2 xl:h-[var(--admin-header-h)]"
            >
              <div
                class="flex items-center gap-4 px-5 py-3 sm:px-6 lg:px-8 xl:h-full xl:px-6 xl:py-0"
              >
                <button
                  type="button"
                  id="admin-sidebar-toggle"
                  data-admin-sidebar-toggle
                  class="admin-focus hidden h-10 w-10 shrink-0 items-center justify-center rounded-admin text-slate-400 transition hover:bg-white/[0.06] hover:text-white xl:inline-flex"
                  aria-label="Contraer sidebar"
                  aria-pressed="false"
                  title="Contraer sidebar"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="h-[22px] w-[22px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 6h16"></path>
                    <path d="M4 12h16"></path>
                    <path d="M4 18h10"></path>
                  </svg>
                </button>

                <div
                  class="flex w-full min-w-0 flex-col gap-2 lg:flex-row lg:items-center lg:justify-between"
                >
                  <div class="min-w-0">
                    <h1
                      data-admin-page-heading
                      class="text-lg font-semibold tracking-[-0.02em] text-white sm:text-xl"
                    >
                      {pageHeading}
                    </h1>

                    {
                      pageDescription ? (
                        <p class="mt-1 max-w-3xl text-xs leading-5 text-admin-muted">
                          {pageDescription}
                        </p>
                      ) : null
                    }
                  </div>

                  <div class="flex shrink-0 items-center gap-2 lg:justify-end">
                    <!-- Estado de impresora (mock — se cablea en la fase de impresoras) -->
                    <span
                      class="inline-flex items-center gap-2 px-1 text-xs font-semibold text-slate-400"
                      title="Estado de impresora (demo)"
                    >
                      <AdminIcon name="printer" class="h-[22px] w-[22px]" />
                      <span class="hidden sm:inline">Impresora</span>
                      <span
                        class="inline-flex h-2 w-2 rounded-full bg-slate-500"
                        aria-hidden="true"
                      ></span>
                    </span>

                    <button
                      type="button"
                      class="admin-focus inline-flex h-10 w-10 items-center justify-center rounded-admin text-slate-400 transition hover:bg-white/[0.06] hover:text-white"
                      aria-label="Notificaciones"
                      title="Notificaciones"
                    >
                      <AdminIcon name="bell" class="h-[22px] w-[22px]" />
                    </button>

                    <!--
                      Quién está dentro. En una cocina el panel se queda abierto
                      entre turnos, así que conviene ver de un vistazo con qué
                      cuenta se está trabajando antes de tocar nada.
                    -->
                    <a
                      href="/admin/cuenta"
                      class="admin-focus group inline-flex min-h-10 items-center gap-2.5 rounded-admin px-2.5 py-1.5 transition hover:bg-white/[0.06]"
                      title="Mi cuenta"
                    >
                      <span
                        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/[0.08] text-xs font-bold uppercase text-slate-200"
                        aria-hidden="true"
                      >
                        {adminName.slice(0, 2)}
                      </span>
                      <span class="hidden min-w-0 flex-col leading-tight sm:flex">
                        <span class="truncate text-sm font-semibold text-slate-200 group-hover:text-white">
                          {adminName}
                        </span>
                        <span class="truncate text-[11px] text-admin-muted">
                          {ADMIN_ROLE_LABEL[admin.role]}
                        </span>
                      </span>
                    </a>

                    <form method="post" action="/api/admin/logout">
                      <button
                        type="submit"
                        class="admin-focus inline-flex min-h-10 items-center justify-center gap-2 rounded-admin px-2.5 py-2 text-sm font-semibold text-slate-400 transition hover:bg-white/[0.06] hover:text-white"
                      >
                        <AdminIcon name="logout" class="h-[22px] w-[22px]" />
                        <span class="hidden sm:inline">Cerrar sesión</span>
                      </button>
                    </form>
                  </div>
                </div>

              </div>
            </header>

            <main
              data-admin-main-scroll
              class="min-h-0 flex-1 overflow-y-auto px-5 py-6 sm:px-6 lg:px-8 xl:px-10 xl:py-8"
            >
              <slot />
            </main>
          </div>
        </div>
      </div>
    </div>

    <style is:global>
      #admin-shell {
        --admin-sidebar-width: 17rem;
      }

      [data-admin-main-scroll] {
        scrollbar-width: thin;
        scrollbar-color: rgba(56, 189, 248, 0.32) transparent;
      }

      [data-admin-main-scroll]::-webkit-scrollbar {
        width: 12px;
      }

      [data-admin-main-scroll]::-webkit-scrollbar-track {
        background: transparent;
      }

      [data-admin-main-scroll]::-webkit-scrollbar-thumb {
        border-radius: 9999px;
        border: 3px solid transparent;
        background: rgba(56, 189, 248, 0.26);
        background-clip: padding-box;
      }

      [data-admin-main-scroll]::-webkit-scrollbar-thumb:hover {
        background: rgba(56, 189, 248, 0.4);
        background-clip: padding-box;
      }

      @media (min-width: 1280px) {
        /* El ancho del aside sale de esta variable vía estilo en línea: como
           utilidad de Tailwind no llegaba a aplicarse y el sidebar se quedaba
           con el ancho del estado anterior al expandir. */
        #admin-shell[data-sidebar-collapsed="true"] {
          --admin-sidebar-width: 5rem;
        }

        #admin-shell[data-sidebar-collapsed="true"]
          [data-admin-sidebar-brand-text],
        #admin-shell[data-sidebar-collapsed="true"]
          [data-admin-sidebar-group-title],
        #admin-shell[data-sidebar-collapsed="true"]
          [data-admin-sidebar-item-copy] {
          display: none;
        }

        #admin-shell[data-sidebar-collapsed="true"] [data-admin-sidebar-nav] {
          padding-left: 0.625rem;
          padding-right: 0.625rem;
        }

        #admin-shell[data-sidebar-collapsed="true"] [data-admin-sidebar-item] {
          padding-left: 0.625rem;
          padding-right: 0.625rem;
        }

        #admin-shell[data-sidebar-collapsed="true"]
          [data-admin-sidebar-item-row] {
          justify-content: center;
        }

        #admin-shell[data-sidebar-collapsed="true"] [data-admin-sidebar-top] {
          padding-left: 0.75rem;
          padding-right: 0.75rem;
        }

        #admin-shell[data-sidebar-collapsed="true"]
          [data-admin-sidebar-brand-row] {
          justify-content: center;
        }

        #admin-shell[data-sidebar-collapsed="true"]
          [data-admin-sidebar-brand-link] {
          flex: 0 0 auto;
          width: auto;
        }

        #admin-shell[data-sidebar-collapsed="true"]
          [data-admin-sidebar-brand-inner] {
          justify-content: center;
        }
      }
    </style>

    <script is:inline>
      (() => {
        const root = document.getElementById("admin-shell");
        const toggle = document.getElementById("admin-sidebar-toggle");
        if (!root || !toggle) return;

        const storageKey = "arcadia-admin-sidebar-collapsed";

        function readState() {
          try {
            return window.localStorage.getItem(storageKey) === "1";
          } catch {
            return false;
          }
        }

        function writeState(collapsed) {
          try {
            window.localStorage.setItem(storageKey, collapsed ? "1" : "0");
          } catch {
            // noop
          }
        }

        function applyState(collapsed) {
          root.setAttribute(
            "data-sidebar-collapsed",
            collapsed ? "true" : "false",
          );
          toggle.setAttribute("aria-pressed", collapsed ? "true" : "false");
          toggle.setAttribute(
            "title",
            collapsed ? "Expandir sidebar" : "Contraer sidebar",
          );
          toggle.setAttribute(
            "aria-label",
            collapsed ? "Expandir sidebar" : "Contraer sidebar",
          );
        }

        let collapsed = readState();
        applyState(collapsed);

        toggle.addEventListener("click", () => {
          collapsed = !collapsed;
          writeState(collapsed);
          applyState(collapsed);
        });
      })();
    </script>

    <script is:inline>
      (() => {
        document.addEventListener("click", (event) => {
          const openTrigger = event.target.closest?.("[data-modal-open]");
          if (openTrigger) {
            const id = openTrigger.getAttribute("data-modal-open");
            const dialog = id ? document.getElementById(id) : null;
            if (dialog && typeof dialog.showModal === "function") {
              dialog.showModal();
            }
            return;
          }

          const closeTrigger = event.target.closest?.("[data-modal-close]");
          if (closeTrigger) {
            closeTrigger.closest("dialog")?.close();
            return;
          }

          if (event.target.tagName === "DIALOG") {
            event.target.close();
          }
        });
      })();
    </script>

    <!--
      Guardado sin recargar. Va aquí, en el layout, para que valga en todas las
      pantallas del panel sin tocar ninguno de sus formularios.
    -->
    <script>
      import "@/scripts/adminAjax";
    </script>
  </body>
</html>
