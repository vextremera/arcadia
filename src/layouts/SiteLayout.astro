---
import "@/styles/global.css";
import { Font } from "astro:assets";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import ProductConfiguratorModal from "@/islands/product/ProductConfiguratorModal";
import CartDrawer from "@/islands/cart/CartDrawer";
import UpsellModal from "@/islands/upsell/UpsellModal";
import { DEFAULT_LANG } from "@/lib/i18n";

type Props = {
  title?: string;
  variant?: "default" | "landing";
  fullWidth?: boolean;
};

const {
  title = "Arcadia",
  variant = "default",
  fullWidth = false,
} = Astro.props as Props;

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const isLanding = variant === "landing";

const bodyClass = isLanding
  ? "min-h-dvh bg-[#fbfaf7] text-zinc-900"
  : "min-h-dvh bg-white text-zinc-900";

const mainClass =
  fullWidth || isLanding
    ? "w-full"
    : "mx-auto w-full max-w-6xl px-4 py-6 sm:py-8 2xl:max-w-[112rem]";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="google-site-verification"
      content="X_9AFrFiL34NnRZeCgcuhiyM1JhFl0V16F4SMOKQWWY"
    />

    <!-- de momento no se quiere indexar realmente -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />

    <link
      rel="icon"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
      href="/ARCADIA_LOGO.svg"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
      href="/ARCADIA_LOGO_WHITE.svg"
    />

    <title>{title}</title>

    <Font cssVariable="--font-sigmar" preload />

    <style is:global>
      body {
        margin: auto 20px;
        background-color: var(--color-bg);
      }

      @media (max-width: 639px) {
        body {
          margin: auto 12px;
        }
      }

      @media (min-width: 1536px) {
        body {
          margin: auto 32px;
        }
      }

      .sigmar-regular {
        font-family: var(--font-sigmar);
        font-style: normal;
      }

      .lang-flag {
        display: inline-block;
        width: 1.15rem;
        height: 0.86rem;
        border-radius: 0.18rem;
        overflow: hidden;
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
        flex: 0 0 auto;
      }

      /*
       * Banderas del selector de idioma.
       *
       * Antes venían de una hoja de 28 KB servida por jsdelivr en todas las
       * páginas, para usar cuatro de sus doscientas cincuenta banderas. Aparte
       * del peso, era una dependencia de terceros en el camino crítico: quien
       * pudiera alterar ese fichero (o mover la etiqueta de git a la que
       * apuntaba) inyectaba CSS en todo el sitio, y con CSS se puede tapar la
       * interfaz o sacar datos por selectores de atributo.
       */
      .lang-flag.fi {
        line-height: 1;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
      }

      .lang-flag.fi-es {
        background-image: url("/images/flags/es.svg");
      }

      .lang-flag.fi-es-ct {
        background-image: url("/images/flags/es-ct.svg");
      }

      .lang-flag.fi-gb {
        background-image: url("/images/flags/gb.svg");
      }

      .lang-flag.fi-fr {
        background-image: url("/images/flags/fr.svg");
      }
    </style>
  </head>

  <body class={bodyClass}>
    <Header />

    <main class={mainClass}>
      <slot />
    </main>

    <Footer />

    <ProductConfiguratorModal client:load />
    <CartDrawer client:load />
    <UpsellModal client:load />
  </body>
</html>
