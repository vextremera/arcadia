---
import "@/styles/global.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import ProductConfiguratorModal from "@/islands/product/ProductConfiguratorModal";
import CartDrawer from "@/islands/cart/CartDrawer";
import UpsellModal from "@/islands/upsell/UpsellModal";

type Props = {
  title?: string;
  variant?: "default" | "landing";
  /**
   * Si true, el <main> no limita ancho ni añade padding.
   * Útil para la carta tipo "kiosk/app".
   */
  fullWidth?: boolean;
};

const {
  title = "Arcadia",
  variant = "default",
  fullWidth = false,
} = Astro.props as Props;
const isLanding = variant === "landing";

const bodyClass = isLanding
  ? "min-h-dvh bg-[#fbfaf7] text-zinc-900"
  : "min-h-dvh bg-white text-zinc-900";

const mainClass =
  fullWidth || isLanding ? "w-full" : "mx-auto w-full max-w-6xl px-4 py-8";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <style is:global>
      /* Header: por defecto sólido */
      #site-header {
        background: rgba(251, 250, 247, 0.9);
        border-bottom: 1px solid rgb(228 228 231);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition:
          background 260ms ease,
          box-shadow 260ms ease,
          border-color 260ms ease,
          backdrop-filter 260ms ease;
      }

      /* Cuando estamos “dentro del hero”: transparente */
      #site-header[data-solid="false"] {
        background: transparent;
        border-bottom-color: transparent;
        box-shadow: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
      }
    </style>
  </head>

  <body class={bodyClass}>
    <Header />

    <main class={mainClass}>
      <slot />
    </main>

    <Footer />

    <!-- Islas globales -->
    <ProductConfiguratorModal client:load />
    <CartDrawer client:load />
    <UpsellModal client:load />

    <!-- ✅ Header transparente SOLO si hay un hero explícito -->
    <script is:inline>
      {
        String.raw`
      (() => {
        const init = () => {
          const header = document.getElementById("site-header");
          if (!header) return;

          // Solo activamos el modo "hero" si existe un elemento marcado.
          const hero = document.querySelector("[data-hero]");
          if (!hero) {
            header.dataset.solid = "true";
            return;
          }

          const update = () => {
            const headerH = header.getBoundingClientRect().height || 84;
            const rect = hero.getBoundingClientRect();
            const inHero = rect.bottom > headerH + 2;
            header.dataset.solid = inHero ? "false" : "true";
          };

          update();

          let ticking = false;
          const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              update();
              ticking = false;
            });
          };

          window.addEventListener("scroll", onScroll, { passive: true });
          window.addEventListener("resize", onScroll, { passive: true });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init, { once: true });
        } else {
          init();
        }
      })();
      `;
      }
    </script>
  </body>
</html>
