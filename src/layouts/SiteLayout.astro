---
import "@/styles/global.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import ProductConfiguratorModal from "@/islands/product/ProductConfiguratorModal";
import CartDrawer from "@/islands/cart/CartDrawer";
import UpsellModal from "@/islands/upsell/UpsellModal";
import SpeedInsights from "@vercel/speed-insights/astro";

type Props = {
  title?: string;
  variant?: "default" | "landing";
  fullWidth?: boolean;
};

const {
  title = "Arcadia",
  variant = "default",
  fullWidth = false,
} = Astro.props as Props;
const isLanding = variant === "landing";

const bodyClass = isLanding
  ? "min-h-dvh bg-[#fbfaf7] text-zinc-900"
  : "min-h-dvh bg-white text-zinc-900";

const mainClass =
  fullWidth || isLanding ? "w-full" : "mx-auto w-full max-w-6xl px-4 py-8";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/ARCADIA_LOGO.svg" />

    <title>{title}</title>

    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=Sigmar&display=swap");

      body {
        margin: auto 20px;
        background-color: var(--color-bg);
      }

      .sigmar-regular {
        font-family: "Sigmar", sans-serif;
        font-style: normal;
      }
    </style>
  </head>

  <body class={bodyClass}>
    <Header />

    <main class={mainClass}>
      <slot />
    </main>

    <Footer />

    <ProductConfiguratorModal client:load />
    <CartDrawer client:load />
    <UpsellModal client:load />
    <SpeedInsights />
  </body>
</html>
