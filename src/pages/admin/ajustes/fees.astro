---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import { db, AppSetting, eq } from "astro:db";

type DeliveryFeeSetting = { cents: number };
type LegacyFeesSetting = { deliveryFeeCents?: number };

const DEFAULT_DELIVERY_FEE: DeliveryFeeSetting = { cents: 0 };

const [rowDelivery] = await db
  .select({ value: AppSetting.value })
  .from(AppSetting)
  .where(eq(AppSetting.key, "deliveryFee"))
  .limit(1);

const [rowLegacy] = await db
  .select({ value: AppSetting.value })
  .from(AppSetting)
  .where(eq(AppSetting.key, "fees"))
  .limit(1);

const legacyValue = rowLegacy?.value as LegacyFeesSetting | undefined;

const deliveryFee = (rowDelivery?.value ??
  (typeof legacyValue?.deliveryFeeCents === "number"
    ? { cents: Number(legacyValue.deliveryFeeCents) }
    : DEFAULT_DELIVERY_FEE)) as DeliveryFeeSetting;

const deliveryFeeEur = (Number(deliveryFee.cents ?? 0) / 100).toFixed(2);
const hasLegacyOnly = Boolean(rowLegacy && !rowDelivery);

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") === "1";
const error = url.searchParams.get("error") ?? "";

const errorMessage = error === "invalid-fee" ? "Introduce un importe válido en euros." : "";
---

<AdminLayout title="Fees de envío · Admin · Arcadia" heading="Fees de envío" description="Tarifa de envío que se suma a los pedidos a domicilio.">
  <div class="space-y-6">
    {saved ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">Fee guardado correctamente.</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{errorMessage}</section> : null}

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard icon="coin" label="Fee actual" value={`${deliveryFeeEur} €`} helper="Solo se aplica a pedidos DELIVERY" />
      <StatCard label="Configuración" value={hasLegacyOnly ? "Legacy" : "Alineada"} helper={hasLegacyOnly ? "Al guardar se migra a la key moderna" : "Formato correcto para checkout y operativa"} />
    </section>

    <Card>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <div class="admin-eyebrow">Configuración</div>
          <h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-white">Tarifa de delivery</h2>
        </div>
        <Badge tone={hasLegacyOnly ? "warning" : "success"}>{hasLegacyOnly ? "Legacy detectado" : "deliveryFee"}</Badge>
      </div>

      <form class="mt-5 grid gap-4 sm:max-w-md" method="post" action="/api/admin/settings/fees">
        <label class="block">
          <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Importe €</span>
          <input
            class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none"
            type="number"
            step="0.01"
            min="0"
            name="deliveryFeeEur"
            value={deliveryFeeEur}
            required
          />
        </label>

        <button class="inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15" type="submit">
          Guardar fee
        </button>
      </form>

      <p class="mt-4 border-t border-admin-border pt-4 text-xs leading-6 text-admin-muted">
        La disponibilidad del canal delivery no depende de esta pantalla: se gobierna desde operativa (horarios, fechas especiales y force pickup).
      </p>
    </Card>
  </div>
</AdminLayout>
