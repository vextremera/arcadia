---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import { getPaymentsSettings } from "@/server/payments/settings";

const payments = getPaymentsSettings();

const rows = [
  { channel: "Delivery", method: "Efectivo", enabled: payments.delivery.cashEnabled, note: "Pago en mano al repartidor" },
  { channel: "Delivery", method: "Tarjeta", enabled: payments.delivery.cardEnabled, note: "Cobro con tarjeta en pedidos a domicilio" },
  { channel: "Pickup", method: "Efectivo", enabled: payments.pickup.cashEnabled, note: "Cobro en local al recoger" },
  { channel: "Pickup", method: "Tarjeta", enabled: payments.pickup.cardEnabled, note: "Pago con tarjeta en recogida" },
];
---

<AdminLayout title="Métodos de pago · Admin · Arcadia" heading="Métodos de pago" description="Estado de los métodos de cobro disponibles en cada canal.">
  <div class="space-y-6">
    <section class="rounded-admin-lg border border-amber-400/20 bg-amber-400/10 px-5 py-3 text-sm leading-6 text-amber-100">
      Solo lectura: en Arcadia efectivo y tarjeta están siempre activos en ambos canales. Lo que sí se puede cambiar es la disponibilidad del canal, desde <a href="/admin/operativa" class="font-semibold underline">operativa</a>.
    </section>

    <Card padded={false}>
      <div class="border-b border-admin-border px-5 py-4 lg:px-6">
        <h2 class="text-base font-semibold text-white">Estado por canal</h2>
      </div>

      <div class="overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Canal</th>
              <th>Método</th>
              <th>Estado</th>
              <th>Detalle</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <td class="font-semibold text-white">{row.channel}</td>
                <td class="text-admin-muted">{row.method}</td>
                <td><Badge tone={row.enabled ? "success" : "danger"}>{row.enabled ? "Activo" : "Inactivo"}</Badge></td>
                <td class="text-admin-muted">{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>

    <Card>
      <div class="admin-eyebrow">Pasarela</div>
      <h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-white">Estado del cobro con tarjeta</h2>
      <p class="mt-3 text-sm leading-6 text-admin-muted">
        Los pedidos con tarjeta generan un registro interno en <code class="rounded-lg border border-admin-border bg-white/[0.04] px-1.5 py-0.5 text-xs text-white">Payment</code>, pero la pasarela real todavía no está conectada: hoy se usa una pasarela de prueba sin cobro efectivo.
      </p>
    </Card>
  </div>
</AdminLayout>
