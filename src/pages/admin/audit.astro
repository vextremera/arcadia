---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db, AuditLog, User, inArray } from "astro:db";

type AuditRow = {
  id: number;
  actorUserId: number | null;
  action: string;
  entityType: string;
  entityId: string;
  diff: unknown;
  ip: string | null;
  userAgent: string | null;
  createdAt: Date;
};

type UserRow = {
  id: number;
  email: string;
  name: string | null;
};

function formatDate(value: Date | string) {
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Europe/Madrid",
  }).format(date);
}

function toneForAction(action: string) {
  if (action.includes("REFUND")) {
    return "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300";
  }
  if (action.includes("PAYMENT")) {
    return "border-emerald-400/20 bg-emerald-400/10 text-emerald-300";
  }
  if (action.includes("NEWSLETTER")) {
    return "border-cyan-400/20 bg-cyan-400/10 text-cyan-300";
  }
  if (
    action.includes("OPS") ||
    action.includes("HOURS") ||
    action.includes("SPECIAL_DATE")
  ) {
    return "border-amber-400/20 bg-amber-400/10 text-amber-300";
  }
  if (
    action.includes("LOYALTY") ||
    action.includes("POINTS") ||
    action.includes("TIER")
  ) {
    return "border-violet-400/20 bg-violet-400/10 text-violet-300";
  }
  if (
    action.includes("MENU") ||
    action.includes("CATEGORY") ||
    action.includes("PRODUCT") ||
    action.includes("INGREDIENT")
  ) {
    return "border-sky-400/20 bg-sky-400/10 text-sky-300";
  }
  return "border-white/10 bg-white/[0.04] text-slate-300";
}

function labelForActionGroup(action: string) {
  if (action.includes("REFUND")) return "Refunds";
  if (action.includes("PAYMENT")) return "Pagos";
  if (action.includes("NEWSLETTER")) return "Newsletter";
  if (
    action.includes("OPS") ||
    action.includes("HOURS") ||
    action.includes("SPECIAL_DATE")
  ) {
    return "Operativa";
  }
  if (
    action.includes("LOYALTY") ||
    action.includes("POINTS") ||
    action.includes("TIER")
  ) {
    return "Loyalty";
  }
  if (
    action.includes("MENU") ||
    action.includes("CATEGORY") ||
    action.includes("PRODUCT") ||
    action.includes("INGREDIENT")
  ) {
    return "Catálogo";
  }
  return "General";
}

const url = new URL(Astro.request.url);
const q = (url.searchParams.get("q") ?? "").trim().toLowerCase();

const rows = (await db
  .select({
    id: AuditLog.id,
    actorUserId: AuditLog.actorUserId,
    action: AuditLog.action,
    entityType: AuditLog.entityType,
    entityId: AuditLog.entityId,
    diff: AuditLog.diff,
    ip: AuditLog.ip,
    userAgent: AuditLog.userAgent,
    createdAt: AuditLog.createdAt,
  })
  .from(AuditLog)) as AuditRow[];

const sorted = [...rows].sort(
  (a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime(),
);

const actorIds = sorted
  .map((row) => row.actorUserId)
  .filter((value): value is number => Number.isFinite(value));

const actors = actorIds.length
  ? ((await db
      .select({
        id: User.id,
        email: User.email,
        name: User.name,
      })
      .from(User)
      .where(inArray(User.id, actorIds))) as UserRow[])
  : [];

const actorById = new Map(actors.map((actor) => [actor.id, actor]));

const filtered = sorted.filter((row) => {
  if (!q) return true;
  const actor = row.actorUserId ? actorById.get(row.actorUserId) : null;
  const haystack = [
    row.action,
    row.entityType,
    row.entityId,
    row.ip ?? "",
    actor?.name ?? "",
    actor?.email ?? "",
    JSON.stringify(row.diff ?? {}),
  ]
    .join(" ")
    .toLowerCase();

  return haystack.includes(q);
});

const last24h = filtered.filter(
  (row) =>
    new Date(row.createdAt).getTime() >= Date.now() - 24 * 60 * 60 * 1000,
).length;

const actorCount = new Set(
  filtered
    .map((row) => row.actorUserId)
    .filter((value) => Number.isFinite(value)),
).size;

const rowsWithDiff = filtered.filter((row) => Boolean(row.diff)).length;

const groupedCount = new Map<string, number>();
for (const row of filtered) {
  const group = labelForActionGroup(row.action);
  groupedCount.set(group, (groupedCount.get(group) ?? 0) + 1);
}

const topGroups = [...groupedCount.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4);

const summaryCards = [
  {
    label: "Eventos",
    value: filtered.length,
    note: "Trazas visibles con el filtro actual",
    tone: "border-white/10 bg-white/[0.03]",
  },
  {
    label: "Últimas 24h",
    value: last24h,
    note: "Actividad reciente en admin",
    tone: "border-cyan-400/20 bg-cyan-400/10",
  },
  {
    label: "Actores",
    value: actorCount,
    note: "Usuarios distintos con rastro",
    tone: "border-violet-400/20 bg-violet-400/10",
  },
  {
    label: "Con diff",
    value: rowsWithDiff,
    note: "Eventos con payload detallado",
    tone: "border-amber-400/20 bg-amber-400/10",
  },
];
---

<AdminLayout
  title="Audit · Admin · Arcadia"
  heading="Audit log"
  description="Trazabilidad de cambios administrativos relevantes. He rehecho la vista para que cada evento se lea mejor como rastro operativo real y no como una lista técnica comprimida."
  actions={true}
>
  <Fragment slot="actions">
    <div class="flex flex-wrap gap-3">
      <a
        href="/admin"
        class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06] hover:text-white"
      >
        Volver al dashboard
      </a>
    </div>
  </Fragment>

  <section class="grid gap-4 md:grid-cols-2 2xl:grid-cols-4">
    {
      summaryCards.map((card) => (
        <article
          class:list={[
            "rounded-[28px] border p-6 shadow-[0_18px_60px_rgba(2,6,23,0.28)]",
            card.tone,
          ]}
        >
          <div class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500">
            {card.label}
          </div>
          <div class="mt-4 text-4xl font-semibold tracking-[-0.05em] text-white">
            {card.value}
          </div>
          <p class="mt-3 text-sm leading-6 text-slate-400">{card.note}</p>
        </article>
      ))
    }
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.15fr)_360px]">
    <article
      class="rounded-[32px] border border-white/10 bg-[#0f172a]/82 shadow-[0_24px_80px_rgba(2,6,23,0.34)]"
    >
      <div class="border-b border-white/[0.08] px-6 py-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <div
              class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
            >
              Consulta
            </div>
            <h2
              class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white lg:text-[2rem]"
            >
              Eventos auditados
            </h2>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-400">
              Búsqueda libre sobre acción, actor, entidad, IP y diff
              serializado. La lista está ordenada de más reciente a más antigua.
            </p>
          </div>
        </div>

        <form
          method="get"
          class="mt-6 grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto_auto]"
        >
          <label class="block">
            <span
              class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
            >
              Buscar
            </span>
            <input
              type="search"
              name="q"
              value={url.searchParams.get("q") ?? ""}
              placeholder="Acción, actor, entidad, IP o diff..."
              class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-cyan-400/40 focus:outline-none"
            />
          </label>

          <div class="flex items-end">
            <button
              type="submit"
              class="inline-flex min-h-11 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 px-5 py-3 text-sm font-semibold text-cyan-100 transition hover:border-cyan-400/30 hover:bg-cyan-400/15"
            >
              Filtrar
            </button>
          </div>

          <div class="flex items-end">
            <a
              href="/admin/audit"
              class="inline-flex min-h-11 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06] hover:text-white"
            >
              Limpiar
            </a>
          </div>
        </form>
      </div>

      {
        filtered.length === 0 ? (
          <div class="px-6 py-16 text-center lg:px-8">
            <div class="mx-auto max-w-md rounded-[28px] border border-white/10 bg-[#091121] p-8">
              <div class="text-lg font-semibold text-white">
                No hay eventos para ese filtro
              </div>
              <p class="mt-2 text-sm leading-6 text-slate-400">
                Ajusta la búsqueda o limpia el filtro para volver a ver trazas.
              </p>
            </div>
          </div>
        ) : (
          <div class="space-y-5 px-6 py-6 lg:px-8 lg:py-8">
            {filtered.map((row) => {
              const actor = row.actorUserId
                ? actorById.get(row.actorUserId)
                : null;
              const actionGroup = labelForActionGroup(row.action);

              return (
                <article class="rounded-[28px] border border-white/10 bg-[#091121]/80 p-5 shadow-[0_18px_60px_rgba(2,6,23,0.22)] lg:p-6">
                  <div class="flex flex-col gap-5 border-b border-white/[0.08] pb-5 lg:flex-row lg:items-start lg:justify-between">
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2.5">
                        <span
                          class:list={[
                            "inline-flex items-center rounded-full border px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em]",
                            toneForAction(row.action),
                          ]}
                        >
                          {row.action}
                        </span>

                        <span class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-300">
                          {row.entityType}
                        </span>

                        <span class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400">
                          {actionGroup}
                        </span>
                      </div>

                      <div class="mt-4 text-lg font-semibold text-white">
                        Entidad: {row.entityId}
                      </div>

                      <div class="mt-2 text-sm text-slate-400">
                        Actor:{" "}
                        <span class="font-semibold text-white">
                          {actor?.name?.trim() ||
                            actor?.email ||
                            "Sistema / desconocido"}
                        </span>
                      </div>

                      {actor?.name?.trim() && actor.email ? (
                        <div class="mt-1 text-sm text-slate-500">
                          {actor.email}
                        </div>
                      ) : null}
                    </div>

                    <div class="lg:min-w-[220px] lg:text-right">
                      <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                        Fecha
                      </div>
                      <div class="mt-2 text-sm font-semibold text-white">
                        {formatDate(row.createdAt)}
                      </div>
                    </div>
                  </div>

                  <div class="mt-6 grid gap-4 xl:grid-cols-3">
                    <section class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4">
                      <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                        Entidad
                      </div>
                      <div class="mt-3 text-sm font-semibold text-white">
                        {row.entityType}
                      </div>
                      <div class="mt-2 break-all text-sm text-slate-500">
                        {row.entityId}
                      </div>
                    </section>

                    <section class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4">
                      <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                        Red
                      </div>
                      <div class="mt-3 text-sm font-semibold text-white">
                        {row.ip ?? "Sin IP"}
                      </div>
                      {row.userAgent ? (
                        <div class="mt-2 line-clamp-3 text-sm leading-6 text-slate-500">
                          {row.userAgent}
                        </div>
                      ) : (
                        <div class="mt-2 text-sm text-slate-500">
                          Sin user agent
                        </div>
                      )}
                    </section>

                    <section class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4">
                      <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                        Diff
                      </div>
                      <div class="mt-3 text-sm font-semibold text-white">
                        {row.diff ? "Payload disponible" : "Sin diff"}
                      </div>
                      <div class="mt-2 text-sm text-slate-500">
                        {row.diff
                          ? "El evento guarda cambios o metadatos serializados."
                          : "Solo rastro básico del evento."}
                      </div>
                    </section>
                  </div>

                  {row.diff ? (
                    <div class="mt-5 border-t border-white/[0.08] pt-5">
                      <div class="mb-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                        Payload / diff
                      </div>
                      <pre class="overflow-x-auto rounded-[24px] border border-white/10 bg-slate-950/60 p-4 text-xs leading-6 text-slate-300">
                        {JSON.stringify(row.diff, null, 2)}
                      </pre>
                    </div>
                  ) : null}
                </article>
              );
            })}
          </div>
        )
      }
    </article>

    <aside class="space-y-6">
      <section
        class="rounded-[32px] border border-white/10 bg-[#0f172a]/82 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.34)] lg:p-7"
      >
        <div
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
        >
          Lectura rápida
        </div>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white">
          Actividad dominante
        </h2>

        <div class="mt-6 space-y-3">
          {
            topGroups.length === 0 ? (
              <div class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4 text-sm text-slate-400">
                Sin grupos detectables con el filtro actual.
              </div>
            ) : (
              topGroups.map(([group, count], index) => (
                <div class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4">
                  <div class="flex items-center justify-between gap-3">
                    <div>
                      <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                        #{index + 1}
                      </div>
                      <div class="mt-2 text-sm font-semibold text-white">
                        {group}
                      </div>
                    </div>
                    <div class="text-lg font-semibold text-white">{count}</div>
                  </div>
                </div>
              ))
            )
          }
        </div>
      </section>

      <section
        class="rounded-[32px] border border-cyan-400/20 bg-cyan-400/10 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.28)] lg:p-7"
      >
        <div
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-cyan-200/80"
        >
          Criterio
        </div>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white">
          Qué aporta esta vista
        </h2>
        <p class="mt-3 text-sm leading-7 text-cyan-100/80">
          Esta pantalla no es un dashboard de métricas avanzadas. Su función
          real es dejar una trazabilidad legible de cambios administrativos
          importantes: quién tocó qué, cuándo y con qué payload.
        </p>
      </section>

      <section
        class="rounded-[32px] border border-white/10 bg-[#0b1220]/90 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.34)] lg:p-7"
      >
        <div
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
        >
          Uso recomendado
        </div>
        <div class="mt-4 space-y-4">
          <article
            class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4"
          >
            <div class="text-sm font-semibold text-white">Incidencias</div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              Revisa refund, payment, newsletter u operativa cuando haya cambios
              inesperados.
            </p>
          </article>

          <article
            class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4"
          >
            <div class="text-sm font-semibold text-white">
              Trazabilidad humana
            </div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              El actor enlazado ayuda a distinguir cambios manuales frente a
              eventos automáticos o huérfanos.
            </p>
          </article>

          <article
            class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4"
          >
            <div class="text-sm font-semibold text-white">Payload</div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              Cuando existe diff, esta vista te da el contexto suficiente para
              depurar sin entrar directamente en base de datos.
            </p>
          </article>
        </div>
      </section>
    </aside>
  </section>
</AdminLayout>
