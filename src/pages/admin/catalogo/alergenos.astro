---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import { db, Allergen, ProductAllergen, inArray } from "astro:db";
import { getCatalogFlags } from "@/server/catalog/settings";

const catalogFlags = await getCatalogFlags();

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") === "1";
const error = url.searchParams.get("error") ?? "";

const allergens = await db
  .select({
    id: Allergen.id,
    name: Allergen.name,
    slug: Allergen.slug,
    iconUrl: Allergen.iconUrl,
    sortOrder: Allergen.sortOrder,
    active: Allergen.active,
  })
  .from(Allergen)
  .orderBy(Allergen.sortOrder, Allergen.name);

const allergenIds = allergens.map((row) => row.id);

const productLinks = allergenIds.length
  ? await db
      .select({ allergenId: ProductAllergen.allergenId, id: ProductAllergen.id })
      .from(ProductAllergen)
      .where(inArray(ProductAllergen.allergenId, allergenIds))
  : [];

const productCountByAllergen = new Map<number, number>();
for (const row of productLinks) {
  productCountByAllergen.set(row.allergenId, (productCountByAllergen.get(row.allergenId) ?? 0) + 1);
}

const totalAllergens = allergens.length;
const activeAllergens = allergens.filter((row) => row.active).length;
const withIcons = allergens.filter((row) => Boolean(row.iconUrl)).length;
const linkedAllergens = allergens.filter((row) => (productCountByAllergen.get(row.id) ?? 0) > 0).length;

const errorMessage =
  error === "missing-name"
    ? "El nombre es obligatorio."
    : error === "invalid-slug"
      ? "El slug no es válido."
      : error === "duplicate-slug"
        ? "Ya existe otro alérgeno con ese slug."
        : error === "invalid-allergen"
          ? "El alérgeno indicado no es válido."
          : error === "not-found"
            ? "El alérgeno ya no existe."
            : error === "in-use-products"
              ? "No se puede borrar porque sigue enlazado a productos."
              : error === "invalid-intent"
                ? "Acción no válida."
                : "";

const stats = [
  { label: "Total", value: String(totalAllergens), helper: "Catálogo global disponible" },
  { label: "Activos", value: String(activeAllergens), helper: "Disponibles para asociar" },
  { label: "Con icono", value: String(withIcons), helper: "Preview visual listo" },
  { label: "En uso", value: String(linkedAllergens), helper: "Actualmente enlazados" },
];
---

<AdminLayout title="Alérgenos · Admin · Arcadia" heading="Alérgenos" description="Catálogo de alérgenos y su uso en los productos de la carta.">
  <div class="space-y-6">
    {saved ? <section class="rounded-admin-lg border border-emerald-400/15 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-100">Alérgenos actualizados correctamente.</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/15 bg-rose-400/10 px-5 py-3 text-sm text-rose-100">{errorMessage}</section> : null}

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      {stats.map((stat) => (
        <StatCard label={stat.label} value={stat.value} helper={stat.helper} />
      ))}
    </section>

    <Card>
      <form method="post" action="/api/admin/allergens" class="flex flex-wrap items-center justify-between gap-4">
        <input type="hidden" name="intent" value="save-visibility" />

        <div class="min-w-0">
          <div class="admin-eyebrow">Visibilidad</div>
          <h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-white">
            Mostrar alérgenos en la web
          </h2>
          <p class="mt-1 max-w-2xl text-sm text-admin-muted">
            {catalogFlags.showAllergens
              ? "Los iconos de alérgenos y el filtro aparecen en la carta y en el pedido a domicilio."
              : "Los alérgenos están ocultos: no salen sus iconos ni el filtro, y tampoco viajan al navegador del cliente."}
          </p>
        </div>

        <div class="flex items-center gap-3">
          <Badge tone={catalogFlags.showAllergens ? "success" : "neutral"}>
            {catalogFlags.showAllergens ? "Visibles" : "Ocultos"}
          </Badge>

          {/* El valor enviado es el contrario al actual: el botón alterna. */}
          <input type="hidden" name="showAllergens" value={catalogFlags.showAllergens ? "off" : "on"} />
          <button
            type="submit"
            class="inline-flex min-h-10 items-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15"
          >
            {catalogFlags.showAllergens ? "Ocultar en la web" : "Mostrar en la web"}
          </button>
        </div>
      </form>
    </Card>

    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <h2 class="text-base font-semibold text-white">Alérgenos</h2>

        <Modal id="allergen-create" title="Nuevo alérgeno" triggerLabel="+ Nuevo alérgeno">
          <form method="post" action="/api/admin/allergens" class="grid gap-4">
            <input type="hidden" name="intent" value="create" />
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Nombre</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" type="text" name="name" placeholder="Gluten" required />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Slug</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" type="text" name="slug" placeholder="Automático si se deja vacío" />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Icon URL</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" type="text" name="iconUrl" placeholder="/images/allergens/gluten.webp" />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Orden</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" type="number" name="sortOrder" min="0" step="1" value={allergens.length} required />
            </label>
            <label class="inline-flex items-center gap-2.5 rounded-2xl border border-admin-border bg-white/[0.03] p-3.5 text-sm text-slate-300">
              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="active" checked />
              Activo
            </label>
            <button type="submit" class="mt-1 inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/15 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/25 hover:bg-sky-400/15">
              Crear alérgeno
            </button>
          </form>
        </Modal>
      </div>

      {
        allergens.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="No hay alérgenos" description="Crea el primero con el botón de arriba." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Alérgeno</th>
                  <th>Orden</th>
                  <th>Icono</th>
                  <th>Uso</th>
                  <th>Estado</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {allergens.map((allergen) => {
                  const linkedProducts = productCountByAllergen.get(allergen.id) ?? 0;
                  const canDelete = linkedProducts === 0;
                  return (
                    <tr>
                      <td>
                        <div class="flex items-center gap-3">
                          {allergen.iconUrl ? (
                            <img src={allergen.iconUrl} alt={allergen.name} class="h-9 w-9 rounded-xl object-cover ring-1 ring-white/10" />
                          ) : (
                            <div class="flex h-9 w-9 items-center justify-center rounded-xl border border-admin-border bg-white/[0.03] text-xs font-semibold text-admin-muted">{allergen.name.slice(0, 1)}</div>
                          )}
                          <div>
                            <div class="font-semibold text-white">{allergen.name}</div>
                            <div class="text-xs text-admin-muted">{allergen.slug}</div>
                          </div>
                        </div>
                      </td>
                      <td class="text-admin-muted">#{allergen.sortOrder}</td>
                      <td class="text-admin-muted">{allergen.iconUrl ? "Configurado" : "Sin icono"}</td>
                      <td class="text-admin-muted">{linkedProducts}</td>
                      <td><Badge tone={allergen.active ? "success" : "danger"}>{allergen.active ? "Activo" : "Inactivo"}</Badge></td>
                      <td>
                        <div class="flex justify-end">
                          <Modal
                            id={`allergen-edit-${allergen.id}`}
                            title={allergen.name}
                            triggerLabel="Editar"
                            triggerClass="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]"
                          >
                            <form method="post" action="/api/admin/allergens" class="grid gap-4">
                              <input type="hidden" name="intent" value="update" />
                              <input type="hidden" name="allergenId" value={allergen.id} />
                              <div class="grid grid-cols-2 gap-4">
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Nombre</span>
                                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" type="text" name="name" value={allergen.name} required />
                                </label>
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Slug</span>
                                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" type="text" name="slug" value={allergen.slug} required />
                                </label>
                              </div>
                              <label class="block">
                                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Icon URL</span>
                                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" type="text" name="iconUrl" value={allergen.iconUrl ?? ""} placeholder="/images/allergens/gluten.webp" />
                              </label>
                              <label class="block">
                                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Orden</span>
                                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" type="number" name="sortOrder" min="0" step="1" value={allergen.sortOrder} required />
                              </label>
                              <label class="inline-flex items-center gap-2.5 rounded-2xl border border-admin-border bg-white/[0.03] p-3.5 text-sm text-slate-300">
                                <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="active" checked={allergen.active} />
                                Activo
                              </label>
                              <div class="flex items-center justify-between gap-3 border-t border-admin-border pt-4">
                                <span class="text-xs leading-5 text-admin-muted">
                                  {canDelete ? "Se puede borrar: sin uso." : "No se puede borrar: en uso."}
                                </span>
                                <button type="submit" class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-sky-400/15 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/25 hover:bg-sky-400/15">
                                  Guardar
                                </button>
                              </div>
                            </form>

                            <form method="post" action="/api/admin/allergens" class="mt-3 border-t border-admin-border pt-3">
                              <input type="hidden" name="intent" value="delete" />
                              <input type="hidden" name="allergenId" value={allergen.id} />
                              <button
                                type="submit"
                                disabled={!canDelete}
                                class:list={[
                                  "inline-flex min-h-9 items-center justify-center rounded-2xl px-4 py-2 text-sm font-semibold transition",
                                  canDelete
                                    ? "border border-rose-400/15 bg-rose-400/10 text-rose-200 hover:border-rose-400/25 hover:bg-rose-400/15"
                                    : "cursor-not-allowed border border-admin-border bg-white/[0.03] text-slate-500",
                                ]}
                              >
                                Borrar alérgeno
                              </button>
                            </form>
                          </Modal>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
