---
import AdminLayout from "@/layouts/AdminLayout.astro";
import {
  db,
  Allergen,
  ProductAllergen,
  inArray,
} from "astro:db";

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") === "1";
const error = url.searchParams.get("error") ?? "";

const allergens = await db
  .select({
    id: Allergen.id,
    name: Allergen.name,
    slug: Allergen.slug,
    iconUrl: Allergen.iconUrl,
    sortOrder: Allergen.sortOrder,
    active: Allergen.active,
    createdAt: Allergen.createdAt,
    updatedAt: Allergen.updatedAt,
  })
  .from(Allergen)
  .orderBy(Allergen.sortOrder, Allergen.name);

const allergenIds = allergens.map((row) => row.id);

const productLinks = allergenIds.length
  ? await db
      .select({
        allergenId: ProductAllergen.allergenId,
        id: ProductAllergen.id,
      })
      .from(ProductAllergen)
      .where(inArray(ProductAllergen.allergenId, allergenIds))
  : [];

const productCountByAllergen = new Map<number, number>();
for (const row of productLinks) {
  productCountByAllergen.set(
    row.allergenId,
    (productCountByAllergen.get(row.allergenId) ?? 0) + 1
  );
}

const totalAllergens = allergens.length;
const activeAllergens = allergens.filter((row) => row.active).length;
const withIcons = allergens.filter((row) => Boolean(row.iconUrl)).length;
const linkedAllergens = allergens.filter((row) => (productCountByAllergen.get(row.id) ?? 0) > 0).length;

const errorMessage =
  error === "missing-name"
    ? "El nombre es obligatorio."
    : error === "invalid-slug"
      ? "El slug no es válido."
      : error === "duplicate-slug"
        ? "Ya existe otro alérgeno con ese slug."
        : error === "invalid-allergen"
          ? "El alérgeno indicado no es válido."
          : error === "not-found"
            ? "El alérgeno ya no existe."
            : error === "in-use-products"
              ? "No se puede borrar porque sigue enlazado a productos."
              : error === "invalid-intent"
                ? "Acción no válida."
                : "";
---

<AdminLayout
  title="Alérgenos · Admin · Arcadia"
  heading="Alérgenos globales"
  description="Catálogo visual de alérgenos. Desde aquí se mantienen slug, icono y orden global para toda la app y el admin."
  actions={true}
>
  <Fragment slot="actions">
    <div class="flex flex-wrap gap-3">
      <a
        href="/admin/catalogo/productos"
        class="inline-flex items-center justify-center rounded-2xl bg-sky-500 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-400"
      >
        Ver productos
      </a>

      <a
        href="/admin/catalogo/ingredientes"
        class="inline-flex items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 px-4 py-3 text-sm font-semibold text-cyan-300 transition hover:border-cyan-400/30 hover:bg-cyan-400/15"
      >
        Ver ingredientes
      </a>

      <a
        href="/admin/catalogo/modificadores"
        class="inline-flex items-center justify-center rounded-2xl border border-violet-400/20 bg-violet-400/10 px-4 py-3 text-sm font-semibold text-violet-300 transition hover:border-violet-400/30 hover:bg-violet-400/15"
      >
        Ver modificadores
      </a>
    </div>
  </Fragment>

  {saved ? (
    <section class="mb-6 rounded-3xl border border-emerald-400/20 bg-emerald-400/10 px-5 py-4 text-sm text-emerald-200">
      Alérgenos actualizados correctamente.
    </section>
  ) : null}

  {errorMessage ? (
    <section class="mb-6 rounded-3xl border border-rose-400/20 bg-rose-400/10 px-5 py-4 text-sm text-rose-200">
      {errorMessage}
    </section>
  ) : null}

  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-[28px] border border-white/10 bg-white/4 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Total</div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">{totalAllergens}</div>
      <p class="mt-2 text-sm text-slate-400">Catálogo global</p>
    </article>

    <article class="rounded-[28px] border border-emerald-400/15 bg-emerald-400/6 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-emerald-200/80">Activos</div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">{activeAllergens}</div>
      <p class="mt-2 text-sm text-emerald-100/70">Disponibles para asociar</p>
    </article>

    <article class="rounded-[28px] border border-cyan-400/15 bg-cyan-400/6 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-cyan-200/80">Con icono</div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">{withIcons}</div>
      <p class="mt-2 text-sm text-cyan-100/70">Preview visual disponible</p>
    </article>

    <article class="rounded-[28px] border border-amber-400/15 bg-amber-400/6 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-amber-200/80">En uso</div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">{linkedAllergens}</div>
      <p class="mt-2 text-sm text-amber-100/70">Asociados a productos</p>
    </article>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[420px_minmax(0,1fr)]">
    <aside class="space-y-6">
      <section class="rounded-[30px] border border-white/10 bg-[#111827] p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">
          Alta
        </div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
          Nuevo alérgeno
        </h2>

        <form method="post" action="/api/admin/allergens" class="mt-6 grid gap-4">
          <input type="hidden" name="intent" value="create" />

          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Nombre</span>
            <input
              class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-amber-400/40 focus:outline-none"
              type="text"
              name="name"
              placeholder="Gluten"
              required
            />
          </label>

          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Slug</span>
            <input
              class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-amber-400/40 focus:outline-none"
              type="text"
              name="slug"
              placeholder="Se genera automáticamente si lo dejas vacío"
            />
          </label>

          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Icon URL</span>
            <input
              class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-amber-400/40 focus:outline-none"
              type="text"
              name="iconUrl"
              placeholder="/images/allergens/gluten.webp"
            />
          </label>

          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Orden</span>
            <input
              class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-amber-400/40 focus:outline-none"
              type="number"
              name="sortOrder"
              min="0"
              step="1"
              value={allergens.length}
              required
            />
          </label>

          <label class="block rounded-3xl border border-white/10 bg-white/5 p-4">
            <div class="flex items-start gap-3">
              <input
                class="mt-1 h-4 w-4 rounded border-white/20 bg-slate-950 text-amber-400"
                type="checkbox"
                name="active"
                checked
              />
              <div>
                <div class="text-sm font-semibold text-white">Activo</div>
                <p class="mt-1 text-sm leading-6 text-slate-400">Disponible para asociar a productos.</p>
              </div>
            </div>
          </label>

          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-2xl bg-amber-400 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-amber-300"
          >
            Crear alérgeno
          </button>
        </form>
      </section>

      <section class="rounded-[30px] border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">
          Criterio
        </div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
          Representación visual
        </h2>

        <div class="mt-6 space-y-4">
          <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
            <div class="text-sm font-semibold text-white">Iconos compartidos</div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              El icono se usa tanto en catálogo admin como en la parte pública donde haya representación visual del alérgeno.
            </p>
          </div>

          <div class="rounded-3xl border border-amber-400/20 bg-amber-400/10 p-4">
            <div class="text-sm font-semibold text-amber-200">Borrado protegido</div>
            <p class="mt-2 text-sm leading-6 text-amber-100/80">
              Un alérgeno no se puede borrar si sigue vinculado a productos.
            </p>
          </div>
        </div>
      </section>
    </aside>

    <section class="rounded-[30px] border border-white/10 bg-[#111827]/80 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
      <div class="border-b border-white/10 px-6 py-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-amber-300/80">
              Gestión
            </div>
            <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
              Catálogo global de alérgenos
            </h2>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300">
            Iconos + orden global
          </div>
        </div>
      </div>

      {allergens.length === 0 ? (
        <div class="px-6 py-12 text-center">
          <div class="mx-auto max-w-md rounded-[28px] border border-white/10 bg-slate-950/40 p-8">
            <div class="text-lg font-semibold text-white">No hay alérgenos</div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              Crea el primero desde el formulario lateral.
            </p>
          </div>
        </div>
      ) : (
        <div class="space-y-4 px-6 py-6">
          {allergens.map((allergen) => {
            const linkedProducts = productCountByAllergen.get(allergen.id) ?? 0;
            const canDelete = linkedProducts === 0;

            return (
              <section class="rounded-3xl border border-white/10 bg-white/4 p-5">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="flex items-center gap-4">
                    {allergen.iconUrl ? (
                      <img
                        src={allergen.iconUrl}
                        alt={allergen.name}
                        class="h-14 w-14 rounded-2xl object-cover ring-1 ring-white/10"
                      />
                    ) : (
                      <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-slate-950/60 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">
                        {allergen.name.slice(0, 1)}
                      </div>
                    )}

                    <div>
                      <div class="text-base font-semibold text-white">{allergen.name}</div>
                      <div class="mt-1">
                        <code class="rounded-xl border border-white/10 bg-slate-950/60 px-2.5 py-1.5 text-xs text-slate-300">
                          {allergen.slug}
                        </code>
                      </div>
                    </div>
                  </div>

                  <div class="flex flex-wrap gap-2">
                    <span class:list={[
                      "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                      allergen.active
                        ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
                        : "border-rose-400/20 bg-rose-400/10 text-rose-300",
                    ]}>
                      {allergen.active ? "Activo" : "Inactivo"}
                    </span>

                    <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-300">
                      {linkedProducts} producto{linkedProducts === 1 ? "" : "s"}
                    </span>
                  </div>
                </div>

                <form method="post" action="/api/admin/allergens" class="mt-5 grid gap-4">
                  <input type="hidden" name="intent" value="update" />
                  <input type="hidden" name="allergenId" value={allergen.id} />

                  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_220px_220px_140px]">
                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Nombre</span>
                      <input
                        class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-amber-400/40 focus:outline-none"
                        type="text"
                        name="name"
                        value={allergen.name}
                        required
                      />
                    </label>

                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Slug</span>
                      <input
                        class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-amber-400/40 focus:outline-none"
                        type="text"
                        name="slug"
                        value={allergen.slug}
                        required
                      />
                    </label>

                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Icon URL</span>
                      <input
                        class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-amber-400/40 focus:outline-none"
                        type="text"
                        name="iconUrl"
                        value={allergen.iconUrl ?? ""}
                        placeholder="/images/allergens/gluten.webp"
                      />
                    </label>

                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Orden</span>
                      <input
                        class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-amber-400/40 focus:outline-none"
                        type="number"
                        name="sortOrder"
                        min="0"
                        step="1"
                        value={allergen.sortOrder}
                        required
                      />
                    </label>
                  </div>

                  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-4">
                    <label class="inline-flex items-center gap-3 text-sm text-slate-300">
                      <input
                        class="h-4 w-4 rounded border-white/20 bg-slate-950 text-amber-400"
                        type="checkbox"
                        name="active"
                        checked={allergen.active}
                      />
                      Activo
                    </label>

                    <button
                      type="submit"
                      class="inline-flex items-center justify-center rounded-2xl bg-amber-400 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-amber-300"
                    >
                      Guardar alérgeno
                    </button>
                  </div>
                </form>

                <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 pt-4">
                  <div class="text-sm text-slate-500">
                    {canDelete
                      ? "Se puede borrar porque no está enlazado a productos."
                      : "No se puede borrar porque sigue asociado a productos."}
                  </div>

                  <form method="post" action="/api/admin/allergens">
                    <input type="hidden" name="intent" value="delete" />
                    <input type="hidden" name="allergenId" value={allergen.id} />
                    <button
                      type="submit"
                      disabled={!canDelete}
                      class:list={[
                        "inline-flex items-center justify-center rounded-2xl px-4 py-3 text-sm font-semibold transition",
                        canDelete
                          ? "border border-rose-400/20 bg-rose-400/10 text-rose-300 hover:border-rose-400/30 hover:bg-rose-400/15"
                          : "cursor-not-allowed border border-white/10 bg-white/5 text-slate-500",
                      ]}
                    >
                      Borrar alérgeno
                    </button>
                  </form>
                </div>
              </section>
            );
          })}
        </div>
      )}
    </section>
  </section>
</AdminLayout>