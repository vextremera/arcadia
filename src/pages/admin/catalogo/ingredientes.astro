---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import {
  db,
  Ingredient,
  ProductIngredient,
  CategoryIngredient,
  Product,
  Category,
  eq,
  inArray,
} from "astro:db";

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

const url = new URL(Astro.request.url);
const q = (url.searchParams.get("q") ?? "").trim().toLowerCase();
const statusFilter = url.searchParams.get("status") ?? "";
const scopeFilter = url.searchParams.get("scope") ?? "";
const saved = url.searchParams.get("saved") === "1";
const error = url.searchParams.get("error") ?? "";

const ingredients = await db
  .select({
    id: Ingredient.id,
    name: Ingredient.name,
    slug: Ingredient.slug,
    imageUrl: Ingredient.imageUrl,
    addPriceDeltaCents: Ingredient.addPriceDeltaCents,
    isCommon: Ingredient.isCommon,
    active: Ingredient.active,
    sortOrder: Ingredient.sortOrder,
  })
  .from(Ingredient)
  .orderBy(Ingredient.sortOrder, Ingredient.name);

const ingredientIds = ingredients.map((ingredient) => ingredient.id);

const productLinks = ingredientIds.length
  ? await db
      .select({
        id: ProductIngredient.id,
        ingredientId: ProductIngredient.ingredientId,
        productId: ProductIngredient.productId,
        defaultIncluded: ProductIngredient.defaultIncluded,
        removable: ProductIngredient.removable,
      })
      .from(ProductIngredient)
      .where(inArray(ProductIngredient.ingredientId, ingredientIds))
  : [];

const categoryLinks = ingredientIds.length
  ? await db
      .select({
        id: CategoryIngredient.id,
        ingredientId: CategoryIngredient.ingredientId,
        categoryId: CategoryIngredient.categoryId,
      })
      .from(CategoryIngredient)
      .where(inArray(CategoryIngredient.ingredientId, ingredientIds))
  : [];

const productCountByIngredient = new Map<number, number>();
for (const link of productLinks) {
  productCountByIngredient.set(
    link.ingredientId,
    (productCountByIngredient.get(link.ingredientId) ?? 0) + 1,
  );
}

const categoryCountByIngredient = new Map<number, number>();
for (const link of categoryLinks) {
  categoryCountByIngredient.set(
    link.ingredientId,
    (categoryCountByIngredient.get(link.ingredientId) ?? 0) + 1,
  );
}

const items = ingredients.map((ingredient) => {
  const linkedProducts = productCountByIngredient.get(ingredient.id) ?? 0;
  const linkedCategories = categoryCountByIngredient.get(ingredient.id) ?? 0;
  const hasPriceDelta = Number(ingredient.addPriceDeltaCents ?? 0) > 0;
  const isOrphan = linkedProducts === 0 && linkedCategories === 0;

  return {
    ...ingredient,
    linkedProducts,
    linkedCategories,
    hasPriceDelta,
    isOrphan,
    canDelete: isOrphan,
  };
});

const filteredIngredients = items.filter((ingredient) => {
  if (statusFilter === "active" && !ingredient.active) return false;
  if (statusFilter === "inactive" && ingredient.active) return false;

  if (scopeFilter === "common" && !ingredient.isCommon) return false;
  if (scopeFilter === "priced" && !ingredient.hasPriceDelta) return false;
  if (
    scopeFilter === "linked" &&
    ingredient.linkedProducts === 0 &&
    ingredient.linkedCategories === 0
  )
    return false;
  if (scopeFilter === "orphan" && !ingredient.isOrphan) return false;

  if (!q) return true;

  const haystack = [ingredient.name, ingredient.slug].join(" ").toLowerCase();
  return haystack.includes(q);
});

const totalIngredients = items.length;
const activeIngredients = items.filter((ingredient) => ingredient.active).length;
const commonIngredients = items.filter((ingredient) => ingredient.isCommon).length;
const linkedIngredients = items.filter(
  (ingredient) => ingredient.linkedProducts > 0 || ingredient.linkedCategories > 0,
).length;
const orphanIngredients = items.filter((ingredient) => ingredient.isOrphan).length;

const errorMessage =
  error === "missing-name"
    ? "El nombre es obligatorio."
    : error === "invalid-slug"
      ? "El slug no es válido."
      : error === "duplicate-slug"
        ? "Ya existe otro ingrediente con ese slug."
        : error === "invalid-price"
          ? "El precio extra debe ser un importe válido mayor o igual que cero."
          : error === "invalid-sort-order"
            ? "El orden debe ser un número válido mayor o igual que cero."
            : error === "invalid-ingredient"
              ? "El ingrediente indicado no es válido."
              : error === "not-found"
                ? "El ingrediente ya no existe."
                : error === "in-use-products"
                  ? "No se puede borrar porque sigue enlazado a productos."
                  : error === "in-use-categories"
                    ? "No se puede borrar porque sigue enlazado a compatibilidades de categoría."
                    : error === "invalid-intent"
                      ? "Acción no válida."
                      : "";

const summaryCards = [
  { label: "Total", value: String(totalIngredients), helper: "Ingredientes globales" },
  { label: "Activos", value: String(activeIngredients), helper: "Disponibles en catálogo" },
  { label: "Comunes", value: String(commonIngredients), helper: "Extras del configurador" },
  { label: "En uso", value: String(linkedIngredients), helper: "Productos o compatibilidades" },
];
---

<AdminLayout title="Ingredientes · Admin · Arcadia" heading="Ingredientes" description="Ingredientes globales, su precio extra y dónde se están usando.">
  <div class="space-y-6">
    {
      saved ? (
        <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">
          Ingredientes actualizados correctamente.
        </section>
      ) : null
    }
    {
      errorMessage ? (
        <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">
          {errorMessage}
        </section>
      ) : null
    }

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      {summaryCards.map((card) => (
        <StatCard label={card.label} value={card.value} helper={card.helper} />
      ))}
    </section>

    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <form method="get" class="flex flex-1 flex-wrap items-center gap-2">
          <input
            class="min-w-[220px] flex-1 rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-slate-500 focus:border-cyan-400/40 focus:outline-none"
            type="search"
            name="q"
            value={q}
            placeholder="Buscar ingrediente..."
          />
          <select name="status" class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none">
            <option value="">Estado</option>
            <option value="active" selected={statusFilter === "active"}>Activos</option>
            <option value="inactive" selected={statusFilter === "inactive"}>Inactivos</option>
          </select>
          <select name="scope" class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none">
            <option value="">Alcance</option>
            <option value="common" selected={scopeFilter === "common"}>Comunes</option>
            <option value="priced" selected={scopeFilter === "priced"}>Con precio</option>
            <option value="linked" selected={scopeFilter === "linked"}>En uso</option>
            <option value="orphan" selected={scopeFilter === "orphan"}>Huérfanos</option>
          </select>
          <button type="submit" class="inline-flex min-h-9 items-center justify-center rounded-2xl border border-admin-border bg-white/[0.03] px-3.5 py-2 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
            Filtrar
          </button>
        </form>

        <Modal
          id="ingredient-create"
          title="Nuevo ingrediente"
          description="Nombre, slug, precio extra, orden y visibilidad operativa."
          triggerLabel="+ Nuevo ingrediente"
        >
          <form method="post" action="/api/admin/ingredients" class="grid gap-4">
            <input type="hidden" name="intent" value="create" />

            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Nombre</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="text" name="name" placeholder="Cebolla caramelizada" required />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Slug</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="text" name="slug" placeholder="Automático si se deja vacío" />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Imagen</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="text" name="imageUrl" placeholder="/images/ingredients/placeholder.svg" />
            </label>

            <div class="grid grid-cols-2 gap-4">
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Precio extra</span>
                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="number" name="addPriceDeltaEur" min="0" step="0.01" value="0.00" required />
              </label>
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Orden</span>
                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="number" name="sortOrder" min="0" step="1" value={ingredients.length} required />
              </label>
            </div>

            <div class="flex flex-wrap gap-6 pt-1">
              <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-cyan-400" type="checkbox" name="isCommon" checked />
                Ingrediente común
              </label>
              <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-cyan-400" type="checkbox" name="active" checked />
                Activo
              </label>
            </div>

            <button type="submit" class="mt-2 inline-flex min-h-11 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 px-4 py-3 text-sm font-semibold text-cyan-100 transition hover:border-cyan-400/30 hover:bg-cyan-400/15">
              Crear ingrediente
            </button>
          </form>
        </Modal>
      </div>

      {
        filteredIngredients.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="No hay ingredientes para ese filtro" description="Ajusta la búsqueda o crea uno nuevo." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Ingrediente</th>
                  <th>Precio extra</th>
                  <th>Alcance</th>
                  <th>Uso</th>
                  <th>Estado</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {filteredIngredients.map((ingredient) => (
                  <tr>
                    <td>
                      <div class="flex items-center gap-3">
                        <div class="h-9 w-9 shrink-0 overflow-hidden rounded-xl border border-admin-border bg-white/5">
                          {ingredient.imageUrl ? (
                            <img src={ingredient.imageUrl} alt={ingredient.name} class="h-full w-full object-contain p-1" loading="lazy" />
                          ) : (
                            <div class="grid h-full w-full place-items-center text-[9px] font-semibold text-admin-faint">—</div>
                          )}
                        </div>
                        <div class="min-w-0">
                          <div class="truncate font-semibold text-white">{ingredient.name}</div>
                          <div class="truncate text-xs text-admin-muted">{ingredient.slug}</div>
                        </div>
                      </div>
                    </td>
                    <td>{ingredient.hasPriceDelta ? `+${money(ingredient.addPriceDeltaCents)}` : "—"}</td>
                    <td>{ingredient.isCommon ? <Badge tone="cyan">Común</Badge> : <span class="text-admin-muted">—</span>}</td>
                    <td class="text-admin-muted">{ingredient.linkedProducts} prod. · {ingredient.linkedCategories} cat.</td>
                    <td><Badge tone={ingredient.active ? "success" : "danger"}>{ingredient.active ? "Activo" : "Inactivo"}</Badge></td>
                    <td>
                      <div class="flex items-center justify-end gap-2">
                        <Modal
                          id={`ingredient-edit-${ingredient.id}`}
                          title={ingredient.name}
                          triggerLabel="Editar"
                          triggerClass="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]"
                        >
                          <form method="post" action="/api/admin/ingredients" class="grid gap-4">
                            <input type="hidden" name="intent" value="update" />
                            <input type="hidden" name="ingredientId" value={ingredient.id} />

                            <div class="grid gap-4 sm:grid-cols-2">
                              <label class="block">
                                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Nombre</span>
                                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="text" name="name" value={ingredient.name} required />
                              </label>
                              <label class="block">
                                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Slug</span>
                                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="text" name="slug" value={ingredient.slug} required />
                              </label>
                            </div>

                            <label class="block">
                              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Imagen</span>
                              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="text" name="imageUrl" value={ingredient.imageUrl ?? ""} placeholder="/images/ingredients/placeholder.svg" />
                            </label>

                            <div class="grid grid-cols-2 gap-4">
                              <label class="block">
                                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Precio extra</span>
                                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="number" name="addPriceDeltaEur" min="0" step="0.01" value={(ingredient.addPriceDeltaCents / 100).toFixed(2)} required />
                              </label>
                              <label class="block">
                                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Orden</span>
                                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="number" name="sortOrder" min="0" step="1" value={ingredient.sortOrder} required />
                              </label>
                            </div>

                            <div class="flex flex-wrap gap-6 pt-1">
                              <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                                <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-cyan-400" type="checkbox" name="isCommon" checked={ingredient.isCommon} />
                                Ingrediente común
                              </label>
                              <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                                <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-cyan-400" type="checkbox" name="active" checked={ingredient.active} />
                                Activo
                              </label>
                            </div>

                            <div class="flex items-center justify-between gap-3 border-t border-admin-border pt-4">
                              <span class="text-xs leading-5 text-admin-muted">
                                {ingredient.canDelete ? "Se puede borrar: sin uso." : "No se puede borrar: sigue en uso."}
                              </span>
                              <button type="submit" class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 px-4 py-2.5 text-sm font-semibold text-cyan-100 transition hover:border-cyan-400/30 hover:bg-cyan-400/15">
                                Guardar
                              </button>
                            </div>
                          </form>

                          <form method="post" action="/api/admin/ingredients" class="mt-3 border-t border-admin-border pt-3">
                            <input type="hidden" name="intent" value="delete" />
                            <input type="hidden" name="ingredientId" value={ingredient.id} />
                            <button
                              type="submit"
                              disabled={!ingredient.canDelete}
                              class:list={[
                                "inline-flex min-h-9 items-center justify-center rounded-2xl px-4 py-2 text-sm font-semibold transition",
                                ingredient.canDelete
                                  ? "border border-rose-400/20 bg-rose-400/10 text-rose-300 hover:border-rose-400/30 hover:bg-rose-400/15"
                                  : "cursor-not-allowed border border-admin-border bg-white/[0.03] text-slate-500",
                              ]}
                            >
                              Borrar ingrediente
                            </button>
                          </form>
                        </Modal>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
