                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <div class="text-sm font-semibold text-white">{ingredient.name}</div>
                      <div class="mt-1 text-xs text-slate-500">{ingredient.slug}</div>
                    </div>

                    <div class="flex flex-wrap gap-2">
                      {ingredient.isCommon ? (
                        <span class="inline-flex items-center rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-cyan-300">
                          Common
                        </span>
                      ) : null}

                      {ingredient.addPriceDeltaCents > 0 ? (
                        <span class="inline-flex items-center rounded-full border border-sky-400/20 bg-sky-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-sky-300">
                          +{money(ingredient.addPriceDeltaCents)}
                        </span>
                      ) : (
                        <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-300">
                          Sin extra
                        </span>
                      )}
                    </div>
                  </div>

                  <div class="grid gap-4 lg:grid-cols-[160px_1fr_1fr]">
                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Orden</span>
                      <input class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="number" name="sortOrder" step="1" value={ingredient.sortOrder} />
                    </label>

                    <label class="block rounded-3xl border border-white/10 bg-white/5 p-4">
                      <div class="flex items-start gap-3">
                        <input class="mt-1 h-4 w-4 rounded border-white/20 bg-slate-950 text-cyan-400" type="checkbox" name="defaultIncluded" checked={ingredient.defaultIncluded} />
                        <div>
                          <div class="text-sm font-semibold text-white">Va por defecto</div>
                          <p class="mt-1 text-sm leading-6 text-slate-400">Incluido de base al abrir el producto</p>
                        </div>
                      </div>
                    </label>

                    <label class="block rounded-3xl border border-white/10 bg-white/5 p-4">
                      <div class="flex items-start gap-3">
                        <input class="mt-1 h-4 w-4 rounded border-white/20 bg-slate-950 text-cyan-400" type="checkbox" name="removable" checked={ingredient.removable} />
                        <div>
                          <div class="text-sm font-semibold text-white">Removible</div>
                          <p class="mt-1 text-sm leading-6 text-slate-400">El cliente lo puede quitar</p>
                        </div>
                      </div>
                    </label>
                  </div>

                  <div class="flex flex-wrap gap-3">
                    <button class="inline-flex items-center justify-center rounded-2xl bg-cyan-400 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300" type="submit">
                      Guardar ingrediente
                    </button>
                  </div>
                </form>

                <form method="post" action={`/api/admin/products/${product.id}/ingredients`} class="mt-3">
                  <input type="hidden" name="intent" value="delete" />
                  <input type="hidden" name="productIngredientId" value={ingredient.id} />
                  <button class="inline-flex items-center justify-center rounded-2xl border border-rose-400/20 bg-rose-400/10 px-4 py-3 text-sm font-semibold text-rose-300 transition hover:border-rose-400/30 hover:bg-rose-400/15" type="submit">
                    Quitar ingrediente
                  </button>
                </form>
              </article>
            ))
          )}
        </div>
      </section>
    </div>

    <aside class="space-y-6 xl:sticky xl:top-28 xl:h-fit">
      <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Metadatos</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Contexto del registro</h2>

        <div class="mt-6 space-y-4 text-sm">
          <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
            <div class="text-slate-400">ID</div>
            <div class="mt-1 font-semibold text-white">{product.id}</div>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
            <div class="text-slate-400">Creado</div>
            <div class="mt-1 font-semibold text-white">{formatDate(product.createdAt)}</div>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
            <div class="text-slate-400">Categoría</div>
            <div class="mt-1 font-semibold text-white">{product.categoryName}</div>
            <div class="mt-1 text-xs text-slate-500">{product.categorySlug}</div>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
            <div class="text-slate-400">Ingredientes removibles</div>
            <div class="mt-1 font-semibold text-white">{removableCount}</div>
          </div>
        </div>
      </article>

      <section id="alergenos" class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Alérgenos</div>
            <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Vincular alérgenos</h2>
          </div>

          <div class="text-sm text-slate-400">Asociados: {allergenRows.length}</div>
        </div>

        <form method="post" action={`/api/admin/products/${product.id}/allergens`} class="mt-6 rounded-3xl border border-amber-400/20 bg-amber-400/10 p-5">
          <input type="hidden" name="intent" value="create" />

          <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto]">
            <label class="block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-amber-100/80">Alérgeno</span>
              <select class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-amber-300/40 focus:outline-none" name="allergenId" required>
                {availableAllergens.length === 0 ? (
                  <option value="">No quedan alérgenos disponibles</option>
                ) : (
                  availableAllergens.map((allergen) => (
                    <option value={allergen.id}>{allergen.name}</option>
                  ))
                )}
              </select>
            </label>

            <div class="flex items-end">
              <button class="inline-flex w-full items-center justify-center rounded-2xl bg-amber-400 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-amber-300 disabled:cursor-not-allowed disabled:opacity-50" type="submit" disabled={availableAllergens.length === 0}>
                Añadir alérgeno
              </button>
            </div>
          </div>
        </form>

        <div class="mt-6 space-y-4">
          {allergenRows.length === 0 ? (
            <div class="rounded-3xl border border-white/10 bg-white/5 p-4 text-sm text-slate-400">
              Sin alérgenos asociados.
            </div>
          ) : (
            allergenRows.map((allergen) => (
              <article class="rounded-3xl border border-white/10 bg-white/5 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div class="flex min-w-0 items-center gap-3">
                    {allergen.iconUrl ? (
                      <img src={allergen.iconUrl} alt={allergen.name} class="h-10 w-10 rounded-2xl object-cover ring-1 ring-white/10" />
                    ) : (
                      <div class="flex h-10 w-10 items-center justify-center rounded-2xl border border-white/10 bg-slate-950/60 text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-500">
                        ALG
                      </div>
                    )}

                    <div class="min-w-0">
                      <div class="text-sm font-semibold text-white">{allergen.name}</div>
                      <div class="mt-1 text-xs text-slate-500">{allergen.slug}</div>
                    </div>
                  </div>

                  <form method="post" action={`/api/admin/products/${product.id}/allergens`}>
                    <input type="hidden" name="intent" value="delete" />
                    <input type="hidden" name="productAllergenId" value={allergen.id} />
                    <button class="inline-flex items-center justify-center rounded-2xl border border-rose-400/20 bg-rose-400/10 px-4 py-3 text-sm font-semibold text-rose-300 transition hover:border-rose-400/30 hover:bg-rose-400/15" type="submit">
                      Quitar
                    </button>
                  </form>
                </div>
              </article>
            ))
          )}
        </div>
      </section>
    </aside>
  </section>
</AdminLayout>