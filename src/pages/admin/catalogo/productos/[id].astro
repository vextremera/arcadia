---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import { isMenuCategorySlug } from "@/lib/admin/catalog";
import {
  db,
  Category,
  Product,
  ProductVariant,
  ProductIngredient,
  Ingredient,
  CategoryIngredient,
  ProductModifierGroup,
  ModifierGroup,
  ModifierOption,
  ProductAllergen,
  Allergen,
  eq,
  inArray,
} from "astro:db";

type ModifierOptionRow = {
  id: number;
  groupId: number;
  name: string;
  priceDeltaCents: number;
  sortOrder: number;
  active: boolean;
};

type LinkedModifierGroup = {
  linkId: number;
  groupId: number;
  name: string;
  minSelect: number;
  maxSelect: number;
  required: boolean;
  active: boolean;
  groupSortOrder: number;
  productSortOrder: number;
  optionCount: number;
  options: ModifierOptionRow[];
};

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function formatDate(value: Date | string) {
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Europe/Madrid",
  }).format(date);
}

const id = Number(Astro.params.id);
if (!Number.isFinite(id)) {
  return new Response("Producto no encontrado", { status: 404 });
}

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") === "1";
const error = url.searchParams.get("error") ?? "";
const variantSaved = url.searchParams.get("variantSaved") === "1";
const variantError = url.searchParams.get("variantError") ?? "";
const ingredientSaved = url.searchParams.get("ingredientSaved") === "1";
const ingredientError = url.searchParams.get("ingredientError") ?? "";
const allergenSaved = url.searchParams.get("allergenSaved") === "1";
const allergenError = url.searchParams.get("allergenError") ?? "";
const modifierGroupSaved = url.searchParams.get("modifierGroupSaved") === "1";
const modifierGroupError = url.searchParams.get("modifierGroupError") ?? "";
const modifierOptionSaved = url.searchParams.get("modifierOptionSaved") === "1";
const modifierOptionError = url.searchParams.get("modifierOptionError") ?? "";

const [product] = await db
  .select({
    id: Product.id,
    categoryId: Product.categoryId,
    name: Product.name,
    slug: Product.slug,
    description: Product.description,
    details: Product.details,
    imageUrl: Product.imageUrl,
    priceCents: Product.priceCents,
    deliveryEnabled: Product.deliveryEnabled,
    dineInEnabled: Product.dineInEnabled,
    active: Product.active,
    createdAt: Product.createdAt,
    updatedAt: Product.updatedAt,
    categoryName: Category.name,
    categorySlug: Category.slug,
  })
  .from(Product)
  .innerJoin(Category, eq(Product.categoryId, Category.id))
  .where(eq(Product.id, id))
  .limit(1);

if (!product) {
  return new Response("Producto no encontrado", { status: 404 });
}

// Se excluye la categoría interna del menú del día para que no se pueda mover
// un producto de carta/delivery al menú desde este desplegable. Si el producto
// que se está editando ya pertenece a ella, se mantiene como opción.
const categories = (
  await db
    .select({
      id: Category.id,
      name: Category.name,
      slug: Category.slug,
      active: Category.active,
      sortOrder: Category.sortOrder,
    })
    .from(Category)
    .orderBy(Category.sortOrder)
).filter((category) => !isMenuCategorySlug(category.slug) || category.id === product.categoryId);

const variants = await db
  .select({
    id: ProductVariant.id,
    name: ProductVariant.name,
    priceDeltaCents: ProductVariant.priceDeltaCents,
    sortOrder: ProductVariant.sortOrder,
    active: ProductVariant.active,
  })
  .from(ProductVariant)
  .where(eq(ProductVariant.productId, id))
  .orderBy(ProductVariant.sortOrder, ProductVariant.name);

const ingredientRows = await db
  .select({
    id: ProductIngredient.id,
    ingredientId: ProductIngredient.ingredientId,
    defaultIncluded: ProductIngredient.defaultIncluded,
    removable: ProductIngredient.removable,
    sortOrder: ProductIngredient.sortOrder,
    name: Ingredient.name,
    slug: Ingredient.slug,
    addPriceDeltaCents: Ingredient.addPriceDeltaCents,
    active: Ingredient.active,
    isCommon: Ingredient.isCommon,
  })
  .from(ProductIngredient)
  .innerJoin(Ingredient, eq(ProductIngredient.ingredientId, Ingredient.id))
  .where(eq(ProductIngredient.productId, id))
  .orderBy(ProductIngredient.sortOrder, Ingredient.name);

const allIngredients = await db
  .select({
    id: Ingredient.id,
    name: Ingredient.name,
    slug: Ingredient.slug,
    addPriceDeltaCents: Ingredient.addPriceDeltaCents,
    isCommon: Ingredient.isCommon,
    active: Ingredient.active,
    sortOrder: Ingredient.sortOrder,
  })
  .from(Ingredient)
  .where(eq(Ingredient.active, true))
  .orderBy(Ingredient.sortOrder, Ingredient.name);

const categoryIngredientRows = await db
  .select({
    id: CategoryIngredient.id,
    ingredientId: CategoryIngredient.ingredientId,
  })
  .from(CategoryIngredient)
  .where(eq(CategoryIngredient.categoryId, product.categoryId));

const categoryCompatibleIngredientIds = new Set(
  categoryIngredientRows.map((row) => row.ingredientId),
);
const categoryCompatibilityEnabled = categoryIngredientRows.length > 0;

const linkedIngredientIds = new Set(ingredientRows.map((row) => row.ingredientId));
const availableIngredients = allIngredients.filter((ingredient) => {
  if (linkedIngredientIds.has(ingredient.id)) return false;
  if (!categoryCompatibilityEnabled) return true;
  return categoryCompatibleIngredientIds.has(ingredient.id);
});

const blockedAvailableIngredients = allIngredients.filter((ingredient) => {
  if (linkedIngredientIds.has(ingredient.id)) return false;
  if (!categoryCompatibilityEnabled) return false;
  return !categoryCompatibleIngredientIds.has(ingredient.id);
});

const incompatibleLinkedIngredients = ingredientRows.filter(
  (row) =>
    categoryCompatibilityEnabled &&
    !categoryCompatibleIngredientIds.has(row.ingredientId),
);

const productModifierGroupLinks = await db
  .select({
    id: ProductModifierGroup.id,
    groupId: ProductModifierGroup.groupId,
    sortOrder: ProductModifierGroup.sortOrder,
  })
  .from(ProductModifierGroup)
  .where(eq(ProductModifierGroup.productId, id))
  .orderBy(ProductModifierGroup.sortOrder, ProductModifierGroup.groupId);

const linkedGroupIds = productModifierGroupLinks.map((row) => row.groupId);

const allModifierGroups = await db
  .select({
    id: ModifierGroup.id,
    name: ModifierGroup.name,
    minSelect: ModifierGroup.minSelect,
    maxSelect: ModifierGroup.maxSelect,
    required: ModifierGroup.required,
    sortOrder: ModifierGroup.sortOrder,
    active: ModifierGroup.active,
  })
  .from(ModifierGroup)
  .orderBy(ModifierGroup.sortOrder, ModifierGroup.name);

const availableModifierGroups = allModifierGroups.filter(
  (group) => group.active && !linkedGroupIds.includes(group.id),
);

const optionRowsForAllGroups: ModifierOptionRow[] = allModifierGroups.length
  ? await db
      .select({
        id: ModifierOption.id,
        groupId: ModifierOption.groupId,
        name: ModifierOption.name,
        priceDeltaCents: ModifierOption.priceDeltaCents,
        sortOrder: ModifierOption.sortOrder,
        active: ModifierOption.active,
      })
      .from(ModifierOption)
      .where(
        inArray(
          ModifierOption.groupId,
          allModifierGroups.map((group) => group.id),
        ),
      )
      .orderBy(ModifierOption.sortOrder, ModifierOption.name)
  : [];

const optionCountByGroup = new Map<number, number>();
for (const option of optionRowsForAllGroups) {
  if (!option.active) continue;
  optionCountByGroup.set(
    option.groupId,
    (optionCountByGroup.get(option.groupId) ?? 0) + 1,
  );
}

const linkedModifierGroups: LinkedModifierGroup[] = [];
for (const link of productModifierGroupLinks) {
  const group = allModifierGroups.find((item) => item.id === link.groupId);
  if (!group) continue;

  linkedModifierGroups.push({
    linkId: link.id,
    groupId: group.id,
    name: group.name,
    minSelect: group.minSelect,
    maxSelect: group.maxSelect,
    required: group.required,
    active: group.active,
    groupSortOrder: group.sortOrder,
    productSortOrder: link.sortOrder,
    optionCount: optionCountByGroup.get(group.id) ?? 0,
    options: optionRowsForAllGroups
      .filter((option) => option.groupId === group.id)
      .sort((a, b) => a.sortOrder - b.sortOrder || a.name.localeCompare(b.name, "es")),
  });
}

linkedModifierGroups.sort((a, b) => a.productSortOrder - b.productSortOrder);

const allergenRows = await db
  .select({
    id: ProductAllergen.id,
    allergenId: ProductAllergen.allergenId,
    name: Allergen.name,
    slug: Allergen.slug,
    iconUrl: Allergen.iconUrl,
    sortOrder: Allergen.sortOrder,
    active: Allergen.active,
  })
  .from(ProductAllergen)
  .innerJoin(Allergen, eq(ProductAllergen.allergenId, Allergen.id))
  .where(eq(ProductAllergen.productId, id))
  .orderBy(Allergen.sortOrder, Allergen.name);

const allAllergens = await db
  .select({
    id: Allergen.id,
    name: Allergen.name,
    slug: Allergen.slug,
    iconUrl: Allergen.iconUrl,
    sortOrder: Allergen.sortOrder,
    active: Allergen.active,
  })
  .from(Allergen)
  .where(eq(Allergen.active, true))
  .orderBy(Allergen.sortOrder, Allergen.name);

const linkedAllergenIds = new Set(allergenRows.map((row) => row.allergenId));
const availableAllergens = allAllergens.filter(
  (allergen) => !linkedAllergenIds.has(allergen.id),
);

const variantCount = variants.filter((variant) => variant.active).length;
const modifierGroupCount = linkedModifierGroups.filter((group) => group.active).length;
const removableCount = ingredientRows.filter(
  (row) => row.defaultIncluded && row.removable,
).length;
const allergenCount = allergenRows.filter((row) => row.active).length;

const errorMessage =
  error === "missing-name"
    ? "El nombre es obligatorio."
    : error === "invalid-slug"
      ? "El slug no es válido."
      : error === "invalid-category"
        ? "La categoría seleccionada no es válida."
        : error === "invalid-price"
          ? "El precio no es válido."
          : error === "duplicate-slug"
            ? "Ya existe otro producto con ese slug."
            : error === "image-upload-disabled"
              ? "La subida de imágenes no está configurada todavía en el entorno."
              : error === "invalid-image"
                ? "La imagen no es válida. Solo se permiten JPG, PNG o WEBP."
                : error === "image-too-large"
                  ? "La imagen supera el tamaño máximo permitido."
                  : error === "image-upload-failed"
                    ? "No se ha podido subir la imagen del producto."
                    : "";

const variantErrorMessage =
  variantError === "missing-name"
    ? "El nombre de la variante es obligatorio."
    : variantError === "invalid-price"
      ? "El precio de la variante no es válido."
      : variantError === "invalid-variant"
        ? "La variante indicada no es válida."
        : variantError === "not-found"
          ? "La variante no existe o no pertenece a este producto."
          : variantError === "invalid-intent"
            ? "Acción de variante no válida."
            : "";

const ingredientErrorMessage =
  ingredientError === "invalid-ingredient"
    ? "El ingrediente seleccionado no es válido."
    : ingredientError === "duplicate-link"
      ? "Ese ingrediente ya está enlazado a este producto."
      : ingredientError === "invalid-link"
        ? "La relación de ingrediente no es válida."
        : ingredientError === "not-found"
          ? "La relación de ingrediente no existe."
          : ingredientError === "not-compatible"
            ? "Ese ingrediente no está permitido por la matriz de compatibilidad de la categoría actual."
            : ingredientError === "invalid-intent"
              ? "Acción de ingrediente no válida."
              : "";

const allergenErrorMessage =
  allergenError === "invalid-allergen"
    ? "El alérgeno seleccionado no es válido."
    : allergenError === "duplicate-link"
      ? "Ese alérgeno ya está enlazado a este producto."
      : allergenError === "invalid-link"
        ? "La relación de alérgeno no es válida."
        : allergenError === "not-found"
          ? "La relación de alérgeno no existe."
          : allergenError === "invalid-intent"
            ? "Acción de alérgeno no válida."
            : "";

const modifierGroupErrorMessage =
  modifierGroupError === "invalid-group"
    ? "El grupo seleccionado no es válido."
    : modifierGroupError === "duplicate-link"
      ? "Ese grupo ya está enlazado a este producto."
      : modifierGroupError === "invalid-link"
        ? "La relación de grupo no es válida."
        : modifierGroupError === "not-found"
          ? "La relación de grupo no existe."
          : modifierGroupError === "invalid-intent"
            ? "Acción de grupo no válida."
            : "";

const modifierOptionErrorMessage =
  modifierOptionError === "missing-name"
    ? "El nombre de la opción es obligatorio."
    : modifierOptionError === "invalid-price"
      ? "El precio de la opción no es válido."
      : modifierOptionError === "invalid-option"
        ? "La opción indicada no es válida."
        : modifierOptionError === "not-found"
          ? "La opción no existe o no pertenece al grupo."
          : modifierOptionError === "invalid-intent"
            ? "Acción de opción no válida."
            : "";


const inputClass =
  "w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/40 focus:outline-none";
const labelClass =
  "mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted";
const primaryBtnClass =
  "inline-flex min-h-10 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15";
const ghostBtnClass =
  "rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]";
const dangerBtnClass =
  "inline-flex min-h-9 items-center justify-center rounded-2xl border border-rose-400/20 bg-rose-400/10 px-4 py-2 text-sm font-semibold text-rose-300 transition hover:border-rose-400/30 hover:bg-rose-400/15";
const checkboxClass = "h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400";

const optionsRedirect = `/admin/catalogo/productos/${product.id}`;

const notices = [
  { ok: saved, okText: "Producto guardado correctamente.", error: errorMessage },
  { ok: variantSaved, okText: "Variantes actualizadas.", error: variantErrorMessage },
  { ok: ingredientSaved, okText: "Ingredientes actualizados.", error: ingredientErrorMessage },
  { ok: allergenSaved, okText: "Alérgenos actualizados.", error: allergenErrorMessage },
  { ok: modifierGroupSaved, okText: "Grupos de modificadores actualizados.", error: modifierGroupErrorMessage },
  { ok: modifierOptionSaved, okText: "Opciones actualizadas.", error: modifierOptionErrorMessage },
];

const successMessages = notices.filter((n) => n.ok).map((n) => n.okText);
const errorMessages = notices.map((n) => n.error).filter(Boolean);
---

<AdminLayout
  title={`${product.name} · Productos · Admin · Arcadia`}
  heading={product.name}
  description="Ficha completa: variantes, ingredientes, modificadores y alérgenos."
  back={{ href: "/admin/catalogo/productos", label: "Productos" }}
>
  <div class="space-y-6">
    {successMessages.map((message) => (
      <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">
        {message}
      </section>
    ))}
    {errorMessages.map((message) => (
      <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">
        {message}
      </section>
    ))}

    <div class="flex flex-wrap items-center gap-2.5">
      <Badge tone={product.active ? "success" : "danger"}>{product.active ? "Activo" : "Inactivo"}</Badge>
      <Badge tone="neutral">{product.categoryName}</Badge>
      <Badge tone={product.deliveryEnabled ? "cyan" : "neutral"}>Domicilio</Badge>
      <Badge tone={product.dineInEnabled ? "violet" : "neutral"}>Carta</Badge>
      <span class="text-xs text-admin-muted">Actualizado: {formatDate(product.updatedAt)}</span>
    </div>

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard label="Precio base" value={money(product.priceCents)} helper="Sin variantes aplicadas" />
      <StatCard label="Configurable" value={`${variantCount} / ${modifierGroupCount}`} helper="Variantes activas / grupos activos" />
    </section>

    {/* ---------------- Datos principales ---------------- */}
    <Card>
      <div class="admin-eyebrow">Producto</div>
      <h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-white">Datos principales</h2>

      <form
        method="post"
        action={`/api/admin/products/${product.id}`}
        enctype="multipart/form-data"
        class="mt-5 grid gap-4"
      >
        <input type="hidden" name="intent" value="save-base" />

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class={labelClass}>Nombre</span>
            <input class={inputClass} type="text" name="name" value={product.name} required />
          </label>
          <label class="block">
            <span class={labelClass}>Slug</span>
            <input class={inputClass} type="text" name="slug" value={product.slug} required />
          </label>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class={labelClass}>Categoría</span>
            <select class={inputClass} name="categoryId">
              {categories.map((category) => (
                <option value={category.id} selected={category.id === product.categoryId}>
                  {category.name}{category.active ? "" : " (inactiva)"}
                </option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class={labelClass}>Precio (€)</span>
            <input
              class={inputClass}
              type="number"
              name="priceEur"
              min="0"
              step="0.01"
              value={(product.priceCents / 100).toFixed(2)}
              required
            />
          </label>
        </div>

        <label class="block">
          <span class={labelClass}>Descripción</span>
          <textarea class={`${inputClass} min-h-20`} name="description">{product.description ?? ""}</textarea>
        </label>

        <label class="block">
          <span class={labelClass}>Detalles</span>
          <textarea class={`${inputClass} min-h-20`} name="details">{product.details ?? ""}</textarea>
        </label>

        <div class="grid gap-4 sm:grid-cols-[auto_minmax(0,1fr)] sm:items-start">
          <div class="h-24 w-24 shrink-0 overflow-hidden rounded-admin-lg border border-admin-border bg-white/[0.03]">
            {product.imageUrl ? (
              <img src={product.imageUrl} alt={product.name} class="h-full w-full object-cover" />
            ) : (
              <div class="grid h-full w-full place-items-center text-[10px] font-semibold text-admin-faint">
                Sin imagen
              </div>
            )}
          </div>

          <div class="grid gap-2">
            <label class="block">
              <span class={labelClass}>Reemplazar imagen</span>
              <input
                class={`${inputClass} file:mr-3 file:rounded-xl file:border-0 file:bg-sky-500 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-slate-950 hover:file:bg-sky-400`}
                type="file"
                name="imageFile"
                accept="image/jpeg,image/png,image/webp"
              />
            </label>
            {product.imageUrl ? (
              <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                <input class={checkboxClass} type="checkbox" name="removeImage" />
                Quitar la imagen actual
              </label>
            ) : null}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          <label class="flex items-center gap-2 rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-slate-300">
            <input class={checkboxClass} type="checkbox" name="active" checked={product.active} />
            Activo
          </label>
          <label class="flex items-center gap-2 rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-slate-300">
            <input class={checkboxClass} type="checkbox" name="dineInEnabled" checked={product.dineInEnabled} />
            Carta
          </label>
          <label class="flex items-center gap-2 rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-slate-300">
            <input class={checkboxClass} type="checkbox" name="deliveryEnabled" checked={product.deliveryEnabled} />
            Domicilio
          </label>
        </div>

        <button type="submit" class={`${primaryBtnClass} mt-1 justify-self-start`}>Guardar producto</button>
      </form>
    </Card>

    {/* ---------------- Ingredientes ---------------- */}
    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <div>
          <h2 class="text-base font-semibold text-white">Ingredientes base</h2>
          <p class="mt-1 text-xs text-admin-muted">
            Los marcados como removibles se pueden quitar desde el configurador público.
          </p>
        </div>

        <Modal
          id="ingredient-link"
          title="Añadir ingrediente"
          description="Solo se ofrecen los permitidos por la matriz de compatibilidad de la familia."
          triggerLabel="+ Añadir ingrediente"
        >
          <form method="post" action={`/api/admin/products/${product.id}/ingredients`} class="grid gap-4">
            <input type="hidden" name="intent" value="create" />

            <label class="block">
              <span class={labelClass}>Ingrediente</span>
              <select class={inputClass} name="ingredientId" required>
                {availableIngredients.map((ingredient) => (
                  <option value={ingredient.id}>
                    {ingredient.name}
                    {ingredient.addPriceDeltaCents > 0 ? ` · +${money(ingredient.addPriceDeltaCents)}` : ""}
                  </option>
                ))}
              </select>
            </label>

            <label class="block">
              <span class={labelClass}>Orden</span>
              <input class={inputClass} type="number" name="sortOrder" min="0" step="1" value={ingredientRows.length} />
            </label>

            <div class="flex flex-wrap gap-6">
              <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                <input class={checkboxClass} type="checkbox" name="defaultIncluded" checked />
                Incluido por defecto
              </label>
              <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                <input class={checkboxClass} type="checkbox" name="removable" checked />
                Se puede quitar
              </label>
            </div>

            <button
              type="submit"
              disabled={availableIngredients.length === 0}
              class:list={[
                "mt-1 inline-flex min-h-11 items-center justify-center rounded-2xl px-4 py-3 text-sm font-semibold transition",
                availableIngredients.length > 0
                  ? "border border-sky-400/20 bg-sky-400/10 text-sky-100 hover:border-sky-400/30 hover:bg-sky-400/15"
                  : "cursor-not-allowed border border-admin-border bg-white/[0.03] text-slate-500",
              ]}
            >
              {availableIngredients.length > 0 ? "Añadir ingrediente" : "No hay ingredientes compatibles"}
            </button>
          </form>
        </Modal>
      </div>

      {
        incompatibleLinkedIngredients.length > 0 ? (
          <div class="border-b border-admin-border bg-amber-400/[0.06] px-5 py-3 text-xs text-amber-100 lg:px-6">
            {incompatibleLinkedIngredients.length} ingrediente(s) enlazados ya no cumplen la compatibilidad de la
            familia actual. Siguen aplicándose, pero conviene revisarlos.
          </div>
        ) : null
      }

      {
        ingredientRows.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="Sin ingredientes enlazados" description="Añade el primero con el botón de arriba." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Ingrediente</th>
                  <th>Extra</th>
                  <th>Por defecto</th>
                  <th>Removible</th>
                  <th>Orden</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {ingredientRows.map((row) => {
                  const compatible =
                    !categoryCompatibilityEnabled || categoryCompatibleIngredientIds.has(row.ingredientId);

                  return (
                    <tr>
                      <td>
                        <div class="font-semibold text-white">{row.name}</div>
                        <div class="text-xs text-admin-muted">
                          {row.slug}
                          {compatible ? "" : " · fuera de compatibilidad"}
                        </div>
                      </td>
                      <td class="text-admin-muted">
                        {row.addPriceDeltaCents > 0 ? `+${money(row.addPriceDeltaCents)}` : "—"}
                      </td>
                      <td>{row.defaultIncluded ? <Badge tone="success">Sí</Badge> : <span class="text-admin-muted">No</span>}</td>
                      <td>{row.removable ? <Badge tone="cyan">Sí</Badge> : <span class="text-admin-muted">No</span>}</td>
                      <td class="text-admin-muted">{row.sortOrder}</td>
                      <td>
                        <div class="flex justify-end">
                          <Modal
                            id={`ingredient-edit-${row.id}`}
                            title={row.name}
                            triggerLabel="Editar"
                            triggerClass={ghostBtnClass}
                          >
                            <form method="post" action={`/api/admin/products/${product.id}/ingredients`} class="grid gap-4">
                              <input type="hidden" name="intent" value="update" />
                              <input type="hidden" name="productIngredientId" value={row.id} />

                              <label class="block">
                                <span class={labelClass}>Orden</span>
                                <input class={inputClass} type="number" name="sortOrder" min="0" step="1" value={row.sortOrder} />
                              </label>

                              <div class="flex flex-wrap gap-6">
                                <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                                  <input class={checkboxClass} type="checkbox" name="defaultIncluded" checked={row.defaultIncluded} />
                                  Incluido por defecto
                                </label>
                                <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                                  <input class={checkboxClass} type="checkbox" name="removable" checked={row.removable} />
                                  Se puede quitar
                                </label>
                              </div>

                              <button type="submit" class={primaryBtnClass}>Guardar</button>
                            </form>

                            <form
                              method="post"
                              action={`/api/admin/products/${product.id}/ingredients`}
                              class="mt-3 border-t border-admin-border pt-3"
                            >
                              <input type="hidden" name="intent" value="delete" />
                              <input type="hidden" name="productIngredientId" value={row.id} />
                              <button type="submit" class={dangerBtnClass}>Quitar del producto</button>
                            </form>
                          </Modal>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>

    {/* ---------------- Variantes ---------------- */}
    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <div>
          <h2 class="text-base font-semibold text-white">Variantes</h2>
          <p class="mt-1 text-xs text-admin-muted">El precio de la variante se suma al precio base.</p>
        </div>

        <Modal id="variant-create" title="Nueva variante" description="Nombre, diferencia de precio y orden." triggerLabel="+ Nueva variante">
          <form method="post" action={`/api/admin/products/${product.id}/variants`} class="grid gap-4">
            <input type="hidden" name="intent" value="create" />

            <label class="block">
              <span class={labelClass}>Nombre</span>
              <input class={inputClass} type="text" name="name" placeholder="Ej. Familiar" required />
            </label>

            <div class="grid grid-cols-2 gap-4">
              <label class="block">
                <span class={labelClass}>Δ Precio (€)</span>
                <input class={inputClass} type="number" name="priceDeltaEur" step="0.01" value="0.00" />
              </label>
              <label class="block">
                <span class={labelClass}>Orden</span>
                <input class={inputClass} type="number" name="sortOrder" min="0" step="1" value={variants.length} />
              </label>
            </div>

            <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
              <input class={checkboxClass} type="checkbox" name="active" checked />
              Activa
            </label>

            <button type="submit" class={`${primaryBtnClass} mt-1`}>Crear variante</button>
          </form>
        </Modal>
      </div>

      {
        variants.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="Sin variantes" description="El producto se vende solo con su precio base." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Variante</th>
                  <th>Δ Precio</th>
                  <th>Precio final</th>
                  <th>Orden</th>
                  <th>Estado</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {variants.map((variant) => (
                  <tr>
                    <td class="font-semibold text-white">{variant.name}</td>
                    <td class="text-admin-muted">
                      {variant.priceDeltaCents === 0
                        ? "—"
                        : `${variant.priceDeltaCents > 0 ? "+" : "−"}${money(Math.abs(variant.priceDeltaCents))}`}
                    </td>
                    <td class="text-admin-muted">{money(product.priceCents + variant.priceDeltaCents)}</td>
                    <td class="text-admin-muted">{variant.sortOrder}</td>
                    <td><Badge tone={variant.active ? "success" : "neutral"}>{variant.active ? "Activa" : "Inactiva"}</Badge></td>
                    <td>
                      <div class="flex justify-end">
                        <Modal id={`variant-edit-${variant.id}`} title={variant.name} triggerLabel="Editar" triggerClass={ghostBtnClass}>
                          <form method="post" action={`/api/admin/products/${product.id}/variants`} class="grid gap-4">
                            <input type="hidden" name="intent" value="update" />
                            <input type="hidden" name="variantId" value={variant.id} />

                            <label class="block">
                              <span class={labelClass}>Nombre</span>
                              <input class={inputClass} type="text" name="name" value={variant.name} required />
                            </label>

                            <div class="grid grid-cols-2 gap-4">
                              <label class="block">
                                <span class={labelClass}>Δ Precio (€)</span>
                                <input class={inputClass} type="number" name="priceDeltaEur" step="0.01" value={(variant.priceDeltaCents / 100).toFixed(2)} />
                              </label>
                              <label class="block">
                                <span class={labelClass}>Orden</span>
                                <input class={inputClass} type="number" name="sortOrder" min="0" step="1" value={variant.sortOrder} />
                              </label>
                            </div>

                            <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                              <input class={checkboxClass} type="checkbox" name="active" checked={variant.active} />
                              Activa
                            </label>

                            <button type="submit" class={primaryBtnClass}>Guardar</button>
                          </form>

                          <form
                            method="post"
                            action={`/api/admin/products/${product.id}/variants`}
                            class="mt-3 border-t border-admin-border pt-3"
                          >
                            <input type="hidden" name="intent" value="delete" />
                            <input type="hidden" name="variantId" value={variant.id} />
                            <button type="submit" class={dangerBtnClass}>Borrar variante</button>
                          </form>
                        </Modal>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>

    {/* ---------------- Modifier groups ---------------- */}
    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <div>
          <h2 class="text-base font-semibold text-white">Grupos de modificadores</h2>
          <p class="mt-1 text-xs text-admin-muted">
            Los grupos son globales; aquí se decide cuáles aplican a este producto y en qué orden.
          </p>
        </div>

        <Modal id="group-link" title="Vincular grupo" description="Solo se listan grupos activos que aún no están enlazados." triggerLabel="+ Vincular grupo">
          <form method="post" action={`/api/admin/products/${product.id}/modifier-groups`} class="grid gap-4">
            <input type="hidden" name="intent" value="create" />

            <label class="block">
              <span class={labelClass}>Grupo</span>
              <select class={inputClass} name="groupId" required>
                {availableModifierGroups.map((group) => (
                  <option value={group.id}>
                    {group.name} · {group.minSelect}–{group.maxSelect}
                  </option>
                ))}
              </select>
            </label>

            <label class="block">
              <span class={labelClass}>Orden</span>
              <input class={inputClass} type="number" name="sortOrder" min="0" step="1" value={linkedModifierGroups.length} />
            </label>

            <button
              type="submit"
              disabled={availableModifierGroups.length === 0}
              class:list={[
                "mt-1 inline-flex min-h-11 items-center justify-center rounded-2xl px-4 py-3 text-sm font-semibold transition",
                availableModifierGroups.length > 0
                  ? "border border-sky-400/20 bg-sky-400/10 text-sky-100 hover:border-sky-400/30 hover:bg-sky-400/15"
                  : "cursor-not-allowed border border-admin-border bg-white/[0.03] text-slate-500",
              ]}
            >
              {availableModifierGroups.length > 0 ? "Vincular grupo" : "No hay grupos disponibles"}
            </button>
          </form>
        </Modal>
      </div>

      {
        linkedModifierGroups.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="Sin grupos vinculados" description="Vincula uno para ofrecer opciones configurables." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Grupo</th>
                  <th>Selección</th>
                  <th>Opciones</th>
                  <th>Orden</th>
                  <th>Estado</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {linkedModifierGroups.map((group) => (
                  <tr>
                    <td>
                      <div class="font-semibold text-white">{group.name}</div>
                      {group.required ? <div class="text-xs text-amber-300">Obligatorio</div> : null}
                    </td>
                    <td class="text-admin-muted">{group.minSelect}–{group.maxSelect}</td>
                    <td class="text-admin-muted">{group.optionCount}</td>
                    <td class="text-admin-muted">{group.productSortOrder}</td>
                    <td><Badge tone={group.active ? "success" : "danger"}>{group.active ? "Activo" : "Inactivo"}</Badge></td>
                    <td>
                      <div class="flex items-center justify-end gap-2">
                        <Modal
                          id={`group-options-${group.linkId}`}
                          title={`Opciones · ${group.name}`}
                          description="Estas opciones son del grupo global: afectan a todos los productos que lo usen."
                          triggerLabel="Opciones"
                          triggerClass={ghostBtnClass}
                          size="lg"
                        >
                          <form method="post" action={`/api/admin/modifier-groups/${group.groupId}/options`} class="grid gap-4">
                            <input type="hidden" name="intent" value="create" />
                            <input type="hidden" name="redirectTo" value={optionsRedirect} />

                            <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_140px_120px]">
                              <label class="block">
                                <span class={labelClass}>Nombre</span>
                                <input class={inputClass} type="text" name="name" placeholder="Ej. Extra queso" required />
                              </label>
                              <label class="block">
                                <span class={labelClass}>Δ Precio (€)</span>
                                <input class={inputClass} type="number" name="priceDeltaEur" step="0.01" value="0.00" />
                              </label>
                              <label class="block">
                                <span class={labelClass}>Orden</span>
                                <input class={inputClass} type="number" name="sortOrder" min="0" step="1" value={group.options.length} />
                              </label>
                            </div>

                            <button type="submit" class={`${primaryBtnClass} justify-self-start`}>Añadir opción</button>
                          </form>

                          <div class="mt-4 border-t border-admin-border pt-4">
                            {group.options.length === 0 ? (
                              <p class="text-sm text-admin-muted">Este grupo todavía no tiene opciones.</p>
                            ) : (
                              <div class="space-y-2">
                                {group.options.map((option) => (
                                  <form
                                    method="post"
                                    action={`/api/admin/modifier-groups/${group.groupId}/options`}
                                    class="grid gap-2 rounded-admin-lg border border-admin-border bg-white/[0.02] p-3 sm:grid-cols-[minmax(0,1fr)_120px_100px_auto] sm:items-end"
                                  >
                                    {/* Sin `intent` oculto: cada botón envía el suyo, así
                                        guardar y borrar caben en la misma fila. */}
                                    <input type="hidden" name="optionId" value={option.id} />
                                    <input type="hidden" name="redirectTo" value={optionsRedirect} />

                                    <label class="block">
                                      <span class={labelClass}>Nombre</span>
                                      <input class={inputClass} type="text" name="name" value={option.name} required />
                                    </label>
                                    <label class="block">
                                      <span class={labelClass}>Δ €</span>
                                      <input class={inputClass} type="number" name="priceDeltaEur" step="0.01" value={(option.priceDeltaCents / 100).toFixed(2)} />
                                    </label>
                                    <label class="block">
                                      <span class={labelClass}>Orden</span>
                                      <input class={inputClass} type="number" name="sortOrder" min="0" step="1" value={option.sortOrder} />
                                    </label>

                                    <div class="flex items-center gap-2">
                                      <label class="inline-flex items-center gap-2 text-xs text-slate-300">
                                        <input class={checkboxClass} type="checkbox" name="active" checked={option.active} />
                                        Activa
                                      </label>
                                      <button type="submit" name="intent" value="update" class={ghostBtnClass}>
                                        Guardar
                                      </button>
                                      <button
                                        type="submit"
                                        name="intent"
                                        value="delete"
                                        title={`Borrar ${option.name}`}
                                        class="rounded-xl border border-admin-border bg-white/[0.03] px-2.5 py-1.5 text-xs font-semibold text-rose-300/80 transition hover:border-rose-400/30 hover:bg-rose-400/10 hover:text-rose-300"
                                      >
                                        ✕
                                      </button>
                                    </div>
                                  </form>
                                ))}
                              </div>
                            )}
                          </div>
                        </Modal>

                        <Modal id={`group-edit-${group.linkId}`} title={group.name} triggerLabel="Editar" triggerClass={ghostBtnClass}>
                          <form method="post" action={`/api/admin/products/${product.id}/modifier-groups`} class="grid gap-4">
                            <input type="hidden" name="intent" value="update" />
                            <input type="hidden" name="productModifierGroupId" value={group.linkId} />

                            <label class="block">
                              <span class={labelClass}>Orden en este producto</span>
                              <input class={inputClass} type="number" name="sortOrder" min="0" step="1" value={group.productSortOrder} />
                            </label>

                            <button type="submit" class={primaryBtnClass}>Guardar</button>
                          </form>

                          <form
                            method="post"
                            action={`/api/admin/products/${product.id}/modifier-groups`}
                            class="mt-3 border-t border-admin-border pt-3"
                          >
                            <input type="hidden" name="intent" value="delete" />
                            <input type="hidden" name="productModifierGroupId" value={group.linkId} />
                            <button type="submit" class={dangerBtnClass}>Desvincular grupo</button>
                          </form>
                        </Modal>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>

    {/* ---------------- Alérgenos ---------------- */}
    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <div>
          <h2 class="text-base font-semibold text-white">Alérgenos</h2>
          <p class="mt-1 text-xs text-admin-muted">Se muestran en la carta pública y en la ficha del producto.</p>
        </div>

        <Modal id="allergen-link" title="Añadir alérgeno" triggerLabel="+ Añadir alérgeno">
          <form method="post" action={`/api/admin/products/${product.id}/allergens`} class="grid gap-4">
            <input type="hidden" name="intent" value="create" />

            <label class="block">
              <span class={labelClass}>Alérgeno</span>
              <select class={inputClass} name="allergenId" required>
                {availableAllergens.map((allergen) => (
                  <option value={allergen.id}>{allergen.name}</option>
                ))}
              </select>
            </label>

            <button
              type="submit"
              disabled={availableAllergens.length === 0}
              class:list={[
                "mt-1 inline-flex min-h-11 items-center justify-center rounded-2xl px-4 py-3 text-sm font-semibold transition",
                availableAllergens.length > 0
                  ? "border border-sky-400/20 bg-sky-400/10 text-sky-100 hover:border-sky-400/30 hover:bg-sky-400/15"
                  : "cursor-not-allowed border border-admin-border bg-white/[0.03] text-slate-500",
              ]}
            >
              {availableAllergens.length > 0 ? "Añadir alérgeno" : "Ya están todos añadidos"}
            </button>
          </form>
        </Modal>
      </div>

      <div class="px-5 py-4 lg:px-6">
        {
          allergenRows.length === 0 ? (
            <EmptyState title="Sin alérgenos declarados" />
          ) : (
            <div class="flex flex-wrap gap-2">
              {allergenRows.map((row) => (
                <form method="post" action={`/api/admin/products/${product.id}/allergens`}>
                  <input type="hidden" name="intent" value="delete" />
                  <input type="hidden" name="productAllergenId" value={row.id} />
                  <button
                    type="submit"
                    title={`Quitar ${row.name}`}
                    class="group inline-flex items-center gap-2 rounded-full border border-admin-border bg-white/[0.03] py-1.5 pl-2 pr-3 text-sm text-slate-200 transition hover:border-rose-400/30 hover:bg-rose-400/10 hover:text-rose-200"
                  >
                    {row.iconUrl ? (
                      <img src={row.iconUrl} alt="" class="h-5 w-5 object-contain" loading="lazy" />
                    ) : null}
                    {row.name}
                    <span class="text-admin-faint transition group-hover:text-rose-300">✕</span>
                  </button>
                </form>
              ))}
            </div>
          )
        }
      </div>
    </Card>
  </div>
</AdminLayout>
