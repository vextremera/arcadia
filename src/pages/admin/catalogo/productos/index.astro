---
import AdminLayout from "@/layouts/AdminLayout.astro";
import {
  db,
  Category,
  Product,
  ProductVariant,
  ProductModifierGroup,
  ProductIngredient,
  ProductAllergen,
  Allergen,
  eq,
  inArray,
} from "astro:db";

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

type QuickLink = {
  href: string;
  eyebrow: string;
  title: string;
  description: string;
  tone: "sky" | "cyan" | "violet" | "indigo";
};

const quickLinks: QuickLink[] = [
  {
    href: "/admin/catalogo/productos/nuevo",
    eyebrow: "Alta",
    title: "Nuevo producto",
    description:
      "Crear una ficha nueva y empezar a trabajar variantes, ingredientes y grupos.",
    tone: "sky",
  },
  {
    href: "/admin/catalogo/ingredientes",
    eyebrow: "Base global",
    title: "Ingredientes",
    description:
      "Gestionar ingredientes reutilizables, precio extra, orden y estado.",
    tone: "cyan",
  },
  {
    href: "/admin/catalogo/modificadores",
    eyebrow: "Configuración",
    title: "Modificadores",
    description:
      "Definir grupos y opciones globales antes de enlazarlos a productos.",
    tone: "violet",
  },
  {
    href: "/admin/categorias",
    eyebrow: "Estructura",
    title: "Categorías",
    description: "Ordenar y mantener la estructura base real del catálogo.",
    tone: "indigo",
  },
];

function quickLinkClasses(tone: QuickLink["tone"]) {
  if (tone === "sky") {
    return {
      card: "border-sky-400/20 bg-sky-400/10 hover:border-sky-400/30 hover:bg-sky-400/15",
      eyebrow: "text-sky-200/80",
      title: "text-white",
      text: "text-sky-100/75",
    };
  }

  if (tone === "cyan") {
    return {
      card: "border-cyan-400/20 bg-cyan-400/10 hover:border-cyan-400/30 hover:bg-cyan-400/15",
      eyebrow: "text-cyan-200/80",
      title: "text-white",
      text: "text-cyan-100/75",
    };
  }

  if (tone === "violet") {
    return {
      card: "border-violet-400/20 bg-violet-400/10 hover:border-violet-400/30 hover:bg-violet-400/15",
      eyebrow: "text-violet-200/80",
      title: "text-white",
      text: "text-violet-100/75",
    };
  }

  return {
    card: "border-indigo-400/20 bg-indigo-400/10 hover:border-indigo-400/30 hover:bg-indigo-400/15",
    eyebrow: "text-indigo-200/80",
    title: "text-white",
    text: "text-indigo-100/75",
  };
}

const url = new URL(Astro.request.url);
const q = (url.searchParams.get("q") ?? "").trim().toLowerCase();
const categoryFilter = url.searchParams.get("category") ?? "";
const statusFilter = url.searchParams.get("status") ?? "";
const channelFilter = url.searchParams.get("channel") ?? "";
const saved = url.searchParams.get("saved") === "1";
const error = url.searchParams.get("error") ?? "";

const categories = await db
  .select({
    id: Category.id,
    name: Category.name,
    slug: Category.slug,
    sortOrder: Category.sortOrder,
    active: Category.active,
    imageUrl: Category.imageUrl,
  })
  .from(Category)
  .orderBy(Category.sortOrder);

const rows = await db
  .select({
    id: Product.id,
    categoryId: Product.categoryId,
    name: Product.name,
    slug: Product.slug,
    description: Product.description,
    details: Product.details,
    imageUrl: Product.imageUrl,
    priceCents: Product.priceCents,
    deliveryEnabled: Product.deliveryEnabled,
    pickupEnabled: Product.pickupEnabled,
    dineInEnabled: Product.dineInEnabled,
    active: Product.active,
    updatedAt: Product.updatedAt,
    categoryName: Category.name,
    categorySlug: Category.slug,
  })
  .from(Product)
  .innerJoin(Category, eq(Product.categoryId, Category.id))
  .orderBy(Product.id);

const productsSorted = [...rows].sort((a, b) => {
  if (a.categoryName !== b.categoryName) {
    return a.categoryName.localeCompare(b.categoryName, "es");
  }
  return a.name.localeCompare(b.name, "es");
});

const productIds = productsSorted.map((row) => row.id);

const variantRows = productIds.length
  ? await db
      .select({
        productId: ProductVariant.productId,
        id: ProductVariant.id,
        active: ProductVariant.active,
      })
      .from(ProductVariant)
      .where(inArray(ProductVariant.productId, productIds))
  : [];

const modifierGroupRows = productIds.length
  ? await db
      .select({
        productId: ProductModifierGroup.productId,
        id: ProductModifierGroup.id,
      })
      .from(ProductModifierGroup)
      .where(inArray(ProductModifierGroup.productId, productIds))
  : [];

const removableIngredientRows = productIds.length
  ? await db
      .select({
        productId: ProductIngredient.productId,
        id: ProductIngredient.id,
        defaultIncluded: ProductIngredient.defaultIncluded,
        removable: ProductIngredient.removable,
      })
      .from(ProductIngredient)
      .where(inArray(ProductIngredient.productId, productIds))
  : [];

const allergenRows = productIds.length
  ? await db
      .select({
        productId: ProductAllergen.productId,
        relationId: ProductAllergen.id,
        allergenId: Allergen.id,
        allergenName: Allergen.name,
        allergenSlug: Allergen.slug,
        allergenIconUrl: Allergen.iconUrl,
        allergenSortOrder: Allergen.sortOrder,
      })
      .from(ProductAllergen)
      .innerJoin(Allergen, eq(ProductAllergen.allergenId, Allergen.id))
      .where(inArray(ProductAllergen.productId, productIds))
      .orderBy(ProductAllergen.productId, Allergen.sortOrder, Allergen.name)
  : [];

const activeVariantCountByProduct = new Map<number, number>();
for (const row of variantRows) {
  if (!row.active) continue;
  activeVariantCountByProduct.set(
    row.productId,
    (activeVariantCountByProduct.get(row.productId) ?? 0) + 1,
  );
}

const modifierGroupCountByProduct = new Map<number, number>();
for (const row of modifierGroupRows) {
  modifierGroupCountByProduct.set(
    row.productId,
    (modifierGroupCountByProduct.get(row.productId) ?? 0) + 1,
  );
}

const removableCountByProduct = new Map<number, number>();
for (const row of removableIngredientRows) {
  if (!row.defaultIncluded || !row.removable) continue;
  removableCountByProduct.set(
    row.productId,
    (removableCountByProduct.get(row.productId) ?? 0) + 1,
  );
}

const allergenPreviewByProduct = new Map<
  number,
  Array<{
    id: number;
    name: string;
    slug: string;
    iconUrl: string | null;
  }>
>();

for (const row of allergenRows) {
  if (!allergenPreviewByProduct.has(row.productId)) {
    allergenPreviewByProduct.set(row.productId, []);
  }

  allergenPreviewByProduct.get(row.productId)?.push({
    id: row.allergenId,
    name: row.allergenName,
    slug: row.allergenSlug,
    iconUrl: row.allergenIconUrl
      ? String(row.allergenIconUrl).trim() || null
      : null,
  });
}

const products = productsSorted.map((row) => {
  const variantCount = activeVariantCountByProduct.get(row.id) ?? 0;
  const modifierGroupCount = modifierGroupCountByProduct.get(row.id) ?? 0;
  const removableCount = removableCountByProduct.get(row.id) ?? 0;
  const allergenPreview = (allergenPreviewByProduct.get(row.id) ?? []).slice(
    0,
    4,
  );

  return {
    ...row,
    variantCount,
    modifierGroupCount,
    removableCount,
    allergenPreview,
    isConfigurable:
      variantCount > 0 || modifierGroupCount > 0 || removableCount > 0,
  };
});

const filteredProducts = products.filter((product) => {
  if (categoryFilter && String(product.categoryId) !== categoryFilter)
    return false;

  if (statusFilter === "active" && !product.active) return false;
  if (statusFilter === "inactive" && product.active) return false;
  if (statusFilter === "configurable" && !product.isConfigurable) return false;

  if (channelFilter === "delivery" && !product.deliveryEnabled) return false;
  if (channelFilter === "pickup" && !product.pickupEnabled) return false;
  if (
    channelFilter === "both" &&
    (!product.deliveryEnabled || !product.pickupEnabled)
  )
    return false;
  if (
    channelFilter === "restricted" &&
    product.deliveryEnabled &&
    product.pickupEnabled
  )
    return false;

  if (q) {
    const haystack = [
      product.name,
      product.slug,
      product.categoryName,
      product.description ?? "",
      product.details ?? "",
    ]
      .join(" ")
      .toLowerCase();

    if (!haystack.includes(q)) return false;
  }

  return true;
});

const totalProducts = products.length;
const activeProducts = products.filter((product) => product.active).length;
const configurableProducts = products.filter(
  (product) => product.isConfigurable,
).length;
const imageProducts = products.filter((product) =>
  Boolean(product.imageUrl),
).length;

const statusMessage =
  error === "invalid-id"
    ? "ID de producto inválido."
    : error === "not-found"
      ? "El producto ya no existe."
      : "";
---

<AdminLayout
  title="Productos · Admin · Arcadia"
  heading="Productos"
  description="Listado real del catálogo con activación rápida, alta de producto y acceso a la ficha editable."
  actions={true}
>
  <Fragment slot="actions">
    <div class="flex flex-wrap gap-3">
      <a
        href="/admin/catalogo/productos/nuevo"
        class="inline-flex items-center justify-center rounded-2xl bg-sky-500 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-400"
      >
        Nuevo producto
      </a>

      <a
        href="/admin/catalogo/ingredientes"
        class="inline-flex items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 px-4 py-3 text-sm font-semibold text-cyan-300 transition hover:border-cyan-400/30 hover:bg-cyan-400/15"
      >
        Ingredientes
      </a>

      <a
        href="/admin/catalogo/modificadores"
        class="inline-flex items-center justify-center rounded-2xl border border-violet-400/20 bg-violet-400/10 px-4 py-3 text-sm font-semibold text-violet-300 transition hover:border-violet-400/30 hover:bg-violet-400/15"
      >
        Modificadores
      </a>

      <a
        href="/admin/categorias"
        class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/10 hover:text-white"
      >
        Categorías
      </a>

      <a
        href="/admin/upsell"
        class="inline-flex items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-300 transition hover:border-sky-400/30 hover:bg-sky-400/15"
      >
        Ver upsell
      </a>
    </div>
  </Fragment>

  {
    saved ? (
      <section class="mb-6 rounded-3xl border border-emerald-400/20 bg-emerald-400/10 px-5 py-4 text-sm text-emerald-200">
        Producto actualizado correctamente.
      </section>
    ) : null
  }

  {
    statusMessage ? (
      <section class="mb-6 rounded-3xl border border-rose-400/20 bg-rose-400/10 px-5 py-4 text-sm text-rose-200">
        {statusMessage}
      </section>
    ) : null
  }

  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <article
      class="rounded-[28px] border border-white/10 bg-white/4 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
      >
        Total productos
      </div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">
        {totalProducts}
      </div>
      <p class="mt-2 text-sm text-slate-400">
        Todos los productos del catálogo
      </p>
    </article>

    <article
      class="rounded-[28px] border border-emerald-400/15 bg-emerald-400/6 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-emerald-200/80"
      >
        Activos
      </div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">
        {activeProducts}
      </div>
      <p class="mt-2 text-sm text-emerald-100/70">
        Disponibles para la app pública
      </p>
    </article>

    <article
      class="rounded-[28px] border border-violet-400/15 bg-violet-400/6 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-violet-200/80"
      >
        Configurables
      </div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">
        {configurableProducts}
      </div>
      <p class="mt-2 text-sm text-violet-100/70">
        Con variantes, grupos o ingredientes removibles
      </p>
    </article>

    <article
      class="rounded-[28px] border border-cyan-400/15 bg-cyan-400/6 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-cyan-200/80"
      >
        Con imagen
      </div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">
        {imageProducts}
      </div>
      <p class="mt-2 text-sm text-cyan-100/70">
        Productos con `imageUrl` informada
      </p>
    </article>
  </section>

  <section
    class="mt-6 rounded-[30px] border border-white/10 bg-[#111827]/80 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]"
  >
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <div
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-sky-300/80"
        >
          Accesos rápidos
        </div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
          Flujo completo de catálogo
        </h2>
      </div>

      <div
        class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300"
      >
        Productos, base global y estructura
      </div>
    </div>

    <div class="mt-6 grid gap-4 xl:grid-cols-4">
      {
        quickLinks.map((link) => {
          const styles = quickLinkClasses(link.tone);

          return (
            <a
              href={link.href}
              class:list={["rounded-[28px] border p-5 transition", styles.card]}
            >
              <div
                class:list={[
                  "text-[11px] font-semibold uppercase tracking-[0.22em]",
                  styles.eyebrow,
                ]}
              >
                {link.eyebrow}
              </div>
              <div
                class:list={[
                  "mt-3 text-lg font-semibold tracking-tight",
                  styles.title,
                ]}
              >
                {link.title}
              </div>
              <p class:list={["mt-2 text-sm leading-6", styles.text]}>
                {link.description}
              </p>
            </a>
          );
        })
      }
    </div>
  </section>

  <section
    class="mt-6 rounded-[30px] border border-white/10 bg-[#111827]/80 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]"
  >
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-sky-300/80"
        >
          Filtros
        </div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
          Buscar y segmentar catálogo
        </h2>
      </div>
    </div>

    <form
      class="mt-6 grid gap-4 xl:grid-cols-[minmax(0,1.2fr)_260px_220px_220px_auto]"
      method="get"
    >
      <label class="block">
        <span
          class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"
        >
          Buscar
        </span>
        <input
          class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/40 focus:outline-none"
          name="q"
          placeholder="Nombre, slug, categoría o texto"
          value={q}
        />
      </label>

      <label class="block">
        <span
          class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"
        >
          Categoría
        </span>
        <select
          class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
          name="category"
        >
          <option value="">Todas</option>
          {
            categories.map((category) => (
              <option
                value={String(category.id)}
                selected={String(category.id) === categoryFilter}
              >
                {category.name}
              </option>
            ))
          }
        </select>
      </label>

      <label class="block">
        <span
          class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"
        >
          Estado
        </span>
        <select
          class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
          name="status"
        >
          <option value="" selected={statusFilter === ""}>Todos</option>
          <option value="active" selected={statusFilter === "active"}
            >Activos</option
          >
          <option value="inactive" selected={statusFilter === "inactive"}
            >Inactivos</option
          >
          <option
            value="configurable"
            selected={statusFilter === "configurable"}>Configurables</option
          >
        </select>
      </label>

      <label class="block">
        <span
          class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"
        >
          Canal
        </span>
        <select
          class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
          name="channel"
        >
          <option value="" selected={channelFilter === ""}>Todos</option>
          <option value="delivery" selected={channelFilter === "delivery"}
            >Delivery</option
          >
          <option value="pickup" selected={channelFilter === "pickup"}
            >Pickup</option
          >
          <option value="both" selected={channelFilter === "both"}>Ambos</option
          >
          <option value="restricted" selected={channelFilter === "restricted"}
            >Canal restringido</option
          >
        </select>
      </label>

      <div class="flex items-end gap-3">
        <button
          class="inline-flex min-h-12.5 items-center justify-center rounded-2xl bg-sky-500 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-400"
          type="submit"
        >
          Filtrar
        </button>

        <a
          href="/admin/catalogo/productos"
          class="inline-flex min-h-12.5 items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/10 hover:text-white"
        >
          Limpiar
        </a>
      </div>
    </form>
  </section>

  <section
    class="mt-6 rounded-[30px] border border-white/10 bg-white/4 shadow-[0_24px_80px_rgba(0,0,0,0.28)]"
  >
    <div class="border-b border-white/10 px-6 py-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <div
            class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
          >
            Resultado
          </div>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
            {filteredProducts.length} producto{
              filteredProducts.length === 1 ? "" : "s"
            }
          </h2>
        </div>

        <div class="text-sm text-slate-400">
          Activación rápida + ficha editable
        </div>
      </div>
    </div>

    {
      filteredProducts.length === 0 ? (
        <div class="px-6 py-12 text-center">
          <div class="mx-auto max-w-md rounded-[28px] border border-white/10 bg-slate-950/40 p-8">
            <div class="text-lg font-semibold text-white">
              No hay productos con esos filtros
            </div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              Ajusta la búsqueda o revisa la categoría y los filtros de canal.
            </p>
          </div>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="min-w-full border-collapse">
            <thead>
              <tr class="border-b border-white/10 text-left">
                <th class="px-6 py-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                  Producto
                </th>
                <th class="px-6 py-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                  Categoría
                </th>
                <th class="px-6 py-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                  Precio
                </th>
                <th class="px-6 py-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                  Canales
                </th>
                <th class="px-6 py-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                  Configuración
                </th>
                <th class="px-6 py-4 text-right text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                  Acciones
                </th>
              </tr>
            </thead>

            <tbody>
              {filteredProducts.map((product) => (
                <tr class="border-b border-white/5 transition hover:bg-white/3">
                  <td class="px-6 py-4 align-top">
                    <div class="flex items-start gap-4">
                      {product.imageUrl ? (
                        <img
                          src={product.imageUrl}
                          alt={product.name}
                          class="h-14 w-14 rounded-2xl object-cover ring-1 ring-white/10"
                        />
                      ) : (
                        <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-slate-950/60 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">
                          Sin img
                        </div>
                      )}

                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                          <div class="text-sm font-semibold text-white">
                            {product.name}
                          </div>

                          <span
                            class:list={[
                              "inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.14em]",
                              product.active
                                ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
                                : "border-rose-400/20 bg-rose-400/10 text-rose-300",
                            ]}
                          >
                            {product.active ? "Activo" : "Inactivo"}
                          </span>
                        </div>

                        <div class="mt-1 text-xs text-slate-500">
                          {product.slug}
                        </div>

                        {product.description ? (
                          <div class="mt-2 max-w-xl text-xs text-slate-400">
                            {product.description}
                          </div>
                        ) : null}
                      </div>
                    </div>
                  </td>

                  <td class="px-6 py-4 align-top">
                    <div class="text-sm font-medium text-slate-200">
                      {product.categoryName}
                    </div>
                    <div class="mt-1 text-xs text-slate-500">
                      {product.categorySlug}
                    </div>
                  </td>

                  <td class="px-6 py-4 align-top">
                    <div class="text-sm font-semibold text-white">
                      {money(product.priceCents)}
                    </div>
                  </td>

                  <td class="px-6 py-4 align-top">
                    <div class="flex flex-wrap gap-2">
                      <span
                        class:list={[
                          "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                          product.deliveryEnabled
                            ? "border-cyan-400/20 bg-cyan-400/10 text-cyan-300"
                            : "border-white/10 bg-white/5 text-slate-500",
                        ]}
                      >
                        Delivery
                      </span>

                      <span
                        class:list={[
                          "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                          product.pickupEnabled
                            ? "border-indigo-400/20 bg-indigo-400/10 text-indigo-300"
                            : "border-white/10 bg-white/5 text-slate-500",
                        ]}
                      >
                        Pickup
                      </span>

                      <span
                        class:list={[
                          "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                          product.dineInEnabled
                            ? "border-violet-400/20 bg-violet-400/10 text-violet-300"
                            : "border-white/10 bg-white/5 text-slate-500",
                        ]}
                      >
                        Sala
                      </span>
                    </div>
                  </td>

                  <td class="px-6 py-4 align-top">
                    <div class="flex flex-wrap gap-2">
                      <span
                        class:list={[
                          "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                          product.isConfigurable
                            ? "border-sky-400/20 bg-sky-400/10 text-sky-300"
                            : "border-white/10 bg-white/5 text-slate-500",
                        ]}
                      >
                        {product.isConfigurable ? "Configurable" : "Simple"}
                      </span>

                      {product.variantCount > 0 ? (
                        <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-300">
                          Variantes {product.variantCount}
                        </span>
                      ) : null}

                      {product.modifierGroupCount > 0 ? (
                        <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-300">
                          Grupos {product.modifierGroupCount}
                        </span>
                      ) : null}

                      {product.allergenPreview.length > 0 ? (
                        <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/20 bg-amber-400/10 px-2.5 py-1.5">
                          <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-amber-300">
                            Alérgenos
                          </span>

                          <div class="flex items-center -space-x-2">
                            {product.allergenPreview.map((allergen) =>
                              allergen.iconUrl ? (
                                <img
                                  src={allergen.iconUrl}
                                  alt={allergen.name}
                                  title={allergen.name}
                                  class="h-6 w-6 rounded-full object-cover ring-1 ring-[#111827]"
                                  loading="lazy"
                                />
                              ) : (
                                <span
                                  title={allergen.name}
                                  class="flex h-6 w-6 items-center justify-center rounded-full border border-amber-300/20 bg-amber-300/15 text-[10px] font-bold uppercase text-amber-100 ring-1 ring-[#111827]"
                                >
                                  {allergen.name.slice(0, 1)}
                                </span>
                              ),
                            )}
                          </div>
                        </div>
                      ) : null}
                    </div>
                  </td>

                  <td class="px-6 py-4 align-top">
                    <div class="flex justify-end gap-2">
                      <form
                        method="post"
                        action={`/api/admin/products/${product.id}`}
                      >
                        <input
                          type="hidden"
                          name="intent"
                          value="toggle-active"
                        />
                        <input
                          type="hidden"
                          name="nextActive"
                          value={product.active ? "false" : "true"}
                        />
                        <input
                          type="hidden"
                          name="redirectTo"
                          value={Astro.url.pathname + Astro.url.search}
                        />
                        <button
                          class:list={[
                            "inline-flex items-center justify-center rounded-xl border px-3 py-2 text-xs font-semibold transition",
                            product.active
                              ? "border-rose-400/20 bg-rose-400/10 text-rose-300 hover:border-rose-400/30 hover:bg-rose-400/15"
                              : "border-emerald-400/20 bg-emerald-400/10 text-emerald-300 hover:border-emerald-400/30 hover:bg-emerald-400/15",
                          ]}
                          type="submit"
                        >
                          {product.active ? "Desactivar" : "Activar"}
                        </button>
                      </form>

                      <a
                        href={`/admin/catalogo/productos/${product.id}`}
                        class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/10 hover:text-white"
                      >
                        Editar
                      </a>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</AdminLayout>
