---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import { excludeMenuCategories, isMenuCategorySlug } from "@/lib/admin/catalog";
import {
  db,
  Category,
  Product,
  ProductVariant,
  ProductModifierGroup,
  ProductIngredient,
  ProductAllergen,
  Allergen,
  eq,
  inArray,
} from "astro:db";

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

const url = new URL(Astro.request.url);
const q = (url.searchParams.get("q") ?? "").trim().toLowerCase();
const categoryFilter = url.searchParams.get("category") ?? "";
const statusFilter = url.searchParams.get("status") ?? "";
const channelFilter = url.searchParams.get("channel") ?? "";
const saved = url.searchParams.get("saved") === "1";
const error = url.searchParams.get("error") ?? "";

// Los productos del menú del día viven en una categoría interna y no forman
// parte de la carta ni del delivery: se gestionan desde /admin/menu/**.
const categories = excludeMenuCategories(
  await db
    .select({
      id: Category.id,
      name: Category.name,
      slug: Category.slug,
      sortOrder: Category.sortOrder,
      active: Category.active,
      imageUrl: Category.imageUrl,
    })
    .from(Category)
    .orderBy(Category.sortOrder),
);

const allRows = await db
  .select({
    id: Product.id,
    categoryId: Product.categoryId,
    name: Product.name,
    slug: Product.slug,
    description: Product.description,
    details: Product.details,
    imageUrl: Product.imageUrl,
    priceCents: Product.priceCents,
    deliveryEnabled: Product.deliveryEnabled,
    dineInEnabled: Product.dineInEnabled,
    active: Product.active,
    updatedAt: Product.updatedAt,
    categoryName: Category.name,
    categorySlug: Category.slug,
  })
  .from(Product)
  .innerJoin(Category, eq(Product.categoryId, Category.id))
  .orderBy(Product.id);

const rows = allRows.filter((row) => !isMenuCategorySlug(row.categorySlug));

const productsSorted = [...rows].sort((a, b) => {
  if (a.categoryName !== b.categoryName) {
    return a.categoryName.localeCompare(b.categoryName, "es");
  }
  return a.name.localeCompare(b.name, "es");
});

const productIds = productsSorted.map((row) => row.id);

const variantRows = productIds.length
  ? await db
      .select({
        productId: ProductVariant.productId,
        id: ProductVariant.id,
        active: ProductVariant.active,
      })
      .from(ProductVariant)
      .where(inArray(ProductVariant.productId, productIds))
  : [];

const modifierGroupRows = productIds.length
  ? await db
      .select({
        productId: ProductModifierGroup.productId,
        id: ProductModifierGroup.id,
      })
      .from(ProductModifierGroup)
      .where(inArray(ProductModifierGroup.productId, productIds))
  : [];

const removableIngredientRows = productIds.length
  ? await db
      .select({
        productId: ProductIngredient.productId,
        id: ProductIngredient.id,
        defaultIncluded: ProductIngredient.defaultIncluded,
        removable: ProductIngredient.removable,
      })
      .from(ProductIngredient)
      .where(inArray(ProductIngredient.productId, productIds))
  : [];

const allergenRows = productIds.length
  ? await db
      .select({
        productId: ProductAllergen.productId,
        allergenId: Allergen.id,
        allergenName: Allergen.name,
        allergenSlug: Allergen.slug,
        allergenIconUrl: Allergen.iconUrl,
        allergenSortOrder: Allergen.sortOrder,
      })
      .from(ProductAllergen)
      .innerJoin(Allergen, eq(ProductAllergen.allergenId, Allergen.id))
      .where(inArray(ProductAllergen.productId, productIds))
      .orderBy(ProductAllergen.productId, Allergen.sortOrder, Allergen.name)
  : [];

const activeVariantCountByProduct = new Map<number, number>();
for (const row of variantRows) {
  if (!row.active) continue;
  activeVariantCountByProduct.set(
    row.productId,
    (activeVariantCountByProduct.get(row.productId) ?? 0) + 1,
  );
}

const modifierGroupCountByProduct = new Map<number, number>();
for (const row of modifierGroupRows) {
  modifierGroupCountByProduct.set(
    row.productId,
    (modifierGroupCountByProduct.get(row.productId) ?? 0) + 1,
  );
}

const removableCountByProduct = new Map<number, number>();
for (const row of removableIngredientRows) {
  if (!row.defaultIncluded || !row.removable) continue;
  removableCountByProduct.set(
    row.productId,
    (removableCountByProduct.get(row.productId) ?? 0) + 1,
  );
}

const allergenPreviewByProduct = new Map<
  number,
  Array<{
    id: number;
    name: string;
    slug: string;
    iconUrl: string | null;
  }>
>();

for (const row of allergenRows) {
  if (!allergenPreviewByProduct.has(row.productId)) {
    allergenPreviewByProduct.set(row.productId, []);
  }

  allergenPreviewByProduct.get(row.productId)?.push({
    id: row.allergenId,
    name: row.allergenName,
    slug: row.allergenSlug,
    iconUrl: row.allergenIconUrl
      ? String(row.allergenIconUrl).trim() || null
      : null,
  });
}

const products = productsSorted.map((row) => {
  const variantCount = activeVariantCountByProduct.get(row.id) ?? 0;
  const modifierGroupCount = modifierGroupCountByProduct.get(row.id) ?? 0;
  const removableCount = removableCountByProduct.get(row.id) ?? 0;
  const allergens = allergenPreviewByProduct.get(row.id) ?? [];
  const allergenPreview = allergens.slice(0, 4);

  return {
    ...row,
    variantCount,
    modifierGroupCount,
    removableCount,
    allergenPreview,
    allergenCount: allergens.length,
    allergenTitle: allergens.map((allergen) => allergen.name).join(", "),
    isConfigurable:
      variantCount > 0 || modifierGroupCount > 0 || removableCount > 0,
  };
});

const filteredProducts = products.filter((product) => {
  if (categoryFilter && String(product.categoryId) !== categoryFilter)
    return false;

  if (statusFilter === "active" && !product.active) return false;
  if (statusFilter === "inactive" && product.active) return false;
  if (statusFilter === "configurable" && !product.isConfigurable) return false;

  if (channelFilter === "domicilio" && !product.deliveryEnabled) return false;
  if (channelFilter === "carta" && !product.dineInEnabled) return false;

  if (q) {
    const haystack = [
      product.name,
      product.slug,
      product.categoryName,
      product.description ?? "",
      product.details ?? "",
    ]
      .join(" ")
      .toLowerCase();

    if (!haystack.includes(q)) return false;
  }

  return true;
});

const totalProducts = products.length;
const activeProducts = products.filter((product) => product.active).length;
const configurableProducts = products.filter(
  (product) => product.isConfigurable,
).length;
const imageProducts = products.filter((product) =>
  Boolean(product.imageUrl),
).length;
const restrictedProducts = products.filter(
  (product) => !(product.deliveryEnabled && product.dineInEnabled),
).length;
const hasFilters = Boolean(
  q || categoryFilter || statusFilter || channelFilter,
);
const redirectTo = `${Astro.url.pathname}${Astro.url.search}`;

const activeCategories = categories.filter((category) => category.active);
const canCreate = activeCategories.length > 0;

const statusMessage =
  error === "invalid-id"
    ? "ID de producto inválido."
    : error === "not-found"
      ? "El producto ya no existe."
      : error === "missing-name"
        ? "El nombre es obligatorio."
        : error === "invalid-slug"
          ? "El slug no es válido."
          : error === "invalid-category"
            ? "La categoría seleccionada no es válida."
            : error === "invalid-price"
              ? "El precio no es válido."
              : error === "duplicate-slug"
                ? "Ya existe otro producto con ese slug."
                : error === "image-upload-disabled"
                  ? "La subida de imágenes no está configurada todavía en el entorno."
                  : error === "invalid-image"
                    ? "La imagen no es válida. Solo se permiten JPG, PNG o WEBP."
                    : error === "image-too-large"
                      ? "La imagen supera el tamaño máximo permitido."
                      : error === "image-upload-failed"
                        ? "No se ha podido subir la imagen del producto."
                        : "";

const summaryCards = [
  { label: "Total", value: String(totalProducts), helper: "Todo el catálogo cargado" },
  { label: "Activos", value: String(activeProducts), helper: "Disponibles para pública" },
  { label: "Configurables", value: String(configurableProducts), helper: "Variantes, grupos o removibles" },
  { label: "Con imagen", value: String(imageProducts), helper: "Preview visual disponible" },
  { label: "Restringidos", value: String(restrictedProducts), helper: "No están en todos los canales" },
];
---

<AdminLayout title="Productos · Admin · Arcadia" heading="Productos" description="Carta y delivery: precios, canales, alérgenos y estado de cada producto.">

  <div class="space-y-8">
    {
      saved ? (
        <section class="rounded-admin-lg border border-emerald-400/15 bg-emerald-400/10 px-5 py-4 text-sm text-emerald-100">
          Producto actualizado correctamente.
        </section>
      ) : null
    }

    {
      statusMessage ? (
        <section class="rounded-admin-lg border border-rose-400/15 bg-rose-400/10 px-5 py-4 text-sm text-rose-100">
          {statusMessage}
        </section>
      ) : null
    }

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      {summaryCards.map((card) => (
        <StatCard label={card.label} value={card.value} helper={card.helper} />
      ))}
    </section>

    <Card padded={false}>
      <div class="flex flex-wrap items-center gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <form class="flex flex-1 flex-wrap items-center gap-2" method="get">
          <input
            class="min-w-[220px] flex-1 rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/30 focus:outline-none"
            name="q"
            placeholder="Buscar producto..."
            value={q}
          />
          <select class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" name="category">
            <option value="">Categoría</option>
            {categories.map((category) => (
              <option value={String(category.id)} selected={String(category.id) === categoryFilter}>{category.name}</option>
            ))}
          </select>
          <select class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" name="status">
            <option value="" selected={statusFilter === ""}>Estado</option>
            <option value="active" selected={statusFilter === "active"}>Activos</option>
            <option value="inactive" selected={statusFilter === "inactive"}>Inactivos</option>
            <option value="configurable" selected={statusFilter === "configurable"}>Configurables</option>
          </select>
          <select class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-sky-400/30 focus:outline-none" name="channel">
            <option value="" selected={channelFilter === ""}>Canal</option>
            <option value="carta" selected={channelFilter === "carta"}>Carta</option>
            <option value="domicilio" selected={channelFilter === "domicilio"}>Domicilio</option>
          </select>
          <button class="inline-flex min-h-9 items-center justify-center rounded-2xl border border-sky-400/15 bg-sky-400/10 px-3.5 py-2 text-sm font-semibold text-sky-100 transition hover:border-sky-400/25 hover:bg-sky-400/15" type="submit">
            Filtrar
          </button>
          {hasFilters ? (
            <a href="/admin/catalogo/productos" class="inline-flex min-h-9 items-center justify-center rounded-2xl border border-admin-border bg-white/[0.03] px-3.5 py-2 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
              Limpiar
            </a>
          ) : null}
        </form>

      <Modal id="product-create" title="Nuevo producto" description="Alta base. Variantes, ingredientes, grupos y alérgenos se completan después en la ficha." triggerLabel="+ Nuevo producto" size="xl">
        {
          !canCreate ? (
            <div class="rounded-2xl border border-amber-400/20 bg-amber-400/10 px-4 py-3 text-sm text-amber-100/85">
              No hay categorías activas. Activa al menos una categoría antes de crear un producto.
            </div>
          ) : null
        }

        <form method="post" action="/api/admin/products/new" enctype="multipart/form-data" class="mt-4 grid gap-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Nombre</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/40 focus:outline-none" type="text" name="name" placeholder="Hamburguesa Arcadia" required disabled={!canCreate} />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Slug</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/40 focus:outline-none" type="text" name="slug" placeholder="Automático si se deja vacío" disabled={!canCreate} />
            </label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Categoría</span>
              <select class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" name="categoryId" required disabled={!canCreate}>
                {activeCategories.length === 0 ? (
                  <option value="">Sin categorías activas</option>
                ) : (
                  activeCategories.map((category) => <option value={category.id}>{category.name}</option>)
                )}
              </select>
            </label>
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Precio (€)</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="number" name="priceEur" min="0" step="0.01" value="0.00" required disabled={!canCreate} />
            </label>
          </div>

          <label class="block">
            <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Imagen (opcional)</span>
            <input
              class="block w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white file:mr-3 file:rounded-xl file:border-0 file:bg-sky-500 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-slate-950 hover:file:bg-sky-400 focus:border-sky-400/40 focus:outline-none"
              type="file"
              name="imageFile"
              accept="image/jpeg,image/png,image/webp"
              disabled={!canCreate}
            />
          </label>

          <label class="block">
            <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Descripción</span>
            <textarea class="min-h-20 w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/40 focus:outline-none" name="description" disabled={!canCreate} />
          </label>

          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            <label class="flex items-center gap-2 rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-slate-300">
              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="active" checked disabled={!canCreate} />
              Activo
            </label>
            <label class="flex items-center gap-2 rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-slate-300">
              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="deliveryEnabled" checked disabled={!canCreate} />
              Domicilio
            </label>
            <label class="flex items-center gap-2 rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-slate-300">
              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="dineInEnabled" checked disabled={!canCreate} />
              Carta
            </label>
          </div>

          <button type="submit" class="mt-1 inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/15 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/25 hover:bg-sky-400/15 disabled:cursor-not-allowed disabled:opacity-50" disabled={!canCreate}>
            Crear producto
          </button>
        </form>
      </Modal>
      </div>

      {
        filteredProducts.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="No hay productos con esos filtros" description="Ajusta la búsqueda o revisa la categoría y los filtros de canal." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Producto</th>
                  <th>Categoría</th>
                  <th>Precio</th>
                  <th>Canales</th>
                  <th>Alérgenos</th>
                  <th>Estado</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {filteredProducts.map((product) => (
                  <tr>
                    <td>
                      <div class="flex items-center gap-3">
                        {product.imageUrl ? (
                          <img src={product.imageUrl} alt={product.name} class="h-9 w-9 shrink-0 rounded-xl object-cover ring-1 ring-white/10" />
                        ) : (
                          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-admin-border bg-white/[0.03] text-[9px] font-semibold text-admin-faint">—</div>
                        )}
                        <div class="min-w-0">
                          <div class="truncate font-semibold text-white">{product.name}</div>
                          <div class="truncate text-xs text-admin-muted">{product.slug}</div>
                        </div>
                      </div>
                    </td>
                    <td class="text-admin-muted">{product.categoryName}</td>
                    <td class="font-semibold text-white">{money(product.priceCents)}</td>
                    <td>
                      <div class="flex gap-1.5">
                        <Badge tone={product.dineInEnabled ? "violet" : "neutral"}>Carta</Badge>
                        <Badge tone={product.deliveryEnabled ? "cyan" : "neutral"}>Domicilio</Badge>
                      </div>
                    </td>
                    <td>
                      {/*
                        Los alérgenos van apilados, no en fila suelta.

                        Solapados ocupan bastante menos y la columna deja de
                        crecer con cada producto que tenga muchos, que era lo
                        que ensanchaba la tabla. El aro del color de la fila los
                        separa visualmente aunque se pisen.

                        El primero queda encima y los siguientes caen por
                        detrás, para que se lea de izquierda a derecha igual que
                        el resto de la tabla.
                      */}
                      {product.allergenCount === 0 ? (
                        <span class="text-admin-faint">—</span>
                      ) : (
                        <div class="flex items-center" title={product.allergenTitle}>
                          {product.allergenPreview.map((allergen, indice) => (
                            <span
                              class:list={[
                                "grid h-7 w-7 shrink-0 place-items-center overflow-hidden rounded-full",
                                "bg-admin-surface ring-2 ring-admin-surface",
                                indice > 0 ? "-ml-2.5" : "",
                              ]}
                              style={`z-index:${product.allergenPreview.length - indice}`}
                            >
                              {allergen.iconUrl ? (
                                <img src={allergen.iconUrl} alt={allergen.name} class="h-[22px] w-[22px] object-contain" loading="lazy" />
                              ) : (
                                <span class="text-[10px] font-bold uppercase text-admin-muted">{allergen.name.slice(0, 2)}</span>
                              )}
                            </span>
                          ))}
                          {product.allergenCount > product.allergenPreview.length ? (
                            <span class="-ml-2.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-admin-elevated text-[10px] font-bold text-admin-muted ring-2 ring-admin-surface">
                              +{product.allergenCount - product.allergenPreview.length}
                            </span>
                          ) : null}
                        </div>
                      )}
                    </td>
                    <td><Badge tone={product.active ? "success" : "danger"}>{product.active ? "Activo" : "Inactivo"}</Badge></td>
                    <td>
                      <div class="flex items-center justify-end gap-2">
                        <form method="post" action={`/api/admin/products/${product.id}`}>
                          <input type="hidden" name="intent" value="toggle-active" />
                          <input type="hidden" name="nextActive" value={product.active ? "false" : "true"} />
                          <input type="hidden" name="redirectTo" value={redirectTo} />
                          <button
                            class:list={[
                              "rounded-xl border px-3 py-1.5 text-xs font-semibold transition",
                              product.active
                                ? "border-rose-400/15 bg-rose-400/10 text-rose-200 hover:border-rose-400/25 hover:bg-rose-400/15"
                                : "border-emerald-400/15 bg-emerald-400/10 text-emerald-200 hover:border-emerald-400/25 hover:bg-emerald-400/15",
                            ]}
                            type="submit"
                          >
                            {product.active ? "Desactivar" : "Activar"}
                          </button>
                        </form>
                        <a href={`/admin/catalogo/productos/${product.id}`} class="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
                          Editar
                        </a>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
