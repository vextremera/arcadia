---
import AdminLayout from "@/layouts/AdminLayout.astro";
import KitchenBoard from "@/islands/admin/KitchenBoard";

type FlowCard = {
  label: string;
  title: string;
  description: string;
};

const flowCards: FlowCard[] = [
  {
    label: "Entrada",
    title: "Nuevos",
    description: "Agrupa pedidos en PENDING y PAID para que cocina pueda aceptarlos rápido.",
  },
  {
    label: "Producción",
    title: "En cocina",
    description: "Muestra ACCEPTED y PREPARING como bloque operativo central del servicio.",
  },
  {
    label: "Salida",
    title: "Listos / reparto",
    description: "Separa READY de OUT_FOR_DELIVERY para distinguir recogida, entrega y expedición.",
  },
];
---

<AdminLayout
  title="Cocina · Admin · Arcadia"
  heading="Cocina"
  description="Board operativo en tiempo real para seguimiento de pedidos y avance de estados desde cocina."
  actions={true}
>
  <Fragment slot="actions">
    <div class="flex flex-wrap gap-3">
      <a
        href="/admin/pedidos"
        class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/10 hover:text-white"
      >
        Ver pedidos
      </a>

      <a
        href="/admin"
        class="inline-flex items-center justify-center rounded-2xl border border-violet-400/20 bg-violet-400/10 px-4 py-3 text-sm font-semibold text-violet-300 transition hover:border-violet-400/30 hover:bg-violet-400/15"
      >
        Volver al dashboard
      </a>
    </div>
  </Fragment>

  <section class="grid gap-4 md:grid-cols-3">
    {flowCards.map((card) => (
      <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">
          {card.label}
        </div>
        <div class="mt-3 text-xl font-semibold tracking-tight text-white">
          {card.title}
        </div>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          {card.description}
        </p>
      </article>
    ))}
  </section>

  <KitchenBoard client:load />
</AdminLayout>