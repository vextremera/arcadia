---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import { db, Coupon, LoyaltyTier, Order, inArray } from "astro:db";
import type { CouponKind } from "@/server/checkout/coupons";

type CouponRow = {
  id: number;
  code: string;
  type: CouponKind;
  value: number;
  minSubtotalCents: number | null;
  maxUses: number | null;
  usesCount: number;
  active: boolean;
  startsAt: Date | null;
  endsAt: Date | null;
  requiredTierId: number | null;
};

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function moneyInput(cents: number | null) {
  if (typeof cents !== "number") return "";
  return (cents / 100).toFixed(2);
}

function dateInputValue(value: Date | null) {
  if (!value) return "";
  const date = value instanceof Date ? value : new Date(value);
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

function couponValueLabel(type: CouponKind, value: number) {
  if (type === "PERCENT") return `${value}%`;
  if (type === "FIXED") return money(value);
  return "Envío gratis";
}

function typeLabel(type: CouponKind) {
  if (type === "PERCENT") return "Porcentaje";
  if (type === "FIXED") return "Importe fijo";
  return "Envío gratis";
}

function typeTone(type: CouponKind) {
  if (type === "PERCENT") return "primary" as const;
  if (type === "FIXED") return "violet" as const;
  return "cyan" as const;
}

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") === "1";
const error = url.searchParams.get("error") ?? "";
const q = (url.searchParams.get("q") ?? "").trim().toLowerCase();
const statusFilter = url.searchParams.get("status") ?? "";

const couponRows = (await db
  .select({
    id: Coupon.id,
    code: Coupon.code,
    type: Coupon.type,
    value: Coupon.value,
    minSubtotalCents: Coupon.minSubtotalCents,
    maxUses: Coupon.maxUses,
    usesCount: Coupon.usesCount,
    active: Coupon.active,
    startsAt: Coupon.startsAt,
    endsAt: Coupon.endsAt,
    requiredTierId: Coupon.requiredTierId,
  })
  .from(Coupon)
  .orderBy(Coupon.code)) as CouponRow[];

const tiers = await db
  .select({ id: LoyaltyTier.id, name: LoyaltyTier.name })
  .from(LoyaltyTier)
  .orderBy(LoyaltyTier.sortOrder, LoyaltyTier.name);

const tierNameById = new Map<number, string>();
for (const tier of tiers) tierNameById.set(tier.id, tier.name);

const couponIds = couponRows.map((row) => row.id);

const orderRows = couponIds.length
  ? await db.select({ couponId: Order.couponId }).from(Order).where(inArray(Order.couponId, couponIds))
  : [];

const linkedOrderCountByCoupon = new Map<number, number>();
for (const row of orderRows) {
  if (typeof row.couponId !== "number") continue;
  linkedOrderCountByCoupon.set(row.couponId, (linkedOrderCountByCoupon.get(row.couponId) ?? 0) + 1);
}

const filteredCoupons = couponRows.filter((coupon) => {
  if (statusFilter === "active" && !coupon.active) return false;
  if (statusFilter === "inactive" && coupon.active) return false;
  if (statusFilter === "used" && coupon.usesCount <= 0) return false;
  if (statusFilter === "limited" && typeof coupon.maxUses !== "number") return false;
  if (!q) return true;
  return [coupon.code, coupon.type, coupon.requiredTierId ? (tierNameById.get(coupon.requiredTierId) ?? "") : ""]
    .join(" ")
    .toLowerCase()
    .includes(q);
});

const totalCoupons = couponRows.length;
const activeCoupons = couponRows.filter((coupon) => coupon.active).length;
const usedCoupons = couponRows.filter((coupon) => coupon.usesCount > 0).length;

const errorMessage =
  error === "missing-code" ? "El código del cupón es obligatorio." :
  error === "duplicate-code" ? "Ya existe otro cupón con ese código." :
  error === "invalid-type" ? "El tipo de cupón no es válido." :
  error === "invalid-value" ? "El valor del cupón no es válido." :
  error === "invalid-min-subtotal" ? "El subtotal mínimo no es válido." :
  error === "invalid-max-uses" ? "El máximo de usos no es válido." :
  error === "invalid-dates" ? "Las fechas del cupón no son válidas." :
  error === "invalid-tier" ? "El tier requerido no es válido." :
  error === "invalid-coupon" ? "El cupón indicado no es válido." :
  error === "coupon-not-found" ? "El cupón ya no existe." :
  error === "coupon-in-use" ? "No se puede borrar un cupón ya usado o vinculado a pedidos." :
  error === "invalid-intent" ? "Acción no válida." :
  "";
---

<AdminLayout title="Cupones · Admin · Arcadia" heading="Cupones" description="Descuentos del checkout: reglas, límites, vigencia y tier requerido.">
  <div class="space-y-6">
    {saved ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">Cupones actualizados correctamente.</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{errorMessage}</section> : null}

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard icon="coin" label="Cupones" value={String(totalCoupons)} helper={`${activeCoupons} activos en checkout`} />
      <StatCard label="Con uso" value={String(usedCoupons)} helper="Tienen al menos un canje" />
    </section>

    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <form method="get" class="flex flex-1 flex-wrap items-center gap-2">
          <input
            class="min-w-[200px] flex-1 rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/40 focus:outline-none"
            type="search"
            name="q"
            value={q}
            placeholder="Buscar código o tier..."
          />
          <select name="status" class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none">
            <option value="">Estado</option>
            <option value="active" selected={statusFilter === "active"}>Activos</option>
            <option value="inactive" selected={statusFilter === "inactive"}>Inactivos</option>
            <option value="used" selected={statusFilter === "used"}>Con uso</option>
            <option value="limited" selected={statusFilter === "limited"}>Con límite</option>
          </select>
          <button type="submit" class="inline-flex min-h-9 items-center justify-center rounded-2xl border border-admin-border bg-white/[0.03] px-3.5 py-2 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
            Filtrar
          </button>
        </form>

        <Modal id="coupon-create" title="Nuevo cupón" description="Código, regla de descuento, límites, vigencia y tier requerido." triggerLabel="+ Nuevo cupón" size="lg">
          <form method="post" action="/api/admin/coupons" class="grid gap-4">
            <input type="hidden" name="intent" value="create" />

            <div class="grid gap-4 sm:grid-cols-[1fr_180px]">
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Código</span>
                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="code" placeholder="VERANO10" required />
              </label>
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Tipo</span>
                <select name="type" class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none">
                  <option value="PERCENT">Porcentaje</option>
                  <option value="FIXED">Importe fijo</option>
                  <option value="FREE_DELIVERY">Envío gratis</option>
                </select>
              </label>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Valor</span>
                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="valueInput" placeholder="10 ó 3.50" />
              </label>
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Subtotal mín. €</span>
                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="minSubtotalEur" placeholder="Opcional" />
              </label>
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Máx. usos</span>
                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="number" min="1" step="1" name="maxUses" placeholder="Opcional" />
              </label>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Desde</span>
                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="date" name="startsAt" />
              </label>
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Hasta</span>
                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="date" name="endsAt" />
              </label>
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Tier requerido</span>
                <select name="requiredTierId" class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none">
                  <option value="">Sin restricción</option>
                  {tiers.map((tier) => <option value={tier.id}>{tier.name}</option>)}
                </select>
              </label>
            </div>

            <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="active" checked />
              Cupón activo
            </label>

            <button type="submit" class="mt-1 inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
              Crear cupón
            </button>
          </form>
        </Modal>
      </div>

      {
        filteredCoupons.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="No hay cupones para ese filtro" description="Ajusta la búsqueda o crea uno nuevo." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Código</th>
                  <th>Tipo</th>
                  <th>Valor</th>
                  <th>Mín.</th>
                  <th>Usos</th>
                  <th>Vigencia</th>
                  <th>Tier</th>
                  <th>Estado</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {filteredCoupons.map((coupon) => {
                  const linkedOrders = linkedOrderCountByCoupon.get(coupon.id) ?? 0;
                  const canDelete = coupon.usesCount === 0 && linkedOrders === 0;
                  const from = dateInputValue(coupon.startsAt);
                  const to = dateInputValue(coupon.endsAt);

                  return (
                    <tr>
                      <td class="font-semibold text-white">{coupon.code}</td>
                      <td><Badge tone={typeTone(coupon.type)}>{typeLabel(coupon.type)}</Badge></td>
                      <td class="text-admin-muted">{couponValueLabel(coupon.type, coupon.value)}</td>
                      <td class="text-admin-muted">{typeof coupon.minSubtotalCents === "number" ? money(coupon.minSubtotalCents) : "—"}</td>
                      <td class="text-admin-muted">
                        {coupon.usesCount}{typeof coupon.maxUses === "number" ? ` / ${coupon.maxUses}` : ""}
                      </td>
                      <td class="text-admin-muted">{from || to ? `${from || "—"} → ${to || "—"}` : "Siempre"}</td>
                      <td class="text-admin-muted">{coupon.requiredTierId ? (tierNameById.get(coupon.requiredTierId) ?? "—") : "—"}</td>
                      <td><Badge tone={coupon.active ? "success" : "danger"}>{coupon.active ? "Activo" : "Inactivo"}</Badge></td>
                      <td>
                        <div class="flex justify-end">
                          <Modal
                            id={`coupon-edit-${coupon.id}`}
                            title={coupon.code}
                            triggerLabel="Editar"
                            triggerClass="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]"
                            size="lg"
                          >
                            <form method="post" action="/api/admin/coupons" class="grid gap-4">
                              <input type="hidden" name="intent" value="update" />
                              <input type="hidden" name="couponId" value={coupon.id} />

                              <div class="grid gap-4 sm:grid-cols-[1fr_180px]">
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Código</span>
                                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="code" value={coupon.code} required />
                                </label>
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Tipo</span>
                                  <select name="type" class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none">
                                    <option value="PERCENT" selected={coupon.type === "PERCENT"}>Porcentaje</option>
                                    <option value="FIXED" selected={coupon.type === "FIXED"}>Importe fijo</option>
                                    <option value="FREE_DELIVERY" selected={coupon.type === "FREE_DELIVERY"}>Envío gratis</option>
                                  </select>
                                </label>
                              </div>

                              <div class="grid gap-4 sm:grid-cols-3">
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Valor</span>
                                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="valueInput" value={coupon.type === "FIXED" ? moneyInput(coupon.value) : String(coupon.value)} />
                                </label>
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Subtotal mín. €</span>
                                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="minSubtotalEur" value={moneyInput(coupon.minSubtotalCents)} />
                                </label>
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Máx. usos</span>
                                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="number" min="1" step="1" name="maxUses" value={coupon.maxUses ?? ""} />
                                </label>
                              </div>

                              <div class="grid gap-4 sm:grid-cols-3">
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Desde</span>
                                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="date" name="startsAt" value={from} />
                                </label>
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Hasta</span>
                                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="date" name="endsAt" value={to} />
                                </label>
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Tier requerido</span>
                                  <select name="requiredTierId" class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none">
                                    <option value="">Sin restricción</option>
                                    {tiers.map((tier) => (
                                      <option value={tier.id} selected={coupon.requiredTierId === tier.id}>{tier.name}</option>
                                    ))}
                                  </select>
                                </label>
                              </div>

                              <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                                <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="active" checked={coupon.active} />
                                Cupón activo
                              </label>

                              <button type="submit" class="mt-1 inline-flex min-h-10 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
                                Guardar
                              </button>
                            </form>

                            <form method="post" action="/api/admin/coupons" class="mt-3 border-t border-admin-border pt-3">
                              <input type="hidden" name="intent" value="delete" />
                              <input type="hidden" name="couponId" value={coupon.id} />
                              <div class="flex items-center justify-between gap-3">
                                <span class="text-xs leading-5 text-admin-muted">
                                  {canDelete ? "Se puede borrar: sin usos ni pedidos." : `No se puede borrar: ${coupon.usesCount} uso(s), ${linkedOrders} pedido(s).`}
                                </span>
                                <button
                                  type="submit"
                                  disabled={!canDelete}
                                  class:list={[
                                    "inline-flex min-h-9 shrink-0 items-center justify-center rounded-2xl px-4 py-2 text-sm font-semibold transition",
                                    canDelete
                                      ? "border border-rose-400/20 bg-rose-400/10 text-rose-300 hover:border-rose-400/30 hover:bg-rose-400/15"
                                      : "cursor-not-allowed border border-admin-border bg-white/[0.03] text-slate-500",
                                  ]}
                                >
                                  Borrar cupón
                                </button>
                              </div>
                            </form>
                          </Modal>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
