---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import { ADMIN_ROLE_LABEL, ADMIN_ROLE_DESCRIPTION } from "@/lib/admin/roles";
import { listAdminAccounts, adminDisplayName, PASSWORD_MIN, USERNAME_MIN } from "@/server/auth/adminUsers";

const admin = Astro.locals.admin!;
const accounts = await listAdminAccounts();

const totalAdmins = accounts.filter((a) => a.role === "ADMIN" && a.active).length;
const totalWorkers = accounts.filter((a) => a.role === "WORKER" && a.active).length;
const inactivos = accounts.filter((a) => !a.active).length;

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") ?? "";
const errorParam = url.searchParams.get("error") ?? "";

const successMessage =
  saved === "created" ? "Cuenta creada." :
  saved === "deleted" ? "Cuenta eliminada." : "";

const errorMessage =
  errorParam === "invalid-username" ? `El usuario debe tener al menos ${USERNAME_MIN} caracteres y sólo letras, números, punto, guion o guion bajo.` :
  errorParam === "duplicate-username" ? "Ya existe una cuenta con ese usuario." :
  errorParam === "weak-password" ? `La contraseña debe tener al menos ${PASSWORD_MIN} caracteres.` :
  errorParam === "invalid-role" ? "El rol no es válido." :
  errorParam === "not-found" ? "Esa cuenta ya no existe." :
  errorParam === "invalid-intent" ? "Acción no válida." : "";

function formatDate(value: Date | null) {
  if (!value) return "Nunca";
  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) return "Nunca";
  return new Intl.DateTimeFormat("es-ES", { dateStyle: "short", timeStyle: "short", timeZone: "Europe/Madrid" }).format(date);
}

const inputClass = "w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none";
const labelClass = "mb-1.5 block text-xs font-semibold uppercase tracking-wide text-admin-muted";
---

<AdminLayout
  title="Equipo · Admin · Arcadia"
  heading="Equipo"
  description="Cuentas de acceso al panel. No tienen nada que ver con los clientes de la web."
>
  <div class="space-y-6">
    {successMessage ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">{successMessage}</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{errorMessage}</section> : null}

    <section class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
      <StatCard label="Admins totales" value={String(totalAdmins)} helper="Acceso a todo el panel" />
      <StatCard label="Trabajadores" value={String(totalWorkers)} helper="Pedidos, cocina e impresoras" />
      <StatCard label="Desactivadas" value={String(inactivos)} helper="No pueden entrar" />
    </section>

    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-admin-border px-5 py-4 lg:px-6">
        <div>
          <h2 class="text-base font-semibold text-white">Cuentas del panel</h2>
          <p class="mt-1 text-xs text-admin-muted">Se entra con nombre de usuario, no con correo.</p>
        </div>

        <Modal
          id="admin-create"
          title="Nueva cuenta"
          description="El usuario se dicta en voz alta en cocina: mejor corto y sin acentos."
          triggerLabel="+ Nueva cuenta"
        >
          <form method="post" action="/api/admin/equipo" class="space-y-4">
            <input type="hidden" name="intent" value="create" />

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label class={labelClass} for="create-username">Usuario</label>
                <input class={inputClass} id="create-username" type="text" name="username" placeholder="marta" autocomplete="off" required />
              </div>
              <div>
                <label class={labelClass} for="create-displayName">Nombre (opcional)</label>
                <input class={inputClass} id="create-displayName" type="text" name="displayName" placeholder="Marta" autocomplete="off" />
              </div>
            </div>

            <div>
              <label class={labelClass} for="create-password">Contraseña</label>
              <input class={inputClass} id="create-password" type="password" name="password" minlength={PASSWORD_MIN} autocomplete="new-password" required />
              <p class="mt-1.5 text-xs text-admin-muted">Mínimo {PASSWORD_MIN} caracteres. Quien la use podrá cambiarla desde su cuenta.</p>
            </div>

            <fieldset class="space-y-2">
              <legend class={labelClass}>Rol</legend>
              {
                (["WORKER", "ADMIN"] as const).map((role) => (
                  <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-admin-border bg-white/[0.02] p-3 transition hover:border-white/15">
                    <input class="mt-1 h-4 w-4" type="radio" name="role" value={role} checked={role === "WORKER"} required />
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold text-white">{ADMIN_ROLE_LABEL[role]}</span>
                      <span class="mt-0.5 block text-xs leading-5 text-admin-muted">{ADMIN_ROLE_DESCRIPTION[role]}</span>
                    </span>
                  </label>
                ))
              }
            </fieldset>

            <button
              type="submit"
              class="admin-focus inline-flex min-h-11 w-full items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15"
            >
              Crear cuenta
            </button>
          </form>
        </Modal>
      </div>

      {
        accounts.length === 0 ? (
          <div class="px-5 py-10 lg:px-6">
            <EmptyState title="Todavía no hay cuentas" description="Crea la primera para que alguien pueda entrar al panel." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full min-w-[46rem] text-left text-sm">
              <thead class="border-b border-admin-border text-[11px] uppercase tracking-[0.14em] text-admin-muted">
                <tr>
                  <th class="px-5 py-3 font-semibold lg:px-6">Usuario</th>
                  <th class="px-5 py-3 font-semibold">Rol</th>
                  <th class="px-5 py-3 font-semibold">Estado</th>
                  <th class="px-5 py-3 font-semibold">Última entrada</th>
                  <th class="px-5 py-3 font-semibold lg:px-6"><span class="sr-only">Acciones</span></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-admin-border">
                {accounts.map((account) => (
                  <tr class="transition hover:bg-white/[0.02]">
                    <td class="px-5 py-4 lg:px-6">
                      <div class="flex items-center gap-3">
                        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/[0.08] text-[11px] font-bold uppercase text-slate-200" aria-hidden="true">
                          {adminDisplayName(account).slice(0, 2)}
                        </span>
                        <div class="min-w-0">
                          <p class="truncate font-semibold text-white">{adminDisplayName(account)}</p>
                          <p class="truncate text-xs text-admin-muted">
                            {account.username}
                            {account.id === admin.id ? " · eres tú" : ""}
                          </p>
                        </div>
                      </div>
                    </td>
                    <td class="px-5 py-4">
                      <Badge tone={account.role === "ADMIN" ? "success" : "neutral"}>
                        {ADMIN_ROLE_LABEL[account.role]}
                      </Badge>
                    </td>
                    <td class="px-5 py-4">
                      <Badge tone={account.active ? "cyan" : "warning"}>
                        {account.active ? "Activa" : "Desactivada"}
                      </Badge>
                    </td>
                    <td class="px-5 py-4 text-admin-muted">{formatDate(account.lastLoginAt)}</td>
                    <td class="px-5 py-4 text-right lg:px-6">
                      <a
                        href={`/admin/equipo/${account.id}`}
                        class="admin-focus inline-flex min-h-9 items-center rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]"
                      >
                        Editar
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
