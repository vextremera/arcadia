---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import { getPrinters, getPrinterJobs } from "@/server/printing/mock";

function kindLabel(kind: "TICKET" | "KITCHEN") {
  return kind === "TICKET" ? "Ticket cliente" : "Comanda cocina";
}

function formatDateTime(value: string) {
  return new Intl.DateTimeFormat("es-ES", { dateStyle: "short", timeStyle: "medium", timeZone: "Europe/Madrid" }).format(new Date(value));
}

const [printers, jobs] = await Promise.all([getPrinters(), getPrinterJobs(12)]);

const onlineCount = printers.filter((p) => p.status === "ONLINE").length;

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") ?? "";
const errorParam = url.searchParams.get("error") ?? "";

const successMessage = saved === "print" ? "Prueba de impresión enviada." : saved === "status" ? "Estado actualizado." : "";
const errorMessage = errorParam === "not-found" ? "La impresora ya no existe." : errorParam === "invalid-printer" ? "Impresora no válida." : "";
---

<AdminLayout title="Impresoras · Admin · Arcadia" heading="Impresoras" description="Estado simulado de las impresoras del local y su cola de impresión.">
  <div class="space-y-6">
    {successMessage ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">{successMessage}</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{errorMessage}</section> : null}

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard icon="printer" label="Impresoras" value={String(printers.length)} helper={`${onlineCount} conectadas`} />
      <StatCard label="Cola de impresión" value={String(jobs.length)} helper="Últimos trabajos (mock)" />
    </section>

    <Card padded={false}>
      <div class="border-b border-admin-border px-5 py-4 lg:px-6">
        <h2 class="text-base font-semibold text-white">Estado de impresoras</h2>
        <p class="mt-1 text-xs text-admin-muted">Simulado — sin hardware conectado todavía.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Ubicación</th>
              <th>Tipo</th>
              <th>Estado</th>
              <th>Última señal</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {printers.map((printer) => (
              <tr>
                <td class="font-semibold text-white">{printer.name}</td>
                <td class="text-admin-muted">{printer.location}</td>
                <td class="text-admin-muted">{kindLabel(printer.kind)}</td>
                <td><Badge tone={printer.status === "ONLINE" ? "success" : "danger"}>{printer.status === "ONLINE" ? "Conectada" : "Desconectada"}</Badge></td>
                <td class="text-admin-muted">{formatDateTime(printer.lastSeenAt)}</td>
                <td>
                  <div class="flex items-center justify-end gap-2">
                    <form method="post" action="/api/admin/printers">
                      <input type="hidden" name="intent" value="toggle-status" />
                      <input type="hidden" name="printerId" value={printer.id} />
                      <button type="submit" class="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
                        {printer.status === "ONLINE" ? "Marcar desconectada" : "Marcar conectada"}
                      </button>
                    </form>
                    <form method="post" action="/api/admin/printers">
                      <input type="hidden" name="intent" value="test-print" />
                      <input type="hidden" name="printerId" value={printer.id} />
                      <button type="submit" class="rounded-xl border border-sky-400/20 bg-sky-400/10 px-3 py-1.5 text-xs font-semibold text-sky-200 transition hover:border-sky-400/30 hover:bg-sky-400/15">
                        Imprimir prueba
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>

    <Card padded={false}>
      <div class="border-b border-admin-border px-5 py-4 lg:px-6">
        <h2 class="text-base font-semibold text-white">Cola de impresión</h2>
        <p class="mt-1 text-xs text-admin-muted">Trabajos recientes (mock, no persistente a largo plazo).</p>
      </div>
      {
        jobs.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="Sin trabajos de impresión todavía" description="Usa «Imprimir prueba» en una impresora para generar uno." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Trabajo</th>
                  <th>Impresora</th>
                  <th>Fecha</th>
                </tr>
              </thead>
              <tbody>
                {jobs.map((job) => (
                  <tr>
                    <td class="font-semibold text-white">{job.label}</td>
                    <td class="text-admin-muted">{job.printerName}</td>
                    <td class="text-admin-muted">{formatDateTime(job.createdAt)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
