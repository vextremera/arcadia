---
import AdminLayout from "@/layouts/AdminLayout.astro";

const user = Astro.locals.user;

const quickActions = [
  {
    href: "/admin/pedidos",
    title: "Pedidos",
    description: "Lista completa, filtros, detalle y trazabilidad del servicio.",
    eyebrow: "Centro operativo",
  },
  {
    href: "/admin/cocina",
    title: "Cocina",
    description: "Board rápido para gestionar estados del flujo en tiempo real.",
    eyebrow: "Tiempo real",
  },
  {
    href: "/admin/operativa",
    title: "Operativa",
    description: "Horarios, pausa de pedidos, delivery y reglas del local.",
    eyebrow: "Control diario",
  },
  {
    href: "/admin/catalogo/productos",
    title: "Productos",
    description: "Base del catálogo real con edición de fichas y estructura de venta.",
    eyebrow: "Catálogo",
  },
  {
    href: "/admin/menu",
    title: "Menús",
    description: "Gestión del menú diario y festivo conectado con la página pública /menu.",
    eyebrow: "Carta del día",
  },
  {
    href: "/admin/ajustes/pagos",
    title: "Pagos y fees",
    description: "Métodos de pago disponibles y tarifa de delivery.",
    eyebrow: "Configuración",
  },
];

const statusCards = [
  {
    label: "Sesión",
    value: user?.role ?? "STAFF",
    helper: user?.name ?? user?.email ?? "Acceso autenticado al panel",
  },
  {
    label: "Objetivo",
    value: "Operativa real",
    helper: "Admin oscuro, limpio y útil para el día a día del restaurante.",
  },
  {
    label: "Estado",
    value: "En marcha",
    helper: "Pedidos, cocina, operativa, pagos, fees y menús ya tienen módulo propio.",
  },
];
---

<AdminLayout
  title="Admin · Arcadia"
  heading="Dashboard"
  description="Punto de entrada del panel. Desde aquí accedes a pedidos, cocina, operativa, catálogo y menú del día."
>
  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {statusCards.map((card) => (
      <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">
          {card.label}
        </div>
        <div class="mt-3 text-2xl font-semibold tracking-tight text-white">
          {card.value}
        </div>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          {card.helper}
        </p>
      </article>
    ))}
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)]">
    <article class="rounded-3xl border border-white/10 bg-[#111827] p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-sky-300/80">
            Hoja de ruta inmediata
          </div>
          <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
            Admin por bloques sin romper la parte pública
          </h2>
        </div>

        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/10 px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-emerald-300">
          Base activa
        </div>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
          <div class="text-sm font-semibold text-white">1. Operativa</div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Pedidos, cocina, horarios, flags y métodos de pago ya conectados a datos reales.
          </p>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
          <div class="text-sm font-semibold text-white">2. Carta del día</div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Menú diario y festivo ya tienen pantalla de gestión y se reflejan en /menu.
          </p>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
          <div class="text-sm font-semibold text-white">3. Próximo paso</div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Rematar catálogo global y consolidar categorías, ingredientes y grupos de modificadores.
          </p>
        </div>
      </div>
    </article>

    <aside class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">
        Sesión actual
      </div>

      <div class="mt-4 rounded-3xl border border-white/10 bg-white/5 p-5">
        <div class="text-sm text-slate-400">Usuario</div>
        <div class="mt-1 text-base font-semibold text-white">
          {user?.name ?? user?.email ?? "Admin"}
        </div>

        <div class="mt-4 text-sm text-slate-400">Rol</div>
        <div class="mt-1 inline-flex items-center rounded-full border border-sky-400/20 bg-sky-400/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-sky-300">
          {user?.role ?? "STAFF"}
        </div>
      </div>

      <div class="mt-4 rounded-3xl border border-amber-300/15 bg-amber-300/10 p-5">
        <div class="text-sm font-semibold text-amber-200">
          Importante
        </div>
        <p class="mt-2 text-sm leading-6 text-amber-100/80">
          Los cambios del admin deben convivir con la base actual y no romper catálogo público, checkout ni middleware.
        </p>
      </div>
    </aside>
  </section>

  <section class="mt-6 rounded-3xl border border-white/10 bg-white/5 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.28)]">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">
          Accesos
        </div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
          Módulos actuales del panel
        </h2>
      </div>

      <div class="text-sm text-slate-400">
        Rutas activas del admin
      </div>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
      {quickActions.map((item) => (
        <a
          href={item.href}
          class="group rounded-3xl border border-white/10 bg-[#0f172a]/70 p-5 transition hover:-translate-y-0.5 hover:border-sky-400/25 hover:bg-[#111c34]"
        >
          <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500 transition group-hover:text-sky-300/80">
            {item.eyebrow}
          </div>
          <div class="mt-3 text-lg font-semibold tracking-tight text-white">
            {item.title}
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            {item.description}
          </p>
          <div class="mt-5 text-sm font-semibold text-sky-300">
            Abrir módulo →
          </div>
        </a>
      ))}
    </div>
  </section>
</AdminLayout>