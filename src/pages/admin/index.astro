---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import RadialGauge from "@/components/admin/ui/RadialGauge.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import RecentAuditActivity from "@/components/admin/RecentAuditActivity.astro";
import AreaChart from "@/islands/admin/charts/AreaChart";
import BarChart from "@/islands/admin/charts/BarChart";
import { orderStatusTone, orderTypeTone } from "@/lib/admin/tones";
import {
  getSummary,
  getHourlyToday,
  getTopProducts,
  getRecentOrders,
  getTodayDateISO,
  resolveRange,
} from "@/server/analytics/queries";
import { db, AppSetting, Order, Coupon, Product, NewsletterSubscriber, eq, inArray } from "astro:db";
import type { Time } from "lightweight-charts";

type OpsFlags = { pauseOrders?: boolean; forcePickup?: boolean };

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function formatDate(value: Date | string) {
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Europe/Madrid",
  }).format(date);
}

function formatDelta(deltaPct: number | null) {
  if (deltaPct === null) return { text: undefined as string | undefined, trend: "flat" as const };
  if (Math.abs(deltaPct) < 0.05) return { text: "0.0%", trend: "flat" as const };
  const trend: "up" | "down" = deltaPct > 0 ? "up" : "down";
  return { text: `${deltaPct > 0 ? "+" : ""}${deltaPct.toFixed(1)}%`, trend };
}

const hourFormatter = (time: Time) => {
  const hour = Math.floor(Number(time) / 3600);
  return `${String(hour).padStart(2, "0")}:00`;
};

// Pedidos aún vivos: nuevos y en reparto.
const PENDING_STATUSES = ["PENDING", "OUT_FOR_DELIVERY"] as const;

const todayISO = getTodayDateISO();

const [
  summary,
  hourly,
  topProducts,
  recentOrders,
  pendingOrders,
  opsFlagsRows,
  activeCoupons,
  products,
  activeSubscribers,
] = await Promise.all([
  getSummary("day", todayISO),
  getHourlyToday(),
  getTopProducts(resolveRange("day", todayISO).current, 5),
  getRecentOrders(5),
  db.select({ id: Order.id }).from(Order).where(inArray(Order.status, [...PENDING_STATUSES])),
  db.select({ value: AppSetting.value }).from(AppSetting).where(eq(AppSetting.key, "opsFlags")).limit(1),
  db.select({ id: Coupon.id }).from(Coupon).where(eq(Coupon.active, true)),
  db.select({ id: Product.id, active: Product.active }).from(Product),
  db
    .select({ id: NewsletterSubscriber.id })
    .from(NewsletterSubscriber)
    .where(eq(NewsletterSubscriber.active, true)),
]);

const opsFlags = (opsFlagsRows[0]?.value ?? {}) as OpsFlags;

const activeProductsCount = products.filter((p) => p.active).length;
const inactiveProductsCount = products.length - activeProductsCount;

const revenueDelta = formatDelta(summary.revenueCents.deltaPct);
const ordersDelta = formatDelta(summary.ordersCount.deltaPct);

const hourlyRevenueData = hourly.today.map((b) => ({
  time: (b.hour * 3600) as Time,
  value: Math.round(b.revenueCents / 100),
}));
const hourlyRevenueCompare = hourly.lastWeek.map((b) => ({
  time: (b.hour * 3600) as Time,
  value: Math.round(b.revenueCents / 100),
}));
const hourlyOrdersData = hourly.today.map((b) => ({
  time: (b.hour * 3600) as Time,
  value: b.ordersCount,
}));

const lastWeekRevenueCents = hourly.lastWeek.reduce((sum, b) => sum + b.revenueCents, 0);
const progressPct =
  lastWeekRevenueCents > 0
    ? (summary.revenueCents.value / lastWeekRevenueCents) * 100
    : summary.revenueCents.value > 0
      ? 100
      : 0;
const progressDiffCents = summary.revenueCents.value - lastWeekRevenueCents;
const progressUp = progressDiffCents >= 0;

const quickLinks = [
  { href: "/admin/pedidos", title: "Pedidos", description: "Seguimiento y detalle operativo", tone: "primary" as const },
  { href: "/admin/cocina", title: "Cocina", description: "Board vivo para tickets en curso", tone: "violet" as const },
  { href: "/admin/operativa", title: "Operativa", description: "Flags, horarios y force pickup", tone: "warning" as const },
  { href: "/admin/catalogo/productos", title: "Catálogo", description: "Productos e ingredientes", tone: "cyan" as const },
];
---

<AdminLayout
  title="Dashboard · Admin · Arcadia"
  heading="Dashboard"
  description="Visión rápida de pedidos, operativa, catálogo y actividad reciente."
>
  <div class="space-y-8">
    <!-- Fila 1 · KPIs principales -->
    <section class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
      <StatCard
        icon="coin"
        label="Facturación hoy"
        value={money(summary.revenueCents.value)}
        delta={revenueDelta.text}
        trend={revenueDelta.trend}
      />
      <StatCard
        icon="cart"
        label="Pedidos hoy"
        value={String(summary.ordersCount.value)}
        delta={ordersDelta.text}
        trend={ordersDelta.trend}
      />
    </section>

    <!-- Fila 2 · Volumen por hora + progreso vs. semana pasada -->
    <section class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:gap-8">
      <Card padded={false}>
        <div class="px-7 pt-7 lg:px-8 lg:pt-8">
          <div class="admin-eyebrow text-sky-300/80">Volumen</div>
          <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white">Pedidos por franja horaria</h2>
        </div>
        <div class="px-3 pb-4 pt-2 lg:px-5">
          <BarChart client:visible data={hourlyOrdersData} height={300} timeLabelFormatter={hourFormatter} />
        </div>
      </Card>

      <Card class="flex flex-col">
        <div class="admin-eyebrow">Progreso</div>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white">Vs. semana pasada</h2>
        <p class="mt-2 text-sm leading-6 text-admin-muted">Facturación de hoy comparada con el mismo día de la semana anterior.</p>

        <div class="relative mx-auto mt-6 w-full max-w-[260px]">
          <RadialGauge percent={progressPct} />
          <div class="absolute inset-x-0 top-[42%] flex flex-col items-center">
            <div class="text-4xl font-semibold tracking-[-0.03em] text-white">{Math.round(progressPct)}%</div>
            <Badge tone={progressUp ? "success" : "danger"} class="mt-2">
              {progressUp ? "▲" : "▼"} {money(Math.abs(progressDiffCents))}
            </Badge>
          </div>
        </div>

        <p class="mt-6 text-center text-sm leading-6 text-admin-muted">
          Hoy llevas <span class="font-semibold text-white">{money(summary.revenueCents.value)}</span>, {" "}
          {progressUp ? "por encima" : "por debajo"} de los {money(lastWeekRevenueCents)} del mismo día hace una semana.
        </p>

        <div class="mt-auto grid grid-cols-3 gap-3 border-t border-admin-border pt-6">
          <div class="text-center">
            <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-admin-muted">Ticket medio</div>
            <div class="mt-1.5 text-lg font-semibold text-white">{money(summary.avgTicketCents.value)}</div>
          </div>
          <div class="text-center">
            <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-admin-muted">En curso</div>
            <div class="mt-1.5 text-lg font-semibold text-white">{pendingOrders.length}</div>
          </div>
          <div class="text-center">
            <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-admin-muted">Clientes</div>
            <div class="mt-1.5 text-lg font-semibold text-white">{summary.newCustomers.value}</div>
          </div>
        </div>
      </Card>
    </section>

    <!-- Fila 3 · Facturación por hora, ancho completo -->
    <section>
      <Card padded={false}>
        <div class="flex flex-wrap items-end justify-between gap-4 px-7 pt-7 lg:px-8 lg:pt-8">
          <div>
            <div class="admin-eyebrow text-sky-300/80">Facturación</div>
            <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white">Ritmo de hoy por hora</h2>
            <p class="mt-2 text-sm leading-6 text-admin-muted">
              Línea sólida: hoy. Línea discontinua: mismo día de la semana pasada.
            </p>
          </div>
        </div>
        <div class="px-3 pb-4 pt-4 lg:px-5">
          <AreaChart
            client:visible
            data={hourlyRevenueData}
            compareData={hourlyRevenueCompare}
            height={340}
            timeLabelFormatter={hourFormatter}
          />
        </div>
      </Card>
    </section>

    <!-- Fila 4 · Top productos + últimos pedidos -->
    <section class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
      <Card>
        <div class="admin-eyebrow">Ventas</div>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white">Top productos de hoy</h2>

        {
          topProducts.length === 0 ? (
            <EmptyState class="mt-6" title="Sin ventas todavía hoy" />
          ) : (
            <div class="mt-6 space-y-3">
              {topProducts.map((product, index) => (
                <div class="flex items-center justify-between gap-3 rounded-admin-lg border border-admin-border bg-white/[0.02] px-5 py-4">
                  <div class="flex min-w-0 items-center gap-4">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/[0.04] text-sm font-semibold text-admin-muted">
                      {index + 1}
                    </span>
                    <div class="min-w-0">
                      <div class="truncate text-sm font-semibold text-white">{product.name}</div>
                      <div class="text-xs text-admin-muted">{product.qty} uds.</div>
                    </div>
                  </div>
                  <div class="shrink-0 text-base font-semibold text-white">{money(product.revenueCents)}</div>
                </div>
              ))}
            </div>
          )
        }
      </Card>

      <Card padded={false}>
        <div class="flex flex-wrap items-end justify-between gap-4 px-7 pt-7 lg:px-8 lg:pt-8">
          <div>
            <div class="admin-eyebrow text-sky-300/80">Pedidos</div>
            <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white">Últimos pedidos</h2>
          </div>
          <a href="/admin/pedidos" class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06] hover:text-white">
            Ver todos
          </a>
        </div>

        {
          recentOrders.length === 0 ? (
            <div class="px-7 py-10 lg:px-8">
              <EmptyState title="Todavía no hay pedidos" />
            </div>
          ) : (
            <div class="mt-4 divide-y divide-admin-border">
              {recentOrders.map((order) => (
                <div class="flex flex-wrap items-center justify-between gap-4 px-7 py-4 lg:px-8">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <a href={`/admin/pedidos/${order.publicId}`} class="font-semibold text-white transition hover:text-sky-300">
                        {order.publicId}
                      </a>
                      <Badge tone={orderStatusTone(order.status)}>{order.status}</Badge>
                      <Badge tone={orderTypeTone(order.type)}>{order.type}</Badge>
                    </div>
                    <div class="mt-1.5 text-sm text-admin-muted">
                      {order.customerName?.trim() || "Cliente sin nombre"} · {formatDate(order.createdAt)}
                    </div>
                  </div>
                  <div class="text-lg font-semibold text-white">{money(order.totalCents)}</div>
                </div>
              ))}
            </div>
          )
        }
      </Card>
    </section>

    <!-- Fila 5 · Operativa + atajos -->
    <section class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
      <Card>
        <div class="admin-eyebrow text-amber-300/80">Operativa</div>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white">Estado rápido</h2>
        <p class="mt-2 text-sm leading-6 text-admin-muted">
          Flags y señales que afectan de forma directa a pedidos, checkout y servicio real.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          <Badge tone={opsFlags.pauseOrders ? "danger" : "success"}>
            Pedidos: {opsFlags.pauseOrders ? "Pausados" : "Activos"}
          </Badge>
          <Badge tone={opsFlags.forcePickup ? "warning" : "primary"}>
            Delivery: {opsFlags.forcePickup ? "Solo recogida" : "Normal"}
          </Badge>
          <Badge tone="fuchsia">Cupones activos: {activeCoupons.length}</Badge>
          <Badge tone="neutral">Catálogo: {activeProductsCount} activos · {inactiveProductsCount} inactivos</Badge>
          <Badge tone="cyan">Newsletter: {activeSubscribers.length}</Badge>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-3">
          <a href="/admin/operativa" class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06] hover:text-white">
            Ajustar operativa
          </a>
          <a href="/admin/audit" class="inline-flex items-center justify-center rounded-2xl border border-amber-400/20 bg-amber-400/10 px-4 py-3 text-sm font-semibold text-amber-300 transition hover:border-amber-400/30 hover:bg-amber-400/15">
            Ver audit log
          </a>
        </div>
      </Card>

      <Card>
        <div class="admin-eyebrow">Navegación</div>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white">Atajos del admin</h2>

        <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {
            quickLinks.map((item) => (
              <a href={item.href} class="block rounded-admin-lg border border-admin-border bg-white/[0.02] p-4 transition hover:border-admin-border-strong hover:bg-white/[0.04]">
                <div class="flex items-center justify-between gap-3">
                  <div class="text-sm font-semibold text-white">{item.title}</div>
                  <Badge tone={item.tone}>Abrir</Badge>
                </div>
                <p class="mt-1.5 text-sm leading-6 text-admin-muted">{item.description}</p>
              </a>
            ))
          }
        </div>
      </Card>
    </section>

    <!-- Fila 6 · Audit, ancho completo -->
    <RecentAuditActivity limit={6} />
  </div>
</AdminLayout>
