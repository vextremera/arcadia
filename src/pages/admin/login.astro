---
import SiteLayout from "@/layouts/SiteLayout.astro";

const error = Astro.url.searchParams.get("error") ?? "";

const errorMessage =
  error === "invalid" ? "Email o contraseña incorrectos." :
    error === "rate" ? "Demasiados intentos. Espera un minuto y vuelve a probar." : "";
---

<SiteLayout title="Admin Login · Arcadia" fullWidth={true}>
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(56,189,248,0.10),transparent_26%),linear-gradient(180deg,#eef2f7_0%,#f8fafc_30%,#eef2f7_100%)]"
    >
    </div>

    <div
      class="relative mx-auto flex min-h-[calc(100dvh-10rem)] w-full max-w-7xl items-center px-4 py-10 sm:px-6 lg:px-8"
    >
      <div class="grid w-full gap-8 xl:grid-cols-[minmax(0,1.05fr)_460px]">
        <section
          class="hidden rounded-[34px] border border-slate-200/80 bg-white/75 p-8 shadow-[0_24px_80px_rgba(15,23,42,0.08)] backdrop-blur xl:block 2xl:p-10"
        >
          <div class="max-w-2xl">
            <div
              class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-700"
            >
              Arcadia · administración
            </div>

            <h1
              class="mt-6 text-4xl font-semibold tracking-[-0.04em] text-slate-950 2xl:text-5xl"
            >
              Acceso al panel interno
            </h1>

            <p
              class="mt-5 max-w-2xl text-base leading-8 text-slate-600 2xl:text-lg"
            >
              Este acceso está reservado para perfiles <strong
                class="text-slate-900">ADMIN</strong
              > y{" "}
              <strong class="text-slate-900">STAFF</strong>. Desde aquí se
              centralizan pedidos, cocina, operativa, catálogo, loyalty,
              newsletter y auditoría.
            </p>

            <div class="mt-8 grid gap-4 md:grid-cols-3">
              <article
                class="rounded-[26px] border border-slate-200 bg-slate-50/80 p-5"
              >
                <div
                  class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500"
                >
                  Pedidos
                </div>
                <div class="mt-3 text-base font-semibold text-slate-950">
                  Workflow real
                </div>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                  Seguimiento, cobro, refunds y trazabilidad de actividad.
                </p>
              </article>

              <article
                class="rounded-[26px] border border-slate-200 bg-slate-50/80 p-5"
              >
                <div
                  class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500"
                >
                  Cocina
                </div>
                <div class="mt-3 text-base font-semibold text-slate-950">
                  Board operativo
                </div>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                  Vista viva de tickets en curso y transiciones rápidas.
                </p>
              </article>

              <article
                class="rounded-[26px] border border-slate-200 bg-slate-50/80 p-5"
              >
                <div
                  class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500"
                >
                  Catálogo
                </div>
                <div class="mt-3 text-base font-semibold text-slate-950">
                  Gestión consolidada
                </div>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                  Productos, ingredientes, modificadores y compatibilidades.
                </p>
              </article>
            </div>

            <div
              class="mt-8 rounded-[28px] border border-slate-200 bg-white p-6"
            >
              <div class="text-sm font-semibold text-slate-950">
                Acceso restringido
              </div>
              <p class="mt-3 text-sm leading-7 text-slate-600">
                Si tu cuenta existe pero no tiene rol interno válido, el acceso
                seguirá siendo rechazado. La validación real se hace en <code
                  >/api/admin/login</code
                > sobre usuario activo y rol permitido.
              </p>
            </div>
          </div>
        </section>

        <section class="flex items-center justify-center">
          <div
            class="w-full max-w-[460px] rounded-[34px] border border-white/10 bg-[#0f172a]/92 p-6 shadow-[0_30px_100px_rgba(2,6,23,0.45)] backdrop-blur sm:p-8"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-[18px] bg-sky-400/12 ring-1 ring-sky-300/15"
              >
                <img
                  src="/ARCADIA_LOGO.svg"
                  alt="Arcadia"
                  class="h-7 w-7 object-contain"
                />
              </div>

              <div>
                <div
                  class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500"
                >
                  Admin login
                </div>
                <h2
                  class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-white"
                >
                  Entrar al panel
                </h2>
              </div>
            </div>

            <p class="mt-4 text-sm leading-7 text-slate-400">
              Usa una cuenta interna válida para acceder a la administración de
              Arcadia.
            </p>

            {
              errorMessage ? (
                <div class="mt-6 rounded-[24px] border border-rose-400/20 bg-rose-400/10 px-4 py-3 text-sm text-rose-200">
                  {errorMessage}
                </div>
              ) : null
            }

            <form
              class="mt-6 grid gap-5"
              method="post"
              action="/api/admin/login"
            >
              <label class="block">
                <span
                  class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
                >
                  Email
                </span>
                <input
                  class="w-full rounded-[24px] border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/40 focus:outline-none"
                  name="email"
                  type="email"
                  autocomplete="username"
                  placeholder="staff@arcadia.local"
                  required
                />
              </label>

              <label class="block">
                <span
                  class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
                >
                  Contraseña
                </span>
                <input
                  class="w-full rounded-[24px] border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/40 focus:outline-none"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  placeholder="Tu contraseña"
                  required
                />
              </label>

              <button
                class="inline-flex min-h-11 items-center justify-center rounded-[24px] bg-sky-500 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-400"
                type="submit"
              >
                Entrar
              </button>
            </form>

            <div
              class="mt-6 rounded-[26px] border border-white/10 bg-white/[0.03] p-4"
            >
              <div class="text-sm font-semibold text-white">
                Qué valida el acceso
              </div>
              <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-400">
                <li>• Cuenta activa</li>
                <li>• Contraseña correcta</li>
                <li>• Rol ADMIN o STAFF</li>
              </ul>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</SiteLayout>
