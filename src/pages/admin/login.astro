---
import "@/styles/global.css";

/**
 * Puerta del panel.
 *
 * No usa SiteLayout ni AdminLayout a propósito: la cabecera y el pie de la web
 * pública no pintan nada aquí, y AdminLayout monta la barra lateral, que
 * presupone una sesión que todavía no existe. Así que es un documento propio,
 * pero con los mismos tokens de color y radios que el resto del panel: quien
 * entra ya está viendo la interfaz en la que va a trabajar.
 */

const error = Astro.url.searchParams.get("error") ?? "";

const errorMessage =
  error === "invalid" ? "Usuario o contraseña incorrectos." :
  error === "rate" ? "Demasiados intentos. Espera un minuto y vuelve a probar." : "";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/ARCADIA_LOGO.svg" />
    <title>Entrar al panel · Arcadia</title>
  </head>

  <body
    data-admin-ui="true"
    class="min-h-dvh bg-admin-bg text-admin-text antialiased"
  >
    <main class="relative flex min-h-dvh items-center justify-center px-4 py-10">
      <!--
        Un resplandor muy suave arriba, el mismo azul de acción del panel.
        Va detrás de todo y no captura el puntero.
      -->
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_-10%,rgba(56,189,248,0.10),transparent_55%)]"
        aria-hidden="true"
      >
      </div>

      <div class="relative w-full max-w-[26rem]">
        <div class="flex flex-col items-center text-center">
          <span
            class="inline-flex h-14 w-14 items-center justify-center rounded-admin-lg bg-white/[0.04] ring-1 ring-admin-border"
          >
            <img src="/ARCADIA_LOGO.svg" alt="" class="h-8 w-8 object-contain" aria-hidden="true" />
          </span>

          <h1 class="mt-5 text-2xl font-semibold tracking-[-0.02em] text-white">
            Panel de Arcadia
          </h1>
          <p class="mt-1.5 text-sm text-admin-muted">
            Entra con tu usuario del bar.
          </p>
        </div>

        <div
          class="mt-7 rounded-admin-xl border border-admin-border bg-admin-surface p-6 shadow-[0_24px_70px_rgba(0,0,0,0.45)] sm:p-7"
        >
          {
            errorMessage ? (
              <div
                class="mb-5 rounded-admin border border-rose-400/20 bg-rose-400/10 px-4 py-3 text-sm text-rose-200"
                role="alert"
              >
                {errorMessage}
              </div>
            ) : null
          }

          <form method="post" action="/api/admin/login" class="grid gap-4">
            <label class="block">
              <span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-admin-muted">
                Usuario
              </span>
              <input
                class="admin-focus w-full rounded-admin border border-admin-border bg-white/[0.03] px-4 py-3 text-sm text-white placeholder:text-admin-faint focus:border-sky-400/40 focus:outline-none"
                name="username"
                type="text"
                autocomplete="username"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                placeholder="marta"
                required
                autofocus
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-admin-muted">
                Contraseña
              </span>
              <input
                class="admin-focus w-full rounded-admin border border-admin-border bg-white/[0.03] px-4 py-3 text-sm text-white placeholder:text-admin-faint focus:border-sky-400/40 focus:outline-none"
                name="password"
                type="password"
                autocomplete="current-password"
                placeholder="••••••••"
                required
              />
            </label>

            <button
              class="admin-focus mt-1 inline-flex min-h-12 items-center justify-center rounded-admin border border-sky-400/20 bg-sky-400/10 px-5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15"
              type="submit"
            >
              Entrar
            </button>
          </form>
        </div>

        <p class="mt-5 text-center text-xs leading-6 text-admin-faint">
          ¿Olvidaste la contraseña? Pídele a un admin total que te la restablezca
          desde <span class="text-admin-muted">Equipo</span>.
        </p>

        <p class="mt-1 text-center text-xs text-admin-faint">
          <a class="admin-focus rounded transition hover:text-admin-muted" href="/">
            ← Volver a la web
          </a>
        </p>
      </div>
    </main>
  </body>
</html>
