---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db, LoyaltyTier, UserProfile, User, inArray } from "astro:db";

type TierRow = {
  id: number;
  name: string;
  minPoints: number;
  perks: unknown;
  active: boolean;
  sortOrder: number;
};

type UserProfileRow = {
  id: number;
  userId: number;
  pointsBalance: number;
  tierId: number | null;
};

type UserRow = {
  id: number;
  name: string | null;
  email: string;
  active: boolean;
  role: string;
};

type TierSummary = {
  tier: TierRow;
  assignedUserCount: number;
  activeAssignedUserCount: number;
  highestPointsInTier: number;
};

function safePerksText(perks: unknown) {
  if (!perks) return "";
  try {
    return JSON.stringify(perks, null, 2);
  } catch {
    return "";
  }
}

function moneyPoints(points: number) {
  return `${Number(points ?? 0)} pts`;
}

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") ?? "";
const error = url.searchParams.get("error") ?? "";

const tiers = (await db
  .select({
    id: LoyaltyTier.id,
    name: LoyaltyTier.name,
    minPoints: LoyaltyTier.minPoints,
    perks: LoyaltyTier.perks,
    active: LoyaltyTier.active,
    sortOrder: LoyaltyTier.sortOrder,
  })
  .from(LoyaltyTier)) as TierRow[];

const sortedTiers = [...tiers].sort((a, b) => {
  if (a.sortOrder !== b.sortOrder) return a.sortOrder - b.sortOrder;
  if (a.minPoints !== b.minPoints) return a.minPoints - b.minPoints;
  return a.name.localeCompare(b.name, "es");
});

const profiles = (await db
  .select({
    id: UserProfile.id,
    userId: UserProfile.userId,
    pointsBalance: UserProfile.pointsBalance,
    tierId: UserProfile.tierId,
  })
  .from(UserProfile)) as UserProfileRow[];

const userIds = [...new Set(profiles.map((profile) => profile.userId))];

const users = userIds.length
  ? ((await db
      .select({
        id: User.id,
        name: User.name,
        email: User.email,
        active: User.active,
        role: User.role,
      })
      .from(User)
      .where(inArray(User.id, userIds))) as UserRow[])
  : [];

const userById = new Map(users.map((user) => [user.id, user]));

const assignedCountByTier = new Map<number, number>();
const activeAssignedCountByTier = new Map<number, number>();
const highestPointsByTier = new Map<number, number>();

for (const profile of profiles) {
  if (typeof profile.tierId !== "number") continue;

  assignedCountByTier.set(
    profile.tierId,
    (assignedCountByTier.get(profile.tierId) ?? 0) + 1,
  );

  const linkedUser = userById.get(profile.userId);
  if (linkedUser?.active) {
    activeAssignedCountByTier.set(
      profile.tierId,
      (activeAssignedCountByTier.get(profile.tierId) ?? 0) + 1,
    );
  }

  highestPointsByTier.set(
    profile.tierId,
    Math.max(
      highestPointsByTier.get(profile.tierId) ?? 0,
      Number(profile.pointsBalance ?? 0),
    ),
  );
}

const summaries: TierSummary[] = sortedTiers.map((tier) => ({
  tier,
  assignedUserCount: assignedCountByTier.get(tier.id) ?? 0,
  activeAssignedUserCount: activeAssignedCountByTier.get(tier.id) ?? 0,
  highestPointsInTier: highestPointsByTier.get(tier.id) ?? 0,
}));

const usersWithoutTier = profiles.filter(
  (profile) => profile.tierId === null,
).length;
const activeTiers = sortedTiers.filter((tier) => tier.active).length;
const totalTiers = sortedTiers.length;

const bestTier =
  [...sortedTiers]
    .filter((tier) => tier.active)
    .sort((a, b) => b.minPoints - a.minPoints)[0] ?? null;

const successMessage =
  saved === "tier"
    ? "Tier actualizado correctamente."
    : saved === "delete"
      ? "Tier borrado correctamente."
      : "";

const errorMessage =
  error === "missing-name"
    ? "El nombre del tier es obligatorio."
    : error === "invalid-min-points"
      ? "El mínimo de puntos no es válido."
      : error === "invalid-sort-order"
        ? "El orden no es válido."
        : error === "invalid-perks-json"
          ? "El JSON de perks no es válido."
          : error === "invalid-tier"
            ? "El tier indicado no es válido."
            : error === "not-found"
              ? "El tier ya no existe."
              : error === "tier-in-use"
                ? "No se puede borrar un tier que sigue asignado a usuarios."
                : error === "invalid-intent"
                  ? "Acción no válida."
                  : "";

const summaryCards = [
  {
    label: "Tiers",
    value: totalTiers,
    note: "Niveles definidos",
    tone: "border-white/10 bg-white/[0.03]",
  },
  {
    label: "Activos",
    value: activeTiers,
    note: "Disponibles para asignación",
    tone: "border-emerald-400/15 bg-emerald-400/8",
  },
  {
    label: "Sin tier",
    value: usersWithoutTier,
    note: "Perfiles aún sin nivel",
    tone: "border-violet-400/15 bg-violet-400/8",
  },
  {
    label: "Tier top",
    value: bestTier?.name ?? "—",
    note: bestTier ? `${bestTier.minPoints} pts mínimo` : "Sin tiers activos",
    tone: "border-cyan-400/15 bg-cyan-400/8",
  },
];
---

<AdminLayout
  title="Loyalty · Admin · Arcadia"
  heading="Loyalty"
  description="Gestión de tiers basada en puntos reales. Esta pantalla ahora prioriza lectura clara del sistema de niveles, usuarios asignados y umbrales sin comprimir demasiada información por bloque."
  actions={true}
>
  <Fragment slot="actions">
    <div class="flex flex-wrap gap-3">
      <a
        href="/admin/usuarios"
        class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15"
      >
        Ver usuarios
      </a>

      <a
        href="/cuenta"
        target="_blank"
        rel="noreferrer"
        class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06] hover:text-white"
      >
        Ver cuenta pública
      </a>
    </div>
  </Fragment>

  {
    successMessage ? (
      <section class="mb-6 rounded-[26px] border border-emerald-400/20 bg-emerald-400/10 px-5 py-4 text-sm text-emerald-200">
        {successMessage}
      </section>
    ) : null
  }

  {
    errorMessage ? (
      <section class="mb-6 rounded-[26px] border border-rose-400/20 bg-rose-400/10 px-5 py-4 text-sm text-rose-200">
        {errorMessage}
      </section>
    ) : null
  }

  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {
      summaryCards.map((card) => (
        <article
          class:list={[
            "rounded-[28px] border p-6 shadow-[0_18px_60px_rgba(2,6,23,0.28)]",
            card.tone,
          ]}
        >
          <div class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500">
            {card.label}
          </div>
          <div class="mt-4 text-4xl font-semibold tracking-[-0.05em] text-white">
            {card.value}
          </div>
          <p class="mt-3 text-sm leading-6 text-slate-400">{card.note}</p>
        </article>
      ))
    }
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[420px_minmax(0,1fr)]">
    <aside class="space-y-6">
      <section
        class="rounded-[32px] border border-white/10 bg-[#0f172a]/82 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.34)] lg:p-7"
      >
        <div
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
        >
          Alta
        </div>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white">
          Nuevo tier
        </h2>
        <p class="mt-3 text-sm leading-7 text-slate-400">
          Define un nombre, su umbral mínimo, el orden de presentación y los
          perks serializados en JSON.
        </p>

        <form
          method="post"
          action="/api/admin/loyalty-tiers"
          class="mt-7 grid gap-5"
        >
          <input type="hidden" name="intent" value="create" />

          <label class="block">
            <span
              class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
            >
              Nombre
            </span>
            <input
              class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
              type="text"
              name="name"
              placeholder="Bronce"
              required
            />
          </label>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span
                class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
              >
                Mínimo puntos
              </span>
              <input
                class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                type="number"
                name="minPoints"
                min="0"
                step="1"
                value="0"
                required
              />
            </label>

            <label class="block">
              <span
                class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
              >
                Orden
              </span>
              <input
                class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                type="number"
                name="sortOrder"
                min="0"
                step="1"
                value={sortedTiers.length}
                required
              />
            </label>
          </div>

          <label class="block">
            <span
              class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
            >
              Perks JSON
            </span>
            <textarea
              class="min-h-32 w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
              name="perks"
              placeholder='{"benefits":["prioridad soporte","promo local"]}'
            ></textarea>
          </label>

          <label
            class="inline-flex items-center gap-3 rounded-[22px] border border-white/10 bg-white/[0.03] p-4 text-sm text-slate-300"
          >
            <input
              class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400"
              type="checkbox"
              name="active"
              checked
            />
            Tier activo
          </label>

          <button
            type="submit"
            class="inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15"
          >
            Crear tier
          </button>
        </form>
      </section>

      <section
        class="rounded-[32px] border border-white/10 bg-[#0b1220]/90 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.34)] lg:p-7"
      >
        <div
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
        >
          Criterio
        </div>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white">
          Cómo asigna el sistema
        </h2>

        <div class="mt-6 space-y-4">
          <article
            class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4"
          >
            <div class="text-sm font-semibold text-white">
              Por puntos reales
            </div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              El tier se asigna automáticamente según <code>pointsBalance</code> y
              el <code>minPoints</code> más alto que el usuario cumpla.
            </p>
          </article>

          <article
            class="rounded-[24px] border border-cyan-400/20 bg-cyan-400/10 p-4"
          >
            <div class="text-sm font-semibold text-cyan-200">
              Recalculo global
            </div>
            <p class="mt-2 text-sm leading-6 text-cyan-100/80">
              Crear, editar o desactivar tiers recalcula <code
                >UserProfile.tierId</code
              > para no dejar datos incoherentes.
            </p>
          </article>

          <article
            class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4"
          >
            <div class="text-sm font-semibold text-white">
              Borrado protegido
            </div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
              Un tier no se puede borrar mientras siga asignado a perfiles.
            </p>
          </article>
        </div>
      </section>
    </aside>

    <section
      class="overflow-hidden rounded-[32px] border border-white/10 bg-[#0f172a]/82 shadow-[0_24px_80px_rgba(2,6,23,0.34)]"
    >
      <div class="border-b border-white/[0.08] px-6 py-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <div
              class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
            >
              Gestión
            </div>
            <h2
              class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white lg:text-[2rem]"
            >
              Tiers de loyalty
            </h2>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-400">
              Cada tier muestra umbral, usuarios asignados, usuarios activos y
              pico actual de puntos, con edición completa en un bloque mucho más
              legible.
            </p>
          </div>

          <div
            class="inline-flex items-center rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm text-slate-300"
          >
            Basado en LoyaltyTier + UserProfile
          </div>
        </div>
      </div>

      {
        summaries.length === 0 ? (
          <div class="px-6 py-16 text-center lg:px-8">
            <div class="mx-auto max-w-md rounded-[28px] border border-white/10 bg-[#091121] p-8">
              <div class="text-lg font-semibold text-white">
                No hay tiers todavía
              </div>
              <p class="mt-2 text-sm leading-6 text-slate-400">
                Crea el primero desde el formulario lateral.
              </p>
            </div>
          </div>
        ) : (
          <div class="space-y-5 px-6 py-6 lg:px-8 lg:py-8">
            {summaries.map((summary) => {
              const canDelete = summary.assignedUserCount === 0;

              return (
                <section class="rounded-[28px] border border-white/10 bg-[#091121]/80 p-5 shadow-[0_18px_60px_rgba(2,6,23,0.22)] lg:p-6">
                  <div class="flex flex-col gap-5 border-b border-white/[0.08] pb-5 lg:flex-row lg:items-start lg:justify-between">
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2.5">
                        <h3 class="text-xl font-semibold tracking-[-0.03em] text-white">
                          {summary.tier.name}
                        </h3>

                        <span
                          class:list={[
                            "inline-flex items-center rounded-full border px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em]",
                            summary.tier.active
                              ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
                              : "border-rose-400/20 bg-rose-400/10 text-rose-300",
                          ]}
                        >
                          {summary.tier.active ? "Activo" : "Inactivo"}
                        </span>

                        <span class="inline-flex items-center rounded-full border border-sky-400/20 bg-sky-400/10 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-sky-300">
                          {summary.tier.minPoints} pts mínimo
                        </span>

                        <span class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-300">
                          Orden {summary.tier.sortOrder}
                        </span>
                      </div>
                    </div>

                    <div class="grid gap-3 sm:grid-cols-3 lg:w-[430px]">
                      <div class="rounded-[22px] border border-white/10 bg-white/[0.03] px-4 py-3">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                          Asignados
                        </div>
                        <div class="mt-2 text-lg font-semibold text-white">
                          {summary.assignedUserCount}
                        </div>
                      </div>

                      <div class="rounded-[22px] border border-white/10 bg-white/[0.03] px-4 py-3">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                          Activos
                        </div>
                        <div class="mt-2 text-lg font-semibold text-white">
                          {summary.activeAssignedUserCount}
                        </div>
                      </div>

                      <div class="rounded-[22px] border border-white/10 bg-white/[0.03] px-4 py-3">
                        <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                          Pico actual
                        </div>
                        <div class="mt-2 text-lg font-semibold text-white">
                          {moneyPoints(summary.highestPointsInTier)}
                        </div>
                      </div>
                    </div>
                  </div>

                  <form
                    method="post"
                    action="/api/admin/loyalty-tiers"
                    class="mt-6 grid gap-5"
                  >
                    <input type="hidden" name="intent" value="update" />
                    <input
                      type="hidden"
                      name="tierId"
                      value={summary.tier.id}
                    />

                    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_180px_140px]">
                      <label class="block">
                        <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                          Nombre
                        </span>
                        <input
                          class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                          type="text"
                          name="name"
                          value={summary.tier.name}
                          required
                        />
                      </label>

                      <label class="block">
                        <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                          Mínimo puntos
                        </span>
                        <input
                          class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                          type="number"
                          name="minPoints"
                          min="0"
                          step="1"
                          value={summary.tier.minPoints}
                          required
                        />
                      </label>

                      <label class="block">
                        <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                          Orden
                        </span>
                        <input
                          class="w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                          type="number"
                          name="sortOrder"
                          min="0"
                          step="1"
                          value={summary.tier.sortOrder}
                          required
                        />
                      </label>
                    </div>

                    <label class="block">
                      <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                        Perks JSON
                      </span>
                      <textarea
                        class="min-h-32 w-full rounded-2xl border border-white/10 bg-[#07101f] px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                        name="perks"
                      >
                        {safePerksText(summary.tier.perks)}
                      </textarea>
                    </label>

                    <div class="flex flex-col gap-4 border-t border-white/[0.08] pt-5 lg:flex-row lg:items-center lg:justify-between">
                      <label class="inline-flex items-center gap-3 text-sm text-slate-300">
                        <input
                          class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400"
                          type="checkbox"
                          name="active"
                          checked={summary.tier.active}
                        />
                        Tier activo
                      </label>

                      <button
                        type="submit"
                        class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15"
                      >
                        Guardar tier
                      </button>
                    </div>
                  </form>

                  <div class="mt-5 flex flex-col gap-4 border-t border-white/[0.08] pt-5 lg:flex-row lg:items-center lg:justify-between">
                    <p class="text-sm leading-6 text-slate-500">
                      {canDelete
                        ? "Se puede borrar porque no tiene perfiles asignados."
                        : `No se puede borrar porque tiene ${summary.assignedUserCount} perfil${summary.assignedUserCount === 1 ? "" : "es"} asignado${summary.assignedUserCount === 1 ? "" : "s"}.`}
                    </p>

                    <form method="post" action="/api/admin/loyalty-tiers">
                      <input type="hidden" name="intent" value="delete" />
                      <input
                        type="hidden"
                        name="tierId"
                        value={summary.tier.id}
                      />
                      <button
                        type="submit"
                        disabled={!canDelete}
                        class:list={[
                          "inline-flex min-h-10 items-center justify-center rounded-2xl px-4 py-2.5 text-sm font-semibold transition",
                          canDelete
                            ? "border border-rose-400/20 bg-rose-400/10 text-rose-300 hover:border-rose-400/30 hover:bg-rose-400/15"
                            : "cursor-not-allowed border border-white/10 bg-white/[0.03] text-slate-500",
                        ]}
                      >
                        Borrar tier
                      </button>
                    </form>
                  </div>
                </section>
              );
            })}
          </div>
        )
      }
    </section>
  </section>
</AdminLayout>
