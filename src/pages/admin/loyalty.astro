---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import { db, LoyaltyTier, UserProfile, User, inArray } from "astro:db";

type TierRow = {
  id: number;
  name: string;
  minPoints: number;
  perks: unknown;
  active: boolean;
  sortOrder: number;
};

function safePerksText(perks: unknown) {
  if (!perks) return "";
  try {
    return JSON.stringify(perks, null, 2);
  } catch {
    return "";
  }
}

function perksSummary(perks: unknown) {
  if (!perks || typeof perks !== "object") return "—";
  const benefits = (perks as Record<string, unknown>).benefits;
  if (Array.isArray(benefits) && benefits.length) {
    return benefits.map((item) => String(item)).join(" · ");
  }
  const keys = Object.keys(perks as Record<string, unknown>);
  return keys.length ? `${keys.length} clave(s)` : "—";
}

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") ?? "";
const error = url.searchParams.get("error") ?? "";

const tiers = (await db
  .select({
    id: LoyaltyTier.id,
    name: LoyaltyTier.name,
    minPoints: LoyaltyTier.minPoints,
    perks: LoyaltyTier.perks,
    active: LoyaltyTier.active,
    sortOrder: LoyaltyTier.sortOrder,
  })
  .from(LoyaltyTier)) as TierRow[];

const sortedTiers = [...tiers].sort((a, b) => {
  if (a.sortOrder !== b.sortOrder) return a.sortOrder - b.sortOrder;
  if (a.minPoints !== b.minPoints) return a.minPoints - b.minPoints;
  return a.name.localeCompare(b.name, "es");
});

const profiles = await db
  .select({ userId: UserProfile.userId, pointsBalance: UserProfile.pointsBalance, tierId: UserProfile.tierId })
  .from(UserProfile);

const userIds = [...new Set(profiles.map((profile) => profile.userId))];

const users = userIds.length
  ? await db.select({ id: User.id, active: User.active }).from(User).where(inArray(User.id, userIds))
  : [];

const userById = new Map(users.map((user) => [user.id, user]));

const assignedCountByTier = new Map<number, number>();
const activeAssignedCountByTier = new Map<number, number>();

for (const profile of profiles) {
  if (typeof profile.tierId !== "number") continue;
  assignedCountByTier.set(profile.tierId, (assignedCountByTier.get(profile.tierId) ?? 0) + 1);
  if (userById.get(profile.userId)?.active) {
    activeAssignedCountByTier.set(profile.tierId, (activeAssignedCountByTier.get(profile.tierId) ?? 0) + 1);
  }
}

const usersWithoutTier = profiles.filter((profile) => profile.tierId === null).length;
const activeTiers = sortedTiers.filter((tier) => tier.active).length;
const totalTiers = sortedTiers.length;

const successMessage =
  saved === "tier" ? "Tier actualizado correctamente." : saved === "delete" ? "Tier borrado correctamente." : "";

const errorMessage =
  error === "missing-name" ? "El nombre del tier es obligatorio." :
  error === "invalid-min-points" ? "El mínimo de puntos no es válido." :
  error === "invalid-sort-order" ? "El orden no es válido." :
  error === "invalid-perks-json" ? "El JSON de perks no es válido." :
  error === "invalid-tier" ? "El tier indicado no es válido." :
  error === "not-found" ? "El tier ya no existe." :
  error === "tier-in-use" ? "No se puede borrar un tier que sigue asignado a usuarios." :
  error === "invalid-intent" ? "Acción no válida." :
  "";
---

<AdminLayout title="Loyalty tiers · Admin · Arcadia" heading="Loyalty tiers" description="Niveles de fidelización, umbrales de puntos y perks asociados.">
  <div class="space-y-6">
    {successMessage ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">{successMessage}</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{errorMessage}</section> : null}

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard icon="coin" label="Tiers" value={String(totalTiers)} helper={`${activeTiers} activos`} />
      <StatCard label="Clientes sin tier" value={String(usersWithoutTier)} helper="Perfiles por debajo del primer umbral" />
    </section>

    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <h2 class="text-base font-semibold text-white">Niveles de fidelización</h2>

        <Modal id="tier-create" title="Nuevo tier" description="Umbral de puntos, orden de visualización y perks opcionales en JSON." triggerLabel="+ Nuevo tier">
          <form method="post" action="/api/admin/loyalty-tiers" class="grid gap-4">
            <input type="hidden" name="intent" value="create" />

            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Nombre</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="name" placeholder="Bronce" required />
            </label>

            <div class="grid grid-cols-2 gap-4">
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Mínimo puntos</span>
                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="number" name="minPoints" min="0" step="1" value="0" required />
              </label>
              <label class="block">
                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Orden</span>
                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="number" name="sortOrder" min="0" step="1" value={sortedTiers.length} required />
              </label>
            </div>

            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Perks (JSON)</span>
              <textarea class="min-h-28 w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 font-mono text-xs text-white focus:border-sky-400/40 focus:outline-none" name="perks" placeholder={'{"benefits":["prioridad soporte"]}'}></textarea>
            </label>

            <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="active" checked />
              Tier activo
            </label>

            <button type="submit" class="mt-1 inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
              Crear tier
            </button>
          </form>
        </Modal>
      </div>

      {
        sortedTiers.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="Todavía no hay tiers" description="Crea el primer nivel con el botón de arriba." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Tier</th>
                  <th>Mínimo</th>
                  <th>Orden</th>
                  <th>Perks</th>
                  <th>Clientes</th>
                  <th>Estado</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {sortedTiers.map((tier) => {
                  const assigned = assignedCountByTier.get(tier.id) ?? 0;
                  const activeAssigned = activeAssignedCountByTier.get(tier.id) ?? 0;
                  const canDelete = assigned === 0;

                  return (
                    <tr>
                      <td class="font-semibold text-white">{tier.name}</td>
                      <td class="text-admin-muted">{tier.minPoints} pts</td>
                      <td class="text-admin-muted">{tier.sortOrder}</td>
                      <td class="max-w-[240px] truncate text-admin-muted">{perksSummary(tier.perks)}</td>
                      <td class="text-admin-muted">{assigned} ({activeAssigned} activos)</td>
                      <td><Badge tone={tier.active ? "success" : "danger"}>{tier.active ? "Activo" : "Inactivo"}</Badge></td>
                      <td>
                        <div class="flex justify-end">
                          <Modal
                            id={`tier-edit-${tier.id}`}
                            title={tier.name}
                            triggerLabel="Editar"
                            triggerClass="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]"
                          >
                            <form method="post" action="/api/admin/loyalty-tiers" class="grid gap-4">
                              <input type="hidden" name="intent" value="update" />
                              <input type="hidden" name="tierId" value={tier.id} />

                              <label class="block">
                                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Nombre</span>
                                <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="name" value={tier.name} required />
                              </label>

                              <div class="grid grid-cols-2 gap-4">
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Mínimo puntos</span>
                                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="number" name="minPoints" min="0" step="1" value={tier.minPoints} required />
                                </label>
                                <label class="block">
                                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Orden</span>
                                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="number" name="sortOrder" min="0" step="1" value={tier.sortOrder} required />
                                </label>
                              </div>

                              <label class="block">
                                <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Perks (JSON)</span>
                                <textarea class="min-h-28 w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 font-mono text-xs text-white focus:border-sky-400/40 focus:outline-none" name="perks">{safePerksText(tier.perks)}</textarea>
                              </label>

                              <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                                <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="active" checked={tier.active} />
                                Tier activo
                              </label>

                              <button type="submit" class="mt-1 inline-flex min-h-10 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
                                Guardar
                              </button>
                            </form>

                            <form method="post" action="/api/admin/loyalty-tiers" class="mt-3 border-t border-admin-border pt-3">
                              <input type="hidden" name="intent" value="delete" />
                              <input type="hidden" name="tierId" value={tier.id} />
                              <div class="flex items-center justify-between gap-3">
                                <span class="text-xs leading-5 text-admin-muted">
                                  {canDelete ? "Se puede borrar: sin clientes asignados." : `No se puede borrar: ${assigned} cliente(s) en este tier.`}
                                </span>
                                <button
                                  type="submit"
                                  disabled={!canDelete}
                                  class:list={[
                                    "inline-flex min-h-9 shrink-0 items-center justify-center rounded-2xl px-4 py-2 text-sm font-semibold transition",
                                    canDelete
                                      ? "border border-rose-400/20 bg-rose-400/10 text-rose-300 hover:border-rose-400/30 hover:bg-rose-400/15"
                                      : "cursor-not-allowed border border-admin-border bg-white/[0.03] text-slate-500",
                                  ]}
                                >
                                  Borrar tier
                                </button>
                              </div>
                            </form>
                          </Modal>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
