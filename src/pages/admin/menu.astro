---
import AdminLayout from "@/layouts/AdminLayout.astro";
import {
  db,
  Menu as MenuTable,
  MenuItem as MenuItemTable,
  Product,
  Category,
  eq,
} from "astro:db";

type MenuKind = "DIARIO" | "FESTIVO";
type MenuCourse = "PRIMERO" | "SEGUNDO" | "POSTRE";

type MenuRow = {
  id: number;
  title: string;
  kind: MenuKind;
  active: boolean;
  validFrom: Date | null;
  validTo: Date | null;
};

type ProductOption = {
  id: number;
  name: string;
  active: boolean;
  categoryName: string;
};

type MenuItemRow = {
  id: number;
  menuId: number;
  productId: number;
  course: MenuCourse;
  printOrder: number;
  sortOrder: number;
  productName: string;
  productActive: boolean;
  categoryName: string;
};

type MenuEntry = MenuRow & {
  items: MenuItemRow[];
  grouped: {
    PRIMERO: MenuItemRow[];
    SEGUNDO: MenuItemRow[];
    POSTRE: MenuItemRow[];
  };
};

function formatDateInput(value: Date | string | null) {
  if (!value) return "";
  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) return "";
  return date.toISOString().slice(0, 10);
}

function courseLabel(course: MenuCourse) {
  return course === "PRIMERO"
    ? "Entrantes"
    : course === "SEGUNDO"
      ? "Principales"
      : "Postres";
}

const url = new URL(Astro.request.url);
const menuSaved = url.searchParams.get("menuSaved") === "1";
const menuError = url.searchParams.get("menuError") ?? "";
const menuItemSaved = url.searchParams.get("menuItemSaved") === "1";
const menuItemError = url.searchParams.get("menuItemError") ?? "";

const menusRaw = await db
  .select({
    id: MenuTable.id,
    title: MenuTable.title,
    kind: MenuTable.kind,
    active: MenuTable.active,
    validFrom: MenuTable.validFrom,
    validTo: MenuTable.validTo,
  })
  .from(MenuTable);

const menus = menusRaw as MenuRow[];

const productRows = await db
  .select({
    id: Product.id,
    name: Product.name,
    active: Product.active,
    categoryName: Category.name,
  })
  .from(Product)
  .innerJoin(Category, eq(Product.categoryId, Category.id));

const productOptions = [...(productRows as ProductOption[])].sort((a, b) => {
  if (a.categoryName !== b.categoryName) {
    return a.categoryName.localeCompare(b.categoryName, "es");
  }
  return a.name.localeCompare(b.name, "es");
});

const menuItemRows = await db
  .select({
    id: MenuItemTable.id,
    menuId: MenuItemTable.menuId,
    productId: MenuItemTable.productId,
    course: MenuItemTable.course,
    printOrder: MenuItemTable.printOrder,
    sortOrder: MenuItemTable.sortOrder,
    productName: Product.name,
    productActive: Product.active,
    categoryName: Category.name,
  })
  .from(MenuItemTable)
  .innerJoin(Product, eq(MenuItemTable.productId, Product.id))
  .innerJoin(Category, eq(Product.categoryId, Category.id));

const allMenuItems = menuItemRows as MenuItemRow[];

const menuItemsByMenuId = new Map<number, MenuItemRow[]>();
for (const item of allMenuItems) {
  const current = menuItemsByMenuId.get(item.menuId) ?? [];
  current.push(item);
  menuItemsByMenuId.set(item.menuId, current);
}

const menuEntries: MenuEntry[] = [...menus]
  .sort((a, b) => {
    if (a.kind !== b.kind) return a.kind.localeCompare(b.kind, "es");
    const aTime = a.validFrom ? new Date(a.validFrom).getTime() : 0;
    const bTime = b.validFrom ? new Date(b.validFrom).getTime() : 0;
    if (aTime !== bTime) return bTime - aTime;
    return b.id - a.id;
  })
  .map((menu) => {
    const items = [...(menuItemsByMenuId.get(menu.id) ?? [])].sort((a, b) => {
      const orderMap: Record<MenuCourse, number> = {
        PRIMERO: 1,
        SEGUNDO: 2,
        POSTRE: 3,
      };

      const c = orderMap[a.course] - orderMap[b.course];
      if (c !== 0) return c;
      if (a.sortOrder !== b.sortOrder) return a.sortOrder - b.sortOrder;
      if (a.printOrder !== b.printOrder) return a.printOrder - b.printOrder;
      return a.id - b.id;
    });

    return {
      ...menu,
      items,
      grouped: {
        PRIMERO: items.filter((item) => item.course === "PRIMERO"),
        SEGUNDO: items.filter((item) => item.course === "SEGUNDO"),
        POSTRE: items.filter((item) => item.course === "POSTRE"),
      },
    };
  });

const diarioMenus = menuEntries.filter((menu) => menu.kind === "DIARIO");
const festivoMenus = menuEntries.filter((menu) => menu.kind === "FESTIVO");

const menuSections: { kind: MenuKind; list: MenuEntry[] }[] = [
  { kind: "DIARIO", list: diarioMenus },
  { kind: "FESTIVO", list: festivoMenus },
];

const activeMenusCount = menuEntries.filter((menu) => menu.active).length;

const menuErrorMessage =
  menuError === "missing-title"
    ? "El título del menú es obligatorio."
    : menuError === "invalid-kind"
      ? "El tipo de menú no es válido."
      : menuError === "invalid-menu"
        ? "El menú indicado no es válido."
        : menuError === "not-found"
          ? "El menú ya no existe."
          : menuError === "invalid-intent"
            ? "Acción de menú no válida."
            : "";

const menuItemErrorMessage =
  menuItemError === "invalid-product"
    ? "El producto seleccionado no es válido."
    : menuItemError === "invalid-course"
      ? "El curso indicado no es válido."
      : menuItemError === "invalid-item"
        ? "El item indicado no es válido."
        : menuItemError === "not-found"
          ? "El item ya no existe."
          : menuItemError === "invalid-intent"
            ? "Acción de item no válida."
            : "";
---

<AdminLayout
  title="Menús · Admin · Arcadia"
  heading="Menús"
  description="Gestión de menú diario y festivo con asignación de productos por curso. Esta pantalla alimenta la página pública /menu."
  actions={true}
>
  <Fragment slot="actions">
    <div class="flex flex-wrap gap-3">
      <a
        href="/menu"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-300 transition hover:border-sky-400/30 hover:bg-sky-400/15"
      >
        Ver página pública
      </a>

      <a
        href="/admin"
        class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/10 hover:text-white"
      >
        Volver al dashboard
      </a>
    </div>
  </Fragment>

  {menuSaved ? (
    <section class="mb-6 rounded-3xl border border-emerald-400/20 bg-emerald-400/10 px-5 py-4 text-sm text-emerald-200">
      Menú actualizado correctamente.
    </section>
  ) : null}

  {menuErrorMessage ? (
    <section class="mb-6 rounded-3xl border border-rose-400/20 bg-rose-400/10 px-5 py-4 text-sm text-rose-200">
      {menuErrorMessage}
    </section>
  ) : null}

  {menuItemSaved ? (
    <section class="mb-6 rounded-3xl border border-sky-400/20 bg-sky-400/10 px-5 py-4 text-sm text-sky-200">
      Items del menú actualizados correctamente.
    </section>
  ) : null}

  {menuItemErrorMessage ? (
    <section class="mb-6 rounded-3xl border border-rose-400/20 bg-rose-400/10 px-5 py-4 text-sm text-rose-200">
      {menuItemErrorMessage}
    </section>
  ) : null}

  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">
        Total menús
      </div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">
        {menuEntries.length}
      </div>
      <p class="mt-2 text-sm text-slate-400">Registros en Menu</p>
    </article>

    <article class="rounded-3xl border border-emerald-400/20 bg-emerald-400/10 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-emerald-200">
        Activos
      </div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">
        {activeMenusCount}
      </div>
      <p class="mt-2 text-sm text-emerald-100/80">Visibles para /menu</p>
    </article>

    <article class="rounded-3xl border border-sky-400/20 bg-sky-400/10 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-sky-200">
        Diario
      </div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">
        {diarioMenus.length}
      </div>
      <p class="mt-2 text-sm text-sky-100/80">Menús tipo DIARIO</p>
    </article>

    <article class="rounded-3xl border border-violet-400/20 bg-violet-400/10 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-violet-200">
        Festivo
      </div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">
        {festivoMenus.length}
      </div>
      <p class="mt-2 text-sm text-violet-100/80">Menús tipo FESTIVO</p>
    </article>
  </section>

  <section class="mt-6 rounded-3xl border border-white/10 bg-[#111827] p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
    <div>
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-sky-300">
        Crear menú
      </div>
      <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
        Nuevo menú diario o festivo
      </h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">
        Puedes preparar varias versiones y activar solo la que corresponda.
      </p>
    </div>

    <form method="post" action="/api/admin/menus" class="mt-6 grid gap-4 lg:grid-cols-[minmax(0,1fr)_180px_180px_180px_auto]">
      <input type="hidden" name="intent" value="create" />

      <label class="block">
        <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
          Título
        </span>
        <input
          class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
          type="text"
          name="title"
          placeholder="Ej. Menú diario 14,95€"
          required
        />
      </label>

      <label class="block">
        <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
          Tipo
        </span>
        <select
          class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
          name="kind"
        >
          <option value="DIARIO">DIARIO</option>
          <option value="FESTIVO">FESTIVO</option>
        </select>
      </label>

      <label class="block">
        <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
          Desde
        </span>
        <input
          class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
          type="date"
          name="validFrom"
        />
      </label>

      <label class="block">
        <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
          Hasta
        </span>
        <input
          class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
          type="date"
          name="validTo"
        />
      </label>

      <div class="flex items-end">
        <button
          class="inline-flex w-full items-center justify-center rounded-2xl bg-sky-500 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-400"
          type="submit"
        >
          Crear menú
        </button>
      </div>

      <label class="lg:col-span-full block rounded-3xl border border-white/10 bg-slate-950/40 p-4">
        <div class="flex items-start gap-3">
          <input
            class="mt-1 h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400"
            type="checkbox"
            name="active"
            checked
          />
          <div>
            <div class="text-sm font-semibold text-white">Activo</div>
            <p class="mt-1 text-sm leading-6 text-slate-300">
              El menú nace activo y puede desactivarse más tarde.
            </p>
          </div>
        </div>
      </label>
    </form>
  </section>

  <section class="mt-6 space-y-8">
    {menuSections.map(({ kind, list }) => (
        <section class="space-y-4">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">
                {kind}
              </div>
              <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
                Menús {kind === "DIARIO" ? "diarios" : "festivos"}
              </h2>
            </div>

            <div class="text-sm text-slate-400">
              {list.length} registro{list.length === 1 ? "" : "s"}
            </div>
          </div>

          {list.length === 0 ? (
            <div class="rounded-3xl border border-white/10 bg-white/5 p-8 text-sm text-slate-400">
              No hay menús de tipo {kind}.
            </div>
          ) : (
            list.map((entry) => (
              <article class="rounded-3xl border border-white/10 bg-[#111827] p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <div
                      class:list={[
                        "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                        entry.kind === "DIARIO"
                          ? "border-sky-400/20 bg-sky-400/10 text-sky-300"
                          : "border-violet-400/20 bg-violet-400/10 text-violet-300",
                      ]}
                    >
                      {entry.kind}
                    </div>

                    <h3 class="mt-3 text-xl font-semibold text-white">{entry.title}</h3>
                  </div>

                  <span
                    class:list={[
                      "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                      entry.active
                        ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
                        : "border-rose-400/20 bg-rose-400/10 text-rose-300",
                    ]}
                  >
                    {entry.active ? "Activo" : "Inactivo"}
                  </span>
                </div>

                <form method="post" action="/api/admin/menus" class="mt-6 grid gap-4">
                  <input type="hidden" name="intent" value="update" />
                  <input type="hidden" name="menuId" value={entry.id} />

                  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_180px_180px_180px]">
                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                        Título
                      </span>
                      <input
                        class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                        type="text"
                        name="title"
                        value={entry.title}
                        required
                      />
                    </label>

                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                        Desde
                      </span>
                      <input
                        class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                        type="date"
                        name="validFrom"
                        value={formatDateInput(entry.validFrom)}
                      />
                    </label>

                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                        Hasta
                      </span>
                      <input
                        class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                        type="date"
                        name="validTo"
                        value={formatDateInput(entry.validTo)}
                      />
                    </label>

                    <label class="block rounded-3xl border border-white/10 bg-slate-950/40 p-4">
                      <div class="flex items-start gap-3">
                        <input
                          class="mt-1 h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400"
                          type="checkbox"
                          name="active"
                          checked={entry.active}
                        />
                        <div>
                          <div class="text-sm font-semibold text-white">Activo</div>
                          <p class="mt-1 text-sm leading-6 text-slate-400">
                            Puede mostrarse en la página pública
                          </p>
                        </div>
                      </div>
                    </label>
                  </div>

                  <div class="flex flex-wrap gap-3">
                    <button
                      class="inline-flex items-center justify-center rounded-2xl bg-sky-500 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-400"
                      type="submit"
                    >
                      Guardar menú
                    </button>
                  </div>
                </form>

                <section class="mt-6 rounded-3xl border border-cyan-400/20 bg-cyan-400/10 p-5">
                  <div>
                    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-100/80">
                      Añadir producto
                    </div>
                    <div class="mt-2 text-sm font-semibold text-white">
                      Asignar item al menú
                    </div>
                  </div>

                  <form
                    method="post"
                    action={`/api/admin/menus/${entry.id}/items`}
                    class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1fr)_180px_140px_140px_auto]"
                  >
                    <input type="hidden" name="intent" value="create" />

                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-cyan-100/80">
                        Producto
                      </span>
                      <select
                        class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-300/40 focus:outline-none"
                        name="productId"
                        required
                      >
                        {productOptions.map((product) => (
                          <option value={product.id}>
                            {product.name} · {product.categoryName}{product.active ? "" : " · inactivo"}
                          </option>
                        ))}
                      </select>
                    </label>

                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-cyan-100/80">
                        Curso
                      </span>
                      <select
                        class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-300/40 focus:outline-none"
                        name="course"
                      >
                        <option value="PRIMERO">PRIMERO</option>
                        <option value="SEGUNDO">SEGUNDO</option>
                        <option value="POSTRE">POSTRE</option>
                      </select>
                    </label>

                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-cyan-100/80">
                        Print order
                      </span>
                      <input
                        class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-300/40 focus:outline-none"
                        type="number"
                        name="printOrder"
                        step="1"
                        value="1"
                      />
                    </label>

                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-cyan-100/80">
                        Sort order
                      </span>
                      <input
                        class="w-full rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-300/40 focus:outline-none"
                        type="number"
                        name="sortOrder"
                        step="1"
                        value={entry.items.length}
                      />
                    </label>

                    <div class="flex items-end">
                      <button
                        class="inline-flex w-full items-center justify-center rounded-2xl bg-cyan-400 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
                        type="submit"
                      >
                        Añadir item
                      </button>
                    </div>
                  </form>
                </section>

                <div class="mt-6 space-y-6">
                  {(["PRIMERO", "SEGUNDO", "POSTRE"] as MenuCourse[]).map((course) => (
                    <section class="rounded-3xl border border-white/10 bg-white/5 p-5">
                      <div class="flex flex-wrap items-end justify-between gap-4">
                        <div>
                          <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                            {course}
                          </div>
                          <div class="mt-2 text-sm font-semibold text-white">
                            {courseLabel(course)}
                          </div>
                        </div>

                        <div class="text-sm text-slate-400">
                          {entry.grouped[course].length} item{entry.grouped[course].length === 1 ? "" : "s"}
                        </div>
                      </div>

                      <div class="mt-4 space-y-4">
                        {entry.grouped[course].length === 0 ? (
                          <div class="rounded-3xl border border-white/10 bg-slate-950/40 p-4 text-sm text-slate-400">
                            Sin productos asignados en este curso.
                          </div>
                        ) : (
                          entry.grouped[course].map((item) => (
                            <article class="rounded-3xl border border-white/10 bg-slate-950/40 p-4">
                              <form
                                method="post"
                                action={`/api/admin/menus/${entry.id}/items`}
                                class="grid gap-4"
                              >
                                <input type="hidden" name="intent" value="update" />
                                <input type="hidden" name="menuItemId" value={item.id} />

                                <div class="flex flex-wrap items-start justify-between gap-3">
                                  <div>
                                    <div class="text-sm font-semibold text-white">
                                      {item.productName}
                                    </div>
                                    <div class="mt-1 text-xs text-slate-500">
                                      {item.categoryName}
                                    </div>
                                  </div>

                                  <span
                                    class:list={[
                                      "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                                      item.productActive
                                        ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
                                        : "border-amber-400/20 bg-amber-400/10 text-amber-300",
                                    ]}
                                  >
                                    {item.productActive ? "Producto activo" : "Producto inactivo"}
                                  </span>
                                </div>

                                <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_180px_140px_140px]">
                                  <label class="block">
                                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                                      Producto
                                    </span>
                                    <select
                                      class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-cyan-400/40 focus:outline-none"
                                      name="productId"
                                    >
                                      {productOptions.map((product) => (
                                        <option value={product.id} selected={product.id === item.productId}>
                                          {product.name} · {product.categoryName}{product.active ? "" : " · inactivo"}
                                        </option>
                                      ))}
                                    </select>
                                  </label>

                                  <label class="block">
                                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                                      Curso
                                    </span>
                                    <select
                                      class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-cyan-400/40 focus:outline-none"
                                      name="course"
                                    >
                                      <option value="PRIMERO" selected={item.course === "PRIMERO"}>PRIMERO</option>
                                      <option value="SEGUNDO" selected={item.course === "SEGUNDO"}>SEGUNDO</option>
                                      <option value="POSTRE" selected={item.course === "POSTRE"}>POSTRE</option>
                                    </select>
                                  </label>

                                  <label class="block">
                                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                                      Print order
                                    </span>
                                    <input
                                      class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-cyan-400/40 focus:outline-none"
                                      type="number"
                                      name="printOrder"
                                      step="1"
                                      value={item.printOrder}
                                    />
                                  </label>

                                  <label class="block">
                                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                                      Sort order
                                    </span>
                                    <input
                                      class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-cyan-400/40 focus:outline-none"
                                      type="number"
                                      name="sortOrder"
                                      step="1"
                                      value={item.sortOrder}
                                    />
                                  </label>
                                </div>

                                <div class="flex flex-wrap gap-3">
                                  <button
                                    class="inline-flex items-center justify-center rounded-2xl bg-cyan-400 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
                                    type="submit"
                                  >
                                    Guardar item
                                  </button>
                                </div>
                              </form>

                              <form method="post" action={`/api/admin/menus/${entry.id}/items`} class="mt-3">
                                <input type="hidden" name="intent" value="delete" />
                                <input type="hidden" name="menuItemId" value={item.id} />
                                <button
                                  class="inline-flex items-center justify-center rounded-2xl border border-rose-400/20 bg-rose-400/10 px-4 py-3 text-sm font-semibold text-rose-300 transition hover:border-rose-400/30 hover:bg-rose-400/15"
                                  type="submit"
                                >
                                  Quitar item
                                </button>
                              </form>
                            </article>
                          ))
                        )}
                      </div>
                    </section>
                  ))}
                </div>

                <form method="post" action="/api/admin/menus" class="mt-6">
                  <input type="hidden" name="intent" value="delete" />
                  <input type="hidden" name="menuId" value={entry.id} />
                  <button
                    class="inline-flex items-center justify-center rounded-2xl border border-rose-400/20 bg-rose-400/10 px-4 py-3 text-sm font-semibold text-rose-300 transition hover:border-rose-400/30 hover:bg-rose-400/15"
                    type="submit"
                  >
                    Eliminar menú
                  </button>
                </form>
              </article>
            ))
          )}
        </section>
      ))}
  </section>
</AdminLayout>