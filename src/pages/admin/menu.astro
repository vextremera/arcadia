<script is:inline>
  (() => {
    let dragged = null;

    function getCardFromEventTarget(target) {
      if (!(target instanceof Element)) return null;
      return target.closest("[data-menu-assignment-card]");
    }

    function clearDraggedState() {
      if (dragged instanceof Element) {
        dragged.classList.remove("opacity-60");
      }
      dragged = null;
    }

    document.addEventListener("dragstart", (event) => {
      const card = getCardFromEventTarget(event.target);
      if (!card) return;

      dragged = card;
      card.classList.add("opacity-60");

      if (event.dataTransfer) {
        event.dataTransfer.effectAllowed = "move";
        event.dataTransfer.setData(
          "text/plain",
          card.getAttribute("data-menu-assignment-card") || "",
        );
      }
    });

    document.addEventListener("dragend", () => {
      clearDraggedState();
    });

    const zones = Array.from(document.querySelectorAll("[data-menu-dropzone]"));

    function getAfterElement(zone, clientY) {
      const cards = Array.from(
        zone.querySelectorAll("[data-menu-assignment-card]"),
      ).filter((card) => card !== dragged);

      let closest = null;
      let closestOffset = Number.NEGATIVE_INFINITY;

      for (const card of cards) {
        const rect = card.getBoundingClientRect();
        const offset = clientY - rect.top - rect.height / 2;
        if (offset < 0 && offset > closestOffset) {
          closestOffset = offset;
          closest = card;
        }
      }

      return closest;
    }

    zones.forEach((zone) => {
      zone.addEventListener("dragover", (event) => {
        if (!dragged) return;
        if (!(dragged instanceof Element)) return;

        const sameKind =
          dragged.getAttribute("data-kind") === zone.getAttribute("data-kind");
        const sameCourse =
          dragged.getAttribute("data-course") ===
          zone.getAttribute("data-course");
        if (!sameKind || !sameCourse) return;

        event.preventDefault();

        const afterElement = getAfterElement(zone, event.clientY);
        if (!afterElement) {
          zone.appendChild(dragged);
        } else {
          zone.insertBefore(dragged, afterElement);
        }
      });

      zone.addEventListener("drop", async (event) => {
        if (!dragged) return;
        if (!(dragged instanceof Element)) return;

        const sameKind =
          dragged.getAttribute("data-kind") === zone.getAttribute("data-kind");
        const sameCourse =
          dragged.getAttribute("data-course") ===
          zone.getAttribute("data-course");
        if (!sameKind || !sameCourse) {
          clearDraggedState();
          return;
        }

        event.preventDefault();

        const orderedIds = Array.from(
          zone.querySelectorAll("[data-menu-assignment-card]"),
        )
          .map((card) => card.getAttribute("data-menu-assignment-card"))
          .filter(Boolean);

        const params = new URLSearchParams();
        params.set("intent", "reorder-assignments");
        params.set("kind", zone.getAttribute("data-kind") || "");
        params.set("course", zone.getAttribute("data-course") || "");
        params.set("orderedIds", orderedIds.join(","));

        try {
          const response = await fetch("/api/admin/menu-v2", {
            method: "POST",
            headers: {
              "content-type": "application/x-www-form-urlencoded;charset=UTF-8",
            },
            body: params.toString(),
          });

          if (!response.ok) {
            window.location.href = "/admin/menu?error=reorder-failed";
            return;
          }

          window.location.reload();
        } catch {
          window.location.href = "/admin/menu?error=reorder-failed";
        } finally {
          clearDraggedState();
        }
      });
    });
  })();
</script>
