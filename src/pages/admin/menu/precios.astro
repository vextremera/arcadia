---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import { db, AppSetting, MenuDishAssignment, eq } from "astro:db";

/**
 * Precio y publicación de los menús.
 *
 * Esta pantalla decide literalmente lo que se ve en la web: ya no hay respaldo
 * legacy ni precios por defecto en el código. Un menú sale publicado sólo si
 * está marcado como publicado, tiene precio y tiene platos asignados; si falta
 * algo, la web no muestra ese menú y aquí se explica cuál de las tres cosas
 * falta, en vez de fallar en silencio.
 */

const PAGE_PATH = "/admin/menu/precios";

type MenuKind = "DIARIO" | "FESTIVO";
type MenuConfigEntry = {
  active: boolean;
  priceCents: number;
  serviceFrom: string | null;
  serviceTo: string | null;
  note: string | null;
};
type MenuConfig = Record<MenuKind, MenuConfigEntry>;

function readTime(value: unknown): string | null {
  const match = String(value ?? "").trim().match(/^(\d{1,2}):(\d{2})$/);
  if (!match || Number(match[1]) > 23 || Number(match[2]) > 59) return null;
  return `${String(Number(match[1])).padStart(2, "0")}:${match[2]}`;
}

function readNote(value: unknown): string | null {
  return typeof value === "string" && value.trim() ? value.trim() : null;
}

const KINDS: Array<{ key: MenuKind; label: string; tone: "primary" | "violet"; managePath: string }> = [
  { key: "DIARIO", label: "Diario", tone: "primary", managePath: "/admin/menu/diario" },
  { key: "FESTIVO", label: "Festivo", tone: "violet", managePath: "/admin/menu/festivo" },
];

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2).replace(".", ",")} €`;
}

function moneyInput(cents: number) {
  return (Number(cents ?? 0) / 100).toFixed(2);
}

const [configRow] = await db
  .select({ value: AppSetting.value })
  .from(AppSetting)
  .where(eq(AppSetting.key, "menuConfigV2"))
  .limit(1);

const configValue = (configRow?.value ?? {}) as Partial<Record<MenuKind, Partial<MenuConfigEntry>>>;

// Sin configuración no se asume nada publicable: el criterio es el mismo que
// aplica src/server/menu/public.ts, para que admin y web no puedan discrepar.
const readEntry = (kind: MenuKind): MenuConfigEntry => ({
  active: configValue[kind]?.active === true,
  priceCents: typeof configValue[kind]?.priceCents === "number" ? configValue[kind]!.priceCents! : 0,
  serviceFrom: readTime(configValue[kind]?.serviceFrom),
  serviceTo: readTime(configValue[kind]?.serviceTo),
  note: readNote(configValue[kind]?.note),
});

const config: MenuConfig = { DIARIO: readEntry("DIARIO"), FESTIVO: readEntry("FESTIVO") };

const assignments = await db
  .select({ id: MenuDishAssignment.id, kind: MenuDishAssignment.kind })
  .from(MenuDishAssignment);

const countByKind: Record<MenuKind, number> = {
  DIARIO: assignments.filter((row) => row.kind === "DIARIO").length,
  FESTIVO: assignments.filter((row) => row.kind === "FESTIVO").length,
};

type Status = { published: boolean; tone: "success" | "warning" | "neutral"; label: string; reason: string | null };

function resolveStatus(kind: MenuKind): Status {
  const entry = config[kind];
  const dishes = countByKind[kind];

  if (!entry.active) {
    return { published: false, tone: "neutral", label: "No publicado", reason: "Está desmarcado como publicado." };
  }
  if (!entry.priceCents) {
    return { published: false, tone: "warning", label: "Incompleto", reason: "Falta el precio." };
  }
  if (!dishes) {
    return { published: false, tone: "warning", label: "Incompleto", reason: "No tiene ningún plato asignado." };
  }
  return { published: true, tone: "success", label: "Publicado", reason: null };
}

const statuses: Record<MenuKind, Status> = {
  DIARIO: resolveStatus("DIARIO"),
  FESTIVO: resolveStatus("FESTIVO"),
};

const incomplete = KINDS.filter((kind) => statuses[kind.key].tone === "warning");

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") ?? "";
const error = url.searchParams.get("error") ?? "";

const successMessage = saved === "config" ? "Configuración guardada correctamente." : "";
const errorMessage =
  error === "invalid-price" ? "El precio del menú no es válido." :
  error === "invalid-intent" ? "Acción no válida." : "";
---

<AdminLayout
  title="Precios del menú · Admin · Arcadia"
  heading="Precios del menú"
  description="Precio y publicación de los menús diario y festivo. Lo que se configure aquí es exactamente lo que ve el cliente."
>
  <div class="space-y-6">
    {successMessage ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">{successMessage}</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{errorMessage}</section> : null}

    {
      incomplete.length > 0 ? (
        <section class="rounded-admin-lg border border-amber-400/20 bg-amber-400/10 px-5 py-4 text-sm text-amber-100">
          <p class="font-semibold">
            {incomplete.length === 1
              ? `El menú ${incomplete[0].label.toLowerCase()} está marcado como publicado pero no sale en la web.`
              : "Hay menús marcados como publicados que no salen en la web."}
          </p>
          <ul class="mt-1.5 space-y-0.5 text-amber-200/85">
            {incomplete.map((kind) => (
              <li>· {kind.label}: {statuses[kind.key].reason}</li>
            ))}
          </ul>
        </section>
      ) : null
    }

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      {
        KINDS.map((kind) => (
          <StatCard
            label={kind.label}
            value={String(countByKind[kind.key])}
            helper={statuses[kind.key].published ? `Publicado · ${money(config[kind.key].priceCents)}` : "Platos asignados"}
          />
        ))
      }
    </section>

    <Card>
      <div class="admin-eyebrow">Configuración</div>
      <h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-white">Precio y visibilidad</h2>
      <p class="mt-1 text-sm text-admin-muted">
        Un menú aparece en la web sólo si está publicado, tiene precio y tiene platos.
      </p>

      <form method="post" action="/api/admin/menu-v2" class="mt-5">
        <input type="hidden" name="intent" value="save-config" />
        <input type="hidden" name="redirectTo" value={PAGE_PATH} />

        <div class="grid gap-4 lg:grid-cols-2">
          {
            KINDS.map((kind) => (
              <div class="rounded-admin-lg border border-admin-border bg-white/[0.02] p-4">
                <div class="flex items-center justify-between gap-3">
                  <Badge tone={kind.tone}>{kind.label}</Badge>
                  <Badge tone={statuses[kind.key].tone}>{statuses[kind.key].label}</Badge>
                </div>

                <div class="mt-4 grid grid-cols-[minmax(0,1fr)_auto] items-end gap-3">
                  <label class="block">
                    <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Precio €</span>
                    <input
                      class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                      type="number"
                      min="0"
                      step="0.01"
                      name={`${kind.key}_priceEur`}
                      value={moneyInput(config[kind.key].priceCents)}
                    />
                  </label>

                  <label class="flex items-center gap-2 rounded-2xl border border-admin-border bg-white/[0.03] px-3.5 py-2.5 text-sm text-slate-300">
                    <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name={`${kind.key}_active`} checked={config[kind.key].active} />
                    Publicado
                  </label>
                </div>

                <div class="mt-3 grid grid-cols-2 gap-3">
                  <label class="block">
                    <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Se sirve desde</span>
                    <input
                      class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                      type="time"
                      name={`${kind.key}_serviceFrom`}
                      value={config[kind.key].serviceFrom ?? ""}
                    />
                  </label>
                  <label class="block">
                    <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Hasta</span>
                    <input
                      class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                      type="time"
                      name={`${kind.key}_serviceTo`}
                      value={config[kind.key].serviceTo ?? ""}
                    />
                  </label>
                </div>

                <label class="mt-3 block">
                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Nota</span>
                  <input
                    class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                    type="text"
                    name={`${kind.key}_note`}
                    value={config[kind.key].note ?? ""}
                    placeholder="Menús personalizados bajo petición."
                  />
                </label>

                <p class="mt-3 text-xs text-admin-muted">
                  {countByKind[kind.key]} platos asignados ·{" "}
                  <a class="font-semibold text-sky-300 hover:underline" href={kind.managePath}>Gestionar</a>
                </p>
              </div>
            ))
          }
        </div>

        <button class="mt-4 inline-flex items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15" type="submit">
          Guardar configuración
        </button>
      </form>
    </Card>
  </div>
</AdminLayout>
