---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import {
  db,
  AppSetting,
  MenuDish,
  MenuDishAssignment,
  Menu as LegacyMenu,
  MenuItem as LegacyMenuItem,
  eq,
} from "astro:db";
import { getPublicMenuState } from "@/server/menu/public";

const PAGE_PATH = "/admin/menu/precios";

type MenuKind = "DIARIO" | "FESTIVO";
type MenuConfig = Record<MenuKind, { active: boolean; priceCents: number }>;

const DEFAULT_MENU_CONFIG: MenuConfig = {
  DIARIO: { active: true, priceCents: 1350 },
  FESTIVO: { active: true, priceCents: 1590 },
};

const KINDS: Array<{ key: MenuKind; label: string; tone: "primary" | "violet" }> = [
  { key: "DIARIO", label: "Diario", tone: "primary" },
  { key: "FESTIVO", label: "Festivo", tone: "violet" },
];

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function moneyInput(cents: number) {
  return (Number(cents ?? 0) / 100).toFixed(2);
}

const [configRow] = await db
  .select({ value: AppSetting.value })
  .from(AppSetting)
  .where(eq(AppSetting.key, "menuConfigV2"))
  .limit(1);

const configValue = configRow?.value as Partial<MenuConfig> | undefined;

const config: MenuConfig = {
  DIARIO: {
    active: configValue?.DIARIO?.active ?? DEFAULT_MENU_CONFIG.DIARIO.active,
    priceCents: configValue?.DIARIO?.priceCents ?? DEFAULT_MENU_CONFIG.DIARIO.priceCents,
  },
  FESTIVO: {
    active: configValue?.FESTIVO?.active ?? DEFAULT_MENU_CONFIG.FESTIVO.active,
    priceCents: configValue?.FESTIVO?.priceCents ?? DEFAULT_MENU_CONFIG.FESTIVO.priceCents,
  },
};

const publicState = await getPublicMenuState();

const dishes = await db.select({ id: MenuDish.id }).from(MenuDish);
const assignments = await db.select({ id: MenuDishAssignment.id, kind: MenuDishAssignment.kind }).from(MenuDishAssignment);

const assignmentCountByKind: Record<MenuKind, number> = {
  DIARIO: assignments.filter((row) => row.kind === "DIARIO").length,
  FESTIVO: assignments.filter((row) => row.kind === "FESTIVO").length,
};

const hasV2Data = dishes.length > 0 || assignments.length > 0;

const legacyMenus = await db.select({ id: LegacyMenu.id }).from(LegacyMenu);
const legacyMenuItems = await db.select({ id: LegacyMenuItem.id }).from(LegacyMenuItem);
const hasUsableLegacyData = legacyMenus.length > 0 && legacyMenuItems.length > 0;

const canImportLegacy = dishes.length === 0 && assignments.length === 0 && hasUsableLegacyData;

const publishedKinds = KINDS.filter(
  (kind) => config[kind.key].active && assignmentCountByKind[kind.key] > 0,
);
const hasPublishedV2Data = publishedKinds.length > 0;
const hasBlockedV2Transition = hasV2Data && !hasPublishedV2Data && hasUsableLegacyData;

const publicSourceLabel =
  publicState.source === "V2" ? "V2 canónico" : publicState.source === "LEGACY" ? "Fallback legacy activo" : "Sin datos publicados";

const legacyStatusLabel = canImportLegacy
  ? "Importable"
  : hasBlockedV2Transition
    ? "Bloqueado por V2 incompleto"
    : hasUsableLegacyData
      ? "Solo respaldo"
      : "Vacío";

const publicationStateLabel = hasPublishedV2Data
  ? publishedKinds.map((kind) => kind.label).join(" + ")
  : hasV2Data
    ? "Datos sin publicar"
    : "Vacío";

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") ?? "";
const error = url.searchParams.get("error") ?? "";

const successMessage =
  saved === "config"
    ? "Configuración guardada correctamente."
    : saved === "import"
      ? "Menú legacy importado correctamente al sistema nuevo."
      : "";

const errorMessage =
  error === "invalid-price"
    ? "El precio del menú no es válido."
    : error === "already-v2-data"
      ? "Ya existe información en el sistema nuevo y no se puede importar encima."
      : error === "import-failed"
        ? "No se ha podido importar el menú legacy."
        : error === "invalid-intent"
          ? "Acción no válida."
          : "";
---

<AdminLayout title="Precios del menú · Admin · Arcadia" heading="Precios del menú" description="Precio y publicación de los menús diario y festivo.">
  <div class="space-y-6">
    {successMessage ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">{successMessage}</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{errorMessage}</section> : null}
    {
      hasBlockedV2Transition ? (
        <section class="rounded-admin-lg border border-amber-400/20 bg-amber-400/10 px-5 py-3 text-sm text-amber-100">
          Hay datos en V2 pero ninguna variante publicable todavía; la pública sigue leyendo el menú legacy.
        </section>
      ) : null
    }

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard label="Diario" value={String(assignmentCountByKind.DIARIO)} helper="Platos asignados" />
      <StatCard label="Festivo" value={String(assignmentCountByKind.FESTIVO)} helper="Platos asignados" />
    </section>

    <Card>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="admin-eyebrow">Estado</div>
          <h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-white">Publicación</h2>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <Badge tone={publicState.source === "V2" ? "success" : publicState.source === "LEGACY" ? "warning" : "neutral"}>
            Pública: {publicSourceLabel}
          </Badge>
          <Badge tone="neutral">Legacy: {legacyStatusLabel}</Badge>
          <Badge tone={hasPublishedV2Data ? "success" : "neutral"}>{publicationStateLabel}</Badge>
          {
            canImportLegacy ? (
              <form method="post" action="/api/admin/menu-v2">
                <input type="hidden" name="intent" value="import-legacy" />
                <input type="hidden" name="redirectTo" value={PAGE_PATH} />
                <button type="submit" class="rounded-xl border border-amber-400/20 bg-amber-400/10 px-3 py-1.5 text-xs font-semibold text-amber-200 transition hover:border-amber-400/30 hover:bg-amber-400/15">
                  Importar legacy
                </button>
              </form>
            ) : null
          }
        </div>
      </div>
    </Card>

    <Card>
      <div class="admin-eyebrow">Configuración</div>
      <h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-white">Precio y visibilidad</h2>

      <form method="post" action="/api/admin/menu-v2" class="mt-5">
        <input type="hidden" name="intent" value="save-config" />
        <input type="hidden" name="redirectTo" value={PAGE_PATH} />

        <div class="grid gap-4 lg:grid-cols-2">
          {
            KINDS.map((kind) => (
              <div class="rounded-admin-lg border border-admin-border bg-white/[0.02] p-4">
                <div class="flex items-center justify-between gap-3">
                  <Badge tone={kind.tone}>{kind.label}</Badge>
                  <div class="text-sm font-semibold text-white">{money(config[kind.key].priceCents)}</div>
                </div>

                <div class="mt-4 grid grid-cols-[minmax(0,1fr)_auto] items-end gap-3">
                  <label class="block">
                    <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Precio €</span>
                    <input
                      class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none"
                      type="number"
                      min="0"
                      step="0.01"
                      name={`${kind.key}_priceEur`}
                      value={moneyInput(config[kind.key].priceCents)}
                    />
                  </label>

                  <label class="flex items-center gap-2 rounded-2xl border border-admin-border bg-white/[0.03] px-3.5 py-2.5 text-sm text-slate-300">
                    <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name={`${kind.key}_active`} checked={config[kind.key].active} />
                    Publicado
                  </label>
                </div>
              </div>
            ))
          }
        </div>

        <button class="mt-4 inline-flex items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15" type="submit">
          Guardar configuración
        </button>
      </form>
    </Card>
  </div>
</AdminLayout>
