---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import { db, NewsletterSubscriber, User, inArray } from "astro:db";

type SubscriberRow = {
  id: number;
  email: string;
  userId: number | null;
  active: boolean;
  createdAt: Date;
  updatedAt: Date;
};

const subscribers = (await db
  .select({
    id: NewsletterSubscriber.id,
    email: NewsletterSubscriber.email,
    userId: NewsletterSubscriber.userId,
    active: NewsletterSubscriber.active,
    createdAt: NewsletterSubscriber.createdAt,
    updatedAt: NewsletterSubscriber.updatedAt,
  })
  .from(NewsletterSubscriber)) as SubscriberRow[];

const userIds = subscribers
  .map((subscriber) => subscriber.userId)
  .filter((value): value is number => Number.isFinite(value));

const users = userIds.length
  ? await db.select({ id: User.id, email: User.email, name: User.name }).from(User).where(inArray(User.id, userIds))
  : [];

const userById = new Map(users.map((user) => [user.id, user]));

const url = new URL(Astro.request.url);
const q = (url.searchParams.get("q") ?? "").trim().toLowerCase();
const statusFilter = url.searchParams.get("status") ?? "";

const sortedSubscribers = [...subscribers].sort((a, b) => {
  if (a.active !== b.active) return a.active ? -1 : 1;
  return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime();
});

const filteredSubscribers = sortedSubscribers.filter((subscriber) => {
  if (statusFilter === "active" && !subscriber.active) return false;
  if (statusFilter === "inactive" && subscriber.active) return false;
  if (statusFilter === "linked" && !subscriber.userId) return false;
  if (!q) return true;
  const linked = subscriber.userId ? userById.get(subscriber.userId) : null;
  return [subscriber.email, linked?.name ?? "", linked?.email ?? ""].join(" ").toLowerCase().includes(q);
});

const activeCount = sortedSubscribers.filter((subscriber) => subscriber.active).length;
const inactiveCount = sortedSubscribers.length - activeCount;
const linkedCount = sortedSubscribers.filter((subscriber) => !!subscriber.userId).length;

const saved = url.searchParams.get("saved") ?? "";
const sent = Number(url.searchParams.get("sent") ?? 0);
const failed = Number(url.searchParams.get("failed") ?? 0);
const error = url.searchParams.get("error") ?? "";

const smtpReady = Boolean(import.meta.env.SMTP_HOST && import.meta.env.SMTP_PORT && import.meta.env.SMTP_FROM);

const successMessage =
  saved === "subscriber"
    ? "Suscriptor actualizado correctamente."
    : saved === "send"
      ? `Envío completado. Enviados: ${sent}. Fallidos: ${failed}.`
      : "";

const errorMessage =
  error === "missing-subject" ? "El asunto es obligatorio." :
  error === "missing-body" ? "El cuerpo del correo es obligatorio." :
  error === "no-subscribers" ? "No hay suscriptores activos a los que enviar." :
  error === "smtp-not-configured" ? "Falta configurar SMTP_HOST, SMTP_PORT o SMTP_FROM para poder enviar correos." :
  error === "send-failed" ? "No se ha podido completar el envío del newsletter." :
  error === "invalid-subscriber" ? "El suscriptor indicado no es válido." :
  "";

const presets = {
  GENERAL: {
    subject: "Novedades de Arcadia",
    body: "Hola,\n\nTe escribimos para contarte las últimas novedades de Arcadia.\n\n¡Te esperamos!",
  },
  OFFER: {
    subject: "Nueva oferta en Arcadia",
    body: "Hola,\n\nTenemos una nueva oferta en Arcadia durante tiempo limitado.\n\nPásate por /pedir o ven a vernos.",
  },
  COUPON: {
    subject: "Tu cupón de Arcadia",
    body: "Hola,\n\nTe compartimos un cupón especial para tu próximo pedido en Arcadia.\n\nConsulta condiciones en el mensaje o en nuestras redes.",
  },
  EVENT: {
    subject: "Nuevo evento en Arcadia",
    body: "Hola,\n\nQueríamos avisarte de un nuevo evento en Arcadia.\n\nReserva o pásate a disfrutarlo con nosotros.",
  },
};

function formatDateTime(value: Date | string) {
  return new Intl.DateTimeFormat("es-ES", { dateStyle: "short", timeStyle: "short", timeZone: "Europe/Madrid" }).format(new Date(value));
}
---

<AdminLayout title="Newsletter · Admin · Arcadia" heading="Newsletter" description="Base de suscriptores y envío manual de comunicaciones.">
  <div class="space-y-6">
    {successMessage ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">{successMessage}</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{errorMessage}</section> : null}
    {
      !smtpReady ? (
        <section class="rounded-admin-lg border border-amber-400/20 bg-amber-400/10 px-5 py-3 text-sm text-amber-100">
          SMTP no configurado (SMTP_HOST / SMTP_PORT / SMTP_FROM): el envío está desactivado.
        </section>
      ) : null
    }

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard label="Suscriptores activos" value={String(activeCount)} helper="Recibirán el envío manual" />
      <StatCard label="Ligados a cuenta" value={String(linkedCount)} helper={`${inactiveCount} inactivos en total`} />
    </section>

    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <form method="get" class="flex flex-1 flex-wrap items-center gap-2">
          <input
            class="min-w-[220px] flex-1 rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-slate-500 focus:border-cyan-400/40 focus:outline-none"
            type="search"
            name="q"
            value={q}
            placeholder="Buscar email..."
          />
          <select name="status" class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none">
            <option value="">Estado</option>
            <option value="active" selected={statusFilter === "active"}>Activos</option>
            <option value="inactive" selected={statusFilter === "inactive"}>Inactivos</option>
            <option value="linked" selected={statusFilter === "linked"}>Con cuenta</option>
          </select>
          <button type="submit" class="inline-flex min-h-9 items-center justify-center rounded-2xl border border-admin-border bg-white/[0.03] px-3.5 py-2 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
            Filtrar
          </button>
        </form>

        <Modal
          id="newsletter-send"
          title="Enviar newsletter"
          description={`Se enviará a los ${activeCount} suscriptores activos.`}
          triggerLabel="Enviar newsletter"
          size="lg"
          triggerClass="inline-flex min-h-10 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 px-4 py-2.5 text-sm font-semibold text-cyan-100 transition hover:border-cyan-400/30 hover:bg-cyan-400/15"
        >
          <form method="post" action="/api/admin/newsletter" class="grid gap-4" id="newsletter-form">
            <input type="hidden" name="intent" value="send" />

            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Preset</span>
              <select id="newsletter-preset" name="preset" class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none">
                <option value="GENERAL">General</option>
                <option value="OFFER">Oferta</option>
                <option value="COUPON">Cupón</option>
                <option value="EVENT">Evento</option>
              </select>
            </label>

            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Asunto</span>
              <input id="newsletter-subject" class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" type="text" name="subject" value={presets.GENERAL.subject} required />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Cuerpo</span>
              <textarea id="newsletter-body" class="min-h-48 w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-cyan-400/40 focus:outline-none" name="body" required>{presets.GENERAL.body}</textarea>
            </label>

            <button
              type="submit"
              disabled={!smtpReady}
              class:list={[
                "mt-1 inline-flex min-h-11 items-center justify-center rounded-2xl px-4 py-3 text-sm font-semibold transition",
                smtpReady
                  ? "border border-cyan-400/20 bg-cyan-400/10 text-cyan-100 hover:border-cyan-400/30 hover:bg-cyan-400/15"
                  : "cursor-not-allowed border border-admin-border bg-white/[0.03] text-slate-500",
              ]}
            >
              {smtpReady ? `Enviar a ${activeCount} suscriptores` : "SMTP no configurado"}
            </button>
          </form>
        </Modal>
      </div>

      {
        filteredSubscribers.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="No hay suscriptores para ese filtro" description="Ajusta la búsqueda o los filtros." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Email</th>
                  <th>Cuenta</th>
                  <th>Estado</th>
                  <th>Alta</th>
                  <th>Último cambio</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {filteredSubscribers.map((subscriber) => {
                  const linked = subscriber.userId ? userById.get(subscriber.userId) : null;
                  return (
                    <tr>
                      <td class="font-semibold text-white">{subscriber.email}</td>
                      <td class="text-admin-muted">
                        {linked ? (
                          <a href={`/admin/usuarios/${linked.id}`} class="transition hover:text-sky-300">{linked.name ?? linked.email}</a>
                        ) : (
                          "—"
                        )}
                      </td>
                      <td><Badge tone={subscriber.active ? "success" : "neutral"}>{subscriber.active ? "Activo" : "Inactivo"}</Badge></td>
                      <td class="text-admin-muted">{formatDateTime(subscriber.createdAt)}</td>
                      <td class="text-admin-muted">{formatDateTime(subscriber.updatedAt)}</td>
                      <td>
                        <div class="flex justify-end">
                          <form method="post" action="/api/admin/newsletter">
                            <input type="hidden" name="intent" value="toggle-subscriber" />
                            <input type="hidden" name="subscriberId" value={subscriber.id} />
                            <input type="hidden" name="active" value={subscriber.active ? "0" : "1"} />
                            <button type="submit" class="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
                              {subscriber.active ? "Desactivar" : "Reactivar"}
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>

  <script is:inline define:vars={{ presets }}>
    document.addEventListener("DOMContentLoaded", () => {
      const preset = document.getElementById("newsletter-preset");
      const subject = document.getElementById("newsletter-subject");
      const body = document.getElementById("newsletter-body");
      if (!preset || !subject || !body) return;

      preset.addEventListener("change", () => {
        const next = presets[preset.value];
        if (!next) return;
        subject.value = next.subject;
        body.value = next.body;
      });
    });
  </script>
</AdminLayout>
