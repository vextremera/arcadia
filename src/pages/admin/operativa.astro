---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import type { ToneName } from "@/lib/admin/tones";
import { db, AppSetting, OpeningHour, SpecialDate, eq } from "astro:db";
import { getArcadiaAvailability, type ArcadiaChannel } from "@/server/time/madrid";

type OperatingHoursSetting = {
  open: { start: string; end: string };
  kitchen: { start: string; end: string };
  delivery: { start: string; end: string };
};

type DeliveryFeeSetting = { cents: number };
type OpsFlagsSetting = { pauseOrders: boolean; forcePickup: boolean };
type DeliveryAreaRuleSetting = { enabled: boolean };

type ChannelEditor = {
  key: ArcadiaChannel;
  label: string;
  isClosed: boolean;
  open: string;
  close: string;
  resolutionSource: "OPENING_HOUR" | "APP_SETTING";
};

type WeeklyRow = {
  dayKey: number;
  dayLabel: string;
  channels: ChannelEditor[];
};

type SpecialDateSummary = {
  id: number;
  dateISO: string;
  channel: ArcadiaChannel;
  isClosed: boolean;
  open: string;
  close: string;
  note: string;
};

const DAYS = [
  { key: 1, label: "Lunes" },
  { key: 2, label: "Martes" },
  { key: 3, label: "Miércoles" },
  { key: 4, label: "Jueves" },
  { key: 5, label: "Viernes" },
  { key: 6, label: "Sábado" },
  { key: 7, label: "Domingo" },
];

const CHANNELS: Array<{ key: ArcadiaChannel; label: string; tone: ToneName }> = [
  { key: "DINE_IN", label: "Local", tone: "success" },
  { key: "PICKUP", label: "Pickup", tone: "indigo" },
  { key: "DELIVERY", label: "Delivery", tone: "cyan" },
];

const DEFAULTS = {
  operatingHours: {
    open: { start: "07:30", end: "00:00" },
    kitchen: { start: "08:00", end: "23:20" },
    delivery: { start: "20:00", end: "22:50" },
  } satisfies OperatingHoursSetting,
  deliveryFee: { cents: 0 } satisfies DeliveryFeeSetting,
  opsFlags: { pauseOrders: false, forcePickup: false } satisfies OpsFlagsSetting,
  deliveryAreaRule: { enabled: false } satisfies DeliveryAreaRuleSetting,
};

async function getSetting<T>(key: string, fallback: T): Promise<T> {
  const [row] = await db.select({ value: AppSetting.value }).from(AppSetting).where(eq(AppSetting.key, key)).limit(1);
  return (row?.value ?? fallback) as T;
}

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function minsToHHMM(mins: number) {
  const value = Math.max(0, Math.min(24 * 60, Math.trunc(mins)));
  if (value === 24 * 60) return "00:00";
  const h = Math.floor(value / 60);
  const mm = value % 60;
  return `${String(h).padStart(2, "0")}:${String(mm).padStart(2, "0")}`;
}

function normalizeDow(v: number) {
  if (!Number.isFinite(v)) return 1;
  if (v === 0) return 7;
  if (v >= 1 && v <= 7) return v;
  if (v >= 0 && v <= 6) return v + 1;
  return 1;
}

function fallbackWindowForChannel(channel: ArcadiaChannel, operatingHours: OperatingHoursSetting) {
  if (channel === "DELIVERY") {
    return {
      start: operatingHours.delivery?.start ?? DEFAULTS.operatingHours.delivery.start,
      end: operatingHours.delivery?.end ?? DEFAULTS.operatingHours.delivery.end,
    };
  }
  return {
    start: operatingHours.open?.start ?? DEFAULTS.operatingHours.open.start,
    end: operatingHours.open?.end ?? DEFAULTS.operatingHours.open.end,
  };
}

function formatDateISO(dateISO: string) {
  const match = String(dateISO).match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) return dateISO;
  return `${match[3]}/${match[2]}/${match[1]}`;
}

function channelLabel(channel: ArcadiaChannel) {
  return CHANNELS.find((item) => item.key === channel)?.label ?? channel;
}

function channelTone(channel: ArcadiaChannel): ToneName {
  return CHANNELS.find((item) => item.key === channel)?.tone ?? "neutral";
}

function sourceLabel(source: string) {
  if (source === "SPECIAL_DATE") return "Excepción activa";
  if (source === "SPECIAL_DATE_CLOSED") return "Excepción de cierre";
  if (source === "OPENING_HOUR") return "Horario semanal";
  if (source === "OPENING_HOUR_CLOSED") return "Descanso semanal";
  return "Fallback AppSetting";
}

const availability = await getArcadiaAvailability(new Date());

const operatingHours = await getSetting<OperatingHoursSetting>("operatingHours", DEFAULTS.operatingHours);
const deliveryFee = await getSetting<DeliveryFeeSetting>("deliveryFee", DEFAULTS.deliveryFee);
const opsFlags = await getSetting<OpsFlagsSetting>("opsFlags", DEFAULTS.opsFlags);
const deliveryAreaRule = await getSetting<DeliveryAreaRuleSetting>("deliveryAreaRule", DEFAULTS.deliveryAreaRule);

const openStart = operatingHours.open?.start ?? DEFAULTS.operatingHours.open.start;
const openEnd = operatingHours.open?.end ?? DEFAULTS.operatingHours.open.end;
const kitchenStart = operatingHours.kitchen?.start ?? DEFAULTS.operatingHours.kitchen.start;
const kitchenEnd = operatingHours.kitchen?.end ?? DEFAULTS.operatingHours.kitchen.end;
const deliveryStart = operatingHours.delivery?.start ?? DEFAULTS.operatingHours.delivery.start;
const deliveryEnd = operatingHours.delivery?.end ?? DEFAULTS.operatingHours.delivery.end;
const deliveryFeeEur = (Number(deliveryFee?.cents ?? 0) / 100).toFixed(2);
const deliveryAreaSummary = "Lloret de Mar · 17310";

const openingHourRows = await db
  .select({
    id: OpeningHour.id,
    dayOfWeek: OpeningHour.dayOfWeek,
    channel: OpeningHour.channel,
    openMins: OpeningHour.openMins,
    closeMins: OpeningHour.closeMins,
    isClosed: OpeningHour.isClosed,
  })
  .from(OpeningHour)
  .orderBy(OpeningHour.dayOfWeek, OpeningHour.channel);

const specialDateRowsRaw = await db
  .select({
    id: SpecialDate.id,
    dateISO: SpecialDate.dateISO,
    channel: SpecialDate.channel,
    isClosed: SpecialDate.isClosed,
    openMins: SpecialDate.openMins,
    closeMins: SpecialDate.closeMins,
    note: SpecialDate.note,
  })
  .from(SpecialDate)
  .orderBy(SpecialDate.dateISO, SpecialDate.channel);

const openingHourByKey = new Map<string, { isClosed: boolean; openMins: number; closeMins: number }>();

for (const row of openingHourRows) {
  const dayKey = normalizeDow(row.dayOfWeek);
  const key = `${dayKey}:${row.channel}`;
  const next = {
    isClosed: !!row.isClosed,
    openMins: Number(row.openMins ?? 0),
    closeMins: Number(row.closeMins ?? 0),
  };

  const prev = openingHourByKey.get(key);
  if (!prev) {
    openingHourByKey.set(key, next);
    continue;
  }

  if (prev.isClosed || next.isClosed) {
    openingHourByKey.set(key, { isClosed: true, openMins: prev.openMins, closeMins: prev.closeMins });
    continue;
  }

  openingHourByKey.set(key, {
    isClosed: false,
    openMins: Math.min(prev.openMins, next.openMins),
    closeMins: Math.max(prev.closeMins, next.closeMins),
  });
}

const weeklyRows: WeeklyRow[] = DAYS.map((day) => ({
  dayKey: day.key,
  dayLabel: day.label,
  channels: CHANNELS.map((channel) => {
    const fallback = fallbackWindowForChannel(channel.key, operatingHours);
    const row = openingHourByKey.get(`${day.key}:${channel.key}`);

    return {
      key: channel.key,
      label: channel.label,
      isClosed: row?.isClosed ?? false,
      open: row ? minsToHHMM(row.openMins) : fallback.start,
      close: row ? minsToHHMM(row.closeMins) : fallback.end,
      resolutionSource: (row ? "OPENING_HOUR" : "APP_SETTING") as "OPENING_HOUR" | "APP_SETTING",
    };
  }),
}));

const specialDates: SpecialDateSummary[] = specialDateRowsRaw.map((row) => {
  const fallback = fallbackWindowForChannel(row.channel as ArcadiaChannel, operatingHours);
  return {
    id: row.id,
    dateISO: row.dateISO,
    channel: row.channel as ArcadiaChannel,
    isClosed: !!row.isClosed,
    open: typeof row.openMins === "number" ? minsToHHMM(row.openMins) : fallback.start,
    close: typeof row.closeMins === "number" ? minsToHHMM(row.closeMins) : fallback.end,
    note: String(row.note ?? ""),
  };
});

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") === "1";
const hoursSaved = url.searchParams.get("hoursSaved") === "1";
const specialDatesSaved = url.searchParams.get("specialDatesSaved") === "1";
const hoursError = url.searchParams.get("hoursError") ?? "";
const specialDatesError = url.searchParams.get("specialDatesError") ?? "";

const hoursErrorMessage =
  hoursError === "invalid-hours" ? "Hay una franja semanal inválida. Revisa horas de inicio y fin." :
  hoursError === "invalid-channel" ? "Se recibió un canal horario no válido." :
  "";

const specialDatesErrorMessage =
  specialDatesError === "invalid-special-date" ? "La excepción indicada no es válida." :
  specialDatesError === "invalid-date" ? "La fecha especial no tiene un formato válido." :
  specialDatesError === "invalid-channel" ? "El canal de la fecha especial no es válido." :
  specialDatesError === "invalid-hours" ? "La franja de la fecha especial no es válida." :
  specialDatesError === "invalid-range" ? "La fecha final del periodo es anterior a la inicial." :
  specialDatesError === "range-too-long" ? "El periodo no puede superar un año." :
  specialDatesError === "duplicate-special-date" ? "Ya existe una excepción para esa fecha y ese canal." :
  specialDatesError === "invalid-intent" ? "Acción de fecha especial no válida." :
  "";

const totalWeeklySlots = DAYS.length * CHANNELS.length;
const structuredWeeklySlots = weeklyRows.reduce(
  (count, day) => count + day.channels.filter((channel) => channel.resolutionSource === "OPENING_HOUR").length,
  0,
);
const fallbackWeeklySlots = totalWeeklySlots - structuredWeeklySlots;
const partiallyStructuredWeeklyHours = structuredWeeklySlots > 0 && structuredWeeklySlots < totalWeeklySlots;

const todayDateISO = availability.todayDateISO;
const upcomingSpecialDates = specialDates.filter((row) => row.dateISO >= todayDateISO);

const statusRows = [
  { label: "Local", value: availability.localOpen ? "Abierto" : "Cerrado", tone: (availability.localOpen ? "success" : "danger") as ToneName, help: `${availability.windows.open.start} – ${availability.windows.open.end} · ${sourceLabel(availability.sources.open)}` },
  { label: "Pickup", value: availability.pickupAvailable ? "Disponible" : "No disponible", tone: (availability.pickupAvailable ? "primary" : "warning") as ToneName, help: `${availability.windows.pickup.start} – ${availability.windows.pickup.end} · ${sourceLabel(availability.sources.pickup)}` },
  { label: "Delivery", value: opsFlags.forcePickup ? "Forzado a pickup" : availability.deliveryAvailable ? "Disponible" : "No disponible", tone: (opsFlags.forcePickup ? "warning" : availability.deliveryAvailable ? "cyan" : "warning") as ToneName, help: `${availability.windows.delivery.start} – ${availability.windows.delivery.end} · ${sourceLabel(availability.sources.delivery)}` },
  { label: "Cocina", value: availability.kitchenOpen ? "Activa" : "Cerrada", tone: (availability.kitchenOpen ? "violet" : "warning") as ToneName, help: `${availability.windows.kitchen.start} – ${availability.windows.kitchen.end} · AppSetting` },
  { label: "Área delivery", value: deliveryAreaRule.enabled ? "Activa" : "Desactivada", tone: (deliveryAreaRule.enabled ? "fuchsia" : "neutral") as ToneName, help: deliveryAreaSummary },
];

const timeInputClass = "w-full rounded-xl border border-admin-border bg-white/[0.03] px-2.5 py-1.5 text-xs text-white focus:border-sky-400/40 focus:outline-none";
const fieldInputClass = "w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none";
const labelClass = "mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted";
---

<AdminLayout title="Operativa · Admin · Arcadia" heading="Operativa" description="Horarios por canal, flags inmediatos y excepciones de calendario.">
  <div class="space-y-6">
    {saved ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">Base operativa y flags guardados correctamente.</section> : null}
    {hoursSaved ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">Horario semanal guardado correctamente.</section> : null}
    {specialDatesSaved ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">Fechas especiales actualizadas correctamente.</section> : null}
    {hoursErrorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{hoursErrorMessage}</section> : null}
    {specialDatesErrorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{specialDatesErrorMessage}</section> : null}

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard icon="live" label="Pedidos" value={opsFlags.pauseOrders ? "Pausados" : "Activos"} helper={opsFlags.pauseOrders ? "Checkout bloqueado" : "Checkout operativo"} />
      <StatCard icon="coin" label="Fee de delivery" value={money(deliveryFee.cents)} helper={`${structuredWeeklySlots}/${totalWeeklySlots} franjas en OpeningHour`} />
    </section>

    <Card padded={false}>
      <div class="border-b border-admin-border px-5 py-4 lg:px-6">
        <h2 class="text-base font-semibold text-white">Estado ahora mismo</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Canal</th>
              <th>Estado</th>
              <th>Ventana y origen</th>
            </tr>
          </thead>
          <tbody>
            {statusRows.map((row) => (
              <tr>
                <td class="font-semibold text-white">{row.label}</td>
                <td><Badge tone={row.tone}>{row.value}</Badge></td>
                <td class="text-admin-muted">{row.help}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>

    <form method="post" action="/api/admin/operativa/save">
      <Card>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <div class="admin-eyebrow">Base operativa</div>
            <h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-white">Ventanas base y flags</h2>
          </div>
          <Badge tone="neutral">Fallback de AppSetting</Badge>
        </div>

        <div class="mt-5 grid gap-4 lg:grid-cols-3">
          {[
            { label: "Local", startName: "openStart", endName: "openEnd", start: openStart, end: openEnd },
            { label: "Cocina", startName: "kitchenStart", endName: "kitchenEnd", start: kitchenStart, end: kitchenEnd },
            { label: "Delivery", startName: "deliveryStart", endName: "deliveryEnd", start: deliveryStart, end: deliveryEnd },
          ].map((block) => (
            <div class="rounded-admin-lg border border-admin-border bg-white/[0.02] p-4">
              <div class="text-sm font-semibold text-white">{block.label}</div>
              <div class="mt-3 grid grid-cols-2 gap-3">
                <label class="block">
                  <span class={labelClass}>Inicio</span>
                  <input class={fieldInputClass} type="time" name={block.startName} value={block.start} required />
                </label>
                <label class="block">
                  <span class={labelClass}>Fin</span>
                  <input class={fieldInputClass} type="time" name={block.endName} value={block.end} required />
                </label>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-[220px_minmax(0,1fr)]">
          <label class="block">
            <span class={labelClass}>Fee delivery €</span>
            <input class={fieldInputClass} type="number" step="0.01" min="0" name="deliveryFeeEur" value={deliveryFeeEur} required />
          </label>

          <div class="flex flex-wrap items-end gap-x-6 gap-y-2.5 pb-1">
            <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="pauseOrders" checked={opsFlags.pauseOrders} />
              Pausar pedidos
            </label>
            <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="forcePickup" checked={opsFlags.forcePickup} />
              Forzar pickup
            </label>
            <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="deliveryAreaEnabled" checked={deliveryAreaRule.enabled} />
              Restringir área de delivery
            </label>
          </div>
        </div>

        <button type="submit" class="mt-5 inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
          Guardar base y flags
        </button>
      </Card>
    </form>

    <form method="post" action="/api/admin/operativa/hours">
      <Card padded={false}>
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
          <div>
            <h2 class="text-base font-semibold text-white">Horario semanal por canal</h2>
            <p class="mt-1 text-xs text-admin-muted">Cada celda pisa solo su franja; las vacías caen al fallback.</p>
          </div>
          <Badge tone={structuredWeeklySlots === totalWeeklySlots ? "success" : structuredWeeklySlots === 0 ? "warning" : "primary"}>
            {structuredWeeklySlots}/{totalWeeklySlots} en OpeningHour
          </Badge>
        </div>

        {
          partiallyStructuredWeeklyHours ? (
            <div class="border-b border-admin-border bg-amber-400/[0.06] px-5 py-3 text-xs text-amber-100 lg:px-6">
              Cobertura parcial: {fallbackWeeklySlots} franja(s) siguen resolviéndose por fallback.
            </div>
          ) : null
        }

        <div class="overflow-x-auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Día</th>
                {CHANNELS.map((channel) => <th>{channel.label}</th>)}
              </tr>
            </thead>
            <tbody>
              {weeklyRows.map((day) => (
                <tr>
                  <td class="font-semibold text-white">{day.dayLabel}</td>
                  {day.channels.map((channel) => (
                    <td>
                      <div class="flex items-center gap-1.5">
                        <input class={timeInputClass} type="time" name={`hours_${day.dayKey}_${channel.key}_open`} value={channel.open} required />
                        <span class="text-admin-faint">–</span>
                        <input class={timeInputClass} type="time" name={`hours_${day.dayKey}_${channel.key}_close`} value={channel.close} required />
                      </div>
                      <label class="mt-1.5 inline-flex items-center gap-1.5 text-[11px] text-admin-muted">
                        <input class="h-3.5 w-3.5 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name={`hours_${day.dayKey}_${channel.key}_closed`} checked={channel.isClosed} />
                        Cerrado
                        {channel.resolutionSource === "APP_SETTING" ? <span class="ml-1 text-amber-300/70">· fallback</span> : null}
                      </label>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="border-t border-admin-border px-5 py-4 lg:px-6">
          <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
            Guardar horario semanal
          </button>
        </div>
      </Card>
    </form>

    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <div>
          <h2 class="text-base font-semibold text-white">Fechas especiales</h2>
          <p class="mt-1 text-xs text-admin-muted">Excepciones puntuales; tienen prioridad sobre el horario semanal.</p>
        </div>

        <Modal id="special-date-create" title="Nueva excepción" description="Un día suelto o un periodo completo, para un canal o para todos." triggerLabel="+ Nueva excepción">
          <form method="post" action="/api/admin/operativa/special-dates" class="grid gap-4">
            <input type="hidden" name="intent" value="create" />

            <div class="grid grid-cols-2 gap-4">
              <label class="block">
                <span class={labelClass}>Desde</span>
                <input class={fieldInputClass} type="date" name="dateFrom" required />
              </label>
              <label class="block">
                <span class={labelClass}>Hasta (opcional)</span>
                <input class={fieldInputClass} type="date" name="dateTo" />
              </label>
            </div>

            <label class="block">
              <span class={labelClass}>Canal</span>
              <select name="channel" class={fieldInputClass}>
                <option value="ALL">Todos los canales</option>
                {CHANNELS.map((channel) => <option value={channel.key}>{channel.label}</option>)}
              </select>
            </label>

            <div class="grid grid-cols-2 gap-4">
              <label class="block">
                <span class={labelClass}>Apertura</span>
                <input class={fieldInputClass} type="time" name="openTime" value={openStart} />
              </label>
              <label class="block">
                <span class={labelClass}>Cierre</span>
                <input class={fieldInputClass} type="time" name="closeTime" value={openEnd} />
              </label>
            </div>

            <label class="block">
              <span class={labelClass}>Nota</span>
              <input class={fieldInputClass} type="text" name="note" placeholder="Festivo local" />
            </label>

            <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="isClosed" />
              Cerrado todo el día
            </label>

            <p class="text-xs leading-5 text-admin-muted">
              Si el periodo abarca varios días se crea una excepción por día y canal. Las que ya existan para esas fechas se sobrescriben.
            </p>

            <button type="submit" class="mt-1 inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
              Crear excepción
            </button>
          </form>
        </Modal>
      </div>

      {
        upcomingSpecialDates.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="Sin excepciones próximas" description="Crea una para cerrar un día concreto o cambiar su franja." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Canal</th>
                  <th>Franja</th>
                  <th>Nota</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {upcomingSpecialDates.map((row) => (
                  <tr>
                    <td>
                      <div class="font-semibold text-white">{formatDateISO(row.dateISO)}</div>
                      {row.dateISO === todayDateISO ? <div class="text-xs text-amber-300">Hoy</div> : null}
                    </td>
                    <td><Badge tone={channelTone(row.channel)}>{channelLabel(row.channel)}</Badge></td>
                    <td>
                      {row.isClosed ? <Badge tone="danger">Cerrado</Badge> : <span class="text-admin-muted">{row.open} – {row.close}</span>}
                    </td>
                    <td class="max-w-[240px] truncate text-admin-muted">{row.note || "—"}</td>
                    <td>
                      <div class="flex justify-end">
                        <Modal
                          id={`special-date-edit-${row.id}`}
                          title={`${formatDateISO(row.dateISO)} · ${channelLabel(row.channel)}`}
                          triggerLabel="Editar"
                          triggerClass="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]"
                        >
                          <form method="post" action="/api/admin/operativa/special-dates" class="grid gap-4">
                            <input type="hidden" name="intent" value="update" />
                            <input type="hidden" name="specialDateId" value={row.id} />

                            <div class="grid grid-cols-2 gap-4">
                              <label class="block">
                                <span class={labelClass}>Fecha</span>
                                <input class={fieldInputClass} type="date" name="dateISO" value={row.dateISO} required />
                              </label>
                              <label class="block">
                                <span class={labelClass}>Canal</span>
                                <select name="channel" class={fieldInputClass}>
                                  {CHANNELS.map((channel) => (
                                    <option value={channel.key} selected={row.channel === channel.key}>{channel.label}</option>
                                  ))}
                                </select>
                              </label>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                              <label class="block">
                                <span class={labelClass}>Apertura</span>
                                <input class={fieldInputClass} type="time" name="openTime" value={row.open} />
                              </label>
                              <label class="block">
                                <span class={labelClass}>Cierre</span>
                                <input class={fieldInputClass} type="time" name="closeTime" value={row.close} />
                              </label>
                            </div>

                            <label class="block">
                              <span class={labelClass}>Nota</span>
                              <input class={fieldInputClass} type="text" name="note" value={row.note} />
                            </label>

                            <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="isClosed" checked={row.isClosed} />
                              Cerrado todo el día
                            </label>

                            <button type="submit" class="mt-1 inline-flex min-h-10 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
                              Guardar
                            </button>
                          </form>

                          <form method="post" action="/api/admin/operativa/special-dates" class="mt-3 border-t border-admin-border pt-3">
                            <input type="hidden" name="intent" value="delete" />
                            <input type="hidden" name="specialDateId" value={row.id} />
                            <button type="submit" class="inline-flex min-h-9 items-center justify-center rounded-2xl border border-rose-400/20 bg-rose-400/10 px-4 py-2 text-sm font-semibold text-rose-300 transition hover:border-rose-400/30 hover:bg-rose-400/15">
                              Borrar excepción
                            </button>
                          </form>
                        </Modal>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
