---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { db, AppSetting, eq } from "astro:db";

const DEFAULTS = {
  operatingHours: {
    kitchen: { start: "08:00", end: "23:20" },
    delivery: { start: "20:00", end: "22:50" },
  },
  deliveryFee: { cents: 0 },
  opsFlags: { pauseOrders: false, forcePickup: false },
};

async function getSetting(key: string, fallback: any) {
  const [r] = await db.select({ value: AppSetting.value }).from(AppSetting).where(eq(AppSetting.key, key)).limit(1);
  return (r?.value ?? fallback) as any;
}

const operatingHours = await getSetting("operatingHours", DEFAULTS.operatingHours);
const deliveryFee = await getSetting("deliveryFee", DEFAULTS.deliveryFee);
const opsFlags = await getSetting("opsFlags", DEFAULTS.opsFlags);
---

<SiteLayout title="Operativa · Admin · Arcadia">
  <h1 class="text-2xl font-semibold tracking-tight">Operativa</h1>
  <p class="mt-2 text-sm text-zinc-600">Cambia horarios, fees y flags sin tocar código.</p>

  <form class="mt-6 space-y-6" method="post" action="/api/admin/operativa/save">
    <section class="rounded-2xl border border-zinc-200 p-5">
      <h2 class="text-lg font-semibold">Horarios</h2>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-zinc-100 p-4">
          <div class="font-semibold">Cocina</div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <div>
              <label class="text-sm">Inicio</label>
              <input class="mt-1 w-full rounded-xl border border-zinc-300 px-3 py-2 text-sm"
                type="time" name="kitchenStart" value={operatingHours.kitchen.start} required />
            </div>
            <div>
              <label class="text-sm">Fin</label>
              <input class="mt-1 w-full rounded-xl border border-zinc-300 px-3 py-2 text-sm"
                type="time" name="kitchenEnd" value={operatingHours.kitchen.end} required />
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-zinc-100 p-4">
          <div class="font-semibold">Delivery</div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <div>
              <label class="text-sm">Inicio</label>
              <input class="mt-1 w-full rounded-xl border border-zinc-300 px-3 py-2 text-sm"
                type="time" name="deliveryStart" value={operatingHours.delivery.start} required />
            </div>
            <div>
              <label class="text-sm">Fin</label>
              <input class="mt-1 w-full rounded-xl border border-zinc-300 px-3 py-2 text-sm"
                type="time" name="deliveryEnd" value={operatingHours.delivery.end} required />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-zinc-200 p-5">
      <h2 class="text-lg font-semibold">Delivery fee</h2>
      <div class="mt-4 max-w-sm">
        <label class="text-sm">€</label>
        <input
          class="mt-1 w-full rounded-xl border border-zinc-300 px-3 py-2 text-sm"
          type="number"
          step="0.01"
          name="deliveryFeeEur"
          value={(deliveryFee.cents / 100).toFixed(2)}
        />
      </div>
    </section>

    <section class="rounded-2xl border border-zinc-200 p-5">
      <h2 class="text-lg font-semibold">Flags</h2>

      <div class="mt-4 space-y-3 text-sm">
        <label class="flex items-center gap-2">
          <input type="checkbox" name="pauseOrders" checked={opsFlags.pauseOrders} />
          Pausar pedidos (checkout bloqueado)
        </label>

        <label class="flex items-center gap-2">
          <input type="checkbox" name="forcePickup" checked={opsFlags.forcePickup} />
          Forzar recogida siempre (sin delivery aunque esté en horario)
        </label>
      </div>
    </section>

    <button class="rounded-xl bg-zinc-900 px-4 py-2 text-sm font-semibold text-white" type="submit">
      Guardar
    </button>
  </form>
</SiteLayout>
