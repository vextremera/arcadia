---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db, AppSetting, OpeningHour, SpecialDate, eq } from "astro:db";
import {
  getArcadiaAvailability,
  type ArcadiaChannel,
} from "@/server/time/madrid";

type OperatingHoursSetting = {
  open: { start: string; end: string };
  kitchen: { start: string; end: string };
  delivery: { start: string; end: string };
};

type DeliveryFeeSetting = {
  cents: number;
};

type OpsFlagsSetting = {
  pauseOrders: boolean;
  forcePickup: boolean;
};

type DeliveryAreaRuleSetting = {
  enabled: boolean;
};

type ChannelEditor = {
  key: ArcadiaChannel;
  label: string;
  badgeClass: string;
  panelClass: string;
  isClosed: boolean;
  open: string;
  close: string;
  resolutionSource: "OPENING_HOUR" | "APP_SETTING";
  resolutionLabel: string;
  resolutionTone: string;
};

type WeeklyRow = {
  dayKey: number;
  dayLabel: string;
  channels: ChannelEditor[];
};

type SpecialDateSummary = {
  id: number;
  dateISO: string;
  channel: ArcadiaChannel;
  isClosed: boolean;
  open: string;
  close: string;
  note: string;
};

const DAYS = [
  { key: 1, label: "Lunes" },
  { key: 2, label: "Martes" },
  { key: 3, label: "Miércoles" },
  { key: 4, label: "Jueves" },
  { key: 5, label: "Viernes" },
  { key: 6, label: "Sábado" },
  { key: 7, label: "Domingo" },
];

const CHANNELS: Array<{
  key: ArcadiaChannel;
  label: string;
  badgeClass: string;
  panelClass: string;
}> = [
  {
    key: "DINE_IN",
    label: "Local",
    badgeClass: "border-emerald-400/20 bg-emerald-400/10 text-emerald-300",
    panelClass: "border-emerald-400/15 bg-emerald-400/6",
  },
  {
    key: "PICKUP",
    label: "Pickup",
    badgeClass: "border-indigo-400/20 bg-indigo-400/10 text-indigo-300",
    panelClass: "border-indigo-400/15 bg-indigo-400/6",
  },
  {
    key: "DELIVERY",
    label: "Delivery",
    badgeClass: "border-cyan-400/20 bg-cyan-400/10 text-cyan-300",
    panelClass: "border-cyan-400/15 bg-cyan-400/6",
  },
];

const DEFAULTS = {
  operatingHours: {
    open: { start: "07:30", end: "00:00" },
    kitchen: { start: "08:00", end: "23:20" },
    delivery: { start: "20:00", end: "22:50" },
  } satisfies OperatingHoursSetting,
  deliveryFee: { cents: 0 } satisfies DeliveryFeeSetting,
  opsFlags: {
    pauseOrders: false,
    forcePickup: false,
  } satisfies OpsFlagsSetting,
  deliveryAreaRule: { enabled: false } satisfies DeliveryAreaRuleSetting,
};

async function getSetting<T>(key: string, fallback: T): Promise<T> {
  const [row] = await db
    .select({ value: AppSetting.value })
    .from(AppSetting)
    .where(eq(AppSetting.key, key))
    .limit(1);

  return (row?.value ?? fallback) as T;
}

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function minsToHHMM(mins: number) {
  const value = Math.max(0, Math.min(24 * 60, Math.trunc(mins)));
  if (value === 24 * 60) return "00:00";
  const h = Math.floor(value / 60);
  const mm = value % 60;
  return `${String(h).padStart(2, "0")}:${String(mm).padStart(2, "0")}`;
}

function normalizeDow(v: number) {
  if (!Number.isFinite(v)) return 1;
  if (v === 0) return 7;
  if (v >= 1 && v <= 7) return v;
  if (v >= 0 && v <= 6) return v + 1;
  return 1;
}

function fallbackWindowForChannel(
  channel: ArcadiaChannel,
  operatingHours: OperatingHoursSetting,
) {
  if (channel === "DELIVERY") {
    return {
      start:
        operatingHours.delivery?.start ??
        DEFAULTS.operatingHours.delivery.start,
      end: operatingHours.delivery?.end ?? DEFAULTS.operatingHours.delivery.end,
    };
  }

  return {
    start: operatingHours.open?.start ?? DEFAULTS.operatingHours.open.start,
    end: operatingHours.open?.end ?? DEFAULTS.operatingHours.open.end,
  };
}

function formatDateISO(dateISO: string) {
  const match = String(dateISO).match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) return dateISO;
  return `${match[3]}/${match[2]}/${match[1]}`;
}

function channelLabel(channel: ArcadiaChannel) {
  return CHANNELS.find((item) => item.key === channel)?.label ?? channel;
}

function sourceLabel(source: string) {
  if (source === "SPECIAL_DATE") return "Excepción activa";
  if (source === "SPECIAL_DATE_CLOSED") return "Excepción de cierre";
  if (source === "OPENING_HOUR") return "Horario semanal";
  if (source === "OPENING_HOUR_CLOSED") return "Descanso semanal";
  return "Fallback AppSetting";
}

function weeklySourceMeta(source: "OPENING_HOUR" | "APP_SETTING") {
  if (source === "OPENING_HOUR") {
    return {
      label: "OpeningHour",
      tone: "border-sky-400/20 bg-sky-400/10 text-sky-200",
    };
  }

  return {
    label: "Fallback AppSetting",
    tone: "border-amber-400/20 bg-amber-400/10 text-amber-200",
  };
}

const availability = await getArcadiaAvailability(new Date());

const operatingHours = await getSetting<OperatingHoursSetting>(
  "operatingHours",
  DEFAULTS.operatingHours,
);
const deliveryFee = await getSetting<DeliveryFeeSetting>(
  "deliveryFee",
  DEFAULTS.deliveryFee,
);
const opsFlags = await getSetting<OpsFlagsSetting>(
  "opsFlags",
  DEFAULTS.opsFlags,
);
const deliveryAreaRule = await getSetting<DeliveryAreaRuleSetting>(
  "deliveryAreaRule",
  DEFAULTS.deliveryAreaRule,
);

const openStart =
  operatingHours.open?.start ?? DEFAULTS.operatingHours.open.start;
const openEnd = operatingHours.open?.end ?? DEFAULTS.operatingHours.open.end;
const kitchenStart =
  operatingHours.kitchen?.start ?? DEFAULTS.operatingHours.kitchen.start;
const kitchenEnd =
  operatingHours.kitchen?.end ?? DEFAULTS.operatingHours.kitchen.end;
const deliveryStart =
  operatingHours.delivery?.start ?? DEFAULTS.operatingHours.delivery.start;
const deliveryEnd =
  operatingHours.delivery?.end ?? DEFAULTS.operatingHours.delivery.end;
const deliveryFeeEur = (Number(deliveryFee?.cents ?? 0) / 100).toFixed(2);
const deliveryAreaSummary = "Lloret de Mar · 17310";

const openingHourRows = await db
  .select({
    id: OpeningHour.id,
    dayOfWeek: OpeningHour.dayOfWeek,
    channel: OpeningHour.channel,
    openMins: OpeningHour.openMins,
    closeMins: OpeningHour.closeMins,
    isClosed: OpeningHour.isClosed,
  })
  .from(OpeningHour)
  .orderBy(OpeningHour.dayOfWeek, OpeningHour.channel);

const specialDateRowsRaw = await db
  .select({
    id: SpecialDate.id,
    dateISO: SpecialDate.dateISO,
    channel: SpecialDate.channel,
    isClosed: SpecialDate.isClosed,
    openMins: SpecialDate.openMins,
    closeMins: SpecialDate.closeMins,
    note: SpecialDate.note,
  })
  .from(SpecialDate)
  .orderBy(SpecialDate.dateISO, SpecialDate.channel);

const openingHourByKey = new Map<
  string,
  { isClosed: boolean; openMins: number; closeMins: number }
>();

for (const row of openingHourRows) {
  const dayKey = normalizeDow(row.dayOfWeek);
  const key = `${dayKey}:${row.channel}`;
  const next = {
    isClosed: !!row.isClosed,
    openMins: Number(row.openMins ?? 0),
    closeMins: Number(row.closeMins ?? 0),
  };

  const prev = openingHourByKey.get(key);
  if (!prev) {
    openingHourByKey.set(key, next);
    continue;
  }

  if (prev.isClosed || next.isClosed) {
    openingHourByKey.set(key, {
      isClosed: true,
      openMins: prev.openMins,
      closeMins: prev.closeMins,
    });
    continue;
  }

  openingHourByKey.set(key, {
    isClosed: false,
    openMins: Math.min(prev.openMins, next.openMins),
    closeMins: Math.max(prev.closeMins, next.closeMins),
  });
}

const weeklyRows: WeeklyRow[] = DAYS.map((day) => ({
  dayKey: day.key,
  dayLabel: day.label,
  channels: CHANNELS.map((channel) => {
    const fallback = fallbackWindowForChannel(channel.key, operatingHours);
    const row = openingHourByKey.get(`${day.key}:${channel.key}`);
    const resolutionSource = row ? "OPENING_HOUR" : "APP_SETTING";
    const resolutionMeta = weeklySourceMeta(resolutionSource);

    return {
      key: channel.key,
      label: channel.label,
      badgeClass: channel.badgeClass,
      panelClass: channel.panelClass,
      isClosed: row?.isClosed ?? false,
      open: row ? minsToHHMM(row.openMins) : fallback.start,
      close: row ? minsToHHMM(row.closeMins) : fallback.end,
      resolutionSource,
      resolutionLabel: resolutionMeta.label,
      resolutionTone: resolutionMeta.tone,
    };
  }),
}));

const specialDates: SpecialDateSummary[] = specialDateRowsRaw.map((row) => {
  const fallback = fallbackWindowForChannel(
    row.channel as ArcadiaChannel,
    operatingHours,
  );

  return {
    id: row.id,
    dateISO: row.dateISO,
    channel: row.channel as ArcadiaChannel,
    isClosed: !!row.isClosed,
    open:
      typeof row.openMins === "number"
        ? minsToHHMM(row.openMins)
        : fallback.start,
    close:
      typeof row.closeMins === "number"
        ? minsToHHMM(row.closeMins)
        : fallback.end,
    note: String(row.note ?? ""),
  };
});

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") === "1";
const hoursSaved = url.searchParams.get("hoursSaved") === "1";
const specialDatesSaved = url.searchParams.get("specialDatesSaved") === "1";
const hoursError = url.searchParams.get("hoursError") ?? "";
const specialDatesError = url.searchParams.get("specialDatesError") ?? "";

const hoursErrorMessage =
  hoursError === "invalid-hours"
    ? "Hay una franja semanal inválida. Revisa horas de inicio y fin."
    : hoursError === "invalid-channel"
      ? "Se recibió un canal horario no válido."
      : "";

const specialDatesErrorMessage =
  specialDatesError === "invalid-special-date"
    ? "La excepción indicada no es válida."
    : specialDatesError === "invalid-date"
      ? "La fecha especial no tiene un formato válido."
      : specialDatesError === "invalid-channel"
        ? "El canal de la fecha especial no es válido."
        : specialDatesError === "invalid-hours"
          ? "La franja de la fecha especial no es válida."
          : specialDatesError === "duplicate-special-date"
            ? "Ya existe una excepción para esa fecha y ese canal."
            : specialDatesError === "invalid-intent"
              ? "Acción de fecha especial no válida."
              : "";

const totalWeeklySlots = DAYS.length * CHANNELS.length;
const structuredWeeklySlots = weeklyRows.reduce(
  (count, day) =>
    count +
    day.channels.filter(
      (channel) => channel.resolutionSource === "OPENING_HOUR",
    ).length,
  0,
);
const fallbackWeeklySlots = totalWeeklySlots - structuredWeeklySlots;
const partiallyStructuredWeeklyHours =
  structuredWeeklySlots > 0 && structuredWeeklySlots < totalWeeklySlots;
const weeklyResolutionHelp =
  structuredWeeklySlots === totalWeeklySlots
    ? "Cobertura completa en OpeningHour"
    : structuredWeeklySlots === 0
      ? "Ahora mismo todo cae a AppSetting"
      : `${structuredWeeklySlots}/${totalWeeklySlots} franjas en OpeningHour · ${fallbackWeeklySlots} en fallback`;
const todayDateISO = availability.todayDateISO;
const todaySpecialDates = specialDates.filter(
  (row) => row.dateISO === todayDateISO,
);
const upcomingSpecialDates = specialDates.filter(
  (row) => row.dateISO >= todayDateISO,
);

const statusCards = [
  {
    label: "Local",
    value: availability.localOpen ? "Abierto" : "Cerrado",
    tone: availability.localOpen
      ? "border-emerald-400/15 bg-emerald-400/8 text-emerald-200"
      : "border-rose-400/15 bg-rose-400/8 text-rose-200",
    help: `${availability.windows.open.start} - ${availability.windows.open.end} · ${sourceLabel(availability.sources.open)}`,
  },
  {
    label: "Pickup",
    value: availability.pickupAvailable ? "Disponible" : "No disponible",
    tone: availability.pickupAvailable
      ? "border-sky-400/15 bg-sky-400/8 text-sky-200"
      : "border-amber-400/15 bg-amber-400/8 text-amber-200",
    help: `${availability.windows.pickup.start} - ${availability.windows.pickup.end} · ${sourceLabel(availability.sources.pickup)}`,
  },
  {
    label: "Delivery",
    value: opsFlags.forcePickup
      ? "Forzado a pickup"
      : availability.deliveryAvailable
        ? "Disponible"
        : "No disponible",
    tone: opsFlags.forcePickup
      ? "border-amber-400/15 bg-amber-400/8 text-amber-200"
      : availability.deliveryAvailable
        ? "border-cyan-400/15 bg-cyan-400/8 text-cyan-200"
        : "border-amber-400/15 bg-amber-400/8 text-amber-200",
    help: `${availability.windows.delivery.start} - ${availability.windows.delivery.end} · ${sourceLabel(availability.sources.delivery)}`,
  },
  {
    label: "Kitchen",
    value: availability.kitchenOpen ? "Activa" : "Cerrada",
    tone: availability.kitchenOpen
      ? "border-violet-400/15 bg-violet-400/8 text-violet-200"
      : "border-amber-400/15 bg-amber-400/8 text-amber-200",
    help: `${availability.windows.kitchen.start} - ${availability.windows.kitchen.end} · AppSetting`,
  },
  {
    label: "Pedidos",
    value: opsFlags.pauseOrders ? "Pausados" : "Activos",
    tone: opsFlags.pauseOrders
      ? "border-rose-400/15 bg-rose-400/8 text-rose-200"
      : "border-emerald-400/15 bg-emerald-400/8 text-emerald-200",
    help: opsFlags.pauseOrders ? "Checkout bloqueado" : "Checkout operativo",
  },
  {
    label: "Fee delivery",
    value: money(deliveryFee.cents),
    tone: "border-white/10 bg-white/[0.03] text-slate-300",
    help: "Tarifa aplicada al envío",
  },
  {
    label: "Área delivery",
    value: deliveryAreaRule.enabled ? "Activa" : "Desactivada",
    tone: deliveryAreaRule.enabled
      ? "border-fuchsia-400/15 bg-fuchsia-400/8 text-fuchsia-200"
      : "border-white/10 bg-white/[0.03] text-slate-300",
    help: deliveryAreaSummary,
  },
];
---

<AdminLayout
  title="Operativa · Admin · Arcadia"
  heading="Operativa"
  description="Pantalla central de horarios, flags y excepciones. La he reordenado para que respire más: menos bloques apretados y una lectura mucho más clara de qué manda realmente en cada capa."
  actions={true}
>
  <Fragment slot="actions">
    <div class="flex flex-wrap gap-3">
      <a
        href="/admin/ajustes/pagos"
        class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06] hover:text-white"
      >
        Ajustes de pago
      </a>

      <a
        href="/admin/ajustes/fees"
        class="inline-flex min-h-10 items-center justify-center rounded-2xl border border-sky-400/15 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/25 hover:bg-sky-400/15"
      >
        Ver fees
      </a>
    </div>
  </Fragment>

  {
    saved ? (
      <section class="mb-6 rounded-[26px] border border-emerald-400/15 bg-emerald-400/10 px-5 py-4 text-sm text-emerald-100">
        Base operativa y flags guardados correctamente.
      </section>
    ) : null
  }

  {
    hoursSaved ? (
      <section class="mb-6 rounded-[26px] border border-sky-400/15 bg-sky-400/10 px-5 py-4 text-sm text-sky-100">
        Horario semanal estructurado guardado correctamente.
      </section>
    ) : null
  }

  {
    specialDatesSaved ? (
      <section class="mb-6 rounded-[26px] border border-violet-400/15 bg-violet-400/10 px-5 py-4 text-sm text-violet-100">
        Fechas especiales actualizadas correctamente.
      </section>
    ) : null
  }

  {
    hoursErrorMessage ? (
      <section class="mb-6 rounded-[26px] border border-rose-400/15 bg-rose-400/10 px-5 py-4 text-sm text-rose-100">
        {hoursErrorMessage}
      </section>
    ) : null
  }

  {
    specialDatesErrorMessage ? (
      <section class="mb-6 rounded-[26px] border border-rose-400/15 bg-rose-400/10 px-5 py-4 text-sm text-rose-100">
        {specialDatesErrorMessage}
      </section>
    ) : null
  }

  <section class="grid gap-4 md:grid-cols-2 2xl:grid-cols-4">
    {
      statusCards.map((card) => (
        <article
          class:list={[
            "rounded-[28px] border p-6 shadow-[0_18px_60px_rgba(2,6,23,0.28)]",
            card.tone,
          ]}
        >
          <div class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500">
            {card.label}
          </div>
          <div class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white">
            {card.value}
          </div>
          <p class="mt-3 text-sm leading-6 text-slate-400">{card.help}</p>
        </article>
      ))
    }
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.35fr)_360px]">
    <article
      class="rounded-[30px] border border-white/10 bg-[#0f172a]/82 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.34)] lg:p-7"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
      >
        Precedencia real
      </div>
      <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white">
        SpecialDate → OpeningHour → AppSetting
      </h2>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-400">
        La resolución es por canal y por fecha. Si falta una celda semanal
        concreta, no se cae todo el sistema: solo esa celda vuelve al fallback
        base. Eso permite migrar la operativa poco a poco sin dejar ambigüedad.
      </p>

      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <article
          class="rounded-[24px] border border-white/10 bg-white/[0.03] p-5"
        >
          <div
            class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
          >
            Cobertura semanal
          </div>
          <div
            class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-white"
          >
            {structuredWeeklySlots}/{totalWeeklySlots}
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Franjas ya resueltas desde OpeningHour.
          </p>
        </article>

        <article
          class="rounded-[24px] border border-white/10 bg-white/[0.03] p-5"
        >
          <div
            class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
          >
            Fallback activo
          </div>
          <div
            class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-white"
          >
            {fallbackWeeklySlots}
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Celdas que todavía siguen dependiendo de AppSetting.
          </p>
        </article>

        <article
          class="rounded-[24px] border border-white/10 bg-white/[0.03] p-5 md:col-span-2 xl:col-span-1"
        >
          <div
            class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500"
          >
            Lectura rápida
          </div>
          <div class="mt-3 text-base font-semibold text-white">
            {weeklyResolutionHelp}
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-400">
            Resumen del estado real del horario semanal estructurado.
          </p>
        </article>
      </div>
    </article>

    <aside class="space-y-6">
      <section
        class="rounded-[30px] border border-white/10 bg-[#0f172a]/82 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.34)] lg:p-7"
      >
        <div
          class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
        >
          Zona delivery
        </div>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white">
          Regla simple de reparto
        </h2>
        <p class="mt-3 text-sm leading-7 text-slate-400">
          Si este control está activo, checkout solo permite <strong
            class="text-slate-200">delivery</strong
          > para <strong class="text-slate-200">Lloret de Mar</strong> con <strong
            class="text-slate-200">17310</strong
          >. Fuera de ese criterio, el sistema fuerza pickup.
        </p>
      </section>

      {
        todaySpecialDates.length > 0 ? (
          <section class="rounded-[30px] border border-amber-400/15 bg-amber-400/10 p-6 shadow-[0_24px_80px_rgba(2,6,23,0.28)] lg:p-7">
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-amber-200">
              Hoy
            </div>
            <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white">
              Excepciones activas
            </h2>
            <p class="mt-3 text-sm leading-7 text-amber-100/85">
              El {formatDateISO(todayDateISO)} hay {todaySpecialDates.length}{" "}
              excepción{todaySpecialDates.length === 1 ? "" : "es"} activa
              {todaySpecialDates.length === 1 ? "" : "s"}. Conviene revisar esto
              antes de tocar flags globales.
            </p>
          </section>
        ) : null
      }
    </aside>
  </section>

  <form class="mt-6" method="post" action="/api/admin/operativa/save">
    <section
      class="rounded-[32px] border border-white/10 bg-[#0f172a]/82 shadow-[0_24px_80px_rgba(2,6,23,0.34)]"
    >
      <div class="border-b border-white/[0.08] px-6 py-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <div
              class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500"
            >
              Base operativa
            </div>
            <h2
              class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white lg:text-[2rem]"
            >
              Fallback general y flags inmediatos
            </h2>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-400">
              Esta capa sigue gobernando la cocina, la fee de delivery y los
              flags operativos. Además, sigue siendo el fallback si todavía
              faltan celdas reales en OpeningHour.
            </p>
          </div>

          <div
            class="inline-flex items-center rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-slate-300"
          >
            Hora Madrid: <span class="ml-2 font-semibold text-white"
              >{availability.now}</span
            >
