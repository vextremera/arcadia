---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db, Order, OrderItem, Payment, Refund, eq, inArray } from "astro:db";

type OrderStatus =
  | "PENDING"
  | "PAID"
  | "ACCEPTED"
  | "PREPARING"
  | "READY"
  | "OUT_FOR_DELIVERY"
  | "DELIVERED"
  | "CANCELLED";

type ModifierEntry = {
  name?: string;
  priceDeltaCents?: number;
};

type TimelineEntry = {
  key: string;
  title: string;
  detail: string;
  at?: Date | string | null;
  tone: string;
};

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function formatDate(value: Date | string) {
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Europe/Madrid",
  }).format(date);
}

function statusTone(status: string) {
  switch (status) {
    case "PENDING":
      return "border-amber-400/20 bg-amber-400/10 text-amber-300";
    case "PAID":
      return "border-sky-400/20 bg-sky-400/10 text-sky-300";
    case "ACCEPTED":
      return "border-cyan-400/20 bg-cyan-400/10 text-cyan-300";
    case "PREPARING":
      return "border-violet-400/20 bg-violet-400/10 text-violet-300";
    case "READY":
      return "border-emerald-400/20 bg-emerald-400/10 text-emerald-300";
    case "OUT_FOR_DELIVERY":
      return "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300";
    case "DELIVERED":
      return "border-emerald-400/20 bg-emerald-400/10 text-emerald-200";
    case "CANCELLED":
      return "border-rose-400/20 bg-rose-400/10 text-rose-300";
    default:
      return "border-white/10 bg-white/5 text-slate-300";
  }
}

function paymentStatusTone(status: string) {
  switch (status) {
    case "PAID":
      return "border-emerald-400/20 bg-emerald-400/10 text-emerald-300";
    case "UNPAID":
      return "border-amber-400/20 bg-amber-400/10 text-amber-300";
    case "AUTH":
      return "border-sky-400/20 bg-sky-400/10 text-sky-300";
    case "FAILED":
      return "border-rose-400/20 bg-rose-400/10 text-rose-300";
    case "REFUNDED":
    case "PARTIALLY_REFUNDED":
      return "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300";
    default:
      return "border-white/10 bg-white/5 text-slate-300";
  }
}

function parsePaymentMethod(snapshot: unknown) {
  const meta = (snapshot ?? {}) as Record<string, unknown>;
  const raw = String(meta.paymentMethod ?? "").toUpperCase();
  return raw === "CASH" || raw === "CARD" ? raw : null;
}

const publicId = String(Astro.params.publicId ?? "").trim();

const [order] = await db
  .select()
  .from(Order)
  .where(eq(Order.publicId, publicId))
  .limit(1);

if (!order) {
  return new Response("Pedido no encontrado", { status: 404 });
}

const items = await db
  .select()
  .from(OrderItem)
  .where(eq(OrderItem.orderId, order.id));

const payments = await db
  .select()
  .from(Payment)
  .where(eq(Payment.orderId, order.id))
  .orderBy(Payment.createdAt);

const paymentIds = payments.map((payment) => payment.id);

const refunds = paymentIds.length
  ? await db
      .select()
      .from(Refund)
      .where(inArray(Refund.paymentId, paymentIds))
      .orderBy(Refund.createdAt)
  : [];

const decoratedItems = items.map((it) => {
  const modifiers = (it.modifiers ?? {}) as Record<string, unknown>;

  const opts = (
    Array.isArray(modifiers.modifierOptions) ? modifiers.modifierOptions : []
  ) as ModifierEntry[];

  const adds = (
    Array.isArray(modifiers.ingredientsAdded) ? modifiers.ingredientsAdded : []
  ) as ModifierEntry[];

  const rems = (
    Array.isArray(modifiers.ingredientsRemoved) ? modifiers.ingredientsRemoved : []
  ) as ModifierEntry[];

  return {
    ...it,
    opts,
    adds,
    rems,
  };
});

const decoratedPayments = payments.map((payment) => ({
  ...payment,
  refunds: refunds.filter((refund) => refund.paymentId === payment.id),
}));

const meta = (order.addressSnapshot ?? {}) as Record<string, unknown>;
const paymentMethod = parsePaymentMethod(order.addressSnapshot);
const forcedPickup = Boolean(meta.forcedPickup);
const forcedReason = String(meta.forcedReason ?? "").trim();

const address = (meta.address ?? null) as
  | {
      line1?: string;
      line2?: string;
      city?: string;
      postalCode?: string;
      notes?: string;
    }
  | null;

const statusOptions: OrderStatus[] = [
  "PENDING",
  "PAID",
  "ACCEPTED",
  "PREPARING",
  "READY",
  "OUT_FOR_DELIVERY",
  "DELIVERED",
  "CANCELLED",
];

const paymentOptions = [
  "UNPAID",
  "AUTH",
  "PAID",
  "FAILED",
  "REFUNDED",
  "PARTIALLY_REFUNDED",
];

const timeline: TimelineEntry[] = [];

timeline.push({
  key: "created",
  title: "Pedido creado",
  detail: `Estado inicial ${order.status}`,
  at: order.createdAt,
  tone: "border-sky-400/20 bg-sky-400/10 text-sky-300",
});

if (order.scheduledFor) {
  timeline.push({
    key: "scheduled",
    title: "Pedido programado",
    detail: "Tiene fecha/hora de servicio programada",
    at: order.scheduledFor,
    tone: "border-indigo-400/20 bg-indigo-400/10 text-indigo-300",
  });
}

if (forcedPickup) {
  timeline.push({
    key: "forced-pickup",
    title: "Forzado a recogida",
    detail: forcedReason || "Cambio operativo aplicado",
    at: order.updatedAt,
    tone: "border-amber-400/20 bg-amber-400/10 text-amber-300",
  });
}

timeline.push({
  key: "payment-state",
  title: "Estado de pago actual",
  detail: `${paymentMethod ?? "Sin método"} · ${order.paymentStatus}`,
  at: order.updatedAt,
  tone: "border-emerald-400/20 bg-emerald-400/10 text-emerald-300",
});

timeline.push({
  key: "updated",
  title: "Última actualización",
  detail: `Estado actual ${order.status}`,
  at: order.updatedAt,
  tone: "border-white/10 bg-white/5 text-slate-300",
});

const sortedTimeline = [...timeline].sort((a, b) => {
  const aTime = a.at ? new Date(a.at).getTime() : 0;
  const bTime = b.at ? new Date(b.at).getTime() : 0;
  return bTime - aTime;
});

const returnTo = `/admin/pedidos/${order.publicId}`;
---

<AdminLayout
  title={`Pedido ${order.publicId} · Admin · Arcadia`}
  heading={`Pedido ${order.publicId}`}
  description="Detalle completo del pedido, items, cobro real y actividad del pedido."
  actions={true}
>
  <Fragment slot="actions">
    <div class="flex flex-wrap gap-3">
      <a
        href="/admin/pedidos"
        class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/10 hover:text-white"
      >
        Volver a pedidos
      </a>

      <a
        href={`/pedido/${order.publicId}`}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/10 hover:text-white"
      >
        Ver página pública
      </a>

      <a
        href={`/admin/pedidos/ticket/${order.publicId}?print=1`}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-300 transition hover:border-sky-400/30 hover:bg-sky-400/15"
      >
        Imprimir ticket
      </a>
    </div>
  </Fragment>

  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Estado</div>
      <div class="mt-3">
        <span class:list={["inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em]", statusTone(order.status)]}>
          {order.status}
        </span>
      </div>
      <p class="mt-3 text-sm text-slate-400">Workflow principal del pedido</p>
    </article>

    <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Pago</div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class:list={["inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em]", paymentStatusTone(order.paymentStatus)]}>
          {order.paymentStatus}
        </span>

        {paymentMethod ? (
          <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-slate-300">
            {paymentMethod}
          </span>
        ) : null}
      </div>
      <p class="mt-3 text-sm text-slate-400">Estado de cobro del pedido</p>
    </article>

    <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Tipo</div>
      <div class="mt-3">
        <span
          class:list={[
            "inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em]",
            order.type === "DELIVERY"
              ? "border-cyan-400/20 bg-cyan-400/10 text-cyan-300"
              : "border-indigo-400/20 bg-indigo-400/10 text-indigo-300",
          ]}
        >
          {order.type}
        </span>
      </div>
      <p class="mt-3 text-sm text-slate-400">Canal seleccionado</p>
    </article>

    <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Total</div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">{money(order.totalCents)}</div>
      <p class="mt-2 text-sm text-slate-400">Creado el {formatDate(order.createdAt)}</p>
    </article>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_420px]">
    <div class="space-y-6">
      <article class="rounded-3xl border border-white/10 bg-[#111827] p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-sky-300">Cliente</div>
            <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Datos del pedido</h2>
          </div>

          <div class="text-sm text-slate-400">Actualizado: {formatDate(order.updatedAt)}</div>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <div class="rounded-3xl border border-white/10 bg-slate-950/40 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Cliente</div>
            <div class="mt-3 text-base font-semibold text-white">{order.customerName ?? "Sin nombre"}</div>
            <div class="mt-2 text-sm text-slate-400">{order.customerPhone ?? "Sin teléfono"}</div>
            {order.customerEmail ? <div class="mt-1 text-sm text-slate-400">{order.customerEmail}</div> : null}
          </div>

          <div class="rounded-3xl border border-white/10 bg-slate-950/40 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Resumen</div>
            <div class="mt-3 space-y-2 text-sm text-slate-300">
              <div>ID público: <span class="font-semibold text-white">{order.publicId}</span></div>
              <div>Tipo: <span class="font-semibold text-white">{order.type}</span></div>
              <div>Pago: <span class="font-semibold text-white">{paymentMethod ?? "—"}</span></div>
              <div>Estado pago: <span class="font-semibold text-white">{order.paymentStatus}</span></div>
              {order.scheduledFor ? (
                <div>Programado: <span class="font-semibold text-white">{formatDate(order.scheduledFor)}</span></div>
              ) : null}
            </div>
          </div>
        </div>

        {order.type === "DELIVERY" && address ? (
          <div class="mt-4 rounded-3xl border border-cyan-400/20 bg-cyan-400/10 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-200">Dirección de entrega</div>
            <div class="mt-3 text-sm font-medium text-white">{address.line1 ?? "—"}</div>
            {address.line2 ? <div class="mt-1 text-sm text-slate-300">{address.line2}</div> : null}
            {(address.postalCode || address.city) ? (
              <div class="mt-1 text-sm text-slate-300">
                {address.postalCode ?? ""}{address.postalCode && address.city ? " · " : ""}{address.city ?? ""}
              </div>
            ) : null}
            {address.notes ? (
              <div class="mt-3 text-sm text-slate-300">
                <span class="font-semibold text-white">Notas:</span> {address.notes}
              </div>
            ) : null}
          </div>
        ) : null}

        {forcedPickup ? (
          <div class="mt-4 rounded-3xl border border-amber-400/20 bg-amber-400/10 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-200">Force pickup</div>
            <p class="mt-3 text-sm leading-6 text-amber-100/85">
              Este pedido fue forzado a recogida por operativa.
              {forcedReason ? ` Motivo: ${forcedReason}` : ""}
            </p>
          </div>
        ) : null}

        {order.notes ? (
          <div class="mt-4 rounded-3xl border border-amber-400/20 bg-amber-400/10 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-200">Comentarios</div>
            <p class="mt-3 text-sm leading-6 text-amber-100/85">{order.notes}</p>
          </div>
        ) : null}
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.28)]">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Items</div>
            <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Contenido del pedido</h2>
          </div>

          <div class="text-sm text-slate-400">
            {decoratedItems.length} línea{decoratedItems.length === 1 ? "" : "s"}
          </div>
        </div>

        <div class="mt-6 space-y-4">
          {decoratedItems.map((it) => (
            <div class="rounded-3xl border border-white/10 bg-slate-950/40 p-5">
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div>
                  <div class="text-base font-semibold text-white">{it.qty}× {it.nameSnapshot}</div>
                  {it.variantSnapshot ? <div class="mt-1 text-sm text-slate-400">{it.variantSnapshot}</div> : null}
                </div>

                <div class="text-sm font-semibold text-white">{money(it.lineTotalCents)}</div>
              </div>

              {it.opts.length ? (
                <div class="mt-3 text-sm text-slate-400">
                  <span class="font-semibold text-white">Extras:</span>{" "}
                  {it.opts.map((o) => `${String(o.name ?? "")} (+${money(Number(o.priceDeltaCents ?? 0))})`).join(", ")}
                </div>
              ) : null}

              {it.adds.length ? (
                <div class="mt-2 text-sm text-slate-400">
                  <span class="font-semibold text-white">Añadidos:</span>{" "}
                  {it.adds.map((a) => `${String(a.name ?? "")} (+${money(Number(a.priceDeltaCents ?? 0))})`).join(", ")}
                </div>
              ) : null}

              {it.rems.length ? (
                <div class="mt-2 text-sm text-slate-400">
                  <span class="font-semibold text-white">Quitados:</span>{" "}
                  {it.rems.map((r) => String(r.name ?? "")).join(", ")}
                </div>
              ) : null}

              {it.notes ? (
                <div class="mt-3 text-sm text-slate-400">
                  <span class="font-semibold text-white">Notas línea:</span> {it.notes}
                </div>
              ) : null}
            </div>
          ))}
        </div>

        <div class="mt-6 rounded-3xl border border-white/10 bg-slate-950/50 p-5">
          <div class="space-y-3 text-sm">
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Subtotal</span>
              <span class="font-semibold text-white">{money(order.subtotalCents)}</span>
            </div>

            {Number(order.deliveryFeeCents ?? 0) > 0 ? (
              <div class="flex items-center justify-between">
                <span class="text-slate-400">Delivery</span>
                <span class="font-semibold text-white">{money(order.deliveryFeeCents)}</span>
              </div>
            ) : null}

            {Number(order.discountCents ?? 0) > 0 ? (
              <div class="flex items-center justify-between">
                <span class="text-slate-400">Descuento</span>
                <span class="font-semibold text-white">-{money(order.discountCents)}</span>
              </div>
            ) : null}

            <div class="flex items-center justify-between">
              <span class="text-slate-400">Impuestos</span>
              <span class="font-semibold text-white">{money(order.taxCents)}</span>
            </div>

            <div class="flex items-center justify-between border-t border-white/10 pt-3 text-base">
              <span class="font-semibold text-white">Total</span>
              <span class="font-semibold text-white">{money(order.totalCents)}</span>
            </div>
          </div>
        </div>
      </article>
    </div>

    <aside class="space-y-6 xl:sticky xl:top-28 xl:h-fit">
      <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Estado</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Cambiar workflow</h2>

        <div class="mt-6 grid gap-2">
          {statusOptions.map((st) => (
            <form method="post" action={`/api/admin/orders/${order.publicId}/update`}>
              <input type="hidden" name="status" value={st} />
              <input type="hidden" name="redirectTo" value={returnTo} />
              <button
                class:list={[
                  "w-full rounded-2xl border px-4 py-3 text-sm font-semibold transition",
                  st === order.status
                    ? "border-sky-400/20 bg-sky-400/10 text-sky-300"
                    : "border-white/10 bg-white/5 text-slate-200 hover:border-white/15 hover:bg-white/10 hover:text-white",
                ]}
                type="submit"
              >
                Cambiar a {st}
              </button>
            </form>
          ))}
        </div>
      </article>

      <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Pago</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Actualizar payment status</h2>

        <div class="mt-6 grid gap-2">
          {paymentOptions.map((ps) => (
            <form method="post" action={`/api/admin/orders/${order.publicId}/update`}>
              <input type="hidden" name="paymentStatus" value={ps} />
              <input type="hidden" name="redirectTo" value={returnTo} />
              <button
                class:list={[
                  "w-full rounded-2xl border px-4 py-3 text-sm font-semibold transition",
                  ps === order.paymentStatus
                    ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
                    : "border-white/10 bg-white/5 text-slate-200 hover:border-white/15 hover:bg-white/10 hover:text-white",
                ]}
                type="submit"
              >
                Pago: {ps}
              </button>
            </form>
          ))}
        </div>
      </article>

      <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Actividad</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Timeline</h2>

        <div class="mt-6 space-y-3">
          {sortedTimeline.map((entry) => (
            <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-center justify-between gap-3">
                <div class="text-sm font-semibold text-white">{entry.title}</div>
                <span class:list={["inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]", entry.tone]}>
                  {entry.at ? formatDate(entry.at) : "Sin fecha"}
                </span>
              </div>
              <p class="mt-2 text-sm text-slate-400">{entry.detail}</p>
            </div>
          ))}
        </div>
      </article>

      <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Cobro real</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Payments y refunds</h2>

        <div class="mt-6 space-y-4">
          {decoratedPayments.length === 0 ? (
            <div class="rounded-3xl border border-white/10 bg-white/5 p-4 text-sm text-slate-400">
              No hay registros en Payment para este pedido.
            </div>
          ) : (
            decoratedPayments.map((payment) => (
              <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <div class="text-sm font-semibold text-white">Payment #{payment.id}</div>
                    <div class="mt-1 text-xs text-slate-500">
                      {payment.provider} · {payment.providerIntentId ?? "sin intent"}
                    </div>
                  </div>

                  <span
                    class:list={[
                      "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                      payment.status === "PAID"
                        ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
                        : payment.status === "AUTHORIZED"
                          ? "border-sky-400/20 bg-sky-400/10 text-sky-300"
                          : payment.status === "FAILED"
                            ? "border-rose-400/20 bg-rose-400/10 text-rose-300"
                            : "border-white/10 bg-white/5 text-slate-300",
                    ]}
                  >
                    {payment.status}
                  </span>
                </div>

                <div class="mt-3 space-y-2 text-sm text-slate-300">
                  <div>Importe: <span class="font-semibold text-white">{money(payment.amountCents)}</span></div>
                  <div>Creado: <span class="font-semibold text-white">{formatDate(payment.createdAt)}</span></div>
                  {payment.providerChargeId ? (
                    <div>Charge: <span class="font-semibold text-white">{payment.providerChargeId}</span></div>
                  ) : null}
                </div>

                {payment.refunds.length ? (
                  <div class="mt-4 space-y-2">
                    {payment.refunds.map((refund) => (
                      <div class="rounded-2xl border border-fuchsia-400/20 bg-fuchsia-400/10 p-3">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                          <div class="text-sm font-semibold text-white">Refund #{refund.id}</div>
                          <span
                            class:list={[
                              "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                              refund.status === "SUCCEEDED"
                                ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
                                : refund.status === "FAILED"
                                  ? "border-rose-400/20 bg-rose-400/10 text-rose-300"
                                  : "border-white/10 bg-white/5 text-slate-300",
                            ]}
                          >
                            {refund.status}
                          </span>
                        </div>

                        <div class="mt-2 text-sm text-slate-300">
                          {money(refund.amountCents)} · {formatDate(refund.createdAt)}
                        </div>
                      </div>
                    ))}
                  </div>
                ) : null}
              </div>
            ))
          )}
        </div>
      </article>
    </aside>
  </section>
</AdminLayout>