---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db, Order, OrderItem, Payment, Refund, eq, inArray } from "astro:db";
import { getPrinters } from "@/server/printing/queue";

type OrderStatus =
  | "PENDING"
  | "PAID"
  | "ACCEPTED"
  | "PREPARING"
  | "READY"
  | "OUT_FOR_DELIVERY"
  | "DELIVERED"
  | "CANCELLED";

type OrderPaymentStatus =
  | "UNPAID"
  | "AUTH"
  | "PAID"
  | "FAILED"
  | "REFUNDED"
  | "PARTIALLY_REFUNDED";

type ManualPaymentStatus = "UNPAID" | "AUTH" | "PAID" | "FAILED";

type ModifierEntry = {
  name?: string;
  priceDeltaCents?: number;
};

type TimelineEntry = {
  key: string;
  title: string;
  detail: string;
  at?: Date | string | null;
  by?: string | null;
  tone: string;
};

type StoredAdminEvent = {
  id?: string;
  kind?: string;
  title?: string;
  detail?: string;
  by?: string | null;
  at?: string;
};

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function formatDate(value: Date | string) {
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Europe/Madrid",
  }).format(date);
}

function statusTone(status: string) {
  switch (status) {
    case "PENDING":
      return "border-amber-400/20 bg-amber-400/10 text-amber-300";
    case "PAID":
      return "border-sky-400/20 bg-sky-400/10 text-sky-300";
    case "ACCEPTED":
      return "border-cyan-400/20 bg-cyan-400/10 text-cyan-300";
    case "PREPARING":
      return "border-violet-400/20 bg-violet-400/10 text-violet-300";
    case "READY":
      return "border-emerald-400/20 bg-emerald-400/10 text-emerald-300";
    case "OUT_FOR_DELIVERY":
      return "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300";
    case "DELIVERED":
      return "border-emerald-400/20 bg-emerald-400/10 text-emerald-200";
    case "CANCELLED":
      return "border-rose-400/20 bg-rose-400/10 text-rose-300";
    default:
      return "border-admin-border bg-white/[0.03] text-slate-300";
  }
}

function paymentStatusTone(status: string) {
  switch (status) {
    case "PAID":
      return "border-emerald-400/20 bg-emerald-400/10 text-emerald-300";
    case "UNPAID":
      return "border-amber-400/20 bg-amber-400/10 text-amber-300";
    case "AUTH":
      return "border-sky-400/20 bg-sky-400/10 text-sky-300";
    case "FAILED":
      return "border-rose-400/20 bg-rose-400/10 text-rose-300";
    case "REFUNDED":
    case "PARTIALLY_REFUNDED":
      return "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300";
    default:
      return "border-admin-border bg-white/[0.03] text-slate-300";
  }
}

function parsePaymentMethod(snapshot: unknown) {
  const meta = (snapshot ?? {}) as Record<string, unknown>;
  const raw = String(meta.paymentMethod ?? "").toUpperCase();
  return raw === "CASH" || raw === "CARD" ? raw : null;
}

function refundTone(status: string) {
  if (status === "SUCCEEDED")
    return "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300";
  if (status === "FAILED")
    return "border-rose-400/20 bg-rose-400/10 text-rose-300";
  return "border-admin-border bg-white/[0.03] text-slate-300";
}

function adminEventTone(kind: string) {
  if (kind === "STATUS")
    return "border-cyan-400/20 bg-cyan-400/10 text-cyan-300";
  if (kind === "PAYMENT")
    return "border-emerald-400/20 bg-emerald-400/10 text-emerald-300";
  return "border-amber-400/20 bg-amber-400/10 text-amber-300";
}

function sumSucceededRefunds(
  refunds: Array<{ status: string; amountCents: number }>,
) {
  return refunds
    .filter((refund) => refund.status === "SUCCEEDED")
    .reduce((sum, refund) => sum + Number(refund.amountCents ?? 0), 0);
}

const publicId = String(Astro.params.publicId ?? "").trim();

const [order] = await db
  .select()
  .from(Order)
  .where(eq(Order.publicId, publicId))
  .limit(1);

if (!order) {
  return new Response("Pedido no encontrado", { status: 404 });
}

const items = await db
  .select()
  .from(OrderItem)
  .where(eq(OrderItem.orderId, order.id));

const payments = await db
  .select()
  .from(Payment)
  .where(eq(Payment.orderId, order.id))
  .orderBy(Payment.createdAt);

const paymentIds = payments.map((payment) => payment.id);

const refunds = paymentIds.length
  ? await db
      .select()
      .from(Refund)
      .where(inArray(Refund.paymentId, paymentIds))
      .orderBy(Refund.createdAt)
  : [];

const decoratedItems = items.map((it) => {
  const modifiers = (it.modifiers ?? {}) as Record<string, unknown>;

  const opts = (
    Array.isArray(modifiers.modifierOptions) ? modifiers.modifierOptions : []
  ) as ModifierEntry[];

  const adds = (
    Array.isArray(modifiers.ingredientsAdded) ? modifiers.ingredientsAdded : []
  ) as ModifierEntry[];

  const rems = (
    Array.isArray(modifiers.ingredientsRemoved)
      ? modifiers.ingredientsRemoved
      : []
  ) as ModifierEntry[];

  return {
    ...it,
    opts,
    adds,
    rems,
  };
});

const decoratedPayments = payments.map((payment) => ({
  ...payment,
  refunds: refunds.filter((refund) => refund.paymentId === payment.id),
}));

const totalSucceededRefundCents = decoratedPayments.reduce(
  (sum, payment) => sum + sumSucceededRefunds(payment.refunds),
  0,
);
const pendingRefundsCount = refunds.filter(
  (refund) => refund.status === "CREATED",
).length;
const failedRefundsCount = refunds.filter(
  (refund) => refund.status === "FAILED",
).length;

const meta = (order.addressSnapshot ?? {}) as Record<string, unknown>;
const paymentMethod = parsePaymentMethod(order.addressSnapshot);
const forcedPickup = Boolean(meta.forcedPickup);
const forcedReason = String(meta.forcedReason ?? "").trim();
const couponCode = String(meta.couponCode ?? "").trim();
const couponAppliedMessage = String(meta.couponAppliedMessage ?? "").trim();
const deliveryResolutionSource = String(
  meta.deliveryResolutionSource ?? "",
).trim();
const deliveryResolutionNote = String(meta.deliveryResolutionNote ?? "").trim();
const adminInternalNote = String(meta.adminInternalNote ?? "").trim();

const address = (meta.address ?? null) as {
  line1?: string;
  line2?: string;
  city?: string;
  postalCode?: string;
  notes?: string;
} | null;

const rawAdminEvents = Array.isArray(meta.adminEvents)
  ? (meta.adminEvents as StoredAdminEvent[])
  : [];

const adminEvents: TimelineEntry[] = rawAdminEvents.map((entry, index) => ({
  key: String(entry.id ?? `admin-${index}`),
  title: String(entry.title ?? "Evento"),
  detail: String(entry.detail ?? ""),
  at: entry.at ?? null,
  by: entry.by ?? null,
  tone: adminEventTone(String(entry.kind ?? "")),
}));

const statusOptions: OrderStatus[] = [
  "PENDING",
  "PAID",
  "ACCEPTED",
  "PREPARING",
  "READY",
  "OUT_FOR_DELIVERY",
  "DELIVERED",
  "CANCELLED",
];

const paymentOptions: ManualPaymentStatus[] = [
  "UNPAID",
  "AUTH",
  "PAID",
  "FAILED",
];

const timeline: TimelineEntry[] = [];

timeline.push({
  key: "created",
  title: "Pedido creado",
  detail: `Estado inicial ${order.status}`,
  at: order.createdAt,
  tone: "border-sky-400/20 bg-sky-400/10 text-sky-300",
});

if (order.scheduledFor) {
  timeline.push({
    key: "scheduled",
    title: "Pedido programado",
    detail: "Tiene fecha/hora de servicio programada",
    at: order.scheduledFor,
    tone: "border-indigo-400/20 bg-indigo-400/10 text-indigo-300",
  });
}

if (forcedPickup) {
  timeline.push({
    key: "forced-pickup",
    title: "Forzado a recogida",
    detail: forcedReason || "Cambio operativo aplicado",
    at: order.updatedAt,
    tone: "border-amber-400/20 bg-amber-400/10 text-amber-300",
  });
}

if (couponCode || Number(order.discountCents ?? 0) > 0) {
  timeline.push({
    key: "coupon",
    title: "Descuento aplicado",
    detail:
      couponAppliedMessage ||
      (couponCode
        ? `${couponCode} · -${money(order.discountCents)}`
        : `-${money(order.discountCents)}`),
    at: order.updatedAt,
    tone: "border-emerald-400/20 bg-emerald-400/10 text-emerald-300",
  });
}

for (const payment of decoratedPayments) {
  timeline.push({
    key: `payment-${payment.id}`,
    title: `Payment #${payment.id}`,
    detail: `${payment.status} · ${money(payment.amountCents)} · ${payment.provider}`,
    at: payment.createdAt,
    tone:
      payment.status === "PAID"
        ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
        : payment.status === "AUTHORIZED"
          ? "border-sky-400/20 bg-sky-400/10 text-sky-300"
          : payment.status === "FAILED"
            ? "border-rose-400/20 bg-rose-400/10 text-rose-300"
            : "border-admin-border bg-white/[0.03] text-slate-300",
  });

  for (const refund of payment.refunds) {
    timeline.push({
      key: `refund-${refund.id}`,
      title: `Refund #${refund.id}`,
      detail: `${refund.status} · ${money(refund.amountCents)}`,
      at: refund.createdAt,
      tone:
        refund.status === "SUCCEEDED"
          ? "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300"
          : "border-rose-400/20 bg-rose-400/10 text-rose-300",
    });
  }
}

timeline.push({
  key: "payment-state",
  title: "Estado de pago actual",
  detail: `${paymentMethod ?? "Sin método"} · ${order.paymentStatus}`,
  at: order.updatedAt,
  tone: "border-emerald-400/20 bg-emerald-400/10 text-emerald-300",
});

timeline.push({
  key: "updated",
  title: "Última actualización",
  detail: `Estado actual ${order.status}`,
  at: order.updatedAt,
  tone: "border-admin-border bg-white/[0.03] text-slate-300",
});

const fullTimeline = [...timeline, ...adminEvents].sort((a, b) => {
  const aTime = a.at ? new Date(a.at).getTime() : 0;
  const bTime = b.at ? new Date(b.at).getTime() : 0;
  return bTime - aTime;
});

const returnTo = `/admin/pedidos/${order.publicId}`;
const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") ?? "";
const error = url.searchParams.get("error") ?? "";

const successMessage =
  saved === "status"
    ? "Estado del pedido actualizado correctamente."
    : saved === "payment"
      ? "Estado de pago actualizado correctamente."
      : saved === "refund"
        ? "Refund registrado correctamente."
        : saved === "admin-note"
          ? "Nota interna guardada correctamente."
          : saved === "activity"
            ? "Anotación añadida al timeline."
            : "";

const errorMessage =
  error === "refund-required"
    ? "Los estados REFUNDED y PARTIALLY_REFUNDED ya no se editan a mano. Se calculan al registrar refunds reales."
    : error === "refund-state-locked"
      ? "Este pedido ya tiene refunds SUCCEEDED. Mientras exista devolución registrada, el estado refund manda y no debe editarse manualmente."
      : error === "refund-only-card"
        ? "Solo se pueden registrar refunds en pedidos con método de pago CARD."
        : error === "invalid-refund-status"
          ? "El estado del refund no es válido."
          : error === "invalid-refund-amount"
            ? "El importe del refund debe ser mayor que cero."
            : error === "invalid-payment-record"
              ? "No se ha encontrado un Payment válido para este pedido."
              : error === "refund-exceeds-payment"
                ? "El refund supera el importe disponible del payment."
                : error === "refund-payment-not-paid"
                  ? "No se puede registrar un refund SUCCEEDED sobre un payment que todavía no está marcado como PAID."
                  : "";

const lineCount = decoratedItems.length;
const totalQty = decoratedItems.reduce(
  (sum, item) => sum + Number(item.qty ?? 0),
  0,
);
const paymentsCount = decoratedPayments.length;
const timelineCount = fullTimeline.length;
const isDelivery = order.type === "DELIVERY";

// Impresoras térmicas del local, para reimprimir la comanda si se atascó o se
// perdió. Distinto de "Imprimir ticket", que abre la vista de navegador.
const thermalPrinters = (await getPrinters()).filter((printer) => printer.enabled);
---

<AdminLayout
  title={`Pedido ${order.publicId} · Admin · Arcadia`}
  heading={`Pedido ${order.publicId}`}
  description="Workflow, cobro, líneas, actividad y devoluciones del pedido."
  back={{ href: "/admin/pedidos", label: "Pedidos" }}
>
  <div class="mb-6 flex flex-wrap gap-3">
    <a
      href={`/admin/pedidos/ticket/${order.publicId}?print=1`}
      target="_blank"
      rel="noreferrer"
      class="inline-flex min-h-9 items-center justify-center rounded-admin-lg border border-sky-400/20 bg-sky-400/10 px-3.5 py-2 text-sm font-semibold text-sky-200 transition hover:border-sky-400/30 hover:bg-sky-400/15"
    >
      Imprimir ticket
    </a>

    <a
      href={`/pedido/${order.publicId}`}
      target="_blank"
      rel="noreferrer"
      class="inline-flex min-h-9 items-center justify-center rounded-admin-lg border border-admin-border bg-white/[0.03] px-3.5 py-2 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06] hover:text-white"
    >
      Ver página pública
    </a>

    {
      thermalPrinters.length > 0 ? (
        <form method="post" action={`/api/admin/orders/${order.publicId}/update`} class="flex flex-wrap items-center gap-2">
          <input type="hidden" name="intent" value="reprint" />
          <select
            name="printerId"
            aria-label="Impresora térmica"
            class="min-h-9 rounded-admin-lg border border-admin-border bg-white/[0.03] px-3 py-2 text-sm text-white focus:border-sky-400/40 focus:outline-none"
          >
            {thermalPrinters.map((printer) => (
              <option value={printer.id}>{printer.name}</option>
            ))}
          </select>
          <button
            type="submit"
            class="inline-flex min-h-9 items-center justify-center rounded-admin-lg border border-admin-border bg-white/[0.03] px-3.5 py-2 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06] hover:text-white"
          >
            Reimprimir comanda
          </button>
        </form>
      ) : null
    }
  </div>

  {
    successMessage ? (
      <section class="mb-6 rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-4 text-sm text-emerald-200">
        {successMessage}
      </section>
    ) : null
  }

  {
    errorMessage ? (
      <section class="mb-6 rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-4 text-sm text-rose-200">
        {errorMessage}
      </section>
    ) : null
  }

  <section class="grid gap-4 md:grid-cols-2 2xl:grid-cols-6">
    <article
      class="rounded-admin-xl border border-admin-border bg-white/[0.03] p-6"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-admin-muted"
      >
        Workflow
      </div>
      <div class="mt-4">
        <span
          class:list={[
            "inline-flex items-center rounded-full border px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em]",
            statusTone(order.status),
          ]}
        >
          {order.status}
        </span>
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-400">
        Estado principal del pedido
      </p>
    </article>

    <article
      class="rounded-admin-xl border border-admin-border bg-white/[0.03] p-6"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-admin-muted"
      >
        Pago
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span
          class:list={[
            "inline-flex items-center rounded-full border px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em]",
            paymentStatusTone(order.paymentStatus),
          ]}
        >
          {order.paymentStatus}
        </span>
        {
          paymentMethod ? (
            <span class="inline-flex items-center rounded-full border border-admin-border bg-white/[0.04] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-300">
              {paymentMethod}
            </span>
          ) : null
        }
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-400">Cobro manual y método</p>
    </article>

    <article
      class="rounded-admin-xl border border-admin-border bg-white/[0.03] p-6"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-admin-muted"
      >
        Canal
      </div>
      <div class="mt-4">
        <span
          class:list={[
            "inline-flex items-center rounded-full border px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em]",
            isDelivery
              ? "border-cyan-400/20 bg-cyan-400/10 text-cyan-300"
              : "border-indigo-400/20 bg-indigo-400/10 text-indigo-300",
          ]}
        >
          {order.type}
        </span>
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-400">Delivery o pickup</p>
    </article>

    <article
      class="rounded-admin-xl border border-admin-border bg-white/[0.03] p-6"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-admin-muted"
      >
        Líneas
      </div>
      <div class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white">
        {lineCount}
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-400">
        {totalQty} unidades totales
      </p>
    </article>

    <article
      class="rounded-admin-xl border border-admin-border bg-white/[0.03] p-6"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-admin-muted"
      >
        Cobro real
      </div>
      <div class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white">
        {paymentsCount}
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-400">Payments registrados</p>
    </article>

    <article
      class="rounded-admin-xl border border-admin-border bg-white/[0.03] p-6"
    >
      <div
        class="text-[11px] font-semibold uppercase tracking-[0.22em] text-admin-muted"
      >
        Total
      </div>
      <div class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white">
        {money(order.totalCents)}
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-400">
        {timelineCount} eventos en timeline
      </p>
    </article>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_420px]">
    <div class="space-y-6">
      <article
        class="rounded-admin-xl border border-admin-border bg-admin-surface/82 p-6 lg:p-7"
      >
        <div
          class="flex flex-wrap items-start justify-between gap-4 border-b border-admin-border pb-5"
        >
          <div>
            <div
              class="text-[11px] font-semibold uppercase tracking-[0.22em] text-admin-muted"
            >
              Pedido
            </div>
            <h2
              class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white"
            >
              Datos principales
            </h2>
          </div>

          <div
            class="rounded-admin-lg border border-admin-border bg-white/[0.03] px-4 py-3 text-right"
          >
            <div
              class="text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted"
            >
              Actualizado
            </div>
            <div class="mt-2 text-sm font-semibold text-white">
              {formatDate(order.updatedAt)}
            </div>
          </div>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <section
            class="rounded-admin-lg border border-admin-border bg-white/[0.02] p-5"
          >
            <div
              class="text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted"
            >
              Cliente
            </div>
            <div class="mt-3 text-lg font-semibold text-white">
              {order.customerName ?? "Sin nombre"}
            </div>
            <div class="mt-2 text-sm text-slate-400">
              {order.customerPhone ?? "Sin teléfono"}
            </div>
            {
              order.customerEmail ? (
                <div class="mt-1 break-all text-sm text-admin-muted">
                  {order.customerEmail}
                </div>
              ) : null
            }
          </section>

          <section
            class="rounded-admin-lg border border-admin-border bg-white/[0.02] p-5"
          >
            <div
              class="text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted"
            >
              Resumen
            </div>
            <div class="mt-3 space-y-2 text-sm text-slate-300">
              <div>
                ID público: <span class="font-semibold text-white"
                  >{order.publicId}</span>
              </div>
              <div>
                Tipo: <span class="font-semibold text-white">{order.type}</span>
              </div>
              <div>
                Método: <span class="font-semibold text-white"
                  >{paymentMethod ?? "—"}</span>
              </div>
              <div>
                Estado pago: <span class="font-semibold text-white"
                  >{order.paymentStatus}</span>
              </div>
              {
                order.scheduledFor ? (
                  <div>
                    Programado:{" "}
                    <span class="font-semibold text-white">
                      {formatDate(order.scheduledFor)}
                    </span>
                  </div>
                ) : null
              }
              <div>
                Creado: <span class="font-semibold text-white"
                  >{formatDate(order.createdAt)}</span>
              </div>
            </div>
          </section>
        </div>

        {
          isDelivery && address ? (
            <div class="mt-4 rounded-admin-lg border border-cyan-400/20 bg-cyan-400/10 p-5">
              <div class="text-[11px] font-semibold uppercase tracking-[0.16em] text-cyan-200">
                Dirección de entrega
              </div>
              <div class="mt-3 text-sm font-semibold text-white">
                {address.line1 ?? "—"}
              </div>
              {address.line2 ? (
                <div class="mt-1 text-sm text-slate-300">{address.line2}</div>
              ) : null}
              {address.postalCode || address.city ? (
                <div class="mt-1 text-sm text-slate-300">
                  {address.postalCode ?? ""}
                  {address.postalCode && address.city ? " · " : ""}
                  {address.city ?? ""}
                </div>
