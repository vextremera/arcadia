                      <div class="flex flex-wrap items-end justify-between gap-3">
                        <div>
                          <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-admin-muted">
                            Registrar refund
                          </div>
                          <div class="mt-1 text-sm text-slate-300">
                            {canRegisterSucceededRefund
                              ? "Puedes registrar devoluciones sobre el importe pendiente de este payment."
                              : paymentMethod !== "CARD"
                                ? "Los refunds solo se habilitan en pedidos CARD."
                                : payment.status !== "PAID"
                                  ? "Para registrar un refund SUCCEEDED, el payment debe estar en PAID."
                                  : "No queda importe disponible para devolver en este payment."}
                          </div>
                        </div>

                        <div class="rounded-admin-lg border border-admin-border bg-white/[0.03] px-4 py-2 text-sm text-slate-300">
                          Pendientes: {pendingCount} · Fallidos: {failedCount}
                        </div>
                      </div>

                      <form
                        method="post"
                        action={`/api/admin/orders/${order.publicId}/update`}
                        class="mt-4 grid gap-4"
                      >
                        <input
                          type="hidden"
                          name="intent"
                          value="create-refund"
                        />
                        <input
                          type="hidden"
                          name="redirectTo"
                          value={returnTo}
                        />
                        <input
                          type="hidden"
                          name="paymentId"
                          value={payment.id}
                        />

                        <div class="grid gap-4 lg:grid-cols-[180px_180px_minmax(0,1fr)]">
                          <label class="block">
                            <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-admin-muted">
                              Importe €
                            </span>
                            <input
                              class="w-full rounded-admin-lg border border-admin-border bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-fuchsia-400/30 focus:outline-none"
                              type="number"
                              name="refundAmountEur"
                              min="0.01"
                              step="0.01"
                              value={(refundableCents / 100).toFixed(2)}
                              required
                            />
                          </label>

                          <label class="block">
                            <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-admin-muted">
                              Estado refund
                            </span>
                            <select
                              class="w-full rounded-admin-lg border border-admin-border bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-fuchsia-400/30 focus:outline-none"
                              name="refundStatus"
                            >
                              <option value="SUCCEEDED">SUCCEEDED</option>
                              <option value="CREATED">CREATED</option>
                              <option value="FAILED">FAILED</option>
                            </select>
                          </label>

                          <label class="block">
                            <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-admin-muted">
                              Nota
                            </span>
                            <input
                              class="w-full rounded-admin-lg border border-admin-border bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-fuchsia-400/30 focus:outline-none"
                              type="text"
                              name="note"
                              placeholder="Motivo, incidencia o referencia externa"
                            />
                          </label>
                        </div>

                        <button
                          type="submit"
                          class:list={[
                            "inline-flex min-h-10 items-center justify-center rounded-admin-lg px-4 py-3 text-sm font-semibold transition",
                            paymentMethod === "CARD" && refundableCents > 0
                              ? "border border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-100 hover:border-fuchsia-400/30 hover:bg-fuchsia-400/15"
                              : "cursor-not-allowed border border-admin-border bg-white/[0.03] text-admin-muted",
                          ]}
                          disabled={
                            paymentMethod !== "CARD" || refundableCents <= 0
                          }
                        >
                          Registrar refund
                        </button>
                      </form>
                    </div>

                    {payment.refunds.length ? (
                      <div class="mt-4 space-y-3">
                        {payment.refunds.map((refund) => (
                          <div class="rounded-admin-lg border border-fuchsia-400/20 bg-fuchsia-400/10 p-4">
                            <div class="flex flex-wrap items-center justify-between gap-3">
                              <div class="text-sm font-semibold text-white">
                                Refund #{refund.id}
                              </div>
                              <span
                                class:list={[
                                  "inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em]",
                                  refundTone(refund.status),
                                ]}
                              >
                                {refund.status}
                              </span>
                            </div>

                            <div class="mt-2 text-sm text-slate-300">
                              {money(refund.amountCents)} ·{" "}
                              {formatDate(refund.createdAt)}
                            </div>
                          </div>
                        ))}
                      </div>
                    ) : null}
                  </article>
                );
              })
            )
          }
        </div>
      </article>
    </aside>
  </section>
</AdminLayout>
