---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { db, Order, OrderItem, Payment, Refund, eq, inArray } from "astro:db";

type OrderStatus =
  | "PENDING"
  | "PAID"
  | "ACCEPTED"
  | "PREPARING"
  | "READY"
  | "OUT_FOR_DELIVERY"
  | "DELIVERED"
  | "CANCELLED";

type OrderPaymentStatus =
  | "UNPAID"
  | "AUTH"
  | "PAID"
  | "FAILED"
  | "REFUNDED"
  | "PARTIALLY_REFUNDED";

type ManualPaymentStatus = "UNPAID" | "AUTH" | "PAID" | "FAILED";

type ModifierEntry = {
  name?: string;
  priceDeltaCents?: number;
};

type TimelineEntry = {
  key: string;
  title: string;
  detail: string;
  at?: Date | string | null;
  by?: string | null;
  tone: string;
};

type StoredAdminEvent = {
  id?: string;
  kind?: string;
  title?: string;
  detail?: string;
  by?: string | null;
  at?: string;
};

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function formatDate(value: Date | string) {
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Europe/Madrid",
  }).format(date);
}

function statusTone(status: string) {
  switch (status) {
    case "PENDING":
      return "border-amber-400/20 bg-amber-400/10 text-amber-300";
    case "PAID":
      return "border-sky-400/20 bg-sky-400/10 text-sky-300";
    case "ACCEPTED":
      return "border-cyan-400/20 bg-cyan-400/10 text-cyan-300";
    case "PREPARING":
      return "border-violet-400/20 bg-violet-400/10 text-violet-300";
    case "READY":
      return "border-emerald-400/20 bg-emerald-400/10 text-emerald-300";
    case "OUT_FOR_DELIVERY":
      return "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300";
    case "DELIVERED":
      return "border-emerald-400/20 bg-emerald-400/10 text-emerald-200";
    case "CANCELLED":
      return "border-rose-400/20 bg-rose-400/10 text-rose-300";
    default:
      return "border-white/10 bg-white/5 text-slate-300";
  }
}

function paymentStatusTone(status: string) {
  switch (status) {
    case "PAID":
      return "border-emerald-400/20 bg-emerald-400/10 text-emerald-300";
    case "UNPAID":
      return "border-amber-400/20 bg-amber-400/10 text-amber-300";
    case "AUTH":
      return "border-sky-400/20 bg-sky-400/10 text-sky-300";
    case "FAILED":
      return "border-rose-400/20 bg-rose-400/10 text-rose-300";
    case "REFUNDED":
    case "PARTIALLY_REFUNDED":
      return "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300";
    default:
      return "border-white/10 bg-white/5 text-slate-300";
  }
}

function parsePaymentMethod(snapshot: unknown) {
  const meta = (snapshot ?? {}) as Record<string, unknown>;
  const raw = String(meta.paymentMethod ?? "").toUpperCase();
  return raw === "CASH" || raw === "CARD" ? raw : null;
}

function refundTone(status: string) {
  if (status === "SUCCEEDED") return "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300";
  if (status === "FAILED") return "border-rose-400/20 bg-rose-400/10 text-rose-300";
  return "border-white/10 bg-white/5 text-slate-300";
}

function sumSucceededRefunds(refunds: Array<{ status: string; amountCents: number }>) {
  return refunds
    .filter((refund) => refund.status === "SUCCEEDED")
    .reduce((sum, refund) => sum + Number(refund.amountCents ?? 0), 0);
}

function adminEventTone(kind: string) {
  if (kind === "STATUS") return "border-cyan-400/20 bg-cyan-400/10 text-cyan-300";
  if (kind === "PAYMENT") return "border-emerald-400/20 bg-emerald-400/10 text-emerald-300";
  return "border-amber-400/20 bg-amber-400/10 text-amber-300";
}

const publicId = String(Astro.params.publicId ?? "").trim();

const [order] = await db
  .select()
  .from(Order)
  .where(eq(Order.publicId, publicId))
  .limit(1);

if (!order) {
  return new Response("Pedido no encontrado", { status: 404 });
}

const items = await db
  .select()
  .from(OrderItem)
  .where(eq(OrderItem.orderId, order.id));

const payments = await db
  .select()
  .from(Payment)
  .where(eq(Payment.orderId, order.id))
  .orderBy(Payment.createdAt);

const paymentIds = payments.map((payment) => payment.id);

const refunds = paymentIds.length
  ? await db
      .select()
      .from(Refund)
      .where(inArray(Refund.paymentId, paymentIds))
      .orderBy(Refund.createdAt)
  : [];

const decoratedItems = items.map((it) => {
  const modifiers = (it.modifiers ?? {}) as Record<string, unknown>;

  const opts = (
    Array.isArray(modifiers.modifierOptions) ? modifiers.modifierOptions : []
  ) as ModifierEntry[];

  const adds = (
    Array.isArray(modifiers.ingredientsAdded) ? modifiers.ingredientsAdded : []
  ) as ModifierEntry[];

  const rems = (
    Array.isArray(modifiers.ingredientsRemoved) ? modifiers.ingredientsRemoved : []
  ) as ModifierEntry[];

  return {
    ...it,
    opts,
    adds,
    rems,
  };
});

const decoratedPayments = payments.map((payment) => ({
  ...payment,
  refunds: refunds.filter((refund) => refund.paymentId === payment.id),
}));

const totalSucceededRefundCents = decoratedPayments.reduce(
  (sum, payment) => sum + sumSucceededRefunds(payment.refunds),
  0
);
const pendingRefundsCount = refunds.filter((refund) => refund.status === "CREATED").length;
const failedRefundsCount = refunds.filter((refund) => refund.status === "FAILED").length;

const meta = (order.addressSnapshot ?? {}) as Record<string, unknown>;
const paymentMethod = parsePaymentMethod(order.addressSnapshot);
const forcedPickup = Boolean(meta.forcedPickup);
const forcedReason = String(meta.forcedReason ?? "").trim();
const couponCode = String(meta.couponCode ?? "").trim();
const couponAppliedMessage = String(meta.couponAppliedMessage ?? "").trim();
const deliveryResolutionSource = String(meta.deliveryResolutionSource ?? "").trim();
const deliveryResolutionNote = String(meta.deliveryResolutionNote ?? "").trim();
const adminInternalNote = String(meta.adminInternalNote ?? "").trim();

const address = (meta.address ?? null) as
  | {
      line1?: string;
      line2?: string;
      city?: string;
      postalCode?: string;
      notes?: string;
    }
  | null;

const rawAdminEvents = Array.isArray(meta.adminEvents)
  ? (meta.adminEvents as StoredAdminEvent[])
  : [];

const adminEvents: TimelineEntry[] = rawAdminEvents.map((entry, index) => ({
  key: String(entry.id ?? `admin-${index}`),
  title: String(entry.title ?? "Evento"),
  detail: String(entry.detail ?? ""),
  at: entry.at ?? null,
  by: entry.by ?? null,
  tone: adminEventTone(String(entry.kind ?? "")),
}));

const statusOptions: OrderStatus[] = [
  "PENDING",
  "PAID",
  "ACCEPTED",
  "PREPARING",
  "READY",
  "OUT_FOR_DELIVERY",
  "DELIVERED",
  "CANCELLED",
];

const paymentOptions: ManualPaymentStatus[] = [
  "UNPAID",
  "AUTH",
  "PAID",
  "FAILED",
];

const timeline: TimelineEntry[] = [];

timeline.push({
  key: "created",
  title: "Pedido creado",
  detail: `Estado inicial ${order.status}`,
  at: order.createdAt,
  tone: "border-sky-400/20 bg-sky-400/10 text-sky-300",
});

if (order.scheduledFor) {
  timeline.push({
    key: "scheduled",
    title: "Pedido programado",
    detail: "Tiene fecha/hora de servicio programada",
    at: order.scheduledFor,
    tone: "border-indigo-400/20 bg-indigo-400/10 text-indigo-300",
  });
}

if (forcedPickup) {
  timeline.push({
    key: "forced-pickup",
    title: "Forzado a recogida",
    detail: forcedReason || "Cambio operativo aplicado",
    at: order.updatedAt,
    tone: "border-amber-400/20 bg-amber-400/10 text-amber-300",
  });
}

if (couponCode || Number(order.discountCents ?? 0) > 0) {
  timeline.push({
    key: "coupon",
    title: "Descuento aplicado",
    detail:
      couponAppliedMessage ||
      (couponCode ? `${couponCode} · -${money(order.discountCents)}` : `-${money(order.discountCents)}`),
    at: order.updatedAt,
    tone: "border-emerald-400/20 bg-emerald-400/10 text-emerald-300",
  });
}

for (const payment of decoratedPayments) {
  timeline.push({
    key: `payment-${payment.id}`,
    title: `Payment #${payment.id}`,
    detail: `${payment.status} · ${money(payment.amountCents)} · ${payment.provider}`,
    at: payment.createdAt,
    tone:
      payment.status === "PAID"
        ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
        : payment.status === "AUTHORIZED"
          ? "border-sky-400/20 bg-sky-400/10 text-sky-300"
          : payment.status === "FAILED"
            ? "border-rose-400/20 bg-rose-400/10 text-rose-300"
            : "border-white/10 bg-white/5 text-slate-300",
  });

  for (const refund of payment.refunds) {
    timeline.push({
      key: `refund-${refund.id}`,
      title: `Refund #${refund.id}`,
      detail: `${refund.status} · ${money(refund.amountCents)}`,
      at: refund.createdAt,
      tone:
        refund.status === "SUCCEEDED"
          ? "border-fuchsia-400/20 bg-fuchsia-400/10 text-fuchsia-300"
          : "border-rose-400/20 bg-rose-400/10 text-rose-300",
    });
  }
}

timeline.push({
  key: "payment-state",
  title: "Estado de pago actual",
  detail: `${paymentMethod ?? "Sin método"} · ${order.paymentStatus}`,
  at: order.updatedAt,
  tone: "border-emerald-400/20 bg-emerald-400/10 text-emerald-300",
});

timeline.push({
  key: "updated",
  title: "Última actualización",
  detail: `Estado actual ${order.status}`,
  at: order.updatedAt,
  tone: "border-white/10 bg-white/5 text-slate-300",
});

const fullTimeline = [...timeline, ...adminEvents].sort((a, b) => {
  const aTime = a.at ? new Date(a.at).getTime() : 0;
  const bTime = b.at ? new Date(b.at).getTime() : 0;
  return bTime - aTime;
});

const returnTo = `/admin/pedidos/${order.publicId}`;
const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") ?? "";
const error = url.searchParams.get("error") ?? "";

const successMessage =
  saved === "status"
    ? "Estado del pedido actualizado correctamente."
    : saved === "payment"
      ? "Estado de pago actualizado correctamente."
      : saved === "refund"
        ? "Refund registrado correctamente."
        : saved === "admin-note"
          ? "Nota interna guardada correctamente."
          : saved === "activity"
            ? "Anotación añadida al timeline."
            : "";

const errorMessage =
  error === "refund-required"
    ? "Los estados REFUNDED y PARTIALLY_REFUNDED ya no se editan a mano. Se calculan al registrar refunds reales."
    : error === "refund-state-locked"
      ? "Este pedido ya tiene refunds SUCCEEDED. Mientras exista devolución registrada, el estado refund manda y no debe editarse manualmente."
      : error === "refund-only-card"
        ? "Solo se pueden registrar refunds en pedidos con método de pago CARD."
        : error === "invalid-refund-status"
          ? "El estado del refund no es válido."
          : error === "invalid-refund-amount"
            ? "El importe del refund debe ser mayor que cero."
            : error === "invalid-payment-record"
              ? "No se ha encontrado un Payment válido para este pedido."
              : error === "refund-exceeds-payment"
                ? "El refund supera el importe disponible del payment."
                : error === "refund-payment-not-paid"
                  ? "No se puede registrar un refund SUCCEEDED sobre un payment que todavía no está marcado como PAID."
                  : "";
---

<AdminLayout
  title={`Pedido ${order.publicId} · Admin · Arcadia`}
  heading={`Pedido ${order.publicId}`}
  description="Detalle final del pedido: cliente, dirección, economía, workflow, cobro real, ticket y actividad persistente de staff."
  actions={true}
>
  <Fragment slot="actions">
    <div class="flex flex-wrap gap-3">
      <a
        href="/admin/pedidos"
        class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/10 hover:text-white"
      >
        Volver a pedidos
      </a>

      <a
        href={`/pedido/${order.publicId}`}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/10 hover:text-white"
      >
        Ver página pública
      </a>

      <a
        href={`/admin/pedidos/ticket/${order.publicId}?print=1`}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-300 transition hover:border-sky-400/30 hover:bg-sky-400/15"
      >
        Imprimir ticket
      </a>
    </div>
  </Fragment>

  {successMessage ? (
    <section class="mb-6 rounded-3xl border border-emerald-400/20 bg-emerald-400/10 px-5 py-4 text-sm text-emerald-200">
      {successMessage}
    </section>
  ) : null}

  {errorMessage ? (
    <section class="mb-6 rounded-3xl border border-rose-400/20 bg-rose-400/10 px-5 py-4 text-sm text-rose-200">
      {errorMessage}
    </section>
  ) : null}
    <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
    <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Estado</div>
      <div class="mt-3">
        <span class:list={["inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em]", statusTone(order.status)]}>
          {order.status}
        </span>
      </div>
      <p class="mt-3 text-sm text-slate-400">Workflow principal</p>
    </article>

    <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Pago</div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class:list={["inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em]", paymentStatusTone(order.paymentStatus)]}>
          {order.paymentStatus}
        </span>

        {paymentMethod ? (
          <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-slate-300">
            {paymentMethod}
          </span>
        ) : null}
      </div>
      <p class="mt-3 text-sm text-slate-400">Cobro y método</p>
    </article>

    <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Tipo</div>
      <div class="mt-3">
        <span
          class:list={[
            "inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em]",
            order.type === "DELIVERY"
              ? "border-cyan-400/20 bg-cyan-400/10 text-cyan-300"
              : "border-indigo-400/20 bg-indigo-400/10 text-indigo-300",
          ]}
        >
          {order.type}
        </span>
      </div>
      <p class="mt-3 text-sm text-slate-400">Canal operativo</p>
    </article>

    <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Descuento</div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">
        {Number(order.discountCents ?? 0) > 0 ? `-${money(order.discountCents)}` : "—"}
      </div>
      <p class="mt-2 text-sm text-slate-400">{couponCode ? couponCode : "Sin cupón"}</p>
    </article>

    <article class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Total</div>
      <div class="mt-3 text-2xl font-semibold tracking-tight text-white">{money(order.totalCents)}</div>
      <p class="mt-2 text-sm text-slate-400">Creado el {formatDate(order.createdAt)}</p>
    </article>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_420px]">
    <div class="space-y-6">
      <article class="rounded-3xl border border-white/10 bg-[#111827] p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-sky-300">Cliente</div>
            <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Datos del pedido</h2>
          </div>

          <div class="text-sm text-slate-400">Actualizado: {formatDate(order.updatedAt)}</div>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <div class="rounded-3xl border border-white/10 bg-slate-950/40 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Cliente</div>
            <div class="mt-3 text-base font-semibold text-white">{order.customerName ?? "Sin nombre"}</div>
            <div class="mt-2 text-sm text-slate-400">{order.customerPhone ?? "Sin teléfono"}</div>
            {order.customerEmail ? <div class="mt-1 text-sm text-slate-400">{order.customerEmail}</div> : null}
          </div>

          <div class="rounded-3xl border border-white/10 bg-slate-950/40 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Resumen</div>
            <div class="mt-3 space-y-2 text-sm text-slate-300">
              <div>ID público: <span class="font-semibold text-white">{order.publicId}</span></div>
              <div>Tipo: <span class="font-semibold text-white">{order.type}</span></div>
              <div>Pago: <span class="font-semibold text-white">{paymentMethod ?? "—"}</span></div>
              <div>Estado pago: <span class="font-semibold text-white">{order.paymentStatus}</span></div>
              {order.scheduledFor ? (
                <div>Programado: <span class="font-semibold text-white">{formatDate(order.scheduledFor)}</span></div>
              ) : null}
            </div>
          </div>
        </div>

        {order.type === "DELIVERY" && address ? (
          <div class="mt-4 rounded-3xl border border-cyan-400/20 bg-cyan-400/10 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-200">Dirección de entrega</div>
            <div class="mt-3 text-sm font-medium text-white">{address.line1 ?? "—"}</div>
            {address.line2 ? <div class="mt-1 text-sm text-slate-300">{address.line2}</div> : null}
            {(address.postalCode || address.city) ? (
              <div class="mt-1 text-sm text-slate-300">
                {address.postalCode ?? ""}{address.postalCode && address.city ? " · " : ""}{address.city ?? ""}
              </div>
            ) : null}
            {address.notes ? (
              <div class="mt-3 text-sm text-slate-300">
                <span class="font-semibold text-white">Notas:</span> {address.notes}
              </div>
            ) : null}
          </div>
        ) : null}

        {forcedPickup ? (
          <div class="mt-4 rounded-3xl border border-amber-400/20 bg-amber-400/10 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-200">Force pickup</div>
            <p class="mt-3 text-sm leading-6 text-amber-100/85">
              Este pedido fue forzado a recogida por operativa.
              {forcedReason ? ` Motivo: ${forcedReason}` : ""}
            </p>
          </div>
        ) : null}

        {deliveryResolutionSource || deliveryResolutionNote ? (
          <div class="mt-4 rounded-3xl border border-white/10 bg-white/5 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Resolución delivery</div>
            <div class="mt-3 space-y-2 text-sm text-slate-300">
              {deliveryResolutionSource ? (
                <div>Source: <span class="font-semibold text-white">{deliveryResolutionSource}</span></div>
              ) : null}
              {deliveryResolutionNote ? (
                <div>Nota: <span class="font-semibold text-white">{deliveryResolutionNote}</span></div>
              ) : null}
            </div>
          </div>
        ) : null}

        {order.notes ? (
          <div class="mt-4 rounded-3xl border border-amber-400/20 bg-amber-400/10 p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-200">Comentarios del cliente</div>
            <p class="mt-3 text-sm leading-6 text-amber-100/85">{order.notes}</p>
          </div>
        ) : null}

        <div class="mt-4 rounded-3xl border border-white/10 bg-slate-950/50 p-5">
          <div class="flex items-center justify-between gap-3">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Economía</div>
              <div class="mt-2 text-base font-semibold text-white">Resumen económico final</div>
            </div>

            {couponCode ? (
              <span class="inline-flex items-center rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-emerald-300">
                {couponCode}
              </span>
            ) : null}
          </div>

          <div class="mt-5 space-y-3 text-sm">
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Subtotal</span>
              <span class="font-semibold text-white">{money(order.subtotalCents)}</span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-slate-400">Delivery fee</span>
              <span class="font-semibold text-white">{money(order.deliveryFeeCents)}</span>
            </div>

            {Number(order.discountCents ?? 0) > 0 ? (
              <div class="flex items-center justify-between">
                <span class="text-slate-400">Descuento</span>
                <span class="font-semibold text-emerald-300">-{money(order.discountCents)}</span>
              </div>
            ) : null}

            <div class="flex items-center justify-between">
              <span class="text-slate-400">Impuestos</span>
              <span class="font-semibold text-white">{money(order.taxCents)}</span>
            </div>

            <div class="flex items-center justify-between border-t border-white/10 pt-3 text-base">
              <span class="font-semibold text-white">Total</span>
              <span class="font-semibold text-white">{money(order.totalCents)}</span>
            </div>

            {couponAppliedMessage ? (
              <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-100/85">
                {couponAppliedMessage}
              </div>
            ) : null}
          </div>
        </div>
      </article>
            <article class="rounded-3xl border border-white/10 bg-[#111827] p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Items</div>
            <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Líneas del pedido</h2>
          </div>

          <div class="text-sm text-slate-400">{decoratedItems.length} línea{decoratedItems.length === 1 ? "" : "s"}</div>
        </div>

        <div class="mt-6 space-y-4">
          {decoratedItems.map((it) => (
            <div class="rounded-3xl border border-white/10 bg-slate-950/40 p-5">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <div class="text-base font-semibold text-white">
                    {it.qty} × {it.nameSnapshot}
                  </div>
                  {it.variantSnapshot ? (
                    <div class="mt-1 text-sm text-slate-400">Variante: {it.variantSnapshot}</div>
                  ) : null}
                </div>

                <div class="text-right">
                  <div class="text-sm text-slate-400">Unitario</div>
                  <div class="mt-1 text-sm font-semibold text-white">{money(it.unitPriceCents)}</div>
                  <div class="mt-2 text-sm text-slate-400">Línea</div>
                  <div class="mt-1 text-base font-semibold text-white">{money(it.lineTotalCents)}</div>
                </div>
              </div>

              {it.opts.length ? (
                <div class="mt-3 text-sm text-slate-400">
                  <span class="font-semibold text-white">Opciones:</span>{" "}
                  {it.opts.map((o) => `${String(o.name ?? "")} (+${money(Number(o.priceDeltaCents ?? 0))})`).join(", ")}
                </div>
              ) : null}

              {it.adds.length ? (
                <div class="mt-2 text-sm text-slate-400">
                  <span class="font-semibold text-white">Añadidos:</span>{" "}
                  {it.adds.map((a) => `${String(a.name ?? "")} (+${money(Number(a.priceDeltaCents ?? 0))})`).join(", ")}
                </div>
              ) : null}

              {it.rems.length ? (
                <div class="mt-2 text-sm text-slate-400">
                  <span class="font-semibold text-white">Quitados:</span>{" "}
                  {it.rems.map((r) => String(r.name ?? "")).join(", ")}
                </div>
              ) : null}

              {it.notes ? (
                <div class="mt-3 text-sm text-slate-400">
                  <span class="font-semibold text-white">Notas línea:</span> {it.notes}
                </div>
              ) : null}
            </div>
          ))}
        </div>
      </article>
    </div>

    <aside class="space-y-6 xl:sticky xl:top-28 xl:h-fit">
      <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Workflow</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Estado del pedido</h2>

        <form method="post" action={`/api/admin/orders/${order.publicId}/update`} class="mt-6 grid gap-4">
          <input type="hidden" name="intent" value="update-status" />
          <input type="hidden" name="redirectTo" value={returnTo} />

          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Nuevo estado</span>
            <select
              class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
              name="status"
            >
              {statusOptions.map((st) => (
                <option value={st} selected={st === order.status}>{st}</option>
              ))}
            </select>
          </label>

          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Nota de actividad</span>
            <textarea
              class="min-h-24 w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-sky-400/40 focus:outline-none"
              name="note"
              placeholder="Opcional: detalle operativo del cambio"
            ></textarea>
          </label>

          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-2xl bg-sky-500 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-sky-400"
          >
            Guardar estado
          </button>
        </form>
      </article>

      <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Pago</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Estado de cobro</h2>

        <div class="mt-4 rounded-3xl border border-emerald-400/20 bg-emerald-400/10 p-4 text-sm leading-6 text-emerald-100/85">
          <div class="font-semibold text-emerald-200">Criterio actual</div>
          <p class="mt-2">
            Aquí se edita el estado manual del cobro (<strong>UNPAID</strong>, <strong>AUTH</strong>, <strong>PAID</strong>, <strong>FAILED</strong>). Los estados <strong>REFUNDED</strong> y <strong>PARTIALLY_REFUNDED</strong> pasan a calcularse automáticamente cuando registras refunds reales abajo.
          </p>
        </div>

        <form method="post" action={`/api/admin/orders/${order.publicId}/update`} class="mt-6 grid gap-4">
          <input type="hidden" name="intent" value="update-payment" />
          <input type="hidden" name="redirectTo" value={returnTo} />

          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Nuevo payment status</span>
            <select
              class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-emerald-400/40 focus:outline-none"
              name="paymentStatus"
            >
              {paymentOptions.map((ps) => (
                <option value={ps} selected={ps === order.paymentStatus}>{ps}</option>
              ))}
            </select>
          </label>

          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Nota de actividad</span>
            <textarea
              class="min-h-24 w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-emerald-400/40 focus:outline-none"
              name="note"
              placeholder="Opcional: detalle del cambio de pago"
            ></textarea>
          </label>

          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-2xl bg-emerald-400 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-300"
          >
            Guardar pago
          </button>
        </form>
      </article>

      <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Staff</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Nota interna</h2>

        {adminInternalNote ? (
          <div class="mt-4 rounded-3xl border border-amber-400/20 bg-amber-400/10 p-4">
            <div class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-200">Actual</div>
            <p class="mt-3 text-sm leading-6 text-amber-100/85">{adminInternalNote}</p>
          </div>
        ) : null}

        <form method="post" action={`/api/admin/orders/${order.publicId}/update`} class="mt-4 grid gap-4">
          <input type="hidden" name="intent" value="save-admin-note" />
          <input type="hidden" name="redirectTo" value={returnTo} />

          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Nota interna persistente</span>
            <textarea
              class="min-h-28 w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-amber-400/40 focus:outline-none"
              name="adminInternalNote"
              placeholder="Indicaciones internas de staff, incidencias, llamadas, seguimiento..."
            >{adminInternalNote}</textarea>
          </label>

          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-2xl bg-amber-400 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-amber-300"
          >
            Guardar nota interna
          </button>
        </form>
      </article>

      <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Actividad</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Añadir anotación</h2>

        <form method="post" action={`/api/admin/orders/${order.publicId}/update`} class="mt-6 grid gap-4">
          <input type="hidden" name="intent" value="add-activity-note" />
          <input type="hidden" name="redirectTo" value={returnTo} />

          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Anotación al timeline</span>
            <textarea
              class="min-h-24 w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-violet-400/40 focus:outline-none"
              name="note"
              placeholder="Llamado al cliente, incidencia con entrega, ajuste acordado..."
            ></textarea>
          </label>

          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-2xl bg-violet-400 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-violet-300"
          >
            Añadir al timeline
          </button>
        </form>
      </article>
            <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Actividad</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Timeline</h2>

        <div class="mt-6 space-y-3">
          {fullTimeline.map((entry) => (
            <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-center justify-between gap-3">
                <div class="text-sm font-semibold text-white">{entry.title}</div>
                <span class:list={["inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]", entry.tone]}>
                  {entry.at ? formatDate(entry.at) : "Sin fecha"}
                </span>
              </div>
              <p class="mt-2 text-sm text-slate-400">{entry.detail}</p>
              {entry.by ? <div class="mt-2 text-xs text-slate-500">Por {entry.by}</div> : null}
            </div>
          ))}
        </div>
      </article>

      <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Cobro real</div>
        <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">Payments y refunds</h2>

        <div class="mt-4 grid gap-4 md:grid-cols-3">
          <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
            <div class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Payments</div>
            <div class="mt-2 text-xl font-semibold text-white">{decoratedPayments.length}</div>
            <p class="mt-2 text-sm text-slate-400">Registros internos de cobro</p>
          </div>

          <div class="rounded-3xl border border-fuchsia-400/20 bg-fuchsia-400/10 p-4">
            <div class="text-xs font-semibold uppercase tracking-[0.16em] text-fuchsia-200">Refunded</div>
            <div class="mt-2 text-xl font-semibold text-white">{money(totalSucceededRefundCents)}</div>
            <p class="mt-2 text-sm text-fuchsia-100/80">Importe total devuelto con éxito</p>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
            <div class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Pendientes / fallidos</div>
            <div class="mt-2 text-xl font-semibold text-white">{pendingRefundsCount} / {failedRefundsCount}</div>
            <p class="mt-2 text-sm text-slate-400">Refunds creados o fallidos</p>
          </div>
        </div>

        <div class="mt-6 space-y-4">
          {decoratedPayments.length === 0 ? (
            <div class="rounded-3xl border border-white/10 bg-white/5 p-4 text-sm text-slate-400">
              {paymentMethod === "CARD"
                ? "No hay registros en Payment para este pedido. Si es un pedido antiguo, guarda primero el payment status en PAID/AUTH para materializar el rastro interno y después ya podrás registrar refunds."
                : "No hay registros en Payment para este pedido."}
            </div>
          ) : (
            decoratedPayments.map((payment) => {
              const succeededRefundCents = sumSucceededRefunds(payment.refunds);
              const refundableCents = Math.max(0, Number(payment.amountCents ?? 0) - succeededRefundCents);
              const pendingCount = payment.refunds.filter((refund) => refund.status === "CREATED").length;
              const failedCount = payment.refunds.filter((refund) => refund.status === "FAILED").length;
              const canRegisterSucceededRefund =
                paymentMethod === "CARD" && payment.status === "PAID" && refundableCents > 0;

              return (
                <div class="rounded-3xl border border-white/10 bg-white/5 p-4">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <div class="text-sm font-semibold text-white">Payment #{payment.id}</div>
                      <div class="mt-1 text-xs text-slate-500">
                        {payment.provider} · {payment.providerIntentId ?? "sin intent"}
                      </div>
                    </div>

                    <span
                      class:list={[
                        "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                        payment.status === "PAID"
                          ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
                          : payment.status === "AUTHORIZED"
                            ? "border-sky-400/20 bg-sky-400/10 text-sky-300"
                            : payment.status === "FAILED"
                              ? "border-rose-400/20 bg-rose-400/10 text-rose-300"
                              : "border-white/10 bg-white/5 text-slate-300",
                      ]}
                    >
                      {payment.status}
                    </span>
                  </div>

                  <div class="mt-3 grid gap-3 md:grid-cols-2 xl:grid-cols-4 text-sm text-slate-300">
                    <div>Importe: <span class="font-semibold text-white">{money(payment.amountCents)}</span></div>
                    <div>Refunded ok: <span class="font-semibold text-white">{money(succeededRefundCents)}</span></div>
                    <div>Disponible: <span class="font-semibold text-white">{money(refundableCents)}</span></div>
                    <div>Creado: <span class="font-semibold text-white">{formatDate(payment.createdAt)}</span></div>
                  </div>

                  {payment.providerChargeId ? (
                    <div class="mt-2 text-sm text-slate-300">
                      Charge: <span class="font-semibold text-white">{payment.providerChargeId}</span>
                    </div>
                  ) : null}

                  <div class="mt-4 rounded-3xl border border-white/10 bg-slate-950/40 p-4">
                    <div class="flex flex-wrap items-end justify-between gap-3">
                      <div>
                        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                          Registrar refund
                        </div>
                        <div class="mt-1 text-sm text-slate-300">
                          {canRegisterSucceededRefund
                            ? "Puedes registrar devoluciones sobre el importe pendiente de este payment."
                            : paymentMethod !== "CARD"
                              ? "Los refunds solo se habilitan en pedidos CARD."
                              : payment.status !== "PAID"
                                ? "Para registrar un refund SUCCEEDED, el payment debe estar en PAID."
                                : "No queda importe disponible para devolver en este payment."}
                        </div>
                      </div>

                      <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300">
                        Pendientes: {pendingCount} · Fallidos: {failedCount}
                      </div>
                    </div>

                    <form method="post" action={`/api/admin/orders/${order.publicId}/update`} class="mt-4 grid gap-4">
                      <input type="hidden" name="intent" value="create-refund" />
                      <input type="hidden" name="redirectTo" value={returnTo} />
                      <input type="hidden" name="paymentId" value={payment.id} />

                      <div class="grid gap-4 lg:grid-cols-[180px_180px_minmax(0,1fr)]">
                        <label class="block">
                          <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Importe €</span>
                          <input
                            class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-fuchsia-400/40 focus:outline-none"
                            type="number"
                            name="refundAmountEur"
                            min="0.01"
                            step="0.01"
                            value={(refundableCents / 100).toFixed(2)}
                            required
                          />
                        </label>

                        <label class="block">
                          <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Estado refund</span>
                          <select
                            class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-fuchsia-400/40 focus:outline-none"
                            name="refundStatus"
                          >
                            <option value="SUCCEEDED">SUCCEEDED</option>
                            <option value="CREATED">CREATED</option>
                            <option value="FAILED">FAILED</option>
                          </select>
                        </label>

                        <label class="block">
                          <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Nota</span>
                          <input
                            class="w-full rounded-2xl border border-white/10 bg-[#0b1120] px-4 py-3 text-sm text-white focus:border-fuchsia-400/40 focus:outline-none"
                            type="text"
                            name="note"
                            placeholder="Motivo, incidencia o referencia externa"
                          />
                        </label>
                      </div>

                      <button
                        type="submit"
                        class:list={[
                          "inline-flex items-center justify-center rounded-2xl px-4 py-3 text-sm font-semibold transition",
                          paymentMethod === "CARD" && refundableCents > 0
                            ? "bg-fuchsia-400 text-slate-950 hover:bg-fuchsia-300"
                            : "cursor-not-allowed border border-white/10 bg-white/5 text-slate-500",
                        ]}
                        disabled={paymentMethod !== "CARD" || refundableCents <= 0}
                      >
                        Registrar refund
                      </button>
                    </form>
                  </div>

                  {payment.refunds.length ? (
                    <div class="mt-4 space-y-2">
                      {payment.refunds.map((refund) => (
                        <div class="rounded-2xl border border-fuchsia-400/20 bg-fuchsia-400/10 p-3">
                          <div class="flex flex-wrap items-center justify-between gap-3">
                            <div class="text-sm font-semibold text-white">Refund #{refund.id}</div>
                            <span
                              class:list={[
                                "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]",
                                refundTone(refund.status),
                              ]}
                            >
                              {refund.status}
                            </span>
                          </div>

                          <div class="mt-2 text-sm text-slate-300">
                            {money(refund.amountCents)} · {formatDate(refund.createdAt)}
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : null}
                </div>
              );
            })
          )}
        </div>
      </article>
    </aside>
  </section>
</AdminLayout>