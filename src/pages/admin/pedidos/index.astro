---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import { orderStatusTone, paymentStatusTone, orderTypeTone, type ToneName } from "@/lib/admin/tones";
import { db, Order } from "astro:db";

type PaymentMethod = "CASH" | "CARD" | "UNKNOWN";

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function formatDate(value: Date | string) {
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", { dateStyle: "short", timeStyle: "short", timeZone: "Europe/Madrid" }).format(date);
}

function paymentMethodTone(value: PaymentMethod): ToneName {
  if (value === "CASH") return "warning";
  if (value === "CARD") return "primary";
  return "neutral";
}

function paymentMethodLabel(value: PaymentMethod) {
  if (value === "CASH") return "Efectivo";
  if (value === "CARD") return "Tarjeta";
  return "—";
}

function parsePaymentMethod(snapshot: unknown): PaymentMethod {
  const meta = (snapshot ?? {}) as Record<string, unknown>;
  const raw = String(meta.paymentMethod ?? "").toUpperCase();
  return raw === "CASH" || raw === "CARD" ? raw : "UNKNOWN";
}

function nextSuggestedStatus(status: string, type: string) {
  if (status === "PENDING" || status === "PAID") return "ACCEPTED";
  if (status === "ACCEPTED") return "PREPARING";
  if (status === "PREPARING") return "READY";
  if (status === "READY") return type === "DELIVERY" ? "OUT_FOR_DELIVERY" : "DELIVERED";
  if (status === "OUT_FOR_DELIVERY") return "DELIVERED";
  return null;
}

const OPEN_STATUSES = ["PENDING", "PAID", "ACCEPTED", "PREPARING", "READY", "OUT_FOR_DELIVERY"];

const url = new URL(Astro.request.url);
const status = (url.searchParams.get("status") ?? "").toUpperCase();
const type = (url.searchParams.get("type") ?? "").toUpperCase();
const paymentMethodFilter = (url.searchParams.get("paymentMethod") ?? "").toUpperCase();
const paymentStatusFilter = (url.searchParams.get("paymentStatus") ?? "").toUpperCase();
const q = (url.searchParams.get("q") ?? "").trim().toLowerCase();

const rows = await db.select().from(Order).orderBy(Order.createdAt).limit(200);
const allOrders = [...rows].reverse();

const decoratedOrders = allOrders.map((order) => {
  const meta = (order.addressSnapshot ?? {}) as Record<string, unknown>;
  const paymentMethod = parsePaymentMethod(order.addressSnapshot);
  const forcedPickup = Boolean(meta.forcedPickup);
  const couponCode = String(meta.couponCode ?? "").trim();
  const adminInternalNote = String(meta.adminInternalNote ?? "").trim();

  return {
    ...order,
    paymentMethod,
    forcedPickup,
    couponCode,
    hasInternalNote: !!adminInternalNote,
    nextStatus: nextSuggestedStatus(order.status, order.type),
  };
});

const orders = decoratedOrders.filter((order) => {
  if (status && order.status !== status) return false;
  if (type && order.type !== type) return false;
  if (paymentMethodFilter && order.paymentMethod !== paymentMethodFilter) return false;
  if (paymentStatusFilter && order.paymentStatus !== paymentStatusFilter) return false;

  if (q) {
    const haystack = [order.publicId, order.customerName ?? "", order.customerPhone ?? "", order.customerEmail ?? "", order.couponCode ?? ""]
      .join(" ")
      .toLowerCase();
    if (!haystack.includes(q)) return false;
  }

  return true;
});

const counters = {
  total: decoratedOrders.length,
  open: decoratedOrders.filter((o) => OPEN_STATUSES.includes(o.status)).length,
  paid: decoratedOrders.filter((o) => o.paymentStatus === "PAID").length,
  revenueCents: decoratedOrders.filter((o) => o.paymentStatus === "PAID").reduce((sum, o) => sum + Number(o.totalCents ?? 0), 0),
};

const returnTo = `${url.pathname}${url.search}`;

const selectClass = "rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none";
---

<AdminLayout title="Pedidos · Admin · Arcadia" heading="Pedidos" description="Todos los pedidos con filtros y avance rápido de estado.">
  <div class="space-y-6">
    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard icon="cart" label="Pedidos abiertos" value={String(counters.open)} helper={`${counters.total} cargados (últimos 200)`} />
      <StatCard icon="coin" label="Cobrado" value={money(counters.revenueCents)} helper={`${counters.paid} pedidos pagados`} />
    </section>

    <Card padded={false}>
      <div class="border-b border-admin-border px-5 py-4 lg:px-6">
        <form method="get" class="flex flex-wrap items-center gap-2">
          <input
            class="min-w-[200px] flex-1 rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/40 focus:outline-none"
            type="search"
            name="q"
            value={q}
            placeholder="Buscar ID, cliente, teléfono o cupón..."
          />
          <select name="status" class={selectClass}>
            <option value="">Estado</option>
            {["PENDING", "PAID", "ACCEPTED", "PREPARING", "READY", "OUT_FOR_DELIVERY", "DELIVERED", "CANCELLED"].map((value) => (
              <option value={value} selected={status === value}>{value}</option>
            ))}
          </select>
          <select name="type" class={selectClass}>
            <option value="">Canal</option>
            <option value="DELIVERY" selected={type === "DELIVERY"}>Delivery</option>
            <option value="PICKUP" selected={type === "PICKUP"}>Pickup</option>
          </select>
          <select name="paymentMethod" class={selectClass}>
            <option value="">Método</option>
            <option value="CASH" selected={paymentMethodFilter === "CASH"}>Efectivo</option>
            <option value="CARD" selected={paymentMethodFilter === "CARD"}>Tarjeta</option>
          </select>
          <select name="paymentStatus" class={selectClass}>
            <option value="">Pago</option>
            {["UNPAID", "AUTH", "PAID", "FAILED", "REFUNDED", "PARTIALLY_REFUNDED"].map((value) => (
              <option value={value} selected={paymentStatusFilter === value}>{value}</option>
            ))}
          </select>
          <button type="submit" class="inline-flex min-h-9 items-center justify-center rounded-2xl border border-admin-border bg-white/[0.03] px-3.5 py-2 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
            Filtrar
          </button>
        </form>
      </div>

      {
        orders.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="No hay pedidos para ese filtro" description="Ajusta la búsqueda o los filtros." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Pedido</th>
                  <th>Cliente</th>
                  <th>Canal</th>
                  <th>Estado</th>
                  <th>Pago</th>
                  <th>Total</th>
                  <th>Fecha</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {orders.map((order) => (
                  <tr>
                    <td>
                      <a href={`/admin/pedidos/${order.publicId}`} class="font-semibold text-white transition hover:text-sky-300">
                        #{order.publicId}
                      </a>
                      <div class="mt-0.5 flex flex-wrap gap-1.5">
                        {order.couponCode ? <span class="text-[11px] text-violet-300">{order.couponCode}</span> : null}
                        {order.forcedPickup ? <span class="text-[11px] text-amber-300">forced pickup</span> : null}
                        {order.hasInternalNote ? <span class="text-[11px] text-cyan-300">nota</span> : null}
                      </div>
                    </td>
                    <td>
                      <div class="truncate text-slate-200">{order.customerName ?? "Sin nombre"}</div>
                      <div class="truncate text-xs text-admin-muted">{order.customerPhone ?? "—"}</div>
                    </td>
                    <td><Badge tone={orderTypeTone(order.type)}>{order.type === "DELIVERY" ? "Delivery" : "Pickup"}</Badge></td>
                    <td><Badge tone={orderStatusTone(order.status)}>{order.status}</Badge></td>
                    <td>
                      <div class="flex flex-wrap items-center gap-1.5">
                        <Badge tone={paymentStatusTone(order.paymentStatus)}>{order.paymentStatus}</Badge>
                        <Badge tone={paymentMethodTone(order.paymentMethod)}>{paymentMethodLabel(order.paymentMethod)}</Badge>
                      </div>
                    </td>
                    <td>
                      <div class="font-semibold text-white">{money(order.totalCents)}</div>
                      {Number(order.discountCents ?? 0) > 0 ? (
                        <div class="text-xs text-violet-300">-{money(order.discountCents)}</div>
                      ) : null}
                    </td>
                    <td class="text-admin-muted">{formatDate(order.createdAt)}</td>
                    <td>
                      <div class="flex items-center justify-end gap-2">
                        {order.nextStatus ? (
                          <form method="post" action={`/api/admin/orders/${order.publicId}/update`}>
                            <input type="hidden" name="intent" value="update-status" />
                            <input type="hidden" name="status" value={order.nextStatus} />
                            <input type="hidden" name="redirectTo" value={returnTo} />
                            <button type="submit" class="rounded-xl border border-sky-400/20 bg-sky-400/10 px-3 py-1.5 text-xs font-semibold text-sky-300 transition hover:border-sky-400/30 hover:bg-sky-400/15">
                              → {order.nextStatus}
                            </button>
                          </form>
                        ) : null}
                        <a href={`/admin/pedidos/${order.publicId}`} class="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
                          Ver
                        </a>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
