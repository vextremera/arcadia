---
import { db, Order, OrderItem, eq } from "astro:db";

const publicId = String(Astro.params.publicId ?? "").trim();
if (!publicId) return new Response("Missing publicId", { status: 400 });

const [order] = await db
  .select()
  .from(Order)
  .where(eq(Order.publicId, publicId))
  .limit(1);

if (!order) return new Response("Pedido no encontrado", { status: 404 });

const items = await db
  .select()
  .from(OrderItem)
  .where(eq(OrderItem.orderId, order.id))
  .orderBy(OrderItem.id);

function money(cents: number) {
  return `${(cents / 100).toFixed(2)} €`;
}

function fmtDate(d: any) {
  const date = new Date(d);
  return new Intl.DateTimeFormat("es-ES", {
    timeZone: "Europe/Madrid",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).format(date);
}

const meta: any = (order as any).addressSnapshot ?? {};
const paymentMethod = meta?.paymentMethod ?? null; // CASH | CARD
const forcedPickup = !!meta?.forcedPickup;
const forcedReason = meta?.forcedReason ?? null;
const address = meta?.address ?? null;

const isDelivery = order.type === "DELIVERY";
const deliveryFeeCents = Number(order.deliveryFeeCents ?? 0);

const url = new URL(Astro.request.url);
const autoPrint = url.searchParams.get("print") === "1";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ticket {order.publicId}</title>

    <style>
      :root {
        --receipt-w: 80mm;
      }

      /* Impresión tipo ticket 80mm */
      @page {
        size: var(--receipt-w) auto;
        margin: 4mm;
      }

      html,
      body {
        padding: 0;
        margin: 0;
      }

      body {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
          "Liberation Mono", "Courier New", monospace;
        font-variant-numeric: tabular-nums;
        background: #f4f4f5; /* zinc-100 */
        color: #000;
      }

      .no-print {
        background: #fff;
        border-bottom: 1px solid #e4e4e7;
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .topbar {
        max-width: 900px;
        margin: 0 auto;
        padding: 10px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .btn {
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 14px;
        font-weight: 700;
        border: 1px solid #d4d4d8;
        background: #fff;
        color: #111;
        text-decoration: none;
        cursor: pointer;
      }

      .btnPrimary {
        background: #111;
        border-color: #111;
        color: #fff;
      }

      .receiptWrap {
        padding: 16px 0 32px;
      }

      .receipt {
        width: var(--receipt-w);
        margin: 0 auto;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
        padding: 12px;
      }

      .center {
        text-align: center;
      }

      .title {
        font-size: 18px;
        font-weight: 900;
        letter-spacing: 0.2px;
      }

      .sub {
        font-size: 11px;
        color: #333;
        margin-top: 2px;
      }

      .sep {
        border-top: 1px dashed #000;
        margin: 10px 0;
      }

      .row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
      }

      .muted {
        color: #333;
      }

      .xs {
        font-size: 10px;
      }

      .sm {
        font-size: 11px;
      }

      .b {
        font-weight: 700;
      }

      .bb {
        font-weight: 900;
      }

      .wrap {
        word-break: break-word;
      }

      .indent {
        padding-left: 10px;
      }

      .badge {
        display: inline-block;
        border: 1px solid #000;
        border-radius: 6px;
        padding: 1px 6px;
        font-size: 10px;
        font-weight: 700;
      }

      .noteBox {
        border: 1px dashed #000;
        border-radius: 10px;
        padding: 8px;
        margin-top: 10px;
        font-size: 11px;
      }

      .bigTotal {
        font-size: 14px;
        font-weight: 900;
      }

      /* Print: sin sombras, sin fondo, sin redondeo */
      @media print {
        body {
          background: #fff;
        }
        .no-print {
          display: none !important;
        }
        .receiptWrap {
          padding: 0;
        }
        .receipt {
          border-radius: 0;
          box-shadow: none;
          padding: 0;
        }
      }
    </style>
  </head>

  <body>
    {/* Barra superior solo pantalla */}
    <div class="no-print">
      <div class="topbar">
        <a class="btn" href={`/admin/pedidos/${order.publicId}`}>← Volver al pedido</a>
        <button class="btn btnPrimary" type="button" onclick="window.print()">Imprimir</button>
      </div>
    </div>

    <div class="receiptWrap">
      <main class="receipt">
        {/* Header */}
        <div class="center">
          <div class="title">ARCADIA</div>
          <div class="sub">Lloret de Mar</div>
        </div>

        <div class="sep"></div>

        {/* Meta pedido */}
        <div class="row">
          <div class="b">Pedido</div>
          <div class="bb">{order.publicId}</div>
        </div>

        <div class="row sm muted" style="margin-top: 4px;">
          <div>{fmtDate(order.createdAt)}</div>
          <div class="badge">{order.type}</div>
        </div>

        <div class="row sm muted" style="margin-top: 4px;">
          <div>Pago</div>
          <div class="b">{paymentMethod ?? "—"}</div>
        </div>

        {forcedPickup ? (
          <div class="noteBox">
            <div class="b">Forzado a RECOGIDA</div>
            <div class="sm muted">{forcedReason ?? ""}</div>
          </div>
        ) : null}

        <div class="sep"></div>

        {/* Cliente */}
        <div class="b">Cliente</div>
        <div class="sm muted" style="margin-top: 4px;">
          {(order as any).customerName} · {(order as any).customerPhone}
        </div>

        {isDelivery && address ? (
          <div style="margin-top: 8px;">
            <div class="b">Dirección</div>
            <div class="sm muted wrap" style="margin-top: 4px;">
              {address.line1}{address.line2 ? `, ${address.line2}` : ""}<br />
              {address.postalCode} {address.city}
              {address.notes ? (
                <>
                  <br />
                  <span class="b">Notas:</span> {address.notes}
                </>
              ) : null}
            </div>
          </div>
        ) : null}

        <div class="sep"></div>

        {/* Items */}
        <div class="b">Items</div>

        <div style="margin-top: 8px;">
          {items.map((it) => {
            const m: any = (it as any).modifiers ?? {};
            const opts = m.modifierOptions ?? [];
            const adds = m.ingredientsAdded ?? [];
            const rems = m.ingredientsRemoved ?? [];

            return (
              <div style="margin-bottom: 10px;">
                <div class="row">
                  <div class="b wrap" style="flex: 1;">
                    {it.qty}× {it.nameSnapshot}
                    {it.variantSnapshot ? (
                      <span class="sm muted"> ({it.variantSnapshot})</span>
                    ) : null}
                  </div>
                  <div class="b">{money(it.lineTotalCents)}</div>
                </div>

                {opts.length ? (
                  <div class="sm muted indent wrap" style="margin-top: 4px;">
                    + Extras: {opts.map((x: any) => x.name).join(", ")}
                  </div>
                ) : null}

                {adds.length ? (
                  <div class="sm muted indent wrap" style="margin-top: 3px;">
                    + Añadir: {adds.map((x: any) => x.name).join(", ")}
                  </div>
                ) : null}

                {rems.length ? (
                  <div class="sm muted indent wrap" style="margin-top: 3px;">
                    - Quitar: {rems.map((x: any) => x.name).join(", ")}
                  </div>
                ) : null}

                <div class="sep" style="margin: 8px 0 0;"></div>
              </div>
            );
          })}
        </div>

        {/* Notas pedido */}
        {(order as any).notes ? (
          <div class="noteBox">
            <div class="b">NOTAS</div>
            <div class="sm wrap" style="margin-top: 4px;">
              {(order as any).notes}
            </div>
          </div>
        ) : null}

        <div class="sep"></div>

        {/* Totales */}
        <div class="row">
          <div class="muted">Subtotal</div>
          <div class="b">{money((order as any).subtotalCents)}</div>
        </div>

        {isDelivery ? (
          <div class="row" style="margin-top: 4px;">
            <div class="muted">Delivery</div>
            <div class="b">{money(deliveryFeeCents)}</div>
          </div>
        ) : null}

        <div class="row" style="margin-top: 8px;">
          <div class="bb bigTotal">TOTAL</div>
          <div class="bb bigTotal">{money((order as any).totalCents)}</div>
        </div>

        <div class="sep"></div>

        <div class="center xs muted">
          Gracias por tu pedido ❤️
        </div>
      </main>
    </div>

    {autoPrint ? (
      <script is:inline>
        {`
          window.addEventListener("load", () => {
            setTimeout(() => window.print(), 50);
          });
        `}
      </script>
    ) : null}
  </body>
</html>
