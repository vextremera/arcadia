---
import { db, Order, OrderItem, eq } from "astro:db";

const publicId = String(Astro.params.publicId ?? "").trim();
if (!publicId) {
  return new Response("Missing publicId", { status: 400 });
}

const [order] = await db
  .select()
  .from(Order)
  .where(eq(Order.publicId, publicId))
  .limit(1);

if (!order) {
  return new Response("Pedido no encontrado", { status: 404 });
}

const items = await db
  .select()
  .from(OrderItem)
  .where(eq(OrderItem.orderId, order.id))
  .orderBy(OrderItem.id);

  type OrderItemModifierEntry = {
  name?: string;
  priceDeltaCents?: number;
};

const decoratedItems = items.map((it) => {
  const modifiers = (it.modifiers ?? {}) as Record<string, unknown>;

  const opts = (
    Array.isArray(modifiers.modifierOptions) ? modifiers.modifierOptions : []
  ) as OrderItemModifierEntry[];

  const adds = (
    Array.isArray(modifiers.ingredientsAdded) ? modifiers.ingredientsAdded : []
  ) as OrderItemModifierEntry[];

  const rems = (
    Array.isArray(modifiers.ingredientsRemoved) ? modifiers.ingredientsRemoved : []
  ) as OrderItemModifierEntry[];

  return {
    ...it,
    opts,
    adds,
    rems,
  };
});

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function formatDate(value: Date | string) {
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", {
    timeZone: "Europe/Madrid",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).format(date);
}

const meta = (order.addressSnapshot ?? {}) as Record<string, unknown>;
const paymentMethod = String(meta.paymentMethod ?? "").toUpperCase() || null;
const forcedPickup = Boolean(meta.forcedPickup);
const forcedReason = String(meta.forcedReason ?? "").trim();
const address = (meta.address ?? null) as
  | {
      line1?: string;
      line2?: string;
      city?: string;
      postalCode?: string;
      notes?: string;
    }
  | null;

const autoPrint = new URL(Astro.request.url).searchParams.get("print") === "1";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ticket {order.publicId}</title>

    <style>
      :root {
        --receipt-width: 80mm;
      }

      @page {
        size: var(--receipt-width) auto;
        margin: 4mm;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: #f4f4f5;
        color: #000;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-variant-numeric: tabular-nums;
      }

      .toolbar {
        position: sticky;
        top: 0;
        z-index: 10;
        border-bottom: 1px solid #e4e4e7;
        background: #fff;
      }

      .toolbarInner {
        margin: 0 auto;
        display: flex;
        max-width: 900px;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 16px;
      }

      .btn {
        border: 1px solid #d4d4d8;
        border-radius: 12px;
        background: #fff;
        color: #111;
        padding: 10px 14px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
      }

      .btnPrimary {
        border-color: #111;
        background: #111;
        color: #fff;
      }

      .wrap {
        padding: 16px 0 32px;
      }

      .ticket {
        width: var(--receipt-width);
        margin: 0 auto;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 8px 26px rgba(0, 0, 0, 0.08);
        padding: 12px;
      }

      .center {
        text-align: center;
      }

      .title {
        font-size: 18px;
        font-weight: 900;
        letter-spacing: 0.3px;
      }

      .sub {
        margin-top: 2px;
        font-size: 11px;
        color: #3f3f46;
      }

      .sep {
        margin: 10px 0;
        border-top: 1px dashed #000;
      }

      .row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
      }

      .sm {
        font-size: 11px;
      }

      .xs {
        font-size: 10px;
      }

      .muted {
        color: #3f3f46;
      }

      .b {
        font-weight: 700;
      }

      .bb {
        font-weight: 900;
      }

      .badge {
        display: inline-block;
        border: 1px solid #000;
        border-radius: 6px;
        padding: 1px 6px;
        font-size: 10px;
        font-weight: 700;
      }

      .noteBox {
        margin-top: 10px;
        border: 1px dashed #000;
        border-radius: 10px;
        padding: 8px;
        font-size: 11px;
      }

      .bigTotal {
        font-size: 14px;
        font-weight: 900;
      }

      .indent {
        padding-left: 10px;
      }

      .prewrap {
        white-space: pre-wrap;
      }

      @media print {
        body {
          background: #fff;
        }

        .toolbar {
          display: none !important;
        }

        .wrap {
          padding: 0;
        }

        .ticket {
          border-radius: 0;
          box-shadow: none;
          padding: 0;
        }
      }
    </style>
  </head>

  <body>
    <div class="toolbar">
      <div class="toolbarInner">
        <a class="btn" href={`/admin/pedidos/${order.publicId}`}>← Volver al pedido</a>
        <button class="btn btnPrimary" type="button" onclick="window.print()">Imprimir</button>
      </div>
    </div>

    <div class="wrap">
      <main class="ticket">
        <div class="center">
          <div class="title">ARCADIA</div>
          <div class="sub">Lloret de Mar</div>
        </div>

        <div class="sep"></div>

        <div class="row">
          <div class="b">Pedido</div>
          <div class="bb">{order.publicId}</div>
        </div>

        <div class="row sm muted" style="margin-top:4px;">
          <div>{formatDate(order.createdAt)}</div>
          <div class="badge">{order.type}</div>
        </div>

        <div class="row sm muted" style="margin-top:4px;">
          <div>Estado</div>
          <div>{order.status}</div>
        </div>

        <div class="row sm muted" style="margin-top:4px;">
          <div>Pago</div>
          <div>{paymentMethod ?? "—"} / {order.paymentStatus}</div>
        </div>

        <div class="sep"></div>

        <div class="sm b">Cliente</div>
        <div class="sm" style="margin-top:4px;">{order.customerName ?? "Sin nombre"}</div>
        <div class="sm">{order.customerPhone ?? "Sin teléfono"}</div>
        {order.customerEmail ? <div class="sm">{order.customerEmail}</div> : null}

        {order.type === "DELIVERY" && address ? (
          <>
            <div class="sep"></div>
            <div class="sm b">Entrega</div>
            <div class="sm" style="margin-top:4px;">{address.line1 ?? "—"}</div>
            {address.line2 ? <div class="sm">{address.line2}</div> : null}
            {(address.postalCode || address.city) ? (
              <div class="sm">{address.postalCode ?? ""}{address.postalCode && address.city ? " · " : ""}{address.city ?? ""}</div>
            ) : null}
            {address.notes ? <div class="sm" style="margin-top:4px;">Notas dirección: {address.notes}</div> : null}
          </>
        ) : null}

        {forcedPickup ? (
          <div class="noteBox">
            <div class="b">Force pickup</div>
            <div style="margin-top:4px;">
              Este pedido fue forzado a recogida.
              {forcedReason ? ` Motivo: ${forcedReason}` : ""}
            </div>
          </div>
        ) : null}

        {order.notes ? (
          <div class="noteBox">
            <div class="b">Notas del pedido</div>
            <div class="prewrap" style="margin-top:4px;">{order.notes}</div>
          </div>
        ) : null}

        <div class="sep"></div>

        <div class="sm b">Items</div>

        <div style="margin-top:6px;">
          {decoratedItems.map((item) => {
            return (
              <div style="margin-top:10px;">
                <div class="row sm">
                  <div class="bb">{item.qty}× {item.nameSnapshot}</div>
                  <div class="bb">{money(item.lineTotalCents)}</div>
                </div>

                {item.variantSnapshot ? (
                  <div class="xs muted indent" style="margin-top:2px;">Variante: {item.variantSnapshot}</div>
                ) : null}

                {item.opts.length ? (
                  <div class="xs muted indent" style="margin-top:2px;">
                    Extras: {item.opts.map((o) => `${String(o.name ?? "")} (+${money(Number(o.priceDeltaCents ?? 0))})`).join(", ")}
                  </div>
                ) : null}

                {item.adds.length ? (
                  <div class="xs muted indent" style="margin-top:2px;">
                    Añadidos: {item.adds.map((a) => `${String(a.name ?? "")} (+${money(Number(a.priceDeltaCents ?? 0))})`).join(", ")}
                  </div>
                ) : null}

                {item.rems.length ? (
                  <div class="xs muted indent" style="margin-top:2px;">
                    Quitados: {item.rems.map((r) => String(r.name ?? "")).join(", ")}
                  </div>
                ) : null}

                {item.notes ? (
                  <div class="xs muted indent" style="margin-top:2px;">
                    Nota línea: {item.notes}
                  </div>
                ) : null}
              </div>
            );
          })}
        </div>

        <div class="sep"></div>

        <div class="row sm">
          <div>Subtotal</div>
          <div>{money(order.subtotalCents)}</div>
        </div>

        {Number(order.deliveryFeeCents ?? 0) > 0 ? (
          <div class="row sm" style="margin-top:4px;">
            <div>Delivery</div>
            <div>{money(order.deliveryFeeCents)}</div>
          </div>
        ) : null}

        {Number(order.discountCents ?? 0) > 0 ? (
          <div class="row sm" style="margin-top:4px;">
            <div>Descuento</div>
            <div>-{money(order.discountCents)}</div>
          </div>
        ) : null}

        <div class="row sm" style="margin-top:4px;">
          <div>Impuestos</div>
          <div>{money(order.taxCents)}</div>
        </div>

        <div class="sep"></div>

        <div class="row bigTotal">
          <div>TOTAL</div>
          <div>{money(order.totalCents)}</div>
        </div>
      </main>
    </div>

    {autoPrint ? (
      <script is:inline>
        {`window.addEventListener("load", () => window.print());`}
      </script>
    ) : null}
  </body>
</html>