---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import { db, Product, UpsellItem, eq } from "astro:db";

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

const upsellRows = await db
  .select({
    id: UpsellItem.id,
    active: UpsellItem.active,
    sortOrder: UpsellItem.sortOrder,
    createdAt: UpsellItem.createdAt,
    productId: Product.id,
    name: Product.name,
    priceCents: Product.priceCents,
    image: Product.imageUrl,
    productActive: Product.active,
  })
  .from(UpsellItem)
  .innerJoin(Product, eq(UpsellItem.productId, Product.id))
  .orderBy(UpsellItem.sortOrder);

const products = await db
  .select({ id: Product.id, name: Product.name, active: Product.active, priceCents: Product.priceCents })
  .from(Product)
  .orderBy(Product.name);

const linkedProductIds = new Set(upsellRows.map((item) => item.productId));
const availableProducts = products.filter((product) => product.active && !linkedProductIds.has(product.id));

const activeCount = upsellRows.filter((item) => item.active).length;
const maxSort = upsellRows.length ? Math.max(...upsellRows.map((item) => Number(item.sortOrder ?? 0))) : 0;
const brokenCount = upsellRows.filter((item) => !item.productActive).length;
---

<AdminLayout title="Upsell · Admin · Arcadia" heading="Upsell" description="Productos sugeridos durante el flujo de compra.">
  <div class="space-y-6">
    {
      brokenCount > 0 ? (
        <section class="rounded-admin-lg border border-amber-400/20 bg-amber-400/10 px-5 py-3 text-sm text-amber-100">
          {brokenCount} item(s) apuntan a productos desactivados en catálogo: no se mostrarán en el flujo público.
        </section>
      ) : null
    }

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard icon="cart" label="Items de upsell" value={String(upsellRows.length)} helper={`${activeCount} activos`} />
      <StatCard label="Productos disponibles" value={String(availableProducts.length)} helper="Activos y aún sin enlazar" />
    </section>

    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <div>
          <h2 class="text-base font-semibold text-white">Productos sugeridos</h2>
          <p class="mt-1 text-xs text-admin-muted">Nombre, precio e imagen salen del catálogo; aquí solo se controla orden y estado.</p>
        </div>

        <Modal id="upsell-add" title="Añadir producto a upsell" description="Solo se listan productos activos que todavía no están en el flujo." triggerLabel="+ Añadir producto">
          <form method="post" action="/api/admin/upsell/add" class="grid gap-4">
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Producto</span>
              <select name="productId" required class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none">
                {availableProducts.map((product) => (
                  <option value={product.id}>{product.name} · {money(product.priceCents)}</option>
                ))}
              </select>
            </label>

            <button
              type="submit"
              disabled={availableProducts.length === 0}
              class:list={[
                "inline-flex min-h-11 items-center justify-center rounded-2xl px-4 py-3 text-sm font-semibold transition",
                availableProducts.length > 0
                  ? "border border-sky-400/20 bg-sky-400/10 text-sky-100 hover:border-sky-400/30 hover:bg-sky-400/15"
                  : "cursor-not-allowed border border-admin-border bg-white/[0.03] text-slate-500",
              ]}
            >
              {availableProducts.length > 0 ? "Añadir a upsell" : "No hay productos disponibles"}
            </button>
          </form>
        </Modal>
      </div>

      {
        upsellRows.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="Todavía no hay productos en upsell" description="Añade el primero con el botón de arriba." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Producto</th>
                  <th>Precio</th>
                  <th>Orden</th>
                  <th>Estado</th>
                  <th>Catálogo</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {upsellRows.map((item) => (
                  <tr>
                    <td>
                      <div class="flex items-center gap-3">
                        <div class="h-9 w-9 shrink-0 overflow-hidden rounded-xl border border-admin-border bg-white/5">
                          {item.image ? (
                            <img src={item.image} alt={item.name} class="h-full w-full object-cover" loading="lazy" />
                          ) : (
                            <div class="grid h-full w-full place-items-center text-[9px] font-semibold text-admin-faint">—</div>
                          )}
                        </div>
                        <a href={`/admin/catalogo/productos/${item.productId}`} class="truncate font-semibold text-white transition hover:text-sky-300">
                          {item.name}
                        </a>
                      </div>
                    </td>
                    <td class="text-admin-muted">{money(item.priceCents)}</td>
                    <td class="text-admin-muted">{item.sortOrder}</td>
                    <td><Badge tone={item.active ? "success" : "neutral"}>{item.active ? "Activo" : "Inactivo"}</Badge></td>
                    <td>{item.productActive ? <span class="text-admin-muted">OK</span> : <Badge tone="warning">Producto inactivo</Badge>}</td>
                    <td>
                      <div class="flex justify-end">
                        <Modal
                          id={`upsell-edit-${item.id}`}
                          title={item.name}
                          triggerLabel="Editar"
                          triggerClass="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]"
                        >
                          <form method="post" action="/api/admin/upsell/update" class="grid gap-4">
                            <input type="hidden" name="id" value={item.id} />

                            <label class="block">
                              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Orden</span>
                              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="number" name="sortOrder" min="0" step="1" value={item.sortOrder} required />
                            </label>

                            <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
                              <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="active" checked={item.active} />
                              Activo en el flujo de upsell
                            </label>

                            <button type="submit" class="mt-1 inline-flex min-h-10 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-2.5 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
                              Guardar
                            </button>
                          </form>

                          <form method="post" action="/api/admin/upsell/delete" class="mt-3 border-t border-admin-border pt-3">
                            <input type="hidden" name="id" value={item.id} />
                            <button type="submit" class="inline-flex min-h-9 items-center justify-center rounded-2xl border border-rose-400/20 bg-rose-400/10 px-4 py-2 text-sm font-semibold text-rose-300 transition hover:border-rose-400/30 hover:bg-rose-400/15">
                              Quitar de upsell
                            </button>
                          </form>
                        </Modal>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
