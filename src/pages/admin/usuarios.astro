---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import { userRoleTone } from "@/lib/admin/tones";
import {
  db,
  User,
  UserProfile,
  Order,
  LoyaltyTier,
  eq,
  inArray,
} from "astro:db";

type UserRole = "ADMIN" | "STAFF" | "CUSTOMER";
type PaymentStatus = "UNPAID" | "AUTH" | "PAID" | "FAILED" | "REFUNDED" | "PARTIALLY_REFUNDED";

type UserRow = {
  id: number;
  email: string;
  name: string | null;
  role: UserRole;
  active: boolean;
  createdAt: Date | string;
};

type ProfileRow = {
  id: number;
  userId: number;
  pointsBalance: number;
  tierId: number | null;
};

type TierRow = {
  id: number;
  name: string;
  minPoints: number;
};

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function formatDateOnly(value: Date | string | null) {
  if (!value) return "—";
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", { dateStyle: "medium", timeZone: "Europe/Madrid" }).format(date);
}

function isPaid(status: PaymentStatus) {
  return status === "PAID" || status === "PARTIALLY_REFUNDED";
}

function roleLabel(role: UserRole) {
  return role === "ADMIN" ? "Admin" : role === "STAFF" ? "Staff" : "Cliente";
}

const url = new URL(Astro.request.url);
const q = (url.searchParams.get("q") ?? "").trim().toLowerCase();
const roleFilter = (url.searchParams.get("role") ?? "").trim().toUpperCase();
const activeFilter = (url.searchParams.get("active") ?? "").trim().toLowerCase();
const tierFilterRaw = (url.searchParams.get("tierId") ?? "").trim();
const ordersFilter = (url.searchParams.get("orders") ?? "").trim().toLowerCase();

const users = (await db
  .select({ id: User.id, email: User.email, name: User.name, role: User.role, active: User.active, createdAt: User.createdAt })
  .from(User)) as UserRow[];

const sortedUsers = [...users].sort((a, b) => {
  if (a.role !== b.role) {
    const order: Record<UserRole, number> = { ADMIN: 1, STAFF: 2, CUSTOMER: 3 };
    return order[a.role] - order[b.role];
  }
  return (a.name ?? a.email).toLowerCase().localeCompare((b.name ?? b.email).toLowerCase(), "es");
});

const userIds = sortedUsers.map((user) => user.id);

const profiles = userIds.length
  ? ((await db
      .select({ id: UserProfile.id, userId: UserProfile.userId, pointsBalance: UserProfile.pointsBalance, tierId: UserProfile.tierId })
      .from(UserProfile)
      .where(inArray(UserProfile.userId, userIds))) as ProfileRow[])
  : [];

const tiers = (await db
  .select({ id: LoyaltyTier.id, name: LoyaltyTier.name, minPoints: LoyaltyTier.minPoints })
  .from(LoyaltyTier)) as TierRow[];

const profileByUserId = new Map<number, ProfileRow>();
for (const profile of profiles) profileByUserId.set(profile.userId, profile);

const tierById = new Map<number, TierRow>();
for (const tier of tiers) tierById.set(tier.id, tier);

const orders = userIds.length
  ? await db
      .select({ userId: Order.userId, totalCents: Order.totalCents, paymentStatus: Order.paymentStatus, createdAt: Order.createdAt })
      .from(Order)
      .where(inArray(Order.userId, userIds))
  : [];

const orderCountByUserId = new Map<number, number>();
const paidOrderCountByUserId = new Map<number, number>();
const totalSpentByUserId = new Map<number, number>();
const lastOrderAtByUserId = new Map<number, Date | string>();

for (const order of orders) {
  if (typeof order.userId !== "number") continue;
  orderCountByUserId.set(order.userId, (orderCountByUserId.get(order.userId) ?? 0) + 1);

  const previousLast = lastOrderAtByUserId.get(order.userId);
  if (!previousLast || new Date(order.createdAt).getTime() > new Date(previousLast).getTime()) {
    lastOrderAtByUserId.set(order.userId, order.createdAt);
  }

  if (isPaid(order.paymentStatus as PaymentStatus)) {
    paidOrderCountByUserId.set(order.userId, (paidOrderCountByUserId.get(order.userId) ?? 0) + 1);
    totalSpentByUserId.set(order.userId, (totalSpentByUserId.get(order.userId) ?? 0) + order.totalCents);
  }
}

const summaries = sortedUsers.map((user) => {
  const profile = profileByUserId.get(user.id) ?? null;
  const tier = profile?.tierId ? (tierById.get(profile.tierId) ?? null) : null;
  return {
    user,
    profile,
    tier,
    orderCount: orderCountByUserId.get(user.id) ?? 0,
    paidOrderCount: paidOrderCountByUserId.get(user.id) ?? 0,
    totalSpentCents: totalSpentByUserId.get(user.id) ?? 0,
    lastOrderAt: lastOrderAtByUserId.get(user.id) ?? null,
  };
});

const tierFilter = Number(tierFilterRaw);
const validRoleFilter = roleFilter === "ADMIN" || roleFilter === "STAFF" || roleFilter === "CUSTOMER";
const validActiveFilter = activeFilter === "active" || activeFilter === "inactive";
const validOrdersFilter = ordersFilter === "with-orders" || ordersFilter === "without-orders" || ordersFilter === "paid-only";

const filteredSummaries = summaries.filter((summary) => {
  if (q) {
    const haystack = [summary.user.name ?? "", summary.user.email, summary.user.role, summary.tier?.name ?? ""].join(" ").toLowerCase();
    if (!haystack.includes(q)) return false;
  }
  if (validRoleFilter && summary.user.role !== roleFilter) return false;
  if (validActiveFilter) {
    if (activeFilter === "active" && !summary.user.active) return false;
    if (activeFilter === "inactive" && summary.user.active) return false;
  }
  if (Number.isFinite(tierFilter) && tierFilterRaw) {
    const currentTierId = summary.profile?.tierId ?? null;
    if (currentTierId !== tierFilter) return false;
  }
  if (validOrdersFilter) {
    if (ordersFilter === "with-orders" && summary.orderCount <= 0) return false;
    if (ordersFilter === "without-orders" && summary.orderCount > 0) return false;
    if (ordersFilter === "paid-only" && summary.paidOrderCount <= 0) return false;
  }
  return true;
});

const totalUsers = summaries.length;
const customerCount = summaries.filter((s) => s.user.role === "CUSTOMER").length;
const activeCustomerCount = summaries.filter((s) => s.user.role === "CUSTOMER" && s.user.active).length;
const loyaltyUsers = summaries.filter((s) => s.user.role === "CUSTOMER" && s.profile).length;

const saved = url.searchParams.get("saved") ?? "";
const errorParam = url.searchParams.get("error") ?? "";

const successMessage =
  saved === "user" ? "Usuario actualizado correctamente." : saved === "points" ? "Puntos ajustados correctamente." : saved === "bonus" ? "Bonus aplicado correctamente." : "";

const errorMessage =
  errorParam === "missing-email" ? "El email es obligatorio." :
  errorParam === "invalid-email" ? "El email no es válido." :
  errorParam === "invalid-role" ? "El rol no es válido." :
  errorParam === "invalid-birthday" ? "La fecha de nacimiento no es válida." :
  errorParam === "duplicate-email" ? "Ya existe otro usuario con ese email." :
  errorParam === "points-required" ? "Indica una cantidad de puntos válida." :
  errorParam === "points-zero" ? "El ajuste no puede dejar el saldo igual." :
  errorParam === "bonus-required" ? "Indica una cantidad de bonus válida." :
  errorParam === "bonus-negative" ? "El bonus debe ser mayor que cero." :
  errorParam === "not-found" ? "El usuario ya no existe." :
  errorParam === "invalid-user" ? "Usuario no válido." :
  "";
---

<AdminLayout title="Usuarios · Admin · Arcadia" heading="Usuarios" description="Clientes y staff con su gasto, pedidos, puntos y tier.">
  <div class="space-y-6">
    {successMessage ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">{successMessage}</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{errorMessage}</section> : null}

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard icon="users" label="Usuarios totales" value={String(totalUsers)} helper="Todos los roles" />
      <StatCard icon="users" label="Clientes" value={String(customerCount)} helper={`${activeCustomerCount} activos`} />
    </section>
    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard label="En programa loyalty" value={String(loyaltyUsers)} helper="Clientes con perfil de puntos" />
      <StatCard label="Sin cuenta de puntos" value={String(customerCount - loyaltyUsers)} helper="Clientes sin perfil todavía" />
    </section>

    <Card padded={false}>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-admin-border px-5 py-4 lg:px-6">
        <form method="get" class="flex flex-1 flex-wrap items-center gap-2">
          <input
            class="min-w-[220px] flex-1 rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white placeholder:text-slate-500 focus:border-sky-400/40 focus:outline-none"
            type="search"
            name="q"
            value={q}
            placeholder="Buscar nombre, email o tier..."
          />
          <select name="role" class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none">
            <option value="">Rol</option>
            <option value="CUSTOMER" selected={roleFilter === "CUSTOMER"}>Clientes</option>
            <option value="STAFF" selected={roleFilter === "STAFF"}>Staff</option>
            <option value="ADMIN" selected={roleFilter === "ADMIN"}>Admin</option>
          </select>
          <select name="active" class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none">
            <option value="">Estado</option>
            <option value="active" selected={activeFilter === "active"}>Activos</option>
            <option value="inactive" selected={activeFilter === "inactive"}>Inactivos</option>
          </select>
          <select name="tierId" class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none">
            <option value="">Tier</option>
            {tiers.map((tier) => (
              <option value={tier.id} selected={tierFilterRaw === String(tier.id)}>{tier.name}</option>
            ))}
          </select>
          <select name="orders" class="rounded-2xl border border-admin-border bg-white/[0.03] px-3 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none">
            <option value="">Pedidos</option>
            <option value="with-orders" selected={ordersFilter === "with-orders"}>Con pedidos</option>
            <option value="without-orders" selected={ordersFilter === "without-orders"}>Sin pedidos</option>
            <option value="paid-only" selected={ordersFilter === "paid-only"}>Con pedidos pagados</option>
          </select>
          <button type="submit" class="inline-flex min-h-9 items-center justify-center rounded-2xl border border-admin-border bg-white/[0.03] px-3.5 py-2 text-sm font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
            Filtrar
          </button>
        </form>
      </div>

      {
        filteredSummaries.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="No hay usuarios para ese filtro" description="Ajusta la búsqueda o los filtros." />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Usuario</th>
                  <th>Rol</th>
                  <th>Estado</th>
                  <th>Tier</th>
                  <th>Puntos</th>
                  <th>Pedidos</th>
                  <th>Gasto total</th>
                  <th>Última compra</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {filteredSummaries.map((summary) => (
                  <tr>
                    <td>
                      <div class="min-w-0">
                        <div class="truncate font-semibold text-white">{summary.user.name ?? summary.user.email}</div>
                        <div class="truncate text-xs text-admin-muted">{summary.user.email}</div>
                      </div>
                    </td>
                    <td><Badge tone={userRoleTone(summary.user.role)}>{roleLabel(summary.user.role)}</Badge></td>
                    <td><Badge tone={summary.user.active ? "success" : "danger"}>{summary.user.active ? "Activo" : "Inactivo"}</Badge></td>
                    <td class="text-admin-muted">{summary.tier?.name ?? "—"}</td>
                    <td class="text-admin-muted">{summary.profile ? summary.profile.pointsBalance : "—"}</td>
                    <td class="text-admin-muted">{summary.orderCount}</td>
                    <td class="text-admin-muted">{money(summary.totalSpentCents)}</td>
                    <td class="text-admin-muted">{formatDateOnly(summary.lastOrderAt)}</td>
                    <td>
                      <div class="flex justify-end">
                        <a href={`/admin/usuarios/${summary.user.id}`} class="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
                          Ver ficha
                        </a>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
