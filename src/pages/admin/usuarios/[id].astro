---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Card from "@/components/admin/ui/Card.astro";
import StatCard from "@/components/admin/ui/StatCard.astro";
import Badge from "@/components/admin/ui/Badge.astro";
import EmptyState from "@/components/admin/ui/EmptyState.astro";
import Modal from "@/components/admin/ui/Modal.astro";
import { userRoleTone, orderStatusTone, paymentStatusTone, ledgerReasonTone } from "@/lib/admin/tones";
import { buildLoyaltyProgress, type LoyaltyTierLite } from "@/server/loyalty/progress";
import {
  db,
  User,
  UserProfile,
  Address,
  Order,
  LoyaltyTier,
  LoyaltyLedger,
  eq,
} from "astro:db";

type UserRole = "ADMIN" | "STAFF" | "CUSTOMER";

function money(cents: number) {
  return `${(Number(cents ?? 0) / 100).toFixed(2)} €`;
}

function formatDateTime(value: Date | string | null) {
  if (!value) return "—";
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", { dateStyle: "short", timeStyle: "short", timeZone: "Europe/Madrid" }).format(date);
}

function formatDateOnly(value: Date | string | null) {
  if (!value) return "—";
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat("es-ES", { dateStyle: "medium", timeZone: "Europe/Madrid" }).format(date);
}

function isPaid(status: string) {
  return status === "PAID" || status === "PARTIALLY_REFUNDED";
}

function roleLabel(role: UserRole) {
  return role === "ADMIN" ? "Admin" : role === "STAFF" ? "Staff" : "Cliente";
}

function reasonLabel(reason: string) {
  if (reason === "ORDER_PAID") return "Pedido pagado";
  if (reason === "ORDER_REFUND") return "Reembolso";
  if (reason === "PROMO_BONUS") return "Bonus promocional";
  return "Ajuste manual";
}

function safeMetaNote(meta: unknown) {
  if (!meta || typeof meta !== "object") return null;
  const note = (meta as Record<string, unknown>).note;
  if (typeof note !== "string") return null;
  const trimmed = note.trim();
  return trimmed || null;
}

const userId = Number(Astro.params.id);
if (!Number.isFinite(userId)) {
  return new Response("Usuario no encontrado", { status: 404 });
}

const [user] = await db
  .select({ id: User.id, email: User.email, name: User.name, role: User.role, active: User.active, createdAt: User.createdAt })
  .from(User)
  .where(eq(User.id, userId))
  .limit(1);

if (!user) {
  return new Response("Usuario no encontrado", { status: 404 });
}

const [profile] = await db
  .select({ id: UserProfile.id, userId: UserProfile.userId, phone: UserProfile.phone, birthday: UserProfile.birthday, pointsBalance: UserProfile.pointsBalance, tierId: UserProfile.tierId })
  .from(UserProfile)
  .where(eq(UserProfile.userId, userId))
  .limit(1);

const tiers = (await db
  .select({ id: LoyaltyTier.id, name: LoyaltyTier.name, minPoints: LoyaltyTier.minPoints, active: LoyaltyTier.active, sortOrder: LoyaltyTier.sortOrder })
  .from(LoyaltyTier)) as LoyaltyTierLite[];

const activeTiers = tiers.filter((tier) => tier.active);
const loyaltyProgress = buildLoyaltyProgress(profile?.pointsBalance ?? 0, activeTiers);

const addresses = await db
  .select({ id: Address.id, label: Address.label, contactName: Address.contactName, phone: Address.phone, line1: Address.line1, line2: Address.line2, city: Address.city, postalCode: Address.postalCode, isDefault: Address.isDefault, createdAt: Address.createdAt })
  .from(Address)
  .where(eq(Address.userId, userId));

const sortedAddresses = [...addresses].sort((a, b) => Number(b.isDefault) - Number(a.isDefault));

const orders = (
  await db
    .select({ id: Order.id, publicId: Order.publicId, type: Order.type, status: Order.status, paymentStatus: Order.paymentStatus, totalCents: Order.totalCents, createdAt: Order.createdAt })
    .from(Order)
    .where(eq(Order.userId, userId))
).sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

const recentOrders = orders.slice(0, 10);
const orderCount = orders.length;
const paidOrders = orders.filter((order) => isPaid(order.paymentStatus));
const totalSpentCents = paidOrders.reduce((sum, order) => sum + order.totalCents, 0);
const lastOrderAt = orders[0]?.createdAt ?? null;

const ledger = (
  await db
    .select({ id: LoyaltyLedger.id, orderId: LoyaltyLedger.orderId, pointsDelta: LoyaltyLedger.pointsDelta, reason: LoyaltyLedger.reason, meta: LoyaltyLedger.meta, createdAt: LoyaltyLedger.createdAt })
    .from(LoyaltyLedger)
    .where(eq(LoyaltyLedger.userId, userId))
).sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

const recentLedger = ledger.slice(0, 16);

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") ?? "";
const errorParam = url.searchParams.get("error") ?? "";

const successMessage =
  saved === "user" ? "Usuario actualizado correctamente." : saved === "points" ? "Puntos ajustados correctamente." : saved === "bonus" ? "Bonus aplicado correctamente." : "";

const errorMessage =
  errorParam === "missing-email" ? "El email es obligatorio." :
  errorParam === "invalid-email" ? "El email no es válido." :
  errorParam === "invalid-role" ? "El rol no es válido." :
  errorParam === "forbidden-role" ? "Solo un administrador puede cambiar el rol o el acceso de una cuenta." :
  errorParam === "self-lockout" ? "No puedes quitarte a ti mismo el rol de administrador ni desactivar tu cuenta." :
  errorParam === "last-admin" ? "Debe quedar al menos un administrador activo." :
  errorParam === "invalid-birthday" ? "La fecha de nacimiento no es válida." :
  errorParam === "duplicate-email" ? "Ya existe otro usuario con ese email." :
  errorParam === "points-required" ? "Indica una cantidad de puntos válida." :
  errorParam === "points-zero" ? "El ajuste no puede dejar el saldo igual." :
  errorParam === "bonus-required" ? "Indica una cantidad de bonus válida." :
  errorParam === "bonus-negative" ? "El bonus debe ser mayor que cero." :
  "";
---

<AdminLayout title={`${user.name ?? user.email} · Usuarios · Admin · Arcadia`} heading={user.name ?? user.email} description="Perfil, loyalty, direcciones, pedidos y ledger de puntos." back={{ href: "/admin/usuarios", label: "Clientes" }}>
  <div class="space-y-6">
    {successMessage ? <section class="rounded-admin-lg border border-emerald-400/20 bg-emerald-400/10 px-5 py-3 text-sm text-emerald-200">{successMessage}</section> : null}
    {errorMessage ? <section class="rounded-admin-lg border border-rose-400/20 bg-rose-400/10 px-5 py-3 text-sm text-rose-200">{errorMessage}</section> : null}

    <div class="flex flex-wrap items-center gap-2.5">
      <Badge tone={user.active ? "success" : "danger"}>{user.active ? "Activo" : "Inactivo"}</Badge>
      {loyaltyProgress.currentTier ? <Badge tone="cyan">{loyaltyProgress.currentTier.name}</Badge> : null}
      <span class="text-xs text-admin-muted">Alta: {formatDateOnly(user.createdAt)}</span>
    </div>

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <StatCard label="Pedidos" value={String(orderCount)} helper={`${paidOrders.length} pagados`} />
      <StatCard label="Gasto total" value={money(totalSpentCents)} helper={`Última compra: ${formatDateOnly(lastOrderAt)}`} />
    </section>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
      <Card>
        <div class="admin-eyebrow">Perfil</div>
        <h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-white">Datos del usuario</h2>

        <form method="post" action="/api/admin/users" class="mt-5 grid gap-4">
          <input type="hidden" name="intent" value="update-user" />
          <input type="hidden" name="userId" value={user.id} />

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Nombre</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="name" value={user.name ?? ""} />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Email</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="email" name="email" value={user.email} required />
            </label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Teléfono</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="phone" value={profile?.phone ?? ""} />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Nacimiento</span>
              <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="date" name="birthday" value={profile?.birthday ?? ""} />
            </label>
          </div>

          <!--
            Ya no hay selector de rol: el acceso al panel dejó de salir de
            `User.role` y se gestiona en Equipo, con su propia tabla. Dejar aquí
            un desplegable que no concede nada sólo llevaría a engaño.
          -->
          <label class="inline-flex items-center gap-2.5 text-sm text-slate-300">
            <input class="h-4 w-4 rounded border-white/20 bg-slate-950 text-sky-400" type="checkbox" name="active" checked={user.active} />
            Cuenta activa
          </label>

          <button type="submit" class="mt-1 inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
            Guardar cambios
          </button>
        </form>
      </Card>

      <Card>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <div class="admin-eyebrow">Loyalty</div>
            <h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-white">Puntos y tier</h2>
          </div>
          <div class="flex flex-wrap gap-2">
            <Modal id="adjust-points" title="Ajuste manual de puntos" description="Suma o resta puntos con un motivo. El saldo nunca baja de cero." triggerLabel="Ajustar puntos" triggerClass="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
              <form method="post" action="/api/admin/users" class="grid gap-4">
                <input type="hidden" name="intent" value="adjust-points" />
                <input type="hidden" name="userId" value={user.id} />
                <label class="block">
                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Puntos (+/-)</span>
                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="number" name="pointsDelta" step="1" placeholder="-50" required />
                </label>
                <label class="block">
                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Motivo (opcional)</span>
                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="note" placeholder="Compensación por incidencia" />
                </label>
                <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm font-semibold text-sky-100 transition hover:border-sky-400/30 hover:bg-sky-400/15">
                  Aplicar ajuste
                </button>
              </form>
            </Modal>
            <Modal id="promo-bonus" title="Bonus promocional" description="Puntos extra positivos, quedan registrados en el ledger." triggerLabel="Dar bonus" triggerClass="rounded-xl border border-admin-border bg-white/[0.03] px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-white/15 hover:bg-white/[0.06]">
              <form method="post" action="/api/admin/users" class="grid gap-4">
                <input type="hidden" name="intent" value="promo-bonus" />
                <input type="hidden" name="userId" value={user.id} />
                <label class="block">
                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Puntos de bonus</span>
                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="number" name="bonusPoints" min="1" step="1" placeholder="100" required />
                </label>
                <label class="block">
                  <span class="mb-1.5 block text-[11px] font-semibold uppercase tracking-[0.16em] text-admin-muted">Motivo (opcional)</span>
                  <input class="w-full rounded-2xl border border-admin-border bg-white/[0.03] px-4 py-2.5 text-sm text-white focus:border-sky-400/40 focus:outline-none" type="text" name="note" placeholder="Campaña de cumpleaños" />
                </label>
                <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-2xl border border-emerald-400/20 bg-emerald-400/10 px-4 py-3 text-sm font-semibold text-emerald-100 transition hover:border-emerald-400/30 hover:bg-emerald-400/15">
                  Aplicar bonus
                </button>
              </form>
            </Modal>
          </div>
        </div>

        <div class="mt-6 flex items-end justify-between gap-4">
          <div>
            <div class="text-sm font-medium text-admin-muted">Puntos</div>
            <div class="mt-1 text-[2rem] font-semibold leading-none tracking-[-0.02em] text-white">{loyaltyProgress.pointsBalance}</div>
          </div>
          {loyaltyProgress.nextTier ? <div class="text-right text-xs text-admin-muted">Faltan {loyaltyProgress.pointsToNext} pts<br />para {loyaltyProgress.nextTier.name}</div> : <div class="text-right text-xs text-admin-muted">Tier máximo</div>}
        </div>

        <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/[0.06]">
          <div class="h-full rounded-full bg-sky-400" style={`width: ${loyaltyProgress.progressPercent}%`} />
        </div>

        <div class="mt-6 border-t border-admin-border pt-5">
          <div class="text-xs font-semibold uppercase tracking-[0.16em] text-admin-muted">Movimientos recientes</div>
          {
            recentLedger.length === 0 ? (
              <p class="mt-3 text-sm text-admin-muted">Sin movimientos todavía.</p>
            ) : (
              <ul class="mt-3 space-y-2.5">
                {recentLedger.slice(0, 6).map((entry) => (
                  <li class="flex items-center justify-between gap-3 text-sm">
                    <div class="min-w-0">
                      <Badge tone={ledgerReasonTone(entry.reason)}>{reasonLabel(entry.reason)}</Badge>
                      {safeMetaNote(entry.meta) ? <span class="ml-2 text-xs text-admin-muted">{safeMetaNote(entry.meta)}</span> : null}
                    </div>
                    <span class:list={["shrink-0 font-semibold", entry.pointsDelta >= 0 ? "text-emerald-300" : "text-rose-300"]}>
                      {entry.pointsDelta >= 0 ? "+" : ""}{entry.pointsDelta}
                    </span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </Card>
    </div>

    <Card padded={false}>
      <div class="border-b border-admin-border px-5 py-4 lg:px-6">
        <h2 class="text-base font-semibold text-white">Direcciones</h2>
      </div>
      {
        sortedAddresses.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="Sin direcciones guardadas" />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Etiqueta</th>
                  <th>Contacto</th>
                  <th>Dirección</th>
                  <th>Ciudad</th>
                  <th>Por defecto</th>
                </tr>
              </thead>
              <tbody>
                {sortedAddresses.map((address) => (
                  <tr>
                    <td class="font-semibold text-white">{address.label ?? "—"}</td>
                    <td class="text-admin-muted">{address.contactName} · {address.phone}</td>
                    <td class="text-admin-muted">{address.line1}{address.line2 ? `, ${address.line2}` : ""}</td>
                    <td class="text-admin-muted">{address.city} ({address.postalCode})</td>
                    <td>{address.isDefault ? <Badge tone="success">Por defecto</Badge> : <span class="text-admin-muted">—</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>

    <Card padded={false}>
      <div class="border-b border-admin-border px-5 py-4 lg:px-6">
        <h2 class="text-base font-semibold text-white">Pedidos recientes</h2>
      </div>
      {
        recentOrders.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="Todavía no ha hecho ningún pedido" />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Pedido</th>
                  <th>Canal</th>
                  <th>Estado</th>
                  <th>Pago</th>
                  <th>Total</th>
                  <th>Fecha</th>
                </tr>
              </thead>
              <tbody>
                {recentOrders.map((order) => (
                  <tr>
                    <td>
                      <a href={`/admin/pedidos/${order.publicId}`} class="font-semibold text-white transition hover:text-sky-300">#{order.publicId}</a>
                    </td>
                    <td class="text-admin-muted">{order.type === "DELIVERY" ? "Delivery" : "Recogida"}</td>
                    <td><Badge tone={orderStatusTone(order.status)}>{order.status}</Badge></td>
                    <td><Badge tone={paymentStatusTone(order.paymentStatus)}>{order.paymentStatus}</Badge></td>
                    <td class="text-admin-muted">{money(order.totalCents)}</td>
                    <td class="text-admin-muted">{formatDateTime(order.createdAt)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>

    <Card padded={false}>
      <div class="border-b border-admin-border px-5 py-4 lg:px-6">
        <h2 class="text-base font-semibold text-white">Ledger de loyalty</h2>
      </div>
      {
        recentLedger.length === 0 ? (
          <div class="px-6 py-14">
            <EmptyState title="Sin movimientos de puntos" />
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Motivo</th>
                  <th>Puntos</th>
                  <th>Nota</th>
                  <th>Fecha</th>
                </tr>
              </thead>
              <tbody>
                {recentLedger.map((entry) => (
                  <tr>
                    <td><Badge tone={ledgerReasonTone(entry.reason)}>{reasonLabel(entry.reason)}</Badge></td>
                    <td class:list={["font-semibold", entry.pointsDelta >= 0 ? "text-emerald-300" : "text-rose-300"]}>
                      {entry.pointsDelta >= 0 ? "+" : ""}{entry.pointsDelta}
                    </td>
                    <td class="text-admin-muted">{safeMetaNote(entry.meta) ?? "—"}</td>
                    <td class="text-admin-muted">{formatDateTime(entry.createdAt)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </Card>
  </div>
</AdminLayout>
