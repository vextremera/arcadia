---
import SiteLayout from "@/layouts/SiteLayout.astro";
import {
  db,
  Category,
  Product,
  ProductAllergen,
  Allergen,
  ProductIngredient,
  Ingredient,
  eq,
  inArray,
  asc,
  and,
} from "astro:db";
import { DEFAULT_LANG } from "@/lib/i18n";
import { getPublicCopy } from "@/lib/publicCopy";
import { formatEuros as money } from "@/lib/money";
import { getCatalogFlags } from "@/server/catalog/settings";

type RowCategory = {
  id: number;
  name: string;
  slug: string;
  sortOrder: number;
};

type RowProduct = {
  id: number;
  categoryId: number;
  name: string;
  description: string | null;
  details: string | null;
  priceCents: number;
};

type RowAllergen = {
  productId: number;
  slug: string;
  name: string;
  iconUrl: string | null;
};

const catalogFlags = await getCatalogFlags();

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = getPublicCopy(lang).pages.carta;


function allergenIconPath(allergen: { slug: string; iconUrl: string | null }) {
  return allergen.iconUrl ?? `/images/allergens/${allergen.slug}.webp`;
}

const categories = (await db
  .select({
    id: Category.id,
    name: Category.name,
    slug: Category.slug,
    sortOrder: Category.sortOrder,
  })
  .from(Category)
  .where(eq(Category.active, true))
  .orderBy(Category.sortOrder)) as RowCategory[];

const products = (await db
  .select({
    id: Product.id,
    categoryId: Product.categoryId,
    name: Product.name,
    description: Product.description,
    details: Product.details,
    priceCents: Product.priceCents,
  })
  .from(Product)
  .where(eq(Product.active, true))
  .orderBy(Product.name)) as RowProduct[];

const productIds = products.map((product) => product.id);

const allergenRows = productIds.length
  ? ((await db
      .select({
        productId: ProductAllergen.productId,
        slug: Allergen.slug,
        name: Allergen.name,
        iconUrl: Allergen.iconUrl,
      })
      .from(ProductAllergen)
      .innerJoin(Allergen, eq(ProductAllergen.allergenId, Allergen.id))
      .where(
        and(
          inArray(ProductAllergen.productId, productIds),
          eq(Allergen.active, true),
        ),
      )
      .orderBy(
        asc(ProductAllergen.productId),
        asc(Allergen.sortOrder),
        asc(Allergen.name),
      )) as RowAllergen[])
  : [];

// Los ingredientes no se muestran, pero entran en el índice de búsqueda: mucha
// gente busca "queso" o "champiñones", no el nombre comercial del plato.
const ingredientRows = productIds.length
  ? await db
      .select({ productId: ProductIngredient.productId, name: Ingredient.name })
      .from(ProductIngredient)
      .innerJoin(Ingredient, eq(ProductIngredient.ingredientId, Ingredient.id))
      .where(
        and(
          inArray(ProductIngredient.productId, productIds),
          eq(ProductIngredient.defaultIncluded, true),
          eq(Ingredient.active, true),
        ),
      )
  : [];

const ingredientsByProduct = new Map<number, string[]>();
for (const row of ingredientRows) {
  const list = ingredientsByProduct.get(row.productId) ?? [];
  list.push(row.name);
  ingredientsByProduct.set(row.productId, list);
}

const allergensByProduct = new Map<
  number,
  Array<{ slug: string; name: string; iconUrl: string | null }>
>();
for (const allergen of allergenRows) {
  const list = allergensByProduct.get(allergen.productId) ?? [];
  list.push({
    slug: allergen.slug,
    name: allergen.name,
    iconUrl: allergen.iconUrl,
  });
  allergensByProduct.set(allergen.productId, list);
}

const productsByCategory = new Map<
  number,
  Array<
    RowProduct & {
      allergens: Array<{ slug: string; name: string; iconUrl: string | null }>;
    }
  >
>();
for (const product of products) {
  const list = productsByCategory.get(product.categoryId) ?? [];
  list.push({
    ...product,
    // Con el ajuste desactivado la lista va vacía desde el servidor, así que
    // los iconos no llegan ni al HTML.
    allergens: catalogFlags.showAllergens ? (allergensByProduct.get(product.id) ?? []) : [],
  });
  productsByCategory.set(product.categoryId, list);
}

const NUMERIC_ORDER_CATEGORIES = new Set([
  "platos-combinados",
  "platos-infantiles",
]);

function leadingNumber(name: string): number | null {
  const match = name.trim().match(/^(\d+)\s*(?:[.: -]|-)/);
  return match ? Number(match[1]) : null;
}

function sortProductsForCategory(
  categorySlug: string,
  items: Array<
    RowProduct & {
      allergens: Array<{ slug: string; name: string; iconUrl: string | null }>;
    }
  >,
) {
  if (!NUMERIC_ORDER_CATEGORIES.has(categorySlug)) return items;

  return [...items].sort((a, b) => {
    const aNumber = leadingNumber(a.name);
    const bNumber = leadingNumber(b.name);

    if (aNumber != null && bNumber != null) return aNumber - bNumber;
    if (aNumber != null) return -1;
    if (bNumber != null) return 1;

    return a.name.localeCompare(b.name, "es");
  });
}

const menu = categories
  .map((category) => ({
    ...category,
    products: sortProductsForCategory(
      category.slug,
      productsByCategory.get(category.id) ?? [],
    ),
  }))
  .filter((category) => category.products.length > 0);

/** Sin acentos y en minúsculas: "champinones" debe encontrar "champiñones". */
function normalize(value: string) {
  return value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "");
}

/** Texto contra el que busca el filtro: nombre + descripción + ingredientes. */
function searchIndex(product: {
  id: number;
  name: string;
  description: string | null;
  details: string | null;
}) {
  return normalize(
    [
      product.name,
      product.details ?? product.description ?? "",
      (ingredientsByProduct.get(product.id) ?? []).join(" "),
    ].join(" "),
  );
}

// Alérgenos presentes en la carta, para ofrecer sólo los que filtran algo.
const allergenFilters = !catalogFlags.showAllergens ? [] : (() => {
  const bySlug = new Map<string, { slug: string; name: string; iconUrl: string | null }>();
  for (const row of allergenRows) {
    if (!bySlug.has(row.slug)) {
      bySlug.set(row.slug, { slug: row.slug, name: row.name, iconUrl: row.iconUrl });
    }
  }
  return [...bySlug.values()].sort((a, b) => a.name.localeCompare(b.name, "es"));
})();

const heroStyle = {
  backgroundImage:
    "linear-gradient(90deg, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.45) 55%, rgba(0,0,0,0.15) 100%), url('/images/general/section-bg.png')",
  backgroundSize: "cover",
  backgroundPosition: "center",
};
---

<SiteLayout title={`${t.title} · Arcadia`} fullWidth>
  <div class="w-full" id="top">
    <section
      class="relative w-full overflow-hidden bg-zinc-900 rounded-t-4xl sm:rounded-t-[50px]"
      style={heroStyle}
    >
      <div class="h-56 sm:h-150"></div>
      <div class="absolute inset-0">
        <div
          class="absolute inset-x-0 bottom-0 h-6 bg-bg z-20 rounded-t-3xl sm:h-8 sm:rounded-t-[40px]"
        >
        </div>
        <div
          class="flex h-full w-full items-center justify-center px-4 pb-12 pt-8 text-center sm:px-10 sm:pb-18 sm:pt-0 sm:mt-10"
        >
          <div class="text-white">
            <div
              class="text-3xl sm:text-5xl font-black tracking-widest sigmar-regular"
            >
              {t.heroTitle}
            </div>
            <div class="mt-1 text-sm sm:text-[20px] text-white/80">
              {t.heroSubtitle}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Navegación entre familias. Son 15 categorías y 157 productos: sin un
        índice permanente, llegar a Bebidas obliga a recorrer casi toda la
        página. En escritorio va como columna fija; en móvil, como barra de
        chips también fija. Todo con anclas y position:sticky, sin JavaScript. */}
    {
      menu.length > 0 ? (
        <div
          class="sticky top-16 z-30 border-b border-zinc-200/80 bg-bg/95 px-4 py-3 backdrop-blur lg:top-[4.5rem] lg:px-10"
          data-carta-bar
        >
          <div class="mx-auto w-full max-w-6xl 2xl:max-w-7xl">
            <div class="flex items-center gap-2">
              <div class="relative min-w-0 flex-1">
                <input
                  type="search"
                  data-carta-search
                  placeholder="Buscar plato o ingrediente…"
                  aria-label="Buscar en la carta"
                  class="min-h-11 w-full rounded-2xl border border-zinc-300 bg-white py-2.5 pl-10 pr-3 text-sm outline-none transition focus:border-zinc-500"
                />
                <svg
                  class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-400"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m20 20-3.5-3.5"></path>
                </svg>
              </div>

              {
                allergenFilters.length > 0 ? (
                  <button
                    type="button"
                    data-carta-allergens-toggle
                    aria-expanded="false"
                    class="inline-flex min-h-11 shrink-0 items-center rounded-2xl border border-zinc-300 bg-white px-3.5 text-sm font-semibold text-zinc-700 transition hover:border-zinc-500"
                  >
                    Alérgenos<span data-carta-allergens-count></span>
                  </button>
                ) : null
              }
            </div>

            {
              allergenFilters.length > 0 ? (
                <div class="mt-3 hidden rounded-2xl border border-zinc-200 bg-white p-3" data-carta-allergens-panel>
                  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-zinc-500">
                    Ocultar platos que contengan
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {allergenFilters.map((allergen) => (
                      <button
                        type="button"
                        data-carta-allergen={allergen.slug}
                        aria-pressed="false"
                        class="inline-flex min-h-10 items-center gap-1.5 rounded-full border border-zinc-300 bg-white px-3.5 text-xs font-semibold text-zinc-700 transition hover:border-zinc-500 aria-pressed:border-zinc-900 aria-pressed:bg-zinc-900 aria-pressed:text-white"
                      >
                        <img src={allergenIconPath(allergen)} alt="" class="h-4 w-4 object-contain" loading="lazy" />
                        {allergen.name}
                      </button>
                    ))}
                  </div>
                </div>
              ) : null
            }

            {/* Índice de familias: se oculta al filtrar, porque entonces no
                representa lo que se está viendo. */}
            <nav
              aria-label="Familias de la carta"
              class="mt-3 flex gap-2 overflow-x-auto [scrollbar-width:none] lg:hidden [&::-webkit-scrollbar]:hidden"
              data-carta-chips
            >
              {menu.map((category) => (
                <a
                  href={`#cat-${category.slug}`}
                  class="inline-flex min-h-10 shrink-0 items-center rounded-full border border-zinc-300 bg-white px-4 text-xs font-semibold text-zinc-700 transition hover:border-zinc-500"
                >
                  {category.name}
                </a>
              ))}
            </nav>

            <p class="mt-3 hidden text-xs font-semibold text-zinc-600" data-carta-count></p>
          </div>
        </div>
      ) : null
    }

    <div class="w-full px-4 py-8 sm:px-10 sm:py-10">
      <div class="mx-auto w-full max-w-6xl 2xl:max-w-7xl">
        {
          menu.length === 0 ? (
            <div class="text-sm text-zinc-600">{t.noProducts}</div>
          ) : (
            <div class="lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[15rem_minmax(0,1fr)]">
              <aside class="hidden lg:block">
                {/* El header del sitio es sticky y mide 72px en escritorio:
                    sin descontarlo, el índice se metía debajo. */}
                <nav
                  aria-label="Familias de la carta"
                  class="sticky top-[5.5rem] max-h-[calc(100vh-7rem)] overflow-y-auto"
                >
                  <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">
                    Familias
                  </p>
                  <ul class="space-y-0.5">
                    {menu.map((category) => (
                      <li>
                        <a
                          href={`#cat-${category.slug}`}
                          class="flex min-h-10 items-center rounded-xl px-3 py-2 text-sm font-medium text-zinc-700 transition hover:bg-white hover:text-zinc-900"
                        >
                          {category.name}
                          <span class="ml-1.5 text-xs text-zinc-400">{category.products.length}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </aside>

              {/* El margen de scroll descuenta lo que hay fijo encima: en móvil
                  el header (64px) más la barra de familias (54px); en
                  escritorio sólo el header (72px). */}
              <div class="min-w-0 space-y-10 sm:space-y-12">
              {menu.map((category) => (
                <section id={`cat-${category.slug}`} class="scroll-mt-32 lg:scroll-mt-24">
                  <h2 class="text-xl sm:text-2xl font-medium tracking-widest sigmar-regular">
                    {category.name}
                  </h2>

                  <div class="mt-4 divide-y divide-zinc-200/70 rounded-3xl border border-zinc-200 bg-bg shadow-sm sm:mt-5">
                    {category.products.map((product) => {
                      const description = (
                        product.details ??
                        product.description ??
                        ""
                      ).trim();

                      return (
                        <div
                          class="px-4 py-4 sm:px-6"
                          data-producto
                          data-buscar={searchIndex(product)}
                          data-alergenos={product.allergens.map((a) => a.slug).join(",")}
                        >
                          <div class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4 gap-y-2 sm:gap-x-5">
                            <div class="min-w-0">
                              <div class="font-semibold text-zinc-900 wrap-break-words">
                                {product.name}
                              </div>
                              {description ? (
                                <div class="mt-1 text-sm text-zinc-600 line-clamp-3">
                                  {description}
                                </div>
                              ) : null}

                              {product.allergens.length > 0 ? (
                                <div class="mt-3 flex flex-wrap gap-2">
                                  {product.allergens.map((allergen) => (
                                    <img
                                      src={allergenIconPath(allergen)}
                                      alt={allergen.name}
                                      title={allergen.name}
                                      class="h-7 w-7 object-contain sm:h-8 sm:w-8"
                                      loading="lazy"
                                    />
                                  ))}
                                </div>
                              ) : null}
                            </div>

                            <div class="justify-self-end text-right shrink-0 font-semibold text-zinc-900 tabular-nums">
                              {money(product.priceCents)}
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </section>
              ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</SiteLayout>

<script is:inline>
  (() => {
    const bar = document.querySelector("[data-carta-bar]");
    if (!bar) return;

    const input = bar.querySelector("[data-carta-search]");
    const chips = bar.querySelector("[data-carta-chips]");
    const counter = bar.querySelector("[data-carta-count]");
    const panel = bar.querySelector("[data-carta-allergens-panel]");
    const toggle = bar.querySelector("[data-carta-allergens-toggle]");
    const countLabel = bar.querySelector("[data-carta-allergens-count]");
    const aside = document.querySelector("aside nav");

    const productos = [...document.querySelectorAll("[data-producto]")];
    const secciones = [...document.querySelectorAll('section[id^="cat-"]')];
    const excluidos = new Set();

    // Mismo criterio que en servidor: sin acentos y en minúsculas.
    const normaliza = (v) =>
      v.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

    function aplicar() {
      const q = normaliza((input?.value ?? "").trim());
      const filtrando = q.length > 0 || excluidos.size > 0;
      let visibles = 0;

      for (const p of productos) {
        const texto = p.getAttribute("data-buscar") ?? "";
        const alerg = (p.getAttribute("data-alergenos") ?? "").split(",").filter(Boolean);

        const chocaAlergeno = alerg.some((a) => excluidos.has(a));
        const coincide = !q || texto.includes(q);
        const mostrar = coincide && !chocaAlergeno;

        p.hidden = !mostrar;
        if (mostrar) visibles += 1;
      }

      // Una familia sin resultados se oculta entera, para no dejar títulos
      // colgando sobre listas vacías.
      for (const s of secciones) {
        s.hidden = ![...s.querySelectorAll("[data-producto]")].some((p) => !p.hidden);
      }

      // El índice de familias deja de representar lo que se ve al filtrar.
      if (chips) chips.hidden = filtrando;
      if (aside) aside.style.visibility = filtrando ? "hidden" : "";

      if (counter) {
        counter.hidden = !filtrando;
        counter.textContent =
          visibles === 0
            ? "Ningún plato coincide"
            : `${visibles} ${visibles === 1 ? "plato" : "platos"}`;
      }

      if (countLabel) countLabel.textContent = excluidos.size ? ` (${excluidos.size})` : "";
      if (toggle) {
        toggle.classList.toggle("border-zinc-900", excluidos.size > 0);
        toggle.classList.toggle("bg-zinc-900", excluidos.size > 0);
        toggle.classList.toggle("text-white", excluidos.size > 0);
      }
    }

    input?.addEventListener("input", aplicar);

    toggle?.addEventListener("click", () => {
      if (!panel) return;
      const abierto = !panel.hidden && !panel.classList.contains("hidden");
      panel.classList.toggle("hidden", abierto);
      toggle.setAttribute("aria-expanded", abierto ? "false" : "true");
    });

    for (const boton of bar.querySelectorAll("[data-carta-allergen]")) {
      boton.addEventListener("click", () => {
        const slug = boton.getAttribute("data-carta-allergen");
        if (excluidos.has(slug)) excluidos.delete(slug);
        else excluidos.add(slug);
        boton.setAttribute("aria-pressed", excluidos.has(slug) ? "true" : "false");
        aplicar();
      });
    }

    // Al saltar a una familia desde el índice, un filtro activo dejaría la
    // página en un sitio que no se corresponde con el ancla.
    for (const enlace of document.querySelectorAll('a[href^="#cat-"]')) {
      enlace.addEventListener("click", () => {
        if (input) input.value = "";
        excluidos.clear();
        for (const b of bar.querySelectorAll("[data-carta-allergen]")) {
          b.setAttribute("aria-pressed", "false");
        }
        aplicar();
      });
    }
  })();
</script>
