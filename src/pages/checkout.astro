---
import SiteLayout from "@/layouts/SiteLayout.astro";
import CheckoutForm from "@/islands/checkout/CheckoutForm";
import { getArcadiaAvailability } from "@/server/time/madrid";
import { DEFAULT_LANG } from "@/lib/i18n";
import { getPublicCopy } from "@/lib/publicCopy";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = getPublicCopy(lang).pages.checkout;

const availability = await getArcadiaAvailability(new Date());

type PublicChannelCard = {
  label: string;
  source: string;
  note: string | null;
  start: string;
  end: string;
  state: string;
  tone: string;
};

function formatDateISO(dateISO: string) {
  const match = String(dateISO).match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) return dateISO;
  return `${match[3]}/${match[2]}/${match[1]}`;
}

function sourceLabel(source: string) {
  if (source === "SPECIAL_DATE") return t.sourceSpecial;
  if (source === "SPECIAL_DATE_CLOSED") return t.sourceSpecialClosed;
  if (source === "OPENING_HOUR") return t.sourceWeekly;
  if (source === "OPENING_HOUR_CLOSED") return t.sourceWeeklyClosed;
  return t.sourceBase;
}

const specialCards: PublicChannelCard[] = [
  {
    label: t.local,
    source: availability.sources.open,
    note: availability.sourceNotes.open,
    start: availability.windows.open.start,
    end: availability.windows.open.end,
    state: availability.isOpen ? t.open : t.closed,
    tone: availability.isOpen
      ? "border-emerald-200 bg-emerald-50 text-emerald-900"
      : "border-rose-200 bg-rose-50 text-rose-900",
  },
  {
    label: t.pickup,
    source: availability.sources.pickup,
    note: availability.sourceNotes.pickup,
    start: availability.windows.pickup.start,
    end: availability.windows.pickup.end,
    state: availability.pickupAvailable ? t.available : t.unavailable,
    tone: availability.pickupAvailable
      ? "border-indigo-200 bg-indigo-50 text-indigo-900"
      : "border-amber-200 bg-amber-50 text-amber-900",
  },
  {
    label: t.delivery,
    source: availability.sources.delivery,
    note: availability.sourceNotes.delivery,
    start: availability.windows.delivery.start,
    end: availability.windows.delivery.end,
    state: availability.forcePickup
      ? t.pickupOnly
      : availability.deliveryAvailable
        ? t.available
        : t.unavailable,
    tone: availability.forcePickup
      ? "border-amber-200 bg-amber-50 text-amber-900"
      : availability.deliveryAvailable
        ? "border-cyan-200 bg-cyan-50 text-cyan-900"
        : "border-amber-200 bg-amber-50 text-amber-900",
  },
].filter(
  (card) =>
    card.source === "SPECIAL_DATE" || card.source === "SPECIAL_DATE_CLOSED",
);

const hasSpecialResolution = specialCards.length > 0;
---

<SiteLayout title={`${t.title} · Arcadia`}>
  <div class="mx-auto w-full max-w-448">
    <h1 class="text-2xl font-semibold tracking-tight 2xl:text-[2rem]">
      {t.title}
    </h1>

    {
      availability.pauseOrders ? (
        <section class="mt-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm text-rose-900">
          <div class="font-semibold">{t.pausedTitle}</div>
          <p class="mt-1 leading-6">{t.pausedBody}</p>
        </section>
      ) : null
    }

    {
      hasSpecialResolution ? (
        <section class="mt-4 rounded-2xl border border-amber-200 bg-amber-50 p-4 sm:p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">
                {t.specialTitle}
              </div>
              <h2 class="mt-1 text-lg font-semibold text-amber-950">
                {formatDateISO(availability.todayDateISO)} {t.specialHeading}
              </h2>
            </div>

            <div class="rounded-full border border-amber-200 bg-white/70 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-amber-800">
              SpecialDate
            </div>
          </div>

          <p class="mt-3 text-sm leading-6 text-amber-900">{t.specialBody}</p>

          <div class="mt-4 grid gap-3 lg:grid-cols-3">
            {specialCards.map((card) => (
              <article class:list={["rounded-2xl border p-4", card.tone]}>
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="text-sm font-semibold">{card.label}</div>
                  <div class="text-xs font-semibold uppercase tracking-[0.14em]">
                    {card.state}
                  </div>
                </div>

                <div class="mt-2 text-sm">
                  {card.start} - {card.end}
                </div>

                <div class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] opacity-80">
                  {sourceLabel(card.source)}
                </div>

                {card.note ? (
                  <p class="mt-2 text-sm leading-6 opacity-90">{card.note}</p>
                ) : null}
              </article>
            ))}
          </div>

          {availability.forcePickup ? (
            <div class="mt-4 rounded-xl border border-amber-200 bg-white/70 px-4 py-3 text-sm text-amber-900">
              {t.forcePickupNote}
            </div>
          ) : null}
        </section>
      ) : null
    }

    <CheckoutForm client:load />
  </div>
</SiteLayout>
