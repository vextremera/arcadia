---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { DEFAULT_LANG, getSiteCopy } from "@/lib/i18n";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = getSiteCopy(lang).contact;

const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error") === "1";
---

<SiteLayout title={`${t.title} · Arcadia`}>
    <section class="mx-auto w-full max-w-6xl py-6 sm:py-8">
        <div
            class="rounded-[30px] border border-zinc-200 bg-[#fbfaf7] p-6 sm:p-8"
        >
            <div
                class="text-[11px] font-semibold uppercase tracking-[0.22em] text-zinc-500"
            >
                CONTACT
            </div>
            <h1
                class="mt-3 text-3xl font-black tracking-tight text-zinc-900 sm:text-4xl"
            >
                {t.title}
            </h1>
            <p
                class="mt-3 max-w-3xl text-sm leading-7 text-zinc-700 sm:text-base"
            >
                {t.intro}
            </p>
        </div>

        <div class="mt-6 grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
            <div class="space-y-4">
                <section
                    class="rounded-[26px] border border-zinc-200 bg-white p-5 shadow-sm"
                >
                    <div
                        class="text-xs font-semibold uppercase tracking-[0.16em] text-zinc-500"
                    >
                        {t.cards.phone}
                    </div>
                    <div class="mt-2 text-lg font-bold text-zinc-900">
                        +34 600 00 00 00
                    </div>
                </section>

                <section
                    class="rounded-[26px] border border-zinc-200 bg-white p-5 shadow-sm"
                >
                    <div
                        class="text-xs font-semibold uppercase tracking-[0.16em] text-zinc-500"
                    >
                        {t.cards.email}
                    </div>
                    <div class="mt-2 text-lg font-bold text-zinc-900">
                        info@bararcadia.com
                    </div>
                </section>

                <section
                    class="rounded-[26px] border border-zinc-200 bg-white p-5 shadow-sm"
                >
                    <div
                        class="text-xs font-semibold uppercase tracking-[0.16em] text-zinc-500"
                    >
                        {t.cards.address}
                    </div>
                    <div class="mt-2 space-y-1 text-zinc-700">
                        <div>C/ Maria Aurèlia Campmany i Farnés, nº 2</div>
                        <div>17310 Lloret de Mar (Girona)</div>
                    </div>
                </section>

                <section
                    class="rounded-[26px] border border-zinc-200 bg-white p-5 shadow-sm"
                >
                    <div
                        class="text-xs font-semibold uppercase tracking-[0.16em] text-zinc-500"
                    >
                        {t.cards.hours}
                    </div>
                    <div class="mt-2 text-zinc-700">
                        Respuesta en horario comercial. Para incidencias
                        urgentes de pedido, es mejor contactar por teléfono.
                    </div>
                </section>
            </div>

            <section
                class="rounded-[26px] border border-zinc-200 bg-white p-5 shadow-sm sm:p-6"
            >
                <h2 class="text-xl font-bold text-zinc-900">{t.form.title}</h2>

                {
                    sent ? (
                        <div class="mt-4 rounded-[18px] border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
                            {t.form.success}
                        </div>
                    ) : null
                }

                {
                    error ? (
                        <div class="mt-4 rounded-[18px] border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                            {t.form.error}
                        </div>
                    ) : null
                }

                <form
                    method="post"
                    action="/api/contact"
                    class="mt-5 grid gap-4"
                >
                    <label class="block">
                        <span
                            class="mb-2 block text-sm font-semibold text-zinc-800"
                        >
                            {t.form.name}
                        </span>
                        <input
                            class="w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-sm text-zinc-900 outline-none transition focus:border-zinc-900"
                            type="text"
                            name="name"
                            required
                        />
                    </label>

                    <label class="block">
                        <span
                            class="mb-2 block text-sm font-semibold text-zinc-800"
                        >
                            {t.form.email}
                        </span>
                        <input
                            class="w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-sm text-zinc-900 outline-none transition focus:border-zinc-900"
                            type="email"
                            name="email"
                            required
                        />
                    </label>

                    <label class="block">
                        <span
                            class="mb-2 block text-sm font-semibold text-zinc-800"
                        >
                            {t.form.subject}
                        </span>
                        <input
                            class="w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-sm text-zinc-900 outline-none transition focus:border-zinc-900"
                            type="text"
                            name="subject"
                            required
                        />
                    </label>

                    <label class="block">
                        <span
                            class="mb-2 block text-sm font-semibold text-zinc-800"
                        >
                            {t.form.message}
                        </span>
                        <textarea
                            class="min-h-40 w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-sm text-zinc-900 outline-none transition focus:border-zinc-900"
                            name="message"
                            required></textarea>
                    </label>

                    <button
                        type="submit"
                        class="inline-flex min-h-11 items-center justify-center rounded-2xl bg-zinc-900 px-5 py-3 text-sm font-semibold text-white hover:bg-zinc-800"
                    >
                        {t.form.submit}
                    </button>
                </form>
            </section>
        </div>
    </section>
</SiteLayout>
