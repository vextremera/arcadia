---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { db, Favorite, Product, eq, inArray, desc } from "astro:db";
import OpenProductButton from "@/islands/product/OpenProductButton";
import FavoriteButton from "@/islands/favorites/FavoriteButton";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/cuenta/favoritos");

// 1) IDs favoritos del usuario
const favRows = await db
  .select({
    productId: Favorite.productId,
    createdAt: Favorite.createdAt,
  })
  .from(Favorite)
  .where(eq(Favorite.userId, user.id))
  .orderBy(desc(Favorite.createdAt));

const favIds = favRows.map((r) => r.productId);

// 2) Productos favoritos
const products = favIds.length
  ? await db
      .select({
        id: Product.id,
        name: Product.name,
        description: Product.description,
        imageUrl: Product.imageUrl,
        priceCents: Product.priceCents,
        active: Product.active,
        deliveryEnabled: Product.deliveryEnabled,
        pickupEnabled: Product.pickupEnabled,
      })
      .from(Product)
      .where(inArray(Product.id, favIds))
  : [];

// 3) Mantener orden por fecha (favorito más reciente primero)
const productById = new Map(products.map((p) => [p.id, p]));
const ordered = favIds.map((id) => productById.get(id)).filter(notNull);

function money(cents: number) {
  return `${(cents / 100).toFixed(2)} €`;
}

function notNull<T>(v: T | null | undefined): v is T {
  return v != null;
}
---

<SiteLayout title="Favoritos · Arcadia">
  <div class="flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-baseline sm:gap-4">
    <h1 class="text-2xl font-semibold tracking-tight">Favoritos</h1>
    <a class="text-sm font-semibold underline" href="/cuenta">Mi cuenta</a>
  </div>

  {
    ordered.length === 0 ? (
      <div class="mt-6 rounded-2xl border border-zinc-200 p-4 sm:p-5">
        <div class="text-sm text-zinc-600">
          Aún no has marcado ningún favorito. Pulsa el ❤️ en la carta para
          guardarlos aquí.
        </div>

        <div class="mt-4">
          <a
            class="inline-flex w-full items-center justify-center rounded-xl bg-zinc-900 px-4 py-2 text-sm font-semibold text-white sm:w-auto"
            href="/pedir"
          >
            Ir a pedir
          </a>
        </div>
      </div>
    ) : (
      <div id="fav-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {ordered.map((p) => (
          <article
            class="rounded-2xl border border-zinc-200 p-4 sm:p-5"
            data-product-id={p.id}
          >
            <div class="flex items-start justify-between gap-3 sm:gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="truncate text-base font-semibold">{p.name}</h3>

                    {p.description ? (
                      <p class="mt-1 line-clamp-2 text-sm text-zinc-600">
                        {p.description}
                      </p>
                    ) : null}

                    <p class="mt-2 text-sm font-semibold">
                      {money(p.priceCents)}
                    </p>

                    <p class="mt-1 text-xs text-zinc-500">
                      {p.deliveryEnabled ? "Delivery" : "Sin delivery"} ·{" "}
                      {p.pickupEnabled ? "Recogida" : "Sin recogida"}
                    </p>
                  </div>

                  {/* Botón favorito (sirve para quitar) */}
                  <FavoriteButton client:load productId={p.id} />
                </div>
              </div>

              {p.imageUrl ? (
                <img
                  src={p.imageUrl}
                  alt={p.name}
                  loading="lazy"
                  class="h-16 w-16 shrink-0 rounded-xl object-cover sm:h-20 sm:w-20"
                />
              ) : (
                <div class="h-16 w-16 shrink-0 rounded-xl bg-zinc-100 sm:h-20 sm:w-20" />
              )}
            </div>

            <div class="mt-4">
              <OpenProductButton
                client:visible
                productId={p.id}
                label="Personalizar"
              />
            </div>

            {!p.active ? (
              <div class="mt-3 rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">
                Este producto no está activo ahora mismo.
              </div>
            ) : null}
          </article>
        ))}
      </div>
    )
  }

  <div class="mt-8 rounded-2xl border border-zinc-200 p-4 sm:p-5">
    <div class="text-sm font-semibold">Tip</div>
    <div class="mt-1 text-sm text-zinc-600">
      En la carta, puedes marcar productos con ❤️ para tenerlos siempre a mano.
    </div>

    <div class="mt-4">
      <a
        class="inline-flex w-full items-center justify-center rounded-xl border border-zinc-300 px-4 py-2 text-sm font-semibold sm:w-auto"
        href="/pedir"
      >
        Volver a la carta
      </a>
    </div>
  </div>

  <!-- ✅ UI tipo app: al quitar un favorito aquí, desaparece sin recargar -->
  <script is:inline>
    {
      String.raw`
      (() => {
        const grid = document.getElementById("fav-grid");
        if (!grid) return;

        window.addEventListener("arcadia:favorites:updated", (e) => {
          const detail = e && e.detail;
          if (!detail || typeof detail.productId !== "number") return;

          // Si lo han quitado (favorited=false), removemos la tarjeta
          if (detail.favorited === false) {
            const el = grid.querySelector(\`[data-product-id="\${detail.productId}"]\`);
            if (el) el.remove();

            // Si ya no quedan, recargamos para mostrar el empty state SSR
            const remaining = grid.querySelectorAll("[data-product-id]").length;
            if (remaining === 0) window.location.reload();
          }
        });
      })();
    `;
    }
  </script>
</SiteLayout>