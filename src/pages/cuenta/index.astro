---
import SiteLayout from "@/layouts/SiteLayout.astro";
const user = Astro.locals.user;
---

<SiteLayout title="Mi cuenta · Arcadia">
  <h1 class="text-2xl font-semibold tracking-tight">Mi cuenta</h1>

  <div class="mt-6 rounded-2xl border border-zinc-200 p-5">
    <div class="text-sm text-zinc-600">Sesión activa</div>
    <div class="mt-1 font-semibold">
      {user?.name ?? user?.email} · {user?.role}
    </div>

    <div class="mt-5 border-t border-zinc-200 pt-5">
      <div class="text-sm font-semibold">Acciones</div>

      <div class="mt-3 flex flex-wrap gap-2">
        <a
          class="rounded-xl border border-zinc-300 px-4 py-2 text-sm font-semibold hover:bg-zinc-50"
          href="/cuenta/pedidos"
        >
          Mis pedidos
        </a>

        <a
          class="rounded-xl border border-zinc-300 px-4 py-2 text-sm font-semibold hover:bg-zinc-50"
          href="/cuenta/favoritos"
        >
          Favoritos
        </a>
      </div>
    </div>

    <div class="mt-5 border-t border-zinc-200 pt-5">
      <form method="post" action="/api/auth/logout">
        <button
          class="rounded-xl border border-zinc-300 px-4 py-2 text-sm font-semibold hover:bg-zinc-50"
          type="submit"
        >
          Cerrar sesión
        </button>
      </form>
    </div>
  </div>
</SiteLayout>
