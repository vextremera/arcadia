---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { db, UserProfile, eq } from "astro:db";
import AccountPanel from "@/islands/account/AccountPanel";
import {
  buildLoyaltyProgress,
  getActiveLoyaltyTiers,
} from "@/server/loyalty/progress";

const user = Astro.locals.user;

let points = 0;
let tierName: string | null = null;
let nextTierName: string | null = null;
let pointsToNext = 0;
let progressPercent = 0;

if (user) {
  const [profile] = await db
    .select({
      pointsBalance: UserProfile.pointsBalance,
      tierId: UserProfile.tierId,
    })
    .from(UserProfile)
    .where(eq(UserProfile.userId, user.id))
    .limit(1);

  points = Number(profile?.pointsBalance ?? 0);

  const tiers = await getActiveLoyaltyTiers();
  const loyalty = buildLoyaltyProgress(points, tiers);

  tierName = loyalty.currentTier?.name ?? null;
  nextTierName = loyalty.nextTier?.name ?? null;
  pointsToNext = loyalty.pointsToNext;
  progressPercent = loyalty.progressPercent;
}
---

<SiteLayout title="Mi cuenta · Arcadia">
  <h1 class="text-2xl font-semibold tracking-tight">Mi cuenta</h1>

  <div class="mt-6 rounded-2xl border border-zinc-200 p-4 sm:p-5">
    <div class="text-sm text-zinc-600">Sesión activa</div>
    <div class="mt-1 wrap-break-words font-semibold">
      {user?.name ?? user?.email} · {user?.role}
    </div>

    <div
      class="mt-5 rounded-[28px] border border-amber-200 bg-amber-50 p-4 sm:p-5"
    >
      <div
        class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"
      >
        <div>
          <div
            class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700"
          >
            Loyalty
          </div>
          <div class="mt-1 text-3xl font-black text-zinc-900">{points} pts</div>
          <div class="mt-2 text-sm text-zinc-700 sm:text-base">
            Nivel actual: <b>{tierName ?? "Sin nivel"}</b>
          </div>
        </div>

        <div
          class="rounded-2xl border border-zinc-200 bg-white px-5 py-4 text-right shadow-sm"
        >
          <div class="text-sm text-zinc-500">Progreso</div>
          <div class="mt-1 text-2xl font-black text-zinc-900">
            {Math.round(progressPercent)}%
          </div>
        </div>
      </div>

      <div class="mt-5 h-4 overflow-hidden rounded-full bg-white">
        <div
          class="h-full rounded-full bg-zinc-900"
          style={`width:${progressPercent}%`}
        >
        </div>
      </div>

      <div class="mt-4 text-sm text-zinc-800 sm:text-base">
        {
          nextTierName ? (
            <>
              Te faltan <b>{pointsToNext} pts</b> para subir a{" "}
              <b>{nextTierName}</b>.
            </>
          ) : (
            <>Ya estás en el nivel más alto.</>
          )
        }
      </div>
    </div>

    <div class="mt-5 border-t border-zinc-200 pt-5">
      <div class="text-sm font-semibold">Acciones</div>

      <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
        <a
          class="w-full rounded-xl border border-zinc-300 px-4 py-2 text-center text-sm font-semibold hover:bg-zinc-50 sm:w-auto"
          href="/cuenta/pedidos"
        >
          Mis pedidos
        </a>
      </div>
    </div>

    <div class="mt-5 border-t border-zinc-200 pt-5">
      <form method="post" action="/api/auth/logout">
        <button
          class="w-full rounded-xl border border-zinc-300 px-4 py-2 text-sm font-semibold hover:bg-zinc-50 sm:w-auto"
          type="submit"
        >
          Cerrar sesión
        </button>
      </form>
    </div>
  </div>

  <AccountPanel client:load />
</SiteLayout>
