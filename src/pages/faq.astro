---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { DEFAULT_LANG, getSiteCopy } from "@/lib/i18n";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = getSiteCopy(lang).faq;
---

<SiteLayout title={`${t.title} · Arcadia`}>
    <section class="mx-auto w-full max-w-5xl py-6 sm:py-8">
        <div
            class="rounded-[30px] border border-zinc-200 bg-[#fbfaf7] p-6 sm:p-8"
        >
            <div
                class="text-[11px] font-semibold uppercase tracking-[0.22em] text-zinc-500"
            >
                FAQ
            </div>
            <h1
                class="mt-3 text-3xl font-black tracking-tight text-zinc-900 sm:text-4xl"
            >
                {t.title}
            </h1>
            <p
                class="mt-3 max-w-3xl text-sm leading-7 text-zinc-700 sm:text-base"
            >
                {t.intro}
            </p>
        </div>

        <div class="mt-6 space-y-6">
            {
                t.sections.map((section) => (
                    <section class="rounded-[28px] border border-zinc-200 bg-white p-5 shadow-sm sm:p-6">
                        <h2 class="text-xl font-bold text-zinc-900">
                            {section.title}
                        </h2>

                        <div class="mt-4 space-y-3">
                            {section.items.map((item) => (
                                <details class="rounded-[22px] border border-zinc-200 bg-[#fbfaf7] px-4 py-3">
                                    <summary class="cursor-pointer text-sm font-semibold text-zinc-900 sm:text-base">
                                        {item.q}
                                    </summary>
                                    <p class="mt-3 text-sm leading-7 text-zinc-700">
                                        {item.a}
                                    </p>
                                </details>
                            ))}
                        </div>
                    </section>
                ))
            }
        </div>
    </section>
</SiteLayout>
