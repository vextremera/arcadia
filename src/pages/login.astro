---
import SiteLayout from "@/layouts/SiteLayout.astro";

const next = Astro.url.searchParams.get("next") ?? "";
const error = Astro.url.searchParams.get("error") ?? "";
---

<SiteLayout title="Login · Arcadia">
  <h1 class="text-2xl font-semibold tracking-tight">Entrar</h1>

  {error ? (
    <div class="mt-4 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-900">
      {error}
    </div>
  ) : null}

  <form class="mt-6 max-w-md space-y-4" method="post" action="/api/auth/login">
    <input type="hidden" name="next" value={next} />

    <div>
      <label class="text-sm font-medium">Email</label>
      <input
        class="mt-1 w-full rounded-xl border border-zinc-300 px-3 py-2 text-sm"
        type="email"
        name="email"
        required
        autocomplete="email"
      />
    </div>

    <div>
      <label class="text-sm font-medium">Contraseña</label>
      <input
        class="mt-1 w-full rounded-xl border border-zinc-300 px-3 py-2 text-sm"
        type="password"
        name="password"
        required
        autocomplete="current-password"
      />
    </div>

    <button class="w-full rounded-xl bg-zinc-900 px-4 py-2 text-sm font-semibold text-white" type="submit">
      Entrar
    </button>

    <div class="text-sm text-zinc-600">
      ¿No tienes cuenta?{" "}
      <a class="font-semibold underline" href={`/registro${next ? `?next=${encodeURIComponent(next)}` : ""}`}>
        Crear cuenta
      </a>
    </div>
  </form>
</SiteLayout>
