---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { db, Order, Payment, eq } from "astro:db";
import { formatEuros as money } from "@/lib/money";

const publicId = String(Astro.params.publicId ?? "").trim();
if (!publicId) return new Response("Missing publicId", { status: 400 });

const [order] = await db
    .select()
    .from(Order)
    .where(eq(Order.publicId, publicId))
    .limit(1);

if (!order) return new Response("Pedido no encontrado", { status: 404 });

const [payment] = await db
    .select()
    .from(Payment)
    .where(eq(Payment.orderId, order.id))
    .limit(1);

if (!payment) return new Response("Pago no encontrado", { status: 404 });


const isPaid = String(payment.status) === "PAID";
const isFailed = String(payment.status) === "FAILED";
---

<SiteLayout title={`Pasarela de prueba · ${order.publicId}`}>
    <div
        class="mx-auto flex min-h-[70vh] w-full max-w-5xl items-center justify-center px-4 py-8 sm:px-6"
    >
        <div class="grid w-full max-w-4xl gap-6 lg:grid-cols-[1.1fr_0.9fr]">
            <section
                class="rounded-[30px] border border-zinc-200 bg-white p-6 shadow-[0_20px_60px_rgba(0,0,0,0.08)] sm:p-8"
            >
                <div
                    class="text-[11px] font-semibold uppercase tracking-[0.22em] text-zinc-500"
                >
                    Pasarela de prueba
                </div>

                <h1
                    class="mt-3 text-3xl font-black tracking-tight text-zinc-900"
                >
                    Pago con tarjeta
                </h1>

                <p
                    class="mt-3 max-w-2xl text-sm leading-7 text-zinc-600 sm:text-base"
                >
                    Esta es una pasarela sandbox de ARCADIA. No se realiza
                    ningún cobro real ni hace falta introducir tarjeta. Sirve
                    solo para probar el flujo completo de pago y retorno a la
                    web.
                </p>

                <div
                    class="mt-6 rounded-[24px] border border-zinc-200 bg-zinc-50 p-5"
                >
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-sm text-zinc-600">Comercio</span>
                        <span class="font-semibold text-zinc-900">Arcadia</span>
                    </div>

                    <div class="mt-3 flex items-center justify-between gap-3">
                        <span class="text-sm text-zinc-600">Pedido</span>
                        <span
                            class="font-mono text-sm font-semibold text-zinc-900"
                            >{order.publicId}</span
                        >
                    </div>

                    <div class="mt-3 flex items-center justify-between gap-3">
                        <span class="text-sm text-zinc-600">Importe</span>
                        <span class="text-2xl font-black text-zinc-900"
                            >{money(Number(order.totalCents ?? 0))}</span
                        >
                    </div>
                </div>

                {
                    isPaid ? (
                        <div class="mt-6 rounded-[22px] border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
                            Este pago ya está confirmado.
                        </div>
                    ) : null
                }

                {
                    isFailed ? (
                        <div class="mt-6 rounded-[22px] border border-rose-200 bg-rose-50 p-4 text-sm text-rose-900">
                            Este pago fue cancelado o marcado como fallido.
                        </div>
                    ) : null
                }

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <form
                        method="post"
                        action="/api/payments/test/confirm"
                        class="flex-1"
                    >
                        <input
                            type="hidden"
                            name="publicId"
                            value={order.publicId}
                        />
                        <button
                            type="submit"
                            class="w-full rounded-2xl bg-zinc-900 px-5 py-3 text-sm font-semibold text-white hover:bg-zinc-800 disabled:opacity-50"
                            disabled={isPaid}
                        >
                            Confirmar pago de prueba
                        </button>
                    </form>

                    <form
                        method="post"
                        action="/api/payments/test/cancel"
                        class="flex-1"
                    >
                        <input
                            type="hidden"
                            name="publicId"
                            value={order.publicId}
                        />
                        <button
                            type="submit"
                            class="w-full rounded-2xl border border-zinc-300 bg-white px-5 py-3 text-sm font-semibold text-zinc-700 hover:bg-zinc-50 disabled:opacity-50"
                            disabled={isPaid}
                        >
                            Cancelar pago
                        </button>
                    </form>
                </div>
            </section>

            <aside
                class="rounded-[30px] border border-zinc-200 bg-white p-6 shadow-[0_20px_60px_rgba(0,0,0,0.08)] sm:p-8"
            >
                <div
                    class="text-[11px] font-semibold uppercase tracking-[0.22em] text-zinc-500"
                >
                    Estado
                </div>

                <div class="mt-4 space-y-4">
                    <div
                        class="rounded-[22px] border border-zinc-200 bg-zinc-50 p-4"
                    >
                        <div class="text-sm text-zinc-600">Pedido</div>
                        <div class="mt-1 text-lg font-bold text-zinc-900">
                            {String(order.status)}
                        </div>
                    </div>

                    <div
                        class="rounded-[22px] border border-zinc-200 bg-zinc-50 p-4"
                    >
                        <div class="text-sm text-zinc-600">Estado de pago</div>
                        <div class="mt-1 text-lg font-bold text-zinc-900">
                            {String(order.paymentStatus)}
                        </div>
                    </div>

                    <div
                        class="rounded-[22px] border border-zinc-200 bg-zinc-50 p-4"
                    >
                        <div class="text-sm text-zinc-600">
                            Registro Payment
                        </div>
                        <div class="mt-1 text-lg font-bold text-zinc-900">
                            {String(payment.status)}
                        </div>
                    </div>
                </div>

                <p class="mt-6 text-sm leading-7 text-zinc-600">
                    Al confirmar, volverás a la web con el pedido completado. Si
                    cancelas, el pedido se anulará y volverás al checkout con el
                    carrito intacto.
                </p>
            </aside>
        </div>
    </div>
</SiteLayout>
