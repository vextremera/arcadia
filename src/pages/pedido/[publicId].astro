---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { db, Order, OrderItem, eq } from "astro:db";

function money(cents: number) {
  return `${(cents / 100).toFixed(2)} €`;
}

const { publicId } = Astro.params;
const pid = String(publicId ?? "").trim();

const [order] = await db
  .select()
  .from(Order)
  .where(eq(Order.publicId, pid))
  .limit(1);

if (!order) {
  return new Response("Pedido no encontrado", { status: 404 });
}

const items = await db
  .select()
  .from(OrderItem)
  .where(eq(OrderItem.orderId, order.id));

const meta: any = order.addressSnapshot ?? {};
const paymentMethod = meta?.paymentMethod ?? null;
const addr = meta?.address ?? null;
---

<SiteLayout title={`Pedido ${order.publicId} · Arcadia`}>
  <div class="mt-4 space-y-6">
    <div class="rounded-2xl border border-zinc-200 p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold tracking-tight">Pedido {order.publicId}</h1>
        <div class="text-sm">
          <span class="rounded-xl border border-zinc-200 px-3 py-1 font-semibold">
            {order.status}
          </span>
          <span class="ml-2 rounded-xl border border-zinc-200 px-3 py-1 font-semibold">
            {order.type}
          </span>
        </div>
      </div>

      <div class="mt-3 text-sm text-zinc-600">
        {order.customerName} · {order.customerPhone}
        {order.customerEmail ? ` · ${order.customerEmail}` : ""}
      </div>

      <div class="mt-2 text-sm text-zinc-600">
        Pago: <span class="font-semibold">{paymentMethod ?? "—"}</span>
      </div>

      {order.type === "DELIVERY" && addr ? (
        <div class="mt-4 rounded-xl border border-zinc-200 p-4 text-sm">
          <div class="font-semibold">Dirección</div>
          <div class="mt-1 text-zinc-700">{addr.line1}</div>
          {addr.line2 ? <div class="text-zinc-700">{addr.line2}</div> : null}
          <div class="text-zinc-700">{addr.postalCode} · {addr.city}</div>
          {addr.notes ? <div class="mt-2 text-zinc-600">Notas: {addr.notes}</div> : null}
        </div>
      ) : null}

      {order.notes ? (
        <div class="mt-4 text-sm text-zinc-600">
          <span class="font-semibold">Comentarios:</span> {order.notes}
        </div>
      ) : null}
    </div>

    <div class="rounded-2xl border border-zinc-200 p-5">
      <h2 class="text-lg font-semibold">Resumen</h2>

      <div class="mt-4 space-y-4">
        {items.map((it: any) => {
          const m = it.modifiers ?? {};
          const opts = m.modifierOptions ?? [];
          const adds = m.ingredientsAdded ?? [];
          const rems = m.ingredientsRemoved ?? [];
          return (
            <div class="rounded-2xl border border-zinc-100 p-4">
              <div class="flex items-baseline justify-between gap-3">
                <div class="font-semibold">{it.qty}× {it.nameSnapshot}</div>
                <div class="font-semibold">{money(it.lineTotalCents)}</div>
              </div>

              {it.variantSnapshot ? (
                <div class="mt-1 text-sm text-zinc-600">{it.variantSnapshot}</div>
              ) : null}

              {opts.length ? (
                <div class="mt-2 text-sm text-zinc-600">
                  Extras:{" "}
                  {opts.map((o: any) => `${o.name} (+${money(o.priceDeltaCents)})`).join(", ")}
                </div>
              ) : null}

              {adds.length ? (
                <div class="mt-1 text-sm text-zinc-600">
                  Añadidos:{" "}
                  {adds.map((a: any) => `${a.name} (+${money(a.priceDeltaCents)})`).join(", ")}
                </div>
              ) : null}

              {rems.length ? (
                <div class="mt-1 text-sm text-zinc-600">
                  Quitados: {rems.map((r: any) => r.name).join(", ")}
                </div>
              ) : null}
            </div>
          );
        })}
      </div>

      <div class="mt-6 border-t border-zinc-200 pt-4 text-sm">
        <div class="flex items-center justify-between">
          <span class="text-zinc-600">Subtotal</span>
          <span class="font-semibold">{money(order.subtotalCents)}</span>
        </div>
        {order.deliveryFeeCents ? (
          <div class="mt-2 flex items-center justify-between">
            <span class="text-zinc-600">Delivery</span>
            <span class="font-semibold">{money(order.deliveryFeeCents)}</span>
          </div>
        ) : null}
        <div class="mt-3 flex items-center justify-between text-base font-semibold">
          <span>Total</span>
          <span>{money(order.totalCents)}</span>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
