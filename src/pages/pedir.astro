---
import SiteLayout from "@/layouts/SiteLayout.astro";
import CartaKiosk from "@/islands/order/CartaKiosk";
import { DEFAULT_LANG } from "@/lib/i18n";
import { getPublicCopy } from "@/lib/publicCopy";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = getPublicCopy(lang).pages.pedir;
---

<SiteLayout title={`${t.title} · Arcadia`} fullWidth>
  <CartaKiosk client:load />
</SiteLayout>
