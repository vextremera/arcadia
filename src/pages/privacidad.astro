---
import SiteLayout from "@/layouts/SiteLayout.astro";
import LegalIdentityWarning from "@/components/layout/LegalIdentityWarning.astro";
import { PROCESSORS as processors, hasInternationalTransfers } from "@/lib/legal/processors";
import { BUSINESS } from "@/lib/legal/business";
import { DEFAULT_LANG, getSiteCopy } from "@/lib/i18n";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = getSiteCopy(lang).privacy;
const hayTransferencias = hasInternationalTransfers();
---

<SiteLayout title={`${t.title} · Arcadia`}>
    <section class="mx-auto w-full max-w-5xl py-6 sm:py-8">
        <LegalIdentityWarning />
        <div
            class="rounded-[30px] border border-zinc-200 bg-[#fbfaf7] p-6 sm:p-8"
        >
            <div
                class="text-[11px] font-semibold uppercase tracking-[0.22em] text-zinc-500"
            >
                PRIVACY
            </div>
            <h1
                class="mt-3 text-3xl font-black tracking-tight text-zinc-900 sm:text-4xl"
            >
                {t.title}
            </h1>
            <p
                class="mt-3 max-w-3xl text-sm leading-7 text-zinc-700 sm:text-base"
            >
                {t.intro}
            </p>
        </div>

        <div class="mt-6 space-y-5">
            {
                t.sections.map((section) => (
                    <section class="rounded-[26px] border border-zinc-200 bg-white p-5 shadow-sm sm:p-6">
                        <h2 class="text-xl font-bold text-zinc-900">
                            {section.title}
                        </h2>
                        <div class="mt-4 space-y-3 text-sm leading-7 text-zinc-700 sm:text-base">
                            {section.body.map((paragraph) => (
                                <p>{paragraph}</p>
                            ))}
                        </div>
                    </section>
                ))
            }

            {/*
                Quién trata los datos y si salen de la UE. Va en una tabla y no
                en prosa porque lo que interesa es poder mirar quién toca qué,
                no leerse un párrafo.
            */}
            <section class="rounded-[26px] border border-zinc-200 bg-white p-5 shadow-sm sm:p-6">
                <h2 class="text-xl font-bold text-zinc-900">Con quién se comparten</h2>
                <div class="mt-4 space-y-3 text-sm leading-7 text-zinc-700 sm:text-base">
                    <p>
                        No vendemos tus datos ni los cedemos con fines publicitarios. Sí los
                        tratan por nuestra cuenta las empresas que hacen funcionar la web, y
                        sólo para lo que se indica:
                    </p>
                </div>

                <div class="mt-4 overflow-x-auto">
                    <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
                        <thead>
                            <tr class="border-b border-zinc-200 text-xs uppercase tracking-wide text-zinc-500">
                                <th class="py-2 pr-4 font-semibold">Empresa</th>
                                <th class="py-2 pr-4 font-semibold">Para qué</th>
                                <th class="py-2 font-semibold">Dónde</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100">
                            {processors.map((processor) => (
                                <tr>
                                    <td class="py-3 pr-4 align-top font-semibold text-zinc-900">
                                        {processor.name}
                                    </td>
                                    <td class="py-3 pr-4 align-top leading-6 text-zinc-700">
                                        {processor.purpose}
                                    </td>
                                    <td class="py-3 align-top leading-6 text-zinc-600">
                                        {processor.location}
                                        {processor.outsideEu ? (
                                            <span class="mt-1 block text-xs font-semibold text-amber-700">
                                                Fuera de la UE
                                            </span>
                                        ) : null}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>

                {
                    hayTransferencias ? (
                        <p class="mt-4 text-sm leading-7 text-zinc-700">
                            Algunos de estos proveedores tratan datos fuera del Espacio Económico
                            Europeo. En esos casos la transferencia se ampara en las cláusulas
                            contractuales tipo aprobadas por la Comisión Europea, o en una decisión
                            de adecuación cuando existe.
                        </p>
                    ) : null
                }
            </section>

            {/* Cómo ejercer los derechos, con el enlace que los hace efectivos. */}
            <section class="rounded-[26px] border border-zinc-200 bg-white p-5 shadow-sm sm:p-6">
                <h2 class="text-xl font-bold text-zinc-900">Tus derechos</h2>
                <div class="mt-4 space-y-3 text-sm leading-7 text-zinc-700 sm:text-base">
                    <p>
                        Puedes acceder a tus datos, corregirlos, llevártelos, oponerte a
                        determinados tratamientos, limitarlos y pedir que se borren.
                    </p>
                    <p>
                        Si tienes cuenta, lo más rápido es hacerlo tú desde{" "}
                        <a class="underline hover:text-zinc-900" href="/cuenta">tu cuenta</a>: allí
                        puedes descargar todo lo que guardamos y eliminar la cuenta sin pedir
                        permiso a nadie. Si no tienes cuenta, o prefieres que lo hagamos nosotros,
                        escríbenos a{" "}
                        <a class="underline hover:text-zinc-900" href={`mailto:${BUSINESS.email}`}>
                            {BUSINESS.email}
                        </a>.
                    </p>
                    <p>
                        Al eliminar la cuenta se borran tu perfil, direcciones, puntos y
                        suscripción. Los pedidos se conservan sin tus datos personales, porque la
                        normativa fiscal obliga a guardar el registro de las ventas.
                    </p>
                    <p>
                        También puedes retirar en cualquier momento el consentimiento que hayas
                        dado —el enlace de baja va en todos los correos del newsletter— y presentar
                        una reclamación ante la Agencia Española de Protección de Datos si crees
                        que no hemos hecho las cosas bien.
                    </p>
                    <p>
                        Sobre las cookies puedes cambiar de opinión cuando quieras:{" "}
                        <button
                            type="button"
                            data-cookie-settings
                            class="underline hover:text-zinc-900"
                        >
                            revisar mi decisión
                        </button>.
                    </p>
                </div>
            </section>
        </div>
    </section>
</SiteLayout>
