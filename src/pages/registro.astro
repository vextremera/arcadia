---
import SiteLayout from "@/layouts/SiteLayout.astro";
import RegisterCard from "@/islands/auth/RegisterCard";

const next = Astro.url.searchParams.get("next") ?? "";
const error = Astro.url.searchParams.get("error") ?? "";
---

<SiteLayout title="Registro · Arcadia" variant="landing">
  <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <div class="grid place-items-center">
      <RegisterCard client:load next={next} error={error} />
    </div>
  </div>
</SiteLayout>