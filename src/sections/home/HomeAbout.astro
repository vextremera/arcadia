---
import { DEFAULT_LANG } from "@/lib/i18n";
import { getPublicCopy } from "@/lib/publicCopy";

const lang = Astro.locals.lang ?? DEFAULT_LANG;
const t = getPublicCopy(lang).home.about;
---

<section id="sobre" class="relative rounded-t-[50px] z-20 home-about">
  <div
    class="mx-auto w-full max-w-6xl px-6 py-12 lg:pt-16 lg:pb-22 home-about__inner"
  >
    <div class="text-center">
      <h2
        class="text-3xl font-black sm:text-4xl sigmar-regular tracking-widest"
      >
        {t.title}
      </h2>
      <div class="mt-2 text-base italic text-zinc-500 sm:text-lg">
        {t.quote}
      </div>
    </div>

    <div
      class="mx-auto mt-10 w-full max-w-5xl text-[20px] leading-relaxed text-center text-stone-900 home-about__copy"
    >
      {t.body[0]}
      <br />
      <br />
      {t.body[1]}
    </div>
  </div>
</section>

<style>
  @media (max-width: 639px) {
    .home-about {
      border-top-left-radius: 28px;
      border-top-right-radius: 28px;
    }

    .home-about__inner {
      padding-left: 1rem;
      padding-right: 1rem;
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }

    .home-about__copy {
      margin-top: 1.75rem;
      max-width: 42rem;
      font-size: 1rem;
      line-height: 1.75;
    }
  }
</style>
