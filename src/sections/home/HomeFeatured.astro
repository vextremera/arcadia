---
import FeaturedProductCard from "@/components/home/FeaturedProductCard.astro";
import { db, Product, Category, eq, asc } from "astro:db";

// Puedes “curar” los IDs cuando quieras.
// De momento, sacamos 6 productos activos.
const featured = await db
  .select({
    id: Product.id,
    name: Product.name,
    priceCents: Product.priceCents,
    imageUrl: Product.imageUrl,
    categoryName: Category.name,
  })
  .from(Product)
  .innerJoin(Category, eq(Product.categoryId, Category.id))
  .where(eq(Product.active, true))
  .orderBy(asc(Product.id))
  .limit(6);
---

<section class="relative py-16 text-white">
  {/* full-bleed background */}
  <div class="absolute inset-0 bg-zinc-900"></div>
  <div class="absolute inset-0 opacity-40 bg-[radial-gradient(circle_at_30%_10%,rgba(255,255,255,.10),transparent_45%)]"></div>

  <div class="relative mx-auto w-full max-w-6xl px-4">
    <h2 class="text-center text-2xl font-black tracking-tight">LOS DE SIEMPRE</h2>
    <p class="mt-2 text-center text-sm text-white/70">
      Una selección rápida para que veas el estilo de producto y personalización.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => (
        <FeaturedProductCard product={p} />
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <a
        href="/carta"
        class="rounded-2xl border border-white/20 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/15"
      >
        Ver toda la carta →
      </a>
    </div>
  </div>
</section>
