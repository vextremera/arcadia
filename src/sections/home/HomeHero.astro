---
/**
 * HERO minimal: imagen B/N + degradados hacia crema (#fbfaf7) SIN corte visible.
 * Clave: un "cream fade" inferior largo y con base sólida (último tramo 100% crema).
 */
import bgImage from "public/images/general/bg.webp";
---

<section
  class="relative w-full overflow-hidden min-h-screen bg-[#fbfaf7] rounded-t-[50px]"
>
  <!-- Fondo -->
  <div class="absolute inset-0 bg-cover bg-center z-0" aria-hidden="true">
    <img
      src={bgImage.src}
      alt="Hero background"
      class="w-full h-full object-center"
    />
    <div class="absolute inset-0 bg-black opacity-60"></div>
  </div>
  <div
    class="container mx-auto px-6 pt-32 pb-48 relative z-10"
    x-data="{ fadeIn: false }"
    x-init="setTimeout(() => fadeIn = true, 500)"
  >
    <div
      class="w-full transition-all duration-1000 justify-center text-center"
      :class="fadeIn ? 'opacity-100 transform translate-y-0' : 'opacity-0 transform translate-y-10'"
    >
      <h1
        class="text-2xl md:text-4xl font-bold sigmar-regular text-white leading-tight mb-6"
      >
        RESTAURANTE<br /><span
          class="text-8xl md:text-10xl font-extrabold sigmar-regular"
          >ARCADIA</span
        >
      </h1>
    </div>
  </div>
</section>
