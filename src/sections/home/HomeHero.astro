---
const heroBg = `background-image:url('/images/landing/hero.jpg');`;
---

<section class="relative">
  <!-- decor suave -->
  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute -top-24 left-1/2 h-130 w-130 -translate-x-1/2 rounded-full bg-[#7b1f1f]/10 blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-40 -right-30 h-130 w-130 rounded-full bg-zinc-900/5 blur-3xl"
    >
    </div>
  </div>

  <div
    class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-14 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:py-20"
  >
    <div>
      <h1
        class="text-4xl font-black leading-[0.95] tracking-tight sm:text-5xl lg:text-6xl"
      >
        AMIGOS, BEBIDA<br />
        Y BUENA COCINA...
      </h1>

      <p class="mt-5 max-w-xl text-base text-zinc-700 sm:text-lg">
        Platos de barrio, producto local y compañía. Ven o pídelo en 2 clics.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/#reservas"
          class="rounded-full border border-zinc-300 bg-white px-7 py-3 text-sm font-semibold text-zinc-900 hover:bg-zinc-50"
        >
          Hacer reserva
        </a>
        <a
          href="/pedir"
          class="rounded-full bg-[#7b1f1f] px-7 py-3 text-sm font-semibold text-white hover:bg-[#6a1919]"
        >
          Pedir para llevar
        </a>
      </div>

      <div class="mt-7 flex flex-wrap gap-2 text-xs text-zinc-600">
        <span class="rounded-full border border-zinc-200 bg-white px-3 py-1"
          >Sin registro obligatorio</span
        >
        <span class="rounded-full border border-zinc-200 bg-white px-3 py-1"
          >Favoritos + historial</span
        >
        <span class="rounded-full border border-zinc-200 bg-white px-3 py-1"
          >Delivery con horario</span
        >
      </div>
    </div>

    <div class="relative">
      <div
        class="aspect-16/10 w-full overflow-hidden rounded-[28px] border border-zinc-300 bg-zinc-200 shadow-[0_18px_50px_rgba(0,0,0,0.12)]"
        style={heroBg}
      >
        <div
          class="h-full w-full bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.35),transparent_55%)]"
        >
        </div>
        <div
          class="absolute inset-0 bg-[linear-gradient(90deg,rgba(0,0,0,0.22),transparent_55%)]"
        >
        </div>
      </div>
    </div>
  </div>
</section>
