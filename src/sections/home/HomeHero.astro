---
const heroImageStyle = `background-image:url('/images/landing/hero.jpg');`;
---

<section class="relative">
  <div
    class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-12 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:py-16"
  >
    <div>
      <h1 class="text-4xl font-black leading-[0.95] tracking-tight sm:text-5xl">
        AMIGOS, BEBIDA<br />
        Y BUENA COCINA...
      </h1>

      <p class="mt-5 max-w-xl text-sm text-zinc-700 sm:text-base">
        Platos de barrio, producto local y compañía. Ven o pídelo en 2 clics.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/#reservas"
          class="rounded-full border border-zinc-300 bg-white px-6 py-2.5 text-sm font-semibold text-zinc-900 hover:bg-zinc-50"
        >
          Hacer reserva
        </a>
        <a
          href="/pedir"
          class="rounded-full bg-[#7b1f1f] px-6 py-2.5 text-sm font-semibold text-white hover:bg-[#6a1919]"
        >
          Pedir para llevar
        </a>
      </div>
    </div>

    <div class="relative">
      <div
        class="aspect-16/10 w-full overflow-hidden rounded-[28px] border border-zinc-300 bg-zinc-200 shadow-[0_10px_30px_rgba(0,0,0,0.08)]"
        style={heroImageStyle}
      >
        <div
          class="h-full w-full bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.35),transparent_55%)]"
        >
        </div>
      </div>

      <div class="mt-3 text-xs text-zinc-500">
        * Sustituye <code>/public/images/landing/hero.jpg</code> por tu foto para
        que se vea como en tu diseño.
      </div>
    </div>
  </div>
</section>
