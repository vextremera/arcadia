---
import LazyMap from "@/islands/home/LazyMap";

const addressLines = [
  "C/ Maria Aurèlia Campmany i Farnés, nº 2",
  "17310 Lloret de Mar",
];

const phone = "+34 600 00 00 00";
const email = "info@bararcadia.com";
const instagram = "@bararcadia";

// Placeholder hasta conectar APIs
const ratings = {
  tripadvisor: { label: "Tripadvisor", rating: 5, count: 0 },
};

const mapQuery =
  "Bar Restaurant Arcadia, Carrer Maria Aurèlia Campmany i Farnés 2, 17310 Lloret de Mar, Girona, España";
---

<section id="ubicacion" class="scroll-mt-24">
  <div id="reservas" class="scroll-mt-24"></div>

  <div class="mx-auto w-full max-w-340 px-6 py-12 lg:py-16">
    <div class="grid gap-6 lg:grid-cols-2">
      <div
        class="rounded-[28px] border border-zinc-300 bg-white p-8 shadow-[0_10px_30px_rgba(0,0,0,0.08)]"
      >
        <h2 class="text-3xl font-black tracking-tight sm:text-4xl">
          UBICACIÓN
        </h2>

        <div class="mt-4 text-sm text-zinc-700">
          {addressLines.map((l) => <div>{l}</div>)}
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <div
            class="flex items-center gap-2 rounded-full bg-emerald-100 px-5 py-2 text-sm"
          >
            <span class="font-semibold text-emerald-900"
              >{ratings.tripadvisor.label}</span
            >
            <span class="text-emerald-900">{"★".repeat(5)}</span>
          </div>
        </div>

        <div class="mt-8 space-y-2 text-sm text-zinc-800">
          <div class="flex items-center justify-between gap-4">
            <span class="text-zinc-600">Teléfono:</span>
            <span class="font-semibold">{phone}</span>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-zinc-600">Correo:</span>
            <span class="font-semibold">{email}</span>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-zinc-600">Instagram:</span>
            <span class="font-semibold">{instagram}</span>
          </div>
        </div>
      </div>

      <div
        class="rounded-[28px] border border-zinc-300 bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,0.08)]"
      >
        <LazyMap client:load query={mapQuery} title="Mapa · Arcadia" />
      </div>
    </div>
  </div>
</section>
