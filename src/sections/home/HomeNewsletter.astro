---
import NewsletterForm from "@/islands/home/NewsletterForm";
---

<section id="newsletter" class="scroll-mt-24">
  <div class="mx-auto w-full max-w-340 px-4 py-10 sm:px-6 sm:py-14 lg:py-18">
    <div
      class="rounded-[28px] bg-accent px-5 py-8 text-white shadow-[0_20px_50px_rgba(0,0,0,0.25)] sm:px-12 sm:py-12"
    >
      <h2 class="text-3xl font-black leading-none tracking-tight sm:text-4xl md:text-5xl">
        ¿TE APETECE ARCADIA HOY?
      </h2>
      <p class="mt-4 text-base text-white/80 sm:text-lg md:text-xl">
        Regístrate a nuestras ofertas y novedades
      </p>

      <div class="mt-7">
        <NewsletterForm client:load />
      </div>
    </div>
  </div>
</section>