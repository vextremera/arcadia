---
import NewsletterForm from "@/islands/home/NewsletterForm";
---

<section id="newsletter" class="scroll-mt-24">
  <div class="mx-auto w-full max-w-6xl px-6 py-14 lg:py-18">
    <div
      class="rounded-[28px] bg-[#7b1f1f] px-10 py-10 text-white shadow-[0_20px_50px_rgba(0,0,0,0.25)] sm:px-12 sm:py-12"
    >
      <h2 class="text-4xl font-black leading-none tracking-tight sm:text-5xl">
        ¿TE APETECE<br />ARCADIA HOY?
      </h2>
      <p class="mt-4 text-lg text-white/80 sm:text-xl">
        Regístrate a nuestras ofertas y novedades
      </p>

      <div class="mt-7">
        <NewsletterForm client:load />
      </div>
    </div>
  </div>
</section>
