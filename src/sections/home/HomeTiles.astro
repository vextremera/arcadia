---
const BOOK_SVG = `<svg xmlns="http://www.w3.org/2000/svg" height="52" viewBox="0 -960 960 960" width="52" fill="#fff"><path d="M160-120v-640q0-33 23.5-56.5T240-840h520v80H240v520h520v80H240q-33 0-56.5-23.5T160-120Zm160-120v-560h560v560H320Zm80-80h400v-400H400v400Zm0 0v-400 400Z"/></svg>`;
const MENU_SVG = `<svg xmlns="http://www.w3.org/2000/svg" height="52" viewBox="0 -960 960 960" width="52" fill="#fff"><path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm120-120h320v-80H320v80Zm0-160h320v-80H320v80Zm0-160h320v-80H320v80Zm-120 440v-560 560Z"/></svg>`;

const cartaBg = `background-image:url('/images/landing/carta.jpg');`;
---

<section class="w-full">
  <div class="grid w-full grid-cols-1 md:grid-cols-2">
    <!-- CARTA -->
    <a
      href="/pedir"
      class="relative aspect-square w-full overflow-hidden bg-zinc-900 text-white"
      style={cartaBg}
    >
      <div
        class="absolute inset-0 bg-[linear-gradient(90deg,rgba(0,0,0,0.55),rgba(0,0,0,0.25))]"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.20),transparent_50%)]"
      >
      </div>

      <div class="relative grid h-full w-full place-items-center">
        <div class="text-center">
          <div
            class="mx-auto grid h-20 w-20 place-items-center rounded-3xl bg-white/10"
            set:html={BOOK_SVG}
          />
          <div class="mt-4 text-2xl font-black tracking-wide">CARTA</div>
        </div>
      </div>
    </a>

    <!-- MENÚ -->
    <a href="/pedir" class="relative aspect-square w-full bg-[#7b1f1f]">
      <div class="relative grid h-full w-full place-items-center">
        <div
          class="grid w-[70%] max-w-105 place-items-center bg-zinc-800 aspect-square"
        >
          <div class="text-center">
            <div
              class="mx-auto grid h-20 w-20 place-items-center rounded-3xl bg-white/10"
              set:html={MENU_SVG}
            />
            <div class="mt-4 text-2xl font-black tracking-wide text-white">
              MENÚ
            </div>
          </div>
        </div>
      </div>
    </a>
  </div>
</section>
