---
const BOOK_SVG = `<svg xmlns="http://www.w3.org/2000/svg" height="44" viewBox="0 -960 960 960" width="44" fill="#fff"><path d="M160-120v-640q0-33 23.5-56.5T240-840h520v80H240v520h520v80H240q-33 0-56.5-23.5T160-120Zm160-120v-560h560v560H320Zm80-80h400v-400H400v400Zm0 0v-400 400Z"/></svg>`;

const MENU_SVG = `<svg xmlns="http://www.w3.org/2000/svg" height="44" viewBox="0 -960 960 960" width="44" fill="#fff"><path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm120-120h320v-80H320v80Zm0-160h320v-80H320v80Zm0-160h320v-80H320v80Zm-120 440v-560 560Z"/></svg>`;
---

<section class="w-full">
  <div class="mx-auto w-full max-w-6xl px-6 pb-10 lg:pb-14">
    <div
      class="grid overflow-hidden rounded-[28px] border border-zinc-200 lg:grid-cols-2"
    >
      <a
        href="/pedir"
        class="group relative grid min-h-55 place-items-center bg-zinc-800 text-white"
      >
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(255,255,255,.12),transparent_45%)]"
        >
        </div>
        <div
          class="absolute inset-0 opacity-30 bg-[linear-gradient(120deg,rgba(0,0,0,.55),transparent_60%)]"
        >
        </div>

        <div class="relative text-center">
          <div
            class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-white/10"
            set:html={BOOK_SVG}
          />
          <div class="mt-3 text-xl font-black tracking-wide">CARTA</div>
        </div>

        <span class="sr-only">Ir a la carta</span>
      </a>

      <a
        href="/pedir"
        class="group relative grid min-h-55 place-items-center bg-[#7b1f1f]"
      >
        <div
          class="relative grid h-42.5 w-[80%] max-w-[320px] place-items-center bg-zinc-800"
        >
          <div
            class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-white/10"
            set:html={MENU_SVG}
          />
          <div class="mt-3 text-xl font-black tracking-wide text-white">
            MENÚ
          </div>
        </div>

        <span class="sr-only">Ver menús</span>
      </a>
    </div>
  </div>
</section>
